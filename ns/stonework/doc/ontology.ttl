@prefix : <https://cyberterrain.org/ns/stonework#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://cyberterrain.org/ns/stonework#> .

<https://cyberterrain.org/ns/stonework#> rdf:type owl:Ontology ;
                                          owl:versionIRI <https://cyberterrain.org/ns/stonework/0.6.1> ;
                                          <http://purl.org/dc/terms/creator> "Hohimer Intelligence Strategies LLC" ;
                                          <http://purl.org/dc/terms/description> "A semantic threat ontology and research framework that serves as the ground-truth model for cyber threat intelligence in the CyberTerrain ecosystem. It provides an extensible foundation for modeling cyber threat intelligence concepts, objects, relationships, workflows, and knowledge, and aligns with established CTI framework ontologies — including STONES (STIX 2.1), ATT&CK, CAPEC, CWE, CVE, and CPE — as authoritative reference vocabularies rather than ontologies it imports and extends." ;
                                          <http://purl.org/dc/terms/license> <https://opensource.org/licenses/MIT> ;
                                          <http://purl.org/dc/terms/title> "STONEWORK — Semantic Threat Ontology and Research Framework"@en ;
                                          rdfs:label "STONEWORK"@en ;
                                          owl:versionInfo "0.6.1" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#notation
<http://www.w3.org/2004/02/skos/core#notation> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
<http://www.w3.org/2004/02/skos/core#prefLabel> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#scopeNote
<http://www.w3.org/2004/02/skos/core#scopeNote> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://cyberterrain.org/ns/stonework#accountOf
:accountOf rdf:type owl:ObjectProperty ;
           owl:inverseOf :hasAccount ;
           rdfs:domain :UserAccount ;
           rdfs:range :Agent ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "accountOf" .


###  https://cyberterrain.org/ns/stonework#achieves
:achieves rdf:type owl:ObjectProperty ;
          rdfs:domain :MalwareSample ,
                      :Tool ;
          rdfs:range :AITechnique ,
                     :AttackTechnique ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "achieves" .


###  https://cyberterrain.org/ns/stonework#actsOn
:actsOn rdf:type owl:ObjectProperty ;
        rdfs:domain :CyberActivity ;
        rdfs:range :CyberEntity ;
        rdfs:seeAlso <http://www.w3.org/ns/prov#used> ;
        <http://www.w3.org/2004/02/skos/core#definition> "Links a CyberActivity to the CyberEntity it acted upon — the asset, artifact, or resource the activity operated against."@en ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "actsOn" ;
        <http://www.w3.org/2004/02/skos/core#scopeNote> "Mirrors prov:used (an Activity used an Entity). Typical range instances are stonework:Host, stonework:RuntimeProcess, or other stonework:DigitalArtifact/stonework:Infrastructure individuals — e.g. the specific lsass.exe stonework:RuntimeProcess a credential-dumping attempt acted on. Distinct from stonework:targets: targets is a direct, open-domain/range lift of the STIX 2.1 relationship_type 'targets' shortcut, describing higher-level strategic targeting (a Sector, a Location, an Agent) by a Campaign/MalwareSample/ThreatActor. actsOn is purpose-built for the concrete technical asset one execution-trace Activity acted upon — the same distinction develop draws between stonework:mitigates (open, STIX-lifted) and stonework:mitigatesAttackPattern (purpose-built, controlled domain/range)."@en .


###  https://cyberterrain.org/ns/stonework#affected
:affected rdf:type owl:ObjectProperty ;
          rdfs:domain :Vulnerability ;
          rdfs:range :VersionedProduct ;
          <http://www.w3.org/2004/02/skos/core#definition> "Relates a vulnerability to a product version known to be affected by it." ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "affected" ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "The range is a stonework:VersionedProduct individual whose IRI is derived deterministically from the CPE identifier. The product individual may be populated by a separate CPE ingest; references from CVE data precede that ingest and are resolved when CPE data is loaded." .


###  https://cyberterrain.org/ns/stonework#affiliatedWith
:affiliatedWith rdf:type owl:ObjectProperty ;
                rdfs:range :Agent ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "affiliatedWith" .


###  https://cyberterrain.org/ns/stonework#associatedWith
:associatedWith rdf:type owl:ObjectProperty ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "associatedWith" .


###  https://cyberterrain.org/ns/stonework#attributedTo
:attributedTo rdf:type owl:ObjectProperty ;
              <http://www.w3.org/2004/02/skos/core#definition> "Links a CyberActivity to the Agent responsible for, or associated with, performing it." ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "attributedTo" ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain/range intentionally left unset: this property is a direct lift of the STIX 2.1 relationship_type 'attributed-to' shortcut. STIX does not schema-constrain which SDO/SCO types may appear as source_ref/target_ref for a given relationship_type — that's producer convention, not enforceable structure, and a closed domain/range here would misrepresent real STIX 2.1 data and mislead reasoner-based consumers. In practice the object is typically a stonework:Agent — most often a stonework:ThreatActor in the adversarial case, matching STIX's own convention for 'attributed-to' — but stonework:CyberActivity is a general occurrence class covering defensive and neutral activities too (Investigations, a ControlPlan's Process), so the performer need not be adversarial."@en .


###  https://cyberterrain.org/ns/stonework#attributedToAgent
:attributedToAgent rdf:type owl:ObjectProperty ;
                   rdfs:domain :DigitalIdentity ;
                   rdfs:range :Agent ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Links a digital identity to the real-world Agent it is believed to belong to." ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "attributedToAgent" .


###  https://cyberterrain.org/ns/stonework#authoredBy
:authoredBy rdf:type owl:ObjectProperty ;
            rdfs:domain :Provenance ;
            rdfs:range :Agent ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "authoredBy"@en .


###  https://cyberterrain.org/ns/stonework#boundTo
:boundTo rdf:type owl:ObjectProperty ;
         rdfs:domain :Variable ;
         rdfs:range owl:Thing ;
         <http://www.w3.org/2004/02/skos/core#definition> "Binds a Variable, at execution time, to the individual it actually resolved to — e.g. the specific SecurityCondition instance a successful attempt produced."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "boundTo" ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "Used when the bound value is an instance of a class rather than a scalar; see stonework:boundToLiteral for scalar bindings. Tested by stonework:guardType on a Transition."@en .


###  https://cyberterrain.org/ns/stonework#categorizedBy
:categorizedBy rdf:type owl:ObjectProperty ,
                        owl:TransitiveProperty ;
               rdfs:range :Category ;
               <http://www.w3.org/2004/02/skos/core#definition> "Links any individual to one or more contextual categories." ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "categorizedBy" ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "This is the primary mechanism for flexible, context-sensitive classification (e.g., Evidence, HighValue, Suspect, etc.). Multiple categories per individual are allowed."@en .


###  https://cyberterrain.org/ns/stonework#circumvents
:circumvents rdf:type owl:ObjectProperty ;
             rdfs:domain :AITechnique ,
                         :AttackPattern ;
             rdfs:range :AnalyticTechnique ,
                        :DefendTechnique ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "circumvents" .


###  https://cyberterrain.org/ns/stonework#clusteredWith
:clusteredWith rdf:type owl:ObjectProperty ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "clusteredWith" .


###  https://cyberterrain.org/ns/stonework#communicatesWith
:communicatesWith rdf:type owl:ObjectProperty ,
                           owl:SymmetricProperty ;
                  rdfs:domain :MalwareSample ,
                              :Tool ;
                  rdfs:range :Infrastructure ,
                             :URI ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "communicatesWith" .


###  https://cyberterrain.org/ns/stonework#compromisedIn
:compromisedIn rdf:type owl:ObjectProperty ;
               rdfs:domain :Agent ;
               rdfs:range :Incident ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "compromisedIn" .


###  https://cyberterrain.org/ns/stonework#consistsOf
:consistsOf rdf:type owl:ObjectProperty ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "consistsOf" .


###  https://cyberterrain.org/ns/stonework#contains
:contains rdf:type owl:ObjectProperty ,
                   owl:TransitiveProperty ;
          rdfs:domain :AutonomousSystem ,
                      :IPBlock ;
          rdfs:range :IPAddress ,
                     :IPBlock ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "contains" .


###  https://cyberterrain.org/ns/stonework#correspondsToStep
:correspondsToStep rdf:type owl:ObjectProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :CyberActivity ;
                   rdfs:range :Step ;
                   rdfs:seeAlso <http://purl.org/net/p-plan#correspondsToStep> ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Links an executing CyberActivity to the Step it is the concrete performance of."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "correspondsToStep" ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Directly mirrors p-plan:correspondsToStep (domain prov:Activity, range p-plan:Step), narrowed to stonework:CyberActivity/stonework:Step. Declared functional, matching p-plan: a single CyberActivity corresponds to at most one Step, but a Step may still be the target of many CyberActivity instances across retries or repeated executions. Fills the gap noted on stonework:Step: the property linking an executing Activity back to the Step it realizes."@en .


###  https://cyberterrain.org/ns/stonework#counters
:counters rdf:type owl:ObjectProperty ;
          rdfs:domain :AnalyticTechnique ,
                      :DefendTechnique ;
          rdfs:range :AITechnique ,
                     :AttackTechnique ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "counters" .


###  https://cyberterrain.org/ns/stonework#dependencyOf
:dependencyOf rdf:type owl:ObjectProperty ,
                       owl:TransitiveProperty ;
              rdfs:domain :VersionedProduct ;
              rdfs:range :VersionedProduct ;
              <http://www.w3.org/2004/02/skos/core#definition> "Relates a product to another product that depends on it. Transitive to support supply chain reasoning across deep dependency trees."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "dependencyOf"@en .


###  https://cyberterrain.org/ns/stonework#derivedFrom
:derivedFrom rdf:type owl:ObjectProperty ;
             rdfs:domain :DetectionRule ;
             rdfs:range :CyberActivity ,
                        :DigitalArtifact ,
                        :Infrastructure ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "derivedFrom" .


###  https://cyberterrain.org/ns/stonework#describesInfrastructure
:describesInfrastructure rdf:type owl:ObjectProperty ;
                         rdfs:range :Infrastructure ;
                         <http://www.w3.org/2004/02/skos/core#definition> "Links a Software Bill of Materials to the enterprise infrastructure, system, or application whose component composition it inventories." ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "describes infrastructure" ;
                         <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain intentionally left unset. The primary subject is stonework:SoftwareBillOfMaterials, but other provenance-bearing artifacts may describe infrastructure without being SBOMs. Multiple SBOMs may describe the same Infrastructure over time, enabling historical component inventory."@en .


###  https://cyberterrain.org/ns/stonework#detects
:detects rdf:type owl:ObjectProperty ;
         <http://www.w3.org/2004/02/skos/core#definition> "Relates a source DetectionRule, Sensor, Indicator, or defensive technique to the threat, activity, or artifact it is capable of detecting. Corresponds to STIX relationship_type 'detects'."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "detects" ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain/range intentionally left unset: this property is a direct lift of the STIX 2.1 relationship_type 'detects' shortcut. STIX does not schema-constrain which SDO/SCO types may appear as source_ref/target_ref for a given relationship_type — that's producer convention, not enforceable structure, and a closed domain/range here would misrepresent real STIX 2.1 data and mislead reasoner-based consumers."@en .


###  https://cyberterrain.org/ns/stonework#downloads
:downloads rdf:type owl:ObjectProperty ;
           rdfs:domain :File ,
                       :MalwareSample ,
                       :Tool ;
           rdfs:range :File ,
                      :MalwareSample ,
                      :Tool ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "downloads" .


###  https://cyberterrain.org/ns/stonework#drops
:drops rdf:type owl:ObjectProperty ,
                owl:TransitiveProperty ;
       rdfs:domain :MalwareSample ;
       rdfs:range :DigitalArtifact ;
       <http://www.w3.org/2004/02/skos/core#prefLabel> "drops" .


###  https://cyberterrain.org/ns/stonework#emailOf
:emailOf rdf:type owl:ObjectProperty ;
         owl:inverseOf :hasEmail ;
         rdfs:domain :EmailAddress ;
         rdfs:range :Agent ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "emailOf" .


###  https://cyberterrain.org/ns/stonework#exploits
:exploits rdf:type owl:ObjectProperty ;
          <http://www.w3.org/2004/02/skos/core#definition> "Shortcut triple: source Malware or ThreatActor exploits target Vulnerability. Corresponds to STIX relationship_type 'exploits'." ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "exploits" ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain/range intentionally left unset: this property is a direct lift of the STIX 2.1 relationship_type 'exploits' shortcut. STIX does not schema-constrain which SDO/SCO types may appear as source_ref/target_ref for a given relationship_type — that's producer convention, not enforceable structure, and a closed domain/range here would misrepresent real STIX 2.1 data and mislead reasoner-based consumers."@en .


###  https://cyberterrain.org/ns/stonework#exploitsWeakness
:exploitsWeakness rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :hasWeakness ;
                  rdfs:domain :Vulnerability ;
                  rdfs:range :Weakness ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Relates a vulnerability to the weakness class it instantiates or exploits. Subproperty of stonework:hasWeakness, using the directional 'exploits' semantics aligned with CVE and CWE mapping conventions."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "exploitsWeakness"@en ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "The range is a stonework:Weakness individual whose IRI is derived from the CWE identifier. Used by cve:exploitsWeakness (rdfs:subPropertyOf this property) when CVE data is loaded."@en .


###  https://cyberterrain.org/ns/stonework#fixedInProduct
:fixedInProduct rdf:type owl:ObjectProperty ;
                rdfs:domain :Vulnerability ;
                rdfs:range :VersionedProduct ;
                <http://www.w3.org/2004/02/skos/core#definition> "Relates a vulnerability to the product version in which it was addressed."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "fixedInProduct"@en ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "The range is a stonework:VersionedProduct individual whose IRI is derived deterministically from the CPE identifier. Populated by CVE/patch ingest."@en .


###  https://cyberterrain.org/ns/stonework#fromStep
:fromStep rdf:type owl:ObjectProperty ;
          rdfs:domain :Transition ;
          rdfs:range :Step ;
          <http://www.w3.org/2004/02/skos/core#definition> "The Step a Transition leaves."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "fromStep" .


###  https://cyberterrain.org/ns/stonework#guardOperator
:guardOperator rdf:type owl:ObjectProperty ;
               rdfs:domain :Transition ;
               rdfs:range :ComparisonOperator ;
               <http://www.w3.org/2004/02/skos/core#definition> "The comparison operator applied between guardVariable's bound literal value and guardLiteralValue."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "guardOperator" ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "Omitted = Equals, preserving equality-only guard semantics without requiring this property on every Transition."@en .


###  https://cyberterrain.org/ns/stonework#guardType
:guardType rdf:type owl:ObjectProperty ;
           rdfs:domain :Transition ;
           rdfs:range rdfs:Class ;
           <http://www.w3.org/2004/02/skos/core#definition> "A Transition fires only if guardVariable's stonework:boundTo value is an instance of this class."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "guardType" ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Used for guards that test whether a Variable was bound to an instance of a particular class (e.g. testing that an attempt's outcome Variable was bound to a stonework:SecurityCondition instance) rather than testing equality against a scalar."@en .


###  https://cyberterrain.org/ns/stonework#guardVariable
:guardVariable rdf:type owl:ObjectProperty ;
               rdfs:domain :Transition ;
               rdfs:range :Variable ;
               <http://www.w3.org/2004/02/skos/core#definition> "The Variable whose bound value is tested to decide whether a Transition is taken."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "guardVariable" .


###  https://cyberterrain.org/ns/stonework#hasAccount
:hasAccount rdf:type owl:ObjectProperty ;
            rdfs:domain :Agent ;
            rdfs:range :UserAccount ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "hasAccount"@en .


###  https://cyberterrain.org/ns/stonework#hasArtifact
:hasArtifact rdf:type owl:ObjectProperty ;
             rdfs:domain :MalwareSample ;
             rdfs:range :DigitalArtifact ;
             <http://www.w3.org/2004/02/skos/core#definition> "Links a MalwareSample to a captured binary artifact (file, memory dump, or encoded payload) constituting the physical evidence of the sample."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "hasArtifact"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Optional — a MalwareSample may be known via hashes or threat reports without the binary being available. When present, the artifact provides retrievable binary evidence. Corresponds to the STIX 2.1 sample_refs property on the malware SDO."@en .


###  https://cyberterrain.org/ns/stonework#hasBomEntry
:hasBomEntry rdf:type owl:ObjectProperty ;
             rdfs:domain :SoftwareBillOfMaterials ;
             rdfs:range :BomEntry ;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a Software Bill of Materials to one of its component entries."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "has BOM entry" ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Each BomEntry carries the component's VersionedProduct reference (via stonework:installationOf) and any component-specific metadata (PURL, license, hash, component type). Range is BomEntry rather than VersionedProduct directly because the same VersionedProduct may appear in multiple SBOMs with different component-level attributes."@en .


###  https://cyberterrain.org/ns/stonework#hasCvssMetric
:hasCvssMetric rdf:type owl:ObjectProperty ;
               rdfs:domain :Vulnerability ;
               <http://www.w3.org/2004/02/skos/core#definition> "Relates a vulnerability to a structured CVSS metric record carrying the version, vector string, and base/temporal/environmental scores."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "hasCvssMetric"@en ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "A single vulnerability may carry metrics for multiple CVSS versions (2.0, 3.1, 4.0). For a single headline score and severity, use stonework:cvssBaseScore and stonework:cvssSeverity directly on the Vulnerability. This property links to the full per-version metric objects populated by CVE ingest."@en .


###  https://cyberterrain.org/ns/stonework#hasDependency
:hasDependency rdf:type owl:ObjectProperty ;
               owl:inverseOf :dependencyOf ;
               rdfs:domain :VersionedProduct ;
               rdfs:range :VersionedProduct ;
               <http://www.w3.org/2004/02/skos/core#definition> "Relates a product version to another product version it depends on."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "hasDependency"@en .


###  https://cyberterrain.org/ns/stonework#hasEmail
:hasEmail rdf:type owl:ObjectProperty ;
          rdfs:domain :Agent ;
          rdfs:range :EmailAddress ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "hasEmail" .


###  https://cyberterrain.org/ns/stonework#hasHash
:hasHash rdf:type owl:ObjectProperty ;
         rdfs:range :Hash ;
         <http://www.w3.org/2004/02/skos/core#definition> "Relates an entity to its hash entries. The range is a stonework:Hash individual representing a single hash algorithm and digest value." ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "hasHash" .


###  https://cyberterrain.org/ns/stonework#hasIdentifier
:hasIdentifier rdf:type owl:ObjectProperty ;
               rdfs:domain :DigitalIdentity ;
               rdfs:range :Identifier ;
               <http://www.w3.org/2004/02/skos/core#definition> "Links a Digital Identity to one or more atomic Identifiers that belong to it." ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "hasIdentifier" .


###  https://cyberterrain.org/ns/stonework#hasInputVariable
:hasInputVariable rdf:type owl:ObjectProperty ;
                  rdfs:domain :Behavior ;
                  rdfs:range :Variable ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Declares a Variable whose value must be bound before the Behavior or Step executes."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "hasInputVariable" .


###  https://cyberterrain.org/ns/stonework#hasInstalledProduct
:hasInstalledProduct rdf:type owl:ObjectProperty ;
                     rdfs:domain :Infrastructure ;
                     rdfs:range :VersionedProduct ;
                     <http://www.w3.org/2004/02/skos/core#definition> "Links an enterprise infrastructure to a versioned product known to be installed in that environment." ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "has installed product" ;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "Used in the user-data graph to assert enterprise inventory directly. Combined with stonework:versionOf and stonework:affected, enables traversal from installed software to applicable CVEs. For SBOM-based ingest with full component provenance, see stonework:SoftwareBillOfMaterials and stonework:hasBomEntry."@en .


###  https://cyberterrain.org/ns/stonework#hasMember
:hasMember rdf:type owl:ObjectProperty ;
           rdfs:domain :Group ,
                       :Organization ,
                       :ThreatActor ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "hasMember"@en .


###  https://cyberterrain.org/ns/stonework#hasObservable
:hasObservable rdf:type owl:ObjectProperty ;
               rdfs:domain :SecurityObservation ;
               rdfs:range :CyberEntity ;
               rdfs:seeAlso <https://www.w3.org/TR/vocab-ssn/#SOSAhasResult> ;
               <http://www.w3.org/2004/02/skos/core#definition> "Links a SecurityObservation to the cyber observable objects (SCOs) captured during the observation window."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "hasObservable"@en ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "The range covers any SCO type: stonework:IPAddress, stonework:Domain, stonework:File, stonework:NetworkTraffic, stonework:RuntimeProcess, stonework:UserAccount, etc. Corresponds to STIX observed-data object_refs. Inspired by SOSA sosa:hasResult."@en .


###  https://cyberterrain.org/ns/stonework#hasOutputVariable
:hasOutputVariable rdf:type owl:ObjectProperty ;
                   rdfs:domain :Behavior ;
                   rdfs:range :Variable ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Declares a Variable whose value is bound only once the Behavior or Step has executed."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "hasOutputVariable" .


###  https://cyberterrain.org/ns/stonework#hasPhoneNumber
:hasPhoneNumber rdf:type owl:ObjectProperty ;
                rdfs:domain :Agent ;
                rdfs:range :PhoneNumber ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "hasPhoneNumber"@en .


###  https://cyberterrain.org/ns/stonework#hasStep
:hasStep rdf:type owl:ObjectProperty ;
         rdfs:domain :Behavior ;
         rdfs:range :Step ;
         <http://www.w3.org/2004/02/skos/core#definition> "Relates a Behavior (Procedure, Playbook, ThreatScenario, Control, or another Step) to a Step that decomposes it."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "hasStep" ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain is the general Behavior root rather than a specific subclass, so decomposition applies uniformly across Procedure, Playbook, ThreatScenario, and — recursively, since Step is itself a Behavior — Step."@en .


###  https://cyberterrain.org/ns/stonework#hasTechnique
:hasTechnique rdf:type owl:ObjectProperty ,
                       owl:TransitiveProperty ;
              rdfs:domain :Tactic ,
                          :Technique ;
              rdfs:range :Technique ;
              <http://www.w3.org/2004/02/skos/core#definition> "Relates a tactic to an offensive technique that serves that tactic's goal." ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "hasTechnique" .


###  https://cyberterrain.org/ns/stonework#hasVendor
:hasVendor rdf:type owl:ObjectProperty ;
           owl:inverseOf :vendorOf ;
           rdfs:domain :Product ;
           rdfs:range :Agent ;
           <http://www.w3.org/2004/02/skos/core#definition> "Relates a product family to the Agent (organization or person) that develops or maintains it."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "hasVendor"@en .


###  https://cyberterrain.org/ns/stonework#hasVersion
:hasVersion rdf:type owl:ObjectProperty ;
            rdfs:domain :Product ;
            rdfs:range :VersionedProduct ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates a product family to a specific versioned product instance."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "hasVersion"@en .


###  https://cyberterrain.org/ns/stonework#hasWeakness
:hasWeakness rdf:type owl:ObjectProperty ,
                      owl:AsymmetricProperty ;
             rdfs:domain :Vulnerability ;
             rdfs:range :Weakness ;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a vulnerability to the weakness class it exploits or instantiates."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "hasWeakness" ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "The range is a stonework:Weakness individual whose IRI is derived from the CWE identifier. The weakness individual may be populated by a separate CWE ingest."@en .


###  https://cyberterrain.org/ns/stonework#hashOf
:hashOf rdf:type owl:ObjectProperty ;
        owl:inverseOf :hasHash ;
        rdfs:domain :Hash ;
        <http://www.w3.org/2004/02/skos/core#definition> "Relates a hash entry to the entity it describes. The domain is a stonework:Hash individual representing a single hash algorithm and digest value." ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "hashOf" .


###  https://cyberterrain.org/ns/stonework#hostedBy
:hostedBy rdf:type owl:ObjectProperty ,
                   owl:TransitiveProperty ;
          rdfs:domain :Infrastructure ;
          rdfs:range :Agent ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "hostedBy" .


###  https://cyberterrain.org/ns/stonework#implementedBy
:implementedBy rdf:type owl:ObjectProperty ;
               owl:inverseOf :implements ;
               rdfs:domain :Behavior ;
               rdfs:range :Behavior ;
               <http://www.w3.org/2004/02/skos/core#definition> "Relates an abstract Behavior to a concrete, Step-decomposed Behavior that realizes it."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "implementedBy" .


###  https://cyberterrain.org/ns/stonework#implements
:implements rdf:type owl:ObjectProperty ;
            rdfs:domain :Behavior ;
            rdfs:range :Behavior ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates a concrete, Step-decomposed Behavior to the more abstract Behavior it is a specific realization of."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "implements" ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "General-purpose relationship covering both offense (a Procedure implements a Technique) and defense (a ControlPlan implements a Control) with one property rather than a bespoke one per pairing."@en .


###  https://cyberterrain.org/ns/stonework#indicates
:indicates rdf:type owl:ObjectProperty ;
           rdfs:domain :Indicator ;
           <http://www.w3.org/2004/02/skos/core#definition> "Asserts that when the source Indicator's pattern is matched, it signals the presence of the target adversary behavior, malware, campaign, or threat actor." ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "indicates"@en ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Corresponds to STIX relationship_type 'indicates'. Domain is stonework:Indicator — unlike the source side of other STIX relationship shortcuts, this is definitional rather than open-world convention: an object is only ever an Indicator because it indicates something, per STIX's own spec role for that object type. Range is intentionally left unset: an Indicator may indicate all sorts of things (AttackPattern/AttackTechnique, Malware, Campaign, CyberActivityCluster, ThreatActor, Infrastructure, Tool, and whatever else a producer's pattern targets), and STIX does not schema-constrain the target_ref type for a given relationship_type. A single Indicator may indicate multiple targets."@en .


###  https://cyberterrain.org/ns/stonework#installationOf
:installationOf rdf:type owl:ObjectProperty ;
                rdfs:range :VersionedProduct ;
                <http://www.w3.org/2004/02/skos/core#definition> "Relates a component context to the versioned product it references or instantiates."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "installation of" ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Used by both stonework:BomEntry (declarative — a component listed in an SBOM) and stonework:ProductInstallation (observational — a verified deployment on a specific system). Domain is intentionally left unset to avoid restricting future component-context subclasses; intended subjects are subclasses of stonework:ComponentContext."@en .


###  https://cyberterrain.org/ns/stonework#isStepOf
:isStepOf rdf:type owl:ObjectProperty ;
          owl:inverseOf :hasStep ;
          rdfs:domain :Step ;
          rdfs:range :Behavior ;
          <http://www.w3.org/2004/02/skos/core#definition> "Relates a Step to the Behavior it decomposes."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "isStepOf" .


###  https://cyberterrain.org/ns/stonework#linkedTo
:linkedTo rdf:type owl:ObjectProperty ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "linkedTo" .


###  https://cyberterrain.org/ns/stonework#madeBySensor
:madeBySensor rdf:type owl:ObjectProperty ;
              rdfs:domain :SecurityObservation ;
              rdfs:range :Sensor ;
              rdfs:seeAlso <https://www.w3.org/TR/vocab-ssn/#SOSAmadeBySensor> ;
              <http://www.w3.org/2004/02/skos/core#definition> "Links a SecurityObservation to the Sensor that produced it."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "madeBySensor"@en ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "Inspired by SOSA sosa:madeBySensor. Enables queries such as 'which sensor produced this observation?' and 'what has this IDS sensor observed in the last 24 hours?' The producing sensor may also be the created_by_ref identity in the STIX wire format."@en .


###  https://cyberterrain.org/ns/stonework#markingRef
:markingRef rdf:type owl:ObjectProperty ;
            rdfs:range :Markings ;
            <http://www.w3.org/2004/02/skos/core#definition> "Reference to the Markings applied by this marking entry." ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "markingRef" .


###  https://cyberterrain.org/ns/stonework#memberOf
:memberOf rdf:type owl:ObjectProperty ;
          owl:inverseOf :hasMember ;
          rdfs:range :Group ,
                     :Organization ,
                     :ThreatActor ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "memberOf"@en .


###  https://cyberterrain.org/ns/stonework#memberOfFamily
:memberOfFamily rdf:type owl:ObjectProperty ;
                rdfs:domain :MalwareSample ;
                rdfs:range :MalwareFamily ;
                <http://www.w3.org/2004/02/skos/core#definition> "Relates a specific malware sample to the malware family it has been classified as belonging to, based on shared behavioral patterns, code similarity, infrastructure overlap, or analyst attribution." ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "memberOfFamily" .


###  https://cyberterrain.org/ns/stonework#mentions
:mentions rdf:type owl:ObjectProperty ;
          rdfs:domain :Provenance ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "mentions" .


###  https://cyberterrain.org/ns/stonework#mitigates
:mitigates rdf:type owl:ObjectProperty ;
           <http://www.w3.org/2004/02/skos/core#definition> "Relates a Mitigation, CourseOfAction, or Control to the AttackPattern or Vulnerability it addresses. Corresponds to STIX relationship_type 'mitigates'."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "mitigates" ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain/range intentionally left unset: this property is a direct lift of the STIX 2.1 relationship_type 'mitigates' shortcut. STIX does not schema-constrain which SDO/SCO types may appear as source_ref/target_ref for a given relationship_type — that's producer convention, not enforceable structure, and a closed domain/range here would misrepresent real STIX 2.1 data and mislead reasoner-based consumers. Contrast with stonework:mitigatesAttackPattern, a purpose-built subproperty with a controlled domain/range, populated by materialize-technique-links.sparql rather than lifted directly from STIX."@en .


###  https://cyberterrain.org/ns/stonework#mitigatesAttackPattern
:mitigatesAttackPattern rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf :mitigates ;
                        rdfs:domain :Countermeasure ;
                        rdfs:range :AttackPattern ;
                        <http://www.w3.org/2004/02/skos/core#definition> "Relates a Countermeasure (e.g. a CIS Control safeguard) to the AttackPattern it mitigates, resolved from a shared technique identifier."@en ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "mitigatesAttackPattern" ;
                        <http://www.w3.org/2004/02/skos/core#scopeNote> "Materialized by joining a framework's technique-identifier literal (see stonework:relatedTechniqueIdentifier, e.g. cis:mitigatesTechniqueId) against the ATT&CK technique's external reference. Framework ontologies declare their concrete property (e.g. cis:mitigatesTechnique) as rdfs:subPropertyOf this."@en .


###  https://cyberterrain.org/ns/stonework#observedIn
:observedIn rdf:type owl:ObjectProperty ;
            rdfs:domain :DigitalArtifact ,
                        :Infrastructure ;
            rdfs:range :Campaign ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "observedIn" .


###  https://cyberterrain.org/ns/stonework#originatesFrom
:originatesFrom rdf:type owl:ObjectProperty ;
                rdfs:domain :Agent ;
                rdfs:range :Location ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "originatesFrom" .


###  https://cyberterrain.org/ns/stonework#overlapsWith
:overlapsWith rdf:type owl:ObjectProperty ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "overlapsWith" .


###  https://cyberterrain.org/ns/stonework#phoneNumberOf
:phoneNumberOf rdf:type owl:ObjectProperty ;
               owl:inverseOf :hasPhoneNumber ;
               rdfs:domain :PhoneNumber ;
               rdfs:range :Agent ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "phoneNumberOf" .


###  https://cyberterrain.org/ns/stonework#playsRole
:playsRole rdf:type owl:ObjectProperty ;
           rdfs:range :Role ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "playsRole" .


###  https://cyberterrain.org/ns/stonework#precededByStep
:precededByStep rdf:type owl:ObjectProperty ;
                rdfs:domain :Step ;
                rdfs:range :Step ;
                <http://www.w3.org/2004/02/skos/core#definition> "Relates a Step to another Step that must occur before it within the same parent Behavior."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "precededByStep" ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Deliberately distinct from stonework:precedes, whose domain and range are IntelligenceProduct (report-version succession) — an unrelated relationship. precededByStep expresses a graph that may contain cycles: an edge targeting an already-reached Step is a loop, not an error. Use stonework:Transition instead when the edge itself needs a guard condition or other structure attached."@en .


###  https://cyberterrain.org/ns/stonework#precedes
:precedes rdf:type owl:ObjectProperty ;
          rdfs:domain :IntelligenceProduct ;
          rdfs:range :IntelligenceProduct ;
          <http://www.w3.org/2004/02/skos/core#definition> "Temporal succession of Information (v1 precedes v2 of a report)"@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "precedes" .


###  https://cyberterrain.org/ns/stonework#predictedType
:predictedType rdf:type owl:ObjectProperty ;
               rdfs:domain :Hypothesis ;
               rdfs:range rdfs:Class ;
               <http://www.w3.org/2004/02/skos/core#definition> "The class a Hypothesis predicts its stonework:predictsVariable will be bound to an instance of, once executed."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "predictedType" ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "Mirrors stonework:guardType on Transition. Exists because a Hypothesis is typically formed before the Variable's eventual value has been constructed — at prediction time there is usually no individual yet to name via stonework:predictedValue, only an expected class of outcome (e.g. 'this attempt will produce some stonework:SecurityCondition')."@en .


###  https://cyberterrain.org/ns/stonework#predictedValue
:predictedValue rdf:type owl:ObjectProperty ;
                rdfs:domain :Hypothesis ;
                rdfs:range owl:Thing ;
                <http://www.w3.org/2004/02/skos/core#definition> "The individual a Hypothesis predicts its stonework:predictsVariable will be bound to, once executed."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "predictedValue" ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Mirrors stonework:boundTo on the actual-result side; usable only when a specific pre-existing individual is predicted. See stonework:predictedType for the more common case of predicting a class of outcome rather than a specific not-yet-constructed individual, and stonework:predictedLiteral for predictions of a scalar."@en .


###  https://cyberterrain.org/ns/stonework#predictsVariable
:predictsVariable rdf:type owl:ObjectProperty ;
                  rdfs:domain :Hypothesis ;
                  rdfs:range :Variable ;
                  <http://www.w3.org/2004/02/skos/core#definition> "The Variable whose eventual binding a Hypothesis is a prediction about."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "predictsVariable" ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "Because stonework:hasInputVariable/stonework:hasOutputVariable are declared on stonework:Behavior, and stonework:Step is itself a Behavior, a Hypothesis may predict a Variable declared at any level of a Step/Plan decomposition — a top-level Plan's overall outcome or a single Step's individual result — without a separate property per level."@en .


###  https://cyberterrain.org/ns/stonework#produces
:produces rdf:type owl:ObjectProperty ;
          rdfs:domain :CyberActivity ;
          rdfs:range :CyberEntity ;
          <http://www.w3.org/2004/02/skos/core#definition> "Links an executing CyberActivity to a CyberEntity it constructed or generated in the course of executing."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "produces" ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "General-purpose construction/generation link — e.g. the CyberActivity realizing a Step is what actually constructs the value a Variable ends up stonework:boundTo, or a complex output artifact (a dataset, a report) that value refers to."@en .


###  https://cyberterrain.org/ns/stonework#references
:references rdf:type owl:ObjectProperty ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "references" .


###  https://cyberterrain.org/ns/stonework#registeredTo
:registeredTo rdf:type owl:ObjectProperty ;
              rdfs:domain :Infrastructure ;
              rdfs:range :Agent ;
              <http://www.w3.org/2004/02/skos/core#definition> "Relates infrastructure to the Agent recorded as its owner or registrant of record — the entity in whose name the resource is officially registered."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "registeredTo" .


###  https://cyberterrain.org/ns/stonework#registeredWith
:registeredWith rdf:type owl:ObjectProperty ;
                rdfs:domain :Infrastructure ;
                rdfs:range :Agent ;
                <http://www.w3.org/2004/02/skos/core#definition> "Relates infrastructure to the registrar, registry, or administrative authority through which the registration was processed or is maintained."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "registeredWith" .


###  https://cyberterrain.org/ns/stonework#relatedAttackPattern
:relatedAttackPattern rdf:type owl:ObjectProperty ;
                      rdfs:range :AttackPattern ;
                      <http://www.w3.org/2004/02/skos/core#definition> "Relates an entity to an AttackPattern representing the same underlying technique in a different framework shape, resolved from a shared technique identifier (e.g. a CAPEC entry and the MITRE ATT&CK technique it maps to, or a CWE weakness and the CAPEC pattern that exploits it)."@en ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "relatedAttackPattern" ;
                      <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain intentionally left unset: subjects include stonework:Weakness (CWE → CAPEC) and stonework:AttackPattern itself (CAPEC → ATT&CK). Materialized by joining a framework's technique-identifier literal (see stonework:relatedTechniqueIdentifier) against the ATT&CK technique's external reference. Framework ontologies declare their concrete property (e.g. capec:relatedAttackTechnique, cwe:relatedAttackPattern) as rdfs:subPropertyOf this."@en .


###  https://cyberterrain.org/ns/stonework#relatedTechnique
:relatedTechnique rdf:type owl:ObjectProperty ;
                  rdfs:domain :CyberTechnique ;
                  rdfs:range :CyberTechnique ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Relates a CyberTechnique to another related CyberTechnique via a cross-framework or cross-abstraction-level association."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "relatedTechnique" ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "For technique-to-technique associations where both ends are already stonework:CyberTechnique individuals. Where the association instead crosses AttackPattern shapes (e.g. CWE weakness → CAPEC pattern, CAPEC pattern → ATT&CK technique), use stonework:relatedAttackPattern, whose domain is not restricted to CyberTechnique."@en .


###  https://cyberterrain.org/ns/stonework#relatedTo
:relatedTo rdf:type owl:ObjectProperty ;
           <http://www.w3.org/2004/02/skos/core#definition> "Shortcut triple: generic relationship. Corresponds to STIX relationship_type 'related-to'." ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "relatedTo" .


###  https://cyberterrain.org/ns/stonework#remediates
:remediates rdf:type owl:ObjectProperty ;
            rdfs:range :Vulnerability ,
                       :Weakness ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "remediates" .


###  https://cyberterrain.org/ns/stonework#resolvesTo
:resolvesTo rdf:type owl:ObjectProperty ;
            rdfs:domain :Infrastructure ;
            rdfs:range :Infrastructure ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "resolvesTo"@en .


###  https://cyberterrain.org/ns/stonework#revokedBy
:revokedBy rdf:type owl:ObjectProperty ;
           <http://www.w3.org/2004/02/skos/core#definition> "Shortcut triple: source STIX object is revoked and superseded by target. Corresponds to STIX relationship_type 'revoked-by'." ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "revokedBy" .


###  https://cyberterrain.org/ns/stonework#sharesCertificate
:sharesCertificate rdf:type owl:ObjectProperty ;
                   rdfs:domain :Infrastructure ;
                   rdfs:range :Certificate ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "sharesCertificate" .


###  https://cyberterrain.org/ns/stonework#sharesRegistrant
:sharesRegistrant rdf:type owl:ObjectProperty ;
                  rdfs:domain :Infrastructure ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "sharesRegistrant" .


###  https://cyberterrain.org/ns/stonework#subdomainOf
:subdomainOf rdf:type owl:ObjectProperty ,
                      owl:TransitiveProperty ;
             rdfs:domain :Domain ;
             rdfs:range :Domain ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "subdomainOf" .


###  https://cyberterrain.org/ns/stonework#supersededBy
:supersededBy rdf:type owl:ObjectProperty ;
              rdfs:domain :Vulnerability ;
              rdfs:range :Vulnerability ;
              <http://www.w3.org/2004/02/skos/core#definition> "Relates a vulnerability to the vulnerability record that supersedes it, e.g. when a CVE is split, merged, or formally replaced by another identifier."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "supersededBy"@en ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "Corresponds to cve:replacedBy in CVE JSON 5.x, but as an object property linking to a stonework:Vulnerability individual rather than a string. The source-specific string form is preserved on cve:replacedBy."@en .


###  https://cyberterrain.org/ns/stonework#supersedes
:supersedes rdf:type owl:ObjectProperty ,
                     owl:TransitiveProperty ;
            rdfs:domain :VersionedProduct ;
            rdfs:range :VersionedProduct ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates a product version to an older version it replaces. Transitive to support full product lifecycle reasoning."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "supersedes"@en .


###  https://cyberterrain.org/ns/stonework#targets
:targets rdf:type owl:ObjectProperty ;
         <http://www.w3.org/2004/02/skos/core#definition> "Shortcut triple: source targets the target Identity, Vulnerability, or Location. Corresponds to STIX relationship_type 'targets'." ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "targets" ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain/range intentionally left unset: this property is a direct lift of the STIX 2.1 relationship_type 'targets' shortcut. STIX does not schema-constrain which SDO/SCO types may appear as source_ref/target_ref for a given relationship_type — that's producer convention, not enforceable structure, and a closed domain/range here would misrepresent real STIX 2.1 data and mislead reasoner-based consumers."@en .


###  https://cyberterrain.org/ns/stonework#techniqueOf
:techniqueOf rdf:type owl:ObjectProperty ;
             owl:inverseOf :hasTechnique ;
             rdfs:domain :Technique ;
             rdfs:range :Tactic ,
                        :Technique ;
             rdfs:isDefinedBy <https://cyberterrain.org/ns/stonework#> ;
             <http://www.w3.org/2004/02/skos/core#definition> "Links a Technique to the Tactic(s) it achieves or supports."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "techniqueOf"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "This is the inverse of hasTechnique. A single Technique may support multiple Tactics (e.g. 'Phishing' supports both Initial Access and Credential Access)."@en .


###  https://cyberterrain.org/ns/stonework#toStep
:toStep rdf:type owl:ObjectProperty ;
        rdfs:domain :Transition ;
        rdfs:range :Step ;
        <http://www.w3.org/2004/02/skos/core#definition> "The Step a Transition enters."@en ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "toStep" ;
        <http://www.w3.org/2004/02/skos/core#scopeNote> "A Transition whose toStep was already reached earlier in the same Behavior's Step graph expresses a loop back-edge; a self-loop (toStep equal to fromStep) is the degenerate case."@en .


###  https://cyberterrain.org/ns/stonework#urlOf
:urlOf rdf:type owl:ObjectProperty ;
       rdfs:domain :URI ;
       <http://www.w3.org/2004/02/skos/core#prefLabel> "urlOf" .


###  https://cyberterrain.org/ns/stonework#uses
:uses rdf:type owl:ObjectProperty ;
      <http://www.w3.org/2004/02/skos/core#definition> "Relates a threat actor group, campaign, malware, or tool to an offensive technique, malware, or tool it is known to employ." ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "uses" ;
      <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain/range intentionally left unset: this property is a direct lift of the STIX 2.1 relationship_type 'uses' shortcut (sub-property stones:uses carries the shortcut triples emitted by the STIX 2.1 transform). STIX does not schema-constrain which SDO/SCO types may appear as source_ref/target_ref for a given relationship_type — that's producer convention, not enforceable structure. In the MITRE ATT&CK bundle alone, observed 'uses' sources include Campaign, IntrusionSet, Malware, and Tool, and observed targets include AttackTechnique, Malware, and Tool — a closed domain/range would misrepresent this real data and mislead reasoner-based consumers. Query-time discrimination (e.g. selecting only IntrusionSet users of a technique) should filter on the asserted stones:stixType literal or a specific rdf:type, not assume it from this property alone."@en .


###  https://cyberterrain.org/ns/stonework#usesRule
:usesRule rdf:type owl:ObjectProperty ;
          rdfs:domain :Sensor ;
          rdfs:range :DetectionRule ;
          <http://www.w3.org/2004/02/skos/core#definition> "Relates a Sensor to the Detection Rules it applies." ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "usesRule" .


###  https://cyberterrain.org/ns/stonework#variantOf
:variantOf rdf:type owl:ObjectProperty ;
           rdfs:domain :MalwareFamily ,
                       :MalwareSample ;
           rdfs:range :File ,
                      :Hash ,
                      :MalwareFamily ,
                      :MalwareSample ;
           <http://www.w3.org/2004/02/skos/core#definition> "Relates a malware sample or family to another sample or family from which it is derived, modified, or evolved — indicating shared code lineage, forked development, or deliberate repackaging."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "variantOf" .


###  https://cyberterrain.org/ns/stonework#vendorOf
:vendorOf rdf:type owl:ObjectProperty ;
          rdfs:domain :Agent ;
          rdfs:range :Product ;
          <http://www.w3.org/2004/02/skos/core#definition> "Relates an Agent to a product family it develops or maintains."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "vendorOf"@en .


###  https://cyberterrain.org/ns/stonework#versionOf
:versionOf rdf:type owl:ObjectProperty ;
           owl:inverseOf :hasVersion ;
           rdfs:domain :VersionedProduct ;
           rdfs:range :Product ;
           <http://www.w3.org/2004/02/skos/core#definition> "Links a specific versioned product instance back to its abstract product family."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "versionOf"@en .


###  https://cyberterrain.org/ns/stonework#weaknessOf
:weaknessOf rdf:type owl:ObjectProperty ;
            owl:inverseOf :hasWeakness ;
            rdfs:domain :Weakness ;
            rdfs:range :Vulnerability ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates a weakness to the vulnerability that exploits or instantiates it."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "weaknessOf"@en ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "The range is a vulnerability individual. The weakness individual (domain) is a stonework:Weakness whose IRI is derived from the CWE identifier. The weakness individual may be populated by a separate CWE ingest."@en .


#################################################################
#    Data properties
#################################################################

###  https://cyberterrain.org/ns/stonework#bomFormat
:bomFormat rdf:type owl:DatatypeProperty ;
           rdfs:range xsd:string ;
           <http://www.w3.org/2004/02/skos/core#definition> "The exchange format and version in which a Bill of Materials was originally serialized (e.g. 'CycloneDX 1.6', 'SPDX 2.3')." ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "BOM format" ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain intentionally left unset. Serves as provenance metadata on stonework:SoftwareBillOfMaterials instances, distinguishing the source format from the STONEWORK representation." .


###  https://cyberterrain.org/ns/stonework#boundToLiteral
:boundToLiteral rdf:type owl:DatatypeProperty ;
                rdfs:domain :Variable ;
                rdfs:range rdfs:Literal ;
                <http://www.w3.org/2004/02/skos/core#definition> "Binds a Variable, at execution time or at plan instantiation, to a scalar result value such as a boolean, count, or numeric score."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "boundToLiteral" ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Tested by stonework:guardLiteralValue and stonework:guardOperator on a Transition. When the guard uses an ordering operator (LessThan, GreaterThanOrEqual, etc.), this value MUST carry a numeric datatype (xsd:decimal, xsd:double, or xsd:integer) — untyped or string literals do not compare numerically under SPARQL."@en .


###  https://cyberterrain.org/ns/stonework#confidence
:confidence rdf:type owl:DatatypeProperty ;
            rdfs:domain :Hypothesis ;
            rdfs:range xsd:integer ;
            <http://www.w3.org/2004/02/skos/core#definition> "A numeric estimate, from 0 to 100, of the degree of belief that a Hypothesis's prediction will be borne out."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "confidence" ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Matches the 0-100 scale of the STIX 2.1 confidence property, for consistency with STIX round-tripping."@en .


###  https://cyberterrain.org/ns/stonework#cvssBaseScore
:cvssBaseScore rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Vulnerability ;
               rdfs:range xsd:decimal ;
               <http://www.w3.org/2004/02/skos/core#definition> "The headline CVSS base score for this vulnerability, on a 0.0–10.0 scale."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "cvssBaseScore"@en ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "When multiple CVSS versions are present, this SHOULD reflect the highest available version (CVSS 4.0 preferred over 3.1, 3.1 over 2.0). For full structured metric data across all CVSS versions use stonework:hasCvssMetric."@en .


###  https://cyberterrain.org/ns/stonework#cvssSeverity
:cvssSeverity rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Vulnerability ;
              rdfs:range xsd:string ;
              <http://www.w3.org/2004/02/skos/core#definition> "The qualitative CVSS severity rating corresponding to the headline base score: NONE, LOW, MEDIUM, HIGH, or CRITICAL."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "cvssSeverity"@en .


###  https://cyberterrain.org/ns/stonework#cvssVector
:cvssVector rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :Vulnerability ;
            rdfs:range xsd:string ;
            <http://www.w3.org/2004/02/skos/core#definition> "The CVSS vector string encoding the metric values used to compute the headline base score, e.g. 'CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:H/I:H/A:H'."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "cvssVector"@en .


###  https://cyberterrain.org/ns/stonework#dateAssigned
:dateAssigned rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Vulnerability ;
              rdfs:range xsd:dateTime ;
              <http://www.w3.org/2004/02/skos/core#definition> "The date and time at which a vulnerability identifier was assigned by the relevant numbering authority."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "dateAssigned"@en ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "Corresponds to cveMetadata.dateReserved in CVE JSON 5.x. cve:dateAssigned is declared owl:equivalentProperty of this property."@en .


###  https://cyberterrain.org/ns/stonework#datePublic
:datePublic rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :Vulnerability ;
            rdfs:range xsd:dateTime ;
            <http://www.w3.org/2004/02/skos/core#definition> "The date and time at which this vulnerability was publicly disclosed."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "datePublic"@en ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Corresponds to cveMetadata.datePublished in CVE JSON 5.x. cve:datePublic is declared owl:equivalentProperty of this property."@en .


###  https://cyberterrain.org/ns/stonework#dateUpdated
:dateUpdated rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Vulnerability ;
             rdfs:range xsd:dateTime ;
             <http://www.w3.org/2004/02/skos/core#definition> "The date and time at which the vulnerability record was last modified in its source database."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "dateUpdated"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Corresponds to cveMetadata.dateUpdated in CVE JSON 5.x. cve:dateUpdated is declared owl:equivalentProperty of this property."@en .


###  https://cyberterrain.org/ns/stonework#endedAtTime
:endedAtTime rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :CyberActivity ;
             rdfs:range xsd:dateTime ;
             rdfs:seeAlso <http://www.w3.org/ns/prov#endedAtTime> ;
             <http://www.w3.org/2004/02/skos/core#definition> "The date and time at which a CyberActivity ended."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "endedAtTime" .


###  https://cyberterrain.org/ns/stonework#guardLiteralValue
:guardLiteralValue rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Transition ;
                   rdfs:range rdfs:Literal ;
                   <http://www.w3.org/2004/02/skos/core#definition> "The literal value that guardVariable's bound value is compared against."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "guardLiteralValue" ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Compared using the operator given by stonework:guardOperator; if guardOperator is omitted, comparison defaults to Equals. Must share a compatible, numerically-typed datatype with the guardVariable's stonework:boundToLiteral value when an ordering operator is used."@en .


###  https://cyberterrain.org/ns/stonework#predictedLiteral
:predictedLiteral rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Hypothesis ;
                  rdfs:range rdfs:Literal ;
                  <http://www.w3.org/2004/02/skos/core#definition> "The scalar value a Hypothesis predicts its stonework:predictsVariable will be bound to, once executed."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "predictedLiteral" ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "Mirrors stonework:boundToLiteral on the actual-result side; see stonework:predictedValue for predictions of an individual rather than a scalar."@en .


###  https://cyberterrain.org/ns/stonework#relatedTechniqueIdentifier
:relatedTechniqueIdentifier rdf:type owl:DatatypeProperty ;
                            rdfs:range xsd:string ;
                            <http://www.w3.org/2004/02/skos/core#definition> "A framework-native technique identifier string (e.g. a MITRE ATT&CK technique ID such as 'T1003.001') carried on an entity from another framework, both for provenance and as the join key used to materialize the corresponding stonework:relatedAttackPattern or stonework:mitigatesAttackPattern edge."@en ;
                            <http://www.w3.org/2004/02/skos/core#prefLabel> "relatedTechniqueIdentifier" ;
                            <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain intentionally left unset: populated on entities as different as capec:AttackPattern and cis:Control. Framework-specific subproperties (e.g. capec:attackTechniqueId, cis:mitigatesTechniqueId) carry the concrete literal. Retained after materialization — it records the source string as ingested, distinct from the resolved object-property edge."@en .


###  https://cyberterrain.org/ns/stonework#serialNumber
:serialNumber rdf:type owl:DatatypeProperty ;
              rdfs:range xsd:string ;
              <http://www.w3.org/2004/02/skos/core#definition> "A globally unique identifier for a BOM document, typically expressed as a URN UUID (e.g. urn:uuid:...) per the CycloneDX specification or as a document namespace per SPDX." ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "serial number" ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain intentionally left unset. Primary subject is stonework:SoftwareBillOfMaterials. Use dcterms:created for the BOM timestamp."@en .


###  https://cyberterrain.org/ns/stonework#startedAtTime
:startedAtTime rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :CyberActivity ;
               rdfs:range xsd:dateTime ;
               rdfs:seeAlso <http://www.w3.org/ns/prov#startedAtTime> ;
               <http://www.w3.org/2004/02/skos/core#definition> "The date and time at which a CyberActivity began."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "startedAtTime" .


###  https://cyberterrain.org/ns/stonework#stepOrder
:stepOrder rdf:type owl:DatatypeProperty ;
           rdfs:domain :Step ;
           rdfs:range xsd:integer ;
           <http://www.w3.org/2004/02/skos/core#definition> "An optional ordinal position for a Step within a strictly linear Behavior, where the full precededByStep graph is unnecessary."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "stepOrder" ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Most CTI procedure write-ups (a numbered list of adversary actions) are linear. stepOrder is a low-overhead alternative to precededByStep for that common case; the two are not mutually exclusive."@en .


###  https://cyberterrain.org/ns/stonework#variableName
:variableName rdf:type owl:DatatypeProperty ;
              rdfs:domain :Variable ;
              rdfs:range xsd:string ;
              <http://www.w3.org/2004/02/skos/core#definition> "A short name identifying a Variable within the scope of its declaring Behavior, allowing it to be referenced consistently across Steps and Transitions."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "variableName" .


###  https://cyberterrain.org/ns/stonework#vulnerabilityId
:vulnerabilityId rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :Vulnerability ;
                 rdfs:range xsd:string ;
                 <http://www.w3.org/2004/02/skos/core#definition> "The canonical identifier assigned to this vulnerability by its originating numbering authority, e.g. 'CVE-2021-44228', 'GHSA-jfh8-c2jp-hdp9', or 'OSV-2021-1'."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "vulnerabilityId"@en ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Source-specific ID properties (e.g. cve:cveId) are declared rdfs:subPropertyOf this property, enabling cross-source queries on a single predicate. Each vulnerability record SHOULD carry exactly one identifier from its primary numbering authority."@en .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/2000/01/rdf-schema#Class
rdfs:Class rdf:type owl:Class .


###  https://cyberterrain.org/ns/stonework#AIAgent
:AIAgent rdf:type owl:Class ;
         rdfs:subClassOf :Agent ;
         <http://www.w3.org/2004/02/skos/core#definition> "An autonomous or semi-autonomous system driven by AI/ML that can act, make decisions, or be attributed responsibility in a cyber or sociotechnical context." ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "AI Agent" ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers both offensive uses (AI-assisted or autonomous threat actors) and defensive uses (AI-driven detection, response, or hunting systems). Distinct from Tool — an AIAgent has a degree of autonomous decision-making rather than being a passively invoked artifact."@en .


###  https://cyberterrain.org/ns/stonework#AITechnique
:AITechnique rdf:type owl:Class ;
             rdfs:subClassOf :Technique ;
             <http://www.w3.org/2004/02/skos/core#definition> "A specific method by which adversaries attack AI/ML systems (e.g., training data poisoning, adversarial examples, model extraction)."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "AI Technique"@en .


###  https://cyberterrain.org/ns/stonework#AccessControlList
:AccessControlList rdf:type owl:Class ;
                   rdfs:subClassOf :DigitalArtifact ;
                   <http://www.w3.org/2004/02/skos/core#definition> "A structured list of access control entries (ACEs) that governs which principals (users, groups, or system accounts) are permitted or denied specific operations on a resource."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Access Control List"@en ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Applies across filesystems, operating system objects (registry keys, processes), network devices (firewall rules), cloud IAM policies, and APIs. In a CTI context, adversaries frequently modify ACLs to establish persistence, escalate privileges, or deny defenders access to compromised resources. Framework-specific extensions (e.g. Windows DACL/SACL structure) are modeled at the framework layer."@en .


###  https://cyberterrain.org/ns/stonework#Agent
:Agent rdf:type owl:Class ;
       rdfs:subClassOf :CyberEntity ;
       <http://www.w3.org/2004/02/skos/core#definition> "Any entity that can act, perform actions, or be attributed responsibility in a cyber or sociotechnical context."@en ;
       <http://www.w3.org/2004/02/skos/core#prefLabel> "Agent" ;
       <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers AI, human individuals, groups, organizations, and other actors (e.g. threat actors, vendors, government bodies). Used as the top-level superclass for identity-related objects in alignment with STIX Identity."@en .


###  https://cyberterrain.org/ns/stonework#Analysis
:Analysis rdf:type owl:Class ;
          rdfs:subClassOf :IntelligenceProduct ;
          <http://www.w3.org/2004/02/skos/core#definition> "A systematic examination of a cyber entity, artifact, or event that produces structured findings about its nature, behavior, or properties."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Analysis"@en ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "Sibling to stonework:Assessment under IntelligenceProduct. Where Assessment answers 'how bad/likely/risky?', Analysis answers 'what is it and what does it do?' Superclass for domain-specific analyses such as MalwareAnalysis. Aligns with STIX MalwareAnalysis SDO at the subclass level."@en .


###  https://cyberterrain.org/ns/stonework#AnalyticTechnique
:AnalyticTechnique rdf:type owl:Class ;
                   rdfs:subClassOf :Technique ;
                   <http://www.w3.org/2004/02/skos/core#definition> "A prescribed analytical method used to process, evaluate, or reason over data to produce intelligence, detections, or assessments."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Analytic Technique" ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers structured analytic techniques (e.g., analysis of competing hypotheses, kill chain analysis, diamond model analysis) and computational analytic methods (e.g., clustering, anomaly detection). Distinct from DetectionRule — an AnalyticTechnique describes the method; a DetectionRule is a deployable artifact implementing it."@en .


###  https://cyberterrain.org/ns/stonework#Assessment
:Assessment rdf:type owl:Class ;
            rdfs:subClassOf :IntelligenceProduct ;
            <http://www.w3.org/2004/02/skos/core#definition> "A structured knowledge artifact capturing the evaluation, analysis, or estimation of risk, likelihood, impact, or other security-relevant attributes."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Assessment" ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers risk assessments, vulnerability assessments, and impact analyses. Assessment is an Information artifact — the output of an evaluative process — not the process itself. The process producing an Assessment may be modeled as a stonework:Process or stonework:Investigation."@en .


###  https://cyberterrain.org/ns/stonework#AttackPattern
:AttackPattern rdf:type owl:Class ;
               rdfs:subClassOf :Behavior ;
               <http://www.w3.org/2004/02/skos/core#definition> "A type of Tactics, Techniques, and Procedures (TTP) that describes ways that adversaries attempt to compromise targets. Often maps to MITRE ATT&CK techniques."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Attack Pattern"@en ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "The abstract concept spanning framework-specific shapes that are not structurally identical: CAPEC's shape (capec:AttackPattern) is a taxonomy entry with severity/likelihood/prerequisite fields; MITRE ATT&CK's shape (stonework:AttackTechnique) is an operationalized technique with sub-techniques, procedures, mitigations, and detections. Both are AttackPatterns; stonework:relatedAttackPattern links instances across shapes that describe the same underlying technique."@en .


###  https://cyberterrain.org/ns/stonework#AttackTechnique
:AttackTechnique rdf:type owl:Class ;
                 rdfs:subClassOf :AttackPattern ,
                                 :CyberTechnique ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A prescribed offensive method used by an adversary to achieve a specific tactical objective within a target environment."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Attack Technique"@en ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Aligns with MITRE ATT&CK techniques and D3FEND OffensiveTechnique. The MITRE ATT&CK-shaped realization of stonework:AttackPattern — operationalized for execution, as distinct from CAPEC's more abstract taxonomy-entry shape (capec:AttackPattern, also a stonework:AttackPattern). Framework-specific subclasses (e.g. attack:Technique) provide the concrete individuals. A specific, concrete realization of this technique is modeled as a stonework:Procedure, linked back via stonework:implementedBy."@en .


###  https://cyberterrain.org/ns/stonework#AutonomousSystem
:AutonomousSystem rdf:type owl:Class ;
                  rdfs:subClassOf :Infrastructure ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Represents an Autonomous System (AS), a collection of IP routing prefixes under the control of a single administrative entity, identified by its AS number." ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Autonomous System"@en .


###  https://cyberterrain.org/ns/stonework#Behavior
:Behavior rdf:type owl:Class ;
          rdfs:subClassOf :CyberEntity ;
          <http://www.w3.org/2004/02/skos/core#definition> "A pattern of actions or methods characteristic of an entity, particularly adversaries."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Behavior" ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "Groups TTP-related classes: Tactic, Technique (and subclasses), and Procedure. In BFO terms, Behaviors are GenericallyDependentContinuants — specifications or patterns describing how actions are carried out. The execution of a Technique is a CyberActivity; the Technique itself is a Behavior. Aligns with IAO PlanSpecification."@en .


###  https://cyberterrain.org/ns/stonework#BomEntry
:BomEntry rdf:type owl:Class ;
          rdfs:subClassOf :ComponentContext ;
          rdfs:comment "BomEntry is the STONEWORK representation of a CycloneDX component element or SPDX package entry. It links a VersionedProduct into the context of a particular SBOM document via stonework:installationOf, and may carry component-specific metadata (PURL, license, hash, component type) that does not belong on the VersionedProduct itself."@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "A single component entry within a Software Bill of Materials, asserting that a specific VersionedProduct is included in the artifact or system described by the SBOM."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "BOM Entry" ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "An SBOM import creates one BomEntry per declared component. The BomEntry IRI is scoped to the SBOM (e.g. <sbom-iri/entry/<component-ref>>). Multiple BomEntry instances across different SBOMs may reference the same VersionedProduct via stonework:installationOf."@en .


###  https://cyberterrain.org/ns/stonework#Campaign
:Campaign rdf:type owl:Class ;
          rdfs:subClassOf :CyberActivity ;
          <http://www.w3.org/2004/02/skos/core#definition> "A grouping of adversary behaviours and resources with a common objective pursued over a period of time. Campaigns may be attributed to ThreatActors and may evolve from a CyberActivityCluster as attribution and objectives become established." ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Campaign"@en .


###  https://cyberterrain.org/ns/stonework#Category
:Category rdf:type owl:Class ;
          rdfs:subClassOf :CyberEntity ;
          <http://www.w3.org/2004/02/skos/core#definition> "A classification or tagging concept used to group or qualify other individuals in a particular context." ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Category" ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "Categories are reified so they can be referenced, versioned, or scoped. They are not rigid types." .


###  https://cyberterrain.org/ns/stonework#Certificate
:Certificate rdf:type owl:Class ;
             rdfs:subClassOf :DigitalArtifact ;
             <http://www.w3.org/2004/02/skos/core#definition> "A structured digital document binding a public key to an identity, issued and signed by a certificate authority. Used for authentication, encryption, and trust establishment in networked systems."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Certificate"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Primarily represents X.509 certificates. May be used to cluster infrastructure sharing the same certificate or to link observed TLS/SSL artifacts to their issuing authority. Referenced by stonework:sharesCertificate on Infrastructure."@en .


###  https://cyberterrain.org/ns/stonework#City
:City rdf:type owl:Class ;
      rdfs:subClassOf :Location ;
      <http://www.w3.org/2004/02/skos/core#definition> "A significant urban settlement, municipality, or metropolitan area." ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "City" .


###  https://cyberterrain.org/ns/stonework#ComparisonOperator
:ComparisonOperator rdf:type owl:Class ;
                    <http://www.w3.org/2004/02/skos/core#definition> "A controlled vocabulary of operators used to compare a Variable's bound value against a threshold in a Transition guard."@en ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Comparison Operator" ;
                    <http://www.w3.org/2004/02/skos/core#scopeNote> "Individuals are stonework:Equals, stonework:NotEquals, stonework:LessThan, stonework:LessThanOrEqual, stonework:GreaterThan, and stonework:GreaterThanOrEqual. Referenced by stonework:guardOperator; omitting an operator on a guard defaults to Equals semantics."@en .


###  https://cyberterrain.org/ns/stonework#ComponentContext
:ComponentContext rdf:type owl:Class ;
                  <http://www.w3.org/2004/02/skos/core#definition> "An abstract class representing a context-specific reference to a VersionedProduct: the same product version appears differently depending on whether it is declared in a bill of materials or observed as a running installation on a specific system."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Component Context" ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "Subclassed by stonework:BomEntry (declarative — listed in an SBOM document) and stonework:ProductInstallation (observational — verified deployment via SWID tag or scan). Unifies these two evidence bases under a single superclass so that stonework:installationOf can span both without domain restrictions forcing incorrect inferences."@en .


###  https://cyberterrain.org/ns/stonework#Control
:Control rdf:type owl:Class ;
         rdfs:subClassOf :Countermeasure ;
         rdfs:comment "Instances of stonework:Control may represent individual controls, control enhancements, or sub‑controls. Framework‑specific identifiers (e.g., \"AC‑2\", \"CIS 4.1\") SHOULD be modeled using explicit properties rather than encoded in the class IRI. Control text SHOULD be referenced via citations rather than reproduced verbatim." ;
         <http://www.w3.org/2004/02/skos/core#definition> "A prescribed security or privacy safeguard that specifies an action, capability, or condition intended to reduce risk, enforce policy, or achieve a defined protection objective within an information system or organization." ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Control" ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "This class provides a semantic representation of security and privacy controls from frameworks such as NIST SP 800‑53 and the CIS Controls. It supports mapping to external control identifiers and families without embedding copyrighted control text." .


###  https://cyberterrain.org/ns/stonework#ControlPlan
:ControlPlan rdf:type owl:Class ;
             rdfs:subClassOf :Behavior ;
             <http://www.w3.org/2004/02/skos/core#definition> "A concrete, Step-decomposed sequence of actions that implements a Control in a specific operational context."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Control Plan" ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Mirrors the Technique/Procedure split on the defensive side: stonework:Control is the abstract prescribed safeguard (a catalog entry, e.g. NIST AC-2 or a CIS control); ControlPlan is its concrete implementation as a Step sequence, linked back via stonework:implements. A ControlPlan is typically invoked from within a Playbook or DetectionPlan by a Step that stonework:implements it."@en .


###  https://cyberterrain.org/ns/stonework#Countermeasure
:Countermeasure rdf:type owl:Class ;
                rdfs:subClassOf :CyberEntity ;
                <http://www.w3.org/2004/02/skos/core#definition> "Any control, mitigation, or safeguard applied to protect against, reduce, or respond to security risks."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Countermeasure" ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Includes Controls, Mitigations, CoursesOfAction, and DetectionRules. The two primary branches are preventive/reactive measures (Mitigation, CourseOfAction, Control) and detection logic (DetectionRule, Signature)."@en .


###  https://cyberterrain.org/ns/stonework#Country
:Country rdf:type owl:Class ;
         rdfs:subClassOf :Location ;
         <http://www.w3.org/2004/02/skos/core#definition> "A sovereign state or top-level administrative entity recognized internationally." ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Country" .


###  https://cyberterrain.org/ns/stonework#CourseOfAction
:CourseOfAction rdf:type owl:Class ;
                rdfs:subClassOf :Mitigation ;
                <http://www.w3.org/2004/02/skos/core#definition> "A specific, contextualized recommended action or set of steps to prevent or respond to a threat, attack, or incident."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Course of Action"@en ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "More prescriptive and situational than a general Mitigation — a CourseOfAction packages guidance for a specific threat context. Corresponds to the STIX 2.1 CourseOfAction SDO. General reusable controls (e.g. ATT&CK mitigations) are modeled as Mitigation; specific incident response actions are CourseOfAction."@en .


###  https://cyberterrain.org/ns/stonework#CryptoAsset
:CryptoAsset rdf:type owl:Class ;
             rdfs:subClassOf :DigitalArtifact ;
             <http://www.w3.org/2004/02/skos/core#definition> "A digital asset or wallet address used in cryptocurrency transactions, often relevant for tracking ransomware payments or illicit finance."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Crypto Asset"@en .


###  https://cyberterrain.org/ns/stonework#CyberActivity
:CyberActivity rdf:type owl:Class ;
               <http://www.w3.org/2004/02/skos/core#definition> "A specific occurrence or performance of actions by one or more agents over time within a cyber or sociotechnical context."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Cyber Activity" ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "One of two root classes in STONEWORK alongside CyberEntity. Superclass for Campaigns, Incidents, Operations, Events, and Processes. Aligns with BFO Occurrent and BFO Process."@en .


###  https://cyberterrain.org/ns/stonework#CyberActivityCluster
:CyberActivityCluster rdf:type owl:Class ;
                      rdfs:subClassOf :CyberActivity ;
                      <http://www.w3.org/2004/02/skos/core#definition> "An analytically-defined grouping of correlated adversarial behaviors, tools, malware, infrastructure, and participants believed to share a common source or campaign thread."@en ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Cyber Activity Cluster"@en ;
                      <http://www.w3.org/2004/02/skos/core#scopeNote> "Represents the intelligence analyst's working construct before enough is known to declare a Campaign: a cluster of correlated observations attributed (loosely or firmly) to a common adversary source. May evolve into a stonework:Campaign when an objective, timeline, and attribution are sufficiently established. Corresponds to the intended meaning of STIX intrusion-set — the correlated set of activity, not the actor responsible for it. Distinct from stonework:ThreatActorGroup, which is the adversary entity; a CyberActivityCluster is the attributed set of activity linked to that entity."@en .


###  https://cyberterrain.org/ns/stonework#CyberEntity
:CyberEntity rdf:type owl:Class ;
             <http://www.w3.org/2004/02/skos/core#definition> "Any concept, object, or resource that exists or operates within a cyber or sociotechnical domain."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Cyber Entity" ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "One of two root classes in STONEWORK. Groups all persistent entities — Agents, Infrastructure, DigitalArtifacts, Behaviors, IntelligenceProducts, SecurityConditions, RiskFactors, Countermeasures, and related classes. Aligns with BFO Continuant. The sibling root class CyberActivity covers happenings (Campaigns, Incidents, Operations, etc.)."@en .


###  https://cyberterrain.org/ns/stonework#CyberTechnique
:CyberTechnique rdf:type owl:Class ;
                rdfs:subClassOf :Technique ;
                <http://www.w3.org/2004/02/skos/core#definition> "A technique performed within or against cyberspace, encompassing both offensive and defensive cyber operations." ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Cyber Technique" ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Mirrors D3FEND's CyberTechnique class. Subclassed by stonework:AttackTechnique (offensive) and stonework:DefendTechnique (defensive), enabling a single property chain to span both ATT&CK and D3FEND individuals." .


###  https://cyberterrain.org/ns/stonework#DataAsset
:DataAsset rdf:type owl:Class ;
           rdfs:subClassOf :CyberEntity ;
           <http://www.w3.org/2004/02/skos/core#definition> "A defender-owned collection of data or information with organizational value, such as databases, intellectual property, credentials stores, or PII collections."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Asset" ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Represents data as a targetable resource distinct from the systems that store or process it. Used to model what adversaries seek to access, exfiltrate, or destroy rather than the infrastructure they exploit to reach it."@en .


###  https://cyberterrain.org/ns/stonework#DefendTechnique
:DefendTechnique rdf:type owl:Class ;
                 rdfs:subClassOf :CyberTechnique ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A prescribed defensive method used to detect, prevent, or respond to adversary behavior within a target environment." ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Defend Technique" ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Aligns with MITRE D3FEND DefensiveTechnique. Framework-specific subclasses (e.g. d3fend:DefensiveTechnique) extend this class when D3FEND data is loaded." .


###  https://cyberterrain.org/ns/stonework#DefensiveTactic
:DefensiveTactic rdf:type owl:Class ;
                 rdfs:subClassOf :Tactic ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A high-level defensive objective that groups related countermeasure techniques by the protection goal they serve." ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Defensive Tactic" ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Aligns with MITRE D3FEND defensive tactics (e.g. Harden, Detect, Isolate, Evict, Restore). Individuals are typically drawn from D3FEND or similar defensive frameworks via the framework mapping layer."@en .


###  https://cyberterrain.org/ns/stonework#DetectionPlan
:DetectionPlan rdf:type owl:Class ;
               rdfs:subClassOf :InvestigationPlan ;
               <http://www.w3.org/2004/02/skos/core#definition> "A Step-decomposed sequence of actions for determining whether observed activity constitutes a security-relevant violation, as distinct from the offensive or defensive action plans that respond to one."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Detection Plan" ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "A specialization of stonework:InvestigationPlan narrowly scoped to violation triage: orchestrating DetectionRule/Signature evaluation and analytic logic to identify whether a violation occurred, typically triggering a defensive Playbook or ControlPlan via a guarded Transition once one is confirmed. Where a Playbook is an action plan carried out by an interested party — offensive (an adversary's operational playbook) or defensive (an incident responder's playbook) — a DetectionPlan plays a neutral, evaluative role, watching for the kind of changes an InvestigationPlan more broadly investigates."@en .


###  https://cyberterrain.org/ns/stonework#DetectionRule
:DetectionRule rdf:type owl:Class ;
               rdfs:subClassOf :Countermeasure ;
               <http://www.w3.org/2004/02/skos/core#definition> "A structured, machine-readable rule designed to detect malicious or suspicious activity, techniques, or indicators. It may be signature-based, behavioral, correlation-based, or analytic."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Detection Rule" ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "Encompasses pattern-matching signatures (YARA, Snort, Suricata), behavioral rules (Sigma), SIEM correlation logic, and analytic detections. Signature is a subclass for content-centric, indicator-matching rules."@en .


###  https://cyberterrain.org/ns/stonework#DigitalArtifact
:DigitalArtifact rdf:type owl:Class ;
                 rdfs:subClassOf :CyberEntity ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Any discrete digital object or content entity that can be observed, transmitted, stored, or acted upon in a cyber environment."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Digital Artifact" ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Includes files, hashes, malware samples, network traffic captures, and other content-bearing items. Aligns with D3FEND DigitalArtifact concepts."@en .


###  https://cyberterrain.org/ns/stonework#DigitalIdentity
:DigitalIdentity rdf:type owl:Class ;
                 rdfs:subClassOf :Agent ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A digital representation or persona of an Agent, inferred from one or more identifiers (email, phone, account, etc.). It may or may not be attributed to a known real-world Agent." ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Digital Identity" ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Useful when you observe identifiers without confirmed attribution. Can aggregate multiple Identifiers and later be linked to a real-worldAgent."@en .


###  https://cyberterrain.org/ns/stonework#Directory
:Directory rdf:type owl:Class ;
           rdfs:subClassOf :DigitalArtifact ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Directory" .


###  https://cyberterrain.org/ns/stonework#Domain
:Domain rdf:type owl:Class ;
        rdfs:subClassOf :Infrastructure ;
        <http://www.w3.org/2004/02/skos/core#definition> "Represents a network domain name. Can reference the IP addresses it resolves to." ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Domain"@en .


###  https://cyberterrain.org/ns/stonework#EmailAddress
:EmailAddress rdf:type owl:Class ;
              rdfs:subClassOf :Identifier ;
              <http://www.w3.org/2004/02/skos/core#definition> "Represents a single email address, optionally associating it with a display name and a user account." ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Email Address"@en .


###  https://cyberterrain.org/ns/stonework#EmailMessage
:EmailMessage rdf:type owl:Class ;
              rdfs:subClassOf :DigitalArtifact ;
              <http://www.w3.org/2004/02/skos/core#definition> "A discrete email communication, including headers, body content, and optional attachments, transmitted over an email protocol."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Email Message"@en ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "Distinct from stonework:EmailAddress, which represents the sender/recipient identifier. An EmailMessage is the content artifact itself. Used to represent phishing lures, spear-phishing emails, or other email-borne threat delivery mechanisms. Corresponds to STIX EmailMessage SCO."@en .


###  https://cyberterrain.org/ns/stonework#Event
:Event rdf:type owl:Class ;
       rdfs:subClassOf :CyberActivity ;
       <http://www.w3.org/2004/02/skos/core#definition> "An atomic, observable occurrence in a system, network, or environment that has potential security relevance but has not yet been assessed or declared as an Incident."@en ;
       <http://www.w3.org/2004/02/skos/core#prefLabel> "Event"@en ;
       <http://www.w3.org/2004/02/skos/core#scopeNote> "Represents the pre-triage state — a raw log entry, alert, or sensor observation. Distinguished from Incident by the absence of human or automated assessment declaring it significant and adverse. Useful for SIEM, log-based, and threat hunting use cases."@en .


###  https://cyberterrain.org/ns/stonework#Feed
:Feed rdf:type owl:Class ;
      rdfs:subClassOf :Provenance ;
      <http://www.w3.org/2004/02/skos/core#definition> "A structured data source that provides indicators, intelligence, or enrichment data on a regular or continuous basis." ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "Feed" ;
      <http://www.w3.org/2004/02/skos/core#scopeNote> "Examples: URLHaus, AlienVault OTX, Abuse.ch, commercial threat feeds, etc."@en .


###  https://cyberterrain.org/ns/stonework#File
:File rdf:type owl:Class ;
      rdfs:subClassOf :DigitalArtifact ;
      <http://www.w3.org/2004/02/skos/core#definition> "A discrete unit of data stored on a filesystem, identified by name, path, and cryptographic hash. Includes executable binaries, scripts, documents, archives, and other file types relevant to cyber threat analysis."@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "File"@en ;
      <http://www.w3.org/2004/02/skos/core#scopeNote> "Linked to hash values via stonework:hasHash. A MalwareSample may be associated with its File representation. Framework-specific extensions (PE headers, NTFS streams, archive contents) are modeled at the framework layer."@en .


###  https://cyberterrain.org/ns/stonework#Group
:Group rdf:type owl:Class ;
       rdfs:subClassOf :Agent ;
       <http://www.w3.org/2004/02/skos/core#definition> "Any collection of Persons, Organizations, or other Groups that share a common purpose or identity but do not necessarily have formal legal structure."@en ;
       <http://www.w3.org/2004/02/skos/core#prefLabel> "Group" ;
       <http://www.w3.org/2004/02/skos/core#scopeNote> "Used for informal collectives, communities, ad-hoc teams, criminal syndicates, or loose alliances. More general than Organization. Can contain other Groups or Organizations."@en .


###  https://cyberterrain.org/ns/stonework#Hash
:Hash rdf:type owl:Class ;
      rdfs:subClassOf :Identifier ;
      <http://www.w3.org/2004/02/skos/core#definition> "A single cryptographic hash entry associating a hashing algorithm with its hex-encoded digest value. Used to represent entries in the STIX hashes dictionary." ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "Hash"@en .


###  https://cyberterrain.org/ns/stonework#Host
:Host rdf:type owl:Class ;
      rdfs:subClassOf :Infrastructure ;
      <http://www.w3.org/2004/02/skos/core#definition> "A computing system, device, or endpoint (physical, virtual, container, or cloud instance) that can run processes, host files, and participate in networks."@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "Host"@en .


###  https://cyberterrain.org/ns/stonework#HumanSource
:HumanSource rdf:type owl:Class ;
             rdfs:subClassOf :Provenance ;
             <http://www.w3.org/2004/02/skos/core#definition> "A person who provides information, intelligence, or a report (as opposed to automated feeds or technical artifacts)." ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Human Source" ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Often used in HUMINT or OSINT contexts. Reliability scoring is commonly applied to human sources."@en .


###  https://cyberterrain.org/ns/stonework#Hypothesis
:Hypothesis rdf:type owl:Class ;
            rdfs:subClassOf :IntelligenceProduct ;
            <http://www.w3.org/2004/02/skos/core#definition> "A structured, falsifiable prediction about the value a Variable will resolve to once the Behavior or Step declaring that Variable executes."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Hypothesis" ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Formalizes the anticipated side of the Variable lifecycle described in stonework:Variable's scopeNote: a Hypothesis names, in advance, the value an output Variable is predicted to be bound to. Linked to the Variable it predicts via stonework:predictsVariable, and to the prediction itself via stonework:predictedType (a class, the common case — mirrors stonework:guardType), stonework:predictedValue (a specific individual), or stonework:predictedLiteral (a scalar) — mirroring stonework:boundTo/stonework:boundToLiteral on the actual-result side. A Transition's guard properties, which test a Variable's actual bound value, implicitly test agreement with whichever Hypothesis predicted that Variable — confirming it if they match, refuting it otherwise. May attach at any level of a Step/Plan decomposition, since stonework:Step is itself a stonework:Behavior."@en .


###  https://cyberterrain.org/ns/stonework#IPAddress
:IPAddress rdf:type owl:Class ;
           rdfs:subClassOf :Infrastructure ;
           <http://www.w3.org/2004/02/skos/core#definition> "Represents a single IP address (IPv4 or IPv6)."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "IP Address"@en .


###  https://cyberterrain.org/ns/stonework#IPBlock
:IPBlock rdf:type owl:Class ;
         rdfs:subClassOf :Infrastructure ;
         <http://www.w3.org/2004/02/skos/core#definition> "A Classless Inter-Domain Routing (CIDR) block used to represent an IP network range."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "IP Block"@en .


###  https://cyberterrain.org/ns/stonework#Identifier
:Identifier rdf:type owl:Class ;
            rdfs:subClassOf :CyberEntity ;
            <http://www.w3.org/2004/02/skos/core#definition> "An atomic label, string, or token used to uniquely identify, locate, or reference a cyber entity, resource, or principal."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Identifier" ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Includes contact identifiers, network locators, accounts, and similar atomic artifacts."@en .


###  https://cyberterrain.org/ns/stonework#Impact
:Impact rdf:type owl:Class ;
        rdfs:subClassOf :RiskFactor ;
        rdfs:comment "Instances of stonework:Impact SHOULD specify the affected asset or mission, the type of consequence, and the severity level. Impact SHOULD be represented using explicit properties rather than encoded in class IRIs or labels." ;
        <http://www.w3.org/2004/02/skos/core#definition> "The magnitude of harm, loss, or adverse effects that would result if a threat were realized and a compromise occurred, expressed in terms of mission, business, operational, or technical consequences." ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Impact" ;
        <http://www.w3.org/2004/02/skos/core#scopeNote> "Impact represents the severity of consequences associated with a compromise. It may include effects on confidentiality, integrity, availability, safety, mission success, financial loss, or reputational damage. Impact values may be qualitative or quantitative." .


###  https://cyberterrain.org/ns/stonework#Incident
:Incident rdf:type owl:Class ;
          rdfs:subClassOf :CyberActivity ;
          <http://www.w3.org/2004/02/skos/core#definition> "A significant adverse event or series of related events that has caused, or has the potential to cause, harm to an organization’s operations, assets, or people."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Incident" ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "Distinguished from stonework:Event (a raw, unassessed occurrence) by the presence of human or automated triage declaring significance and adversity. An Incident may aggregate multiple Events, involve one or more Campaigns, and trigger Investigation and Playbook execution."@en .


###  https://cyberterrain.org/ns/stonework#Indicator
:Indicator rdf:type owl:Class ;
           rdfs:subClassOf :IntelligenceProduct ;
           <http://www.w3.org/2004/02/skos/core#definition> "An intelligence assertion that a pattern — atomic, expression-based, or behavioral — when matched in an observed environment, indicates the presence of threat activity attributable to a specific adversary behavior, malware, or campaign."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Indicator"@en ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "The central concept in operational CTI. The term is used by the community in three overlapping senses, all of which stonework:Indicator covers: (1) IOC sense — an atomic observable (IP address, domain, file hash, URL) that has been assessed as malicious or suspicious and tagged for detection; in STONEWORK the underlying observable is the SCO (stonework:IPAddress, stonework:Domain, stonework:Hash), and the Indicator wraps it with the assertion, confidence, and validity window. (2) Pattern sense — a STIX patterning expression over one or more SCOs (e.g., [ipv4-addr:value = ‘198.51.100.0/24’]). (3) Behavioral sense — a multi-step or TTPs-based pattern asserting that an observed sequence of behaviors indicates a technique or campaign. Distinct from stonework:DetectionRule: an Indicator is the intelligence claim (‘look for this’); a DetectionRule is the operational artifact that implements the check (‘here is the Sigma/Snort/YARA rule that looks for it’). Indicators are produced by threat intelligence analysts and consumed by detection pipelines; DetectionRules are deployed in SIEMs, EDRs, and network sensors. Corresponds to STIX 2.1 Indicator SDO. Use stonework:indicates to link an Indicator to the AttackPattern, Malware, Campaign, or ThreatActor it asserts."@en .


###  https://cyberterrain.org/ns/stonework#Infrastructure
:Infrastructure rdf:type owl:Class ;
                rdfs:subClassOf :CyberEntity ;
                <http://www.w3.org/2004/02/skos/core#definition> "Represents systems, software services, or any group of resources used to conduct cyber operations. Infrastructure is used by threat actors and intrusion sets both offensively and defensively." ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Infrastructure"@en .


###  https://cyberterrain.org/ns/stonework#IntelligenceProduct
:IntelligenceProduct rdf:type owl:Class ;
                     rdfs:subClassOf :CyberEntity ;
                     <http://www.w3.org/2004/02/skos/core#definition> "A structured artifact produced by an intelligence or analytical process, intended to convey findings, assessments, observations, or sourcing context to support decision-making."@en ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Intelligence Product"@en ;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "The intelligence product hierarchy covers the outputs of the intelligence lifecycle: Reports, Assessments, Sightings, Notes, and Provenance records. Distinguished from stonework:DigitalArtifact (raw observable technical data) and stonework:Behavior (plan specifications and TTP patterns). Intelligence products are the result of human or automated analytical work applied to raw data — they carry judgment, context, and traceability that raw artifacts do not."@en .


###  https://cyberterrain.org/ns/stonework#Investigation
:Investigation rdf:type owl:Class ;
               rdfs:subClassOf :Process ;
               <http://www.w3.org/2004/02/skos/core#definition> "A systematic Process of inquiry, evidence collection, analysis, hypothesis testing, and conclusion to understand, attribute, or resolve security incidents, threats, anomalies, or other matters of interest." ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Investigation" ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "Includes digital forensics, threat hunting, root cause analysis, and incident investigations. Links to Sightings, Evidence (via categorizedBy), Sensors, and produces Findings or updated Assessments."@en .


###  https://cyberterrain.org/ns/stonework#InvestigationPlan
:InvestigationPlan rdf:type owl:Class ;
                   rdfs:subClassOf :Behavior ;
                   rdfs:comment "An InvestigationPlan is a plan specification; executing one produces an instance of stonework:Investigation."@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "A Step-decomposed sequence of actions for systematically examining a cyber entity, artifact, or event to determine its nature, extent, or significance."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Investigation Plan" ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "The general assessment-plan counterpart to stonework:Playbook on the production side: where a Playbook's execution changes state in the world, an InvestigationPlan's execution (a stonework:Investigation) produces judgment about something that already exists or happened — typically a stonework:Analysis or stonework:Assessment. stonework:DetectionPlan is a specialized subclass, narrowly scoped to determining whether observed activity constitutes a security-relevant violation; broader analytical work (forensic analysis, malware analysis, vulnerability assessment) is modeled directly as InvestigationPlan."@en .


###  https://cyberterrain.org/ns/stonework#Likelihood
:Likelihood rdf:type owl:Class ;
            rdfs:subClassOf :RiskFactor ;
            rdfs:comment "Instances of stonework:Likelihood may incorporate assumptions, uncertainty, adversary behavior, historical frequency, or environmental conditions. Likelihood SHOULD be represented using explicit properties rather than encoded in class IRIs or labels." ;
            <http://www.w3.org/2004/02/skos/core#definition> "The estimated probability, plausibility, or frequency with which a threat could be realized and lead to a compromise under specified conditions." ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Likelihood" ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Likelihood reflects the chance that a compromise will occur, considering adversary capability, intent, opportunity, preconditions, and environmental factors. Likelihood values may be qualitative, ordinal, or quantitative." .


###  https://cyberterrain.org/ns/stonework#Location
:Location rdf:type owl:Class ;
          rdfs:subClassOf :CyberEntity ;
          <http://www.w3.org/2004/02/skos/core#definition> "Represents a geographic location. May be as specific as a latitude/longitude coordinate or as broad as a continent. At least one of region, country, or latitude/longitude must be provided." ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Location"@en .


###  https://cyberterrain.org/ns/stonework#Log
:Log rdf:type owl:Class ;
     rdfs:subClassOf :DigitalArtifact ;
     <http://www.w3.org/2004/02/skos/core#definition> "A structured or semi-structured record of events, actions, or state changes generated by a system, application, or network component over time."@en ;
     <http://www.w3.org/2004/02/skos/core#prefLabel> "Log"@en ;
     <http://www.w3.org/2004/02/skos/core#scopeNote> "Logs are primary data sources for detection, investigation, and threat hunting. Examples include system event logs, authentication logs, DNS query logs, firewall logs, and application logs. Distinct from NetworkTraffic (which captures raw packet data) and from Event (which represents a parsed, security-relevant occurrence derived from log data)."@en .


###  https://cyberterrain.org/ns/stonework#Malware
:Malware rdf:type owl:Class ;
         rdfs:subClassOf :CyberEntity ;
         <http://www.w3.org/2004/02/skos/core#definition> "A software object intended to perform malicious functions within, or on behalf of, a threat actor. Encompasses both abstract family-level concepts and concrete specimen-level artifacts."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Malware"@en ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "Parent class for stonework:MalwareFamily (STIX is_family=true) and stonework:MalwareSample (STIX is_family=false). Corresponds to the STIX 2.1 malware SDO. Use stonework:categorizedBy to assert behavioral type (e.g., stonework:Ransomware). Use stonework:hasArtifact to link a sample to its captured binary."@en .


###  https://cyberterrain.org/ns/stonework#MalwareAnalysis
:MalwareAnalysis rdf:type owl:Class ;
                 rdfs:subClassOf :Analysis ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A structured record of findings from static or dynamic analysis performed on a malware specimen or family, including the tool used, analysis configuration, and verdict."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Malware Analysis"@en ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Captures the output of a single analysis run: antivirus scan, sandbox execution, reverse-engineering session, etc. Key properties include the analysis product and version, the result verdict (malicious/suspicious/benign/unknown), and references to SCOs observed during analysis. Corresponds to STIX 2.1 MalwareAnalysis SDO."@en .


###  https://cyberterrain.org/ns/stonework#MalwareFamily
:MalwareFamily rdf:type owl:Class ;
               rdfs:subClassOf :Malware ;
               <http://www.w3.org/2004/02/skos/core#definition> "An abstract malware concept representing a named strain, lineage, or campaign of malicious software sharing common behavioral patterns, code ancestry, or infrastructure. Corresponds to STIX 2.1 malware SDO with is_family=true."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Malware Family"@en ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "Examples: Cobalt Strike, Mimikatz, WannaCry, BlackCat. A MalwareFamily does not have a specific hash or binary but may be linked to MalwareSample instances via the inverse of stonework:memberOfFamily. Use stonework:categorizedBy to assert behavioral type (e.g., stonework:Ransomware, stonework:Backdoor)."@en .


###  https://cyberterrain.org/ns/stonework#MalwareSample
:MalwareSample rdf:type owl:Class ;
               rdfs:subClassOf :Malware ,
                               :Product ;
               <http://www.w3.org/2004/02/skos/core#definition> "A discrete, observable instance of malicious code — a specific binary, script, or executable artifact that can be identified by cryptographic hash, file characteristics, or behavioral signature."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Malware Sample"@en ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "Represents a concrete sample rather than an abstract family concept. A single MalwareFamily may have thousands of associated samples across versions, packers, and dropper variants. Samples are linked to their family via stonework:memberOfFamily and to their file representation via stonework:hasHash or a direct stonework:File association. Properties such as stonework:drops, stonework:downloads, and stonework:communicatesWith describe the behavior of this specific sample, not the family in general."@en .


###  https://cyberterrain.org/ns/stonework#MalwareType
:MalwareType rdf:type owl:Class ;
             rdfs:subClassOf :Category ;
             <http://www.w3.org/2004/02/skos/core#definition> "A behavioral or functional classification of malware, describing what the malware does rather than what it is. Corresponds to the STIX 2.1 malware-type open vocabulary."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Malware Type"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Instances (e.g., stonework:Ransomware, stonework:Trojan) are assigned via stonework:categorizedBy. A malware object may carry multiple types. The skos:notation value gives the STIX 2.1 wire-format string for aspirational round-trip export."@en .


###  https://cyberterrain.org/ns/stonework#Markings
:Markings rdf:type owl:Class .


###  https://cyberterrain.org/ns/stonework#Mitigation
:Mitigation rdf:type owl:Class ;
            rdfs:subClassOf :Countermeasure ;
            rdfs:seeAlso <https://csrc.nist.gov/glossary/term/mitigation> ;
            <http://www.w3.org/2004/02/skos/core#definition> "A deliberate action or control intended to reduce the likelihood, impact, or severity of a risk, threat, vulnerability, or adverse event."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Mitigation" ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Mitigations are proactive or reactive measures applied to address weaknesses or threats. Examples include: applying a security patch, enabling MFA, deploying a firewall rule, isolating a compromised host, or training users. A Mitigation may be a reusable control (ATT&CK sense) or a specific situational action. CourseOfAction is a subclass for contextualized, packaged response actions."@en .


###  https://cyberterrain.org/ns/stonework#MobileDevice
:MobileDevice rdf:type owl:Class ;
              rdfs:subClassOf :Host ;
              <http://www.w3.org/2004/02/skos/core#definition> "A portable computing device with wireless connectivity, typically used for communication, data processing, and accessing networks (e.g., smartphones, tablets, or laptops with cellular capability)."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Mobile Device" ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "In a cyber threat context, Mobile Devices are often treated as both endpoints (Infrastructure) and vectors for attacks (e.g., mobile malware, phishing, lost/stolen device risks). They may host UserAccounts, run Mobile Applications, and connect via cellular, Wi-Fi, or Bluetooth."@en .


###  https://cyberterrain.org/ns/stonework#Mutex
:Mutex rdf:type owl:Class ;
       rdfs:subClassOf :DigitalArtifact ;
       <http://www.w3.org/2004/02/skos/core#definition> "A named mutual exclusion object (mutex or semaphore) used by a process to prevent concurrent access to a shared resource. Commonly used as a malware indicator — malware families often create uniquely named mutexes to avoid re-infecting a host."@en ;
       <http://www.w3.org/2004/02/skos/core#prefLabel> "Mutex"@en ;
       <http://www.w3.org/2004/02/skos/core#scopeNote> "Mutex names serve as host-based indicators of compromise. A specific mutex name found on a system can be attributed to a known malware family. Corresponds to the STIX 2.1 Mutex SCO."@en .


###  https://cyberterrain.org/ns/stonework#NetworkService
:NetworkService rdf:type owl:Class ;
                rdfs:subClassOf :Infrastructure ;
                <http://www.w3.org/2004/02/skos/core#definition> "A network-accessible service or endpoint provided by infrastructure, such as HTTP, DNS, or SSH servers."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Network Service" .


###  https://cyberterrain.org/ns/stonework#NetworkTraffic
:NetworkTraffic rdf:type owl:Class ;
                rdfs:subClassOf :DigitalArtifact ;
                <http://www.w3.org/2004/02/skos/core#definition> "A captured or observed network traffic flow between source and destination endpoints, including protocol, ports, payload characteristics, and timing."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Network Traffic"@en ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Distinct from stonework:Log (which captures parsed event records) and stonework:Event (a security-relevant occurrence). NetworkTraffic is the raw flow artifact. May carry indicators such as user-agent strings, URI patterns, or certificate fingerprints observable in transit."@en .


###  https://cyberterrain.org/ns/stonework#Note
:Note rdf:type owl:Class ;
      rdfs:subClassOf :IntelligenceProduct ;
      <http://www.w3.org/2004/02/skos/core#definition> "A free-text annotation attached to one or more individuals to provide additional context, analyst commentary, caveats, or confidence assessments."@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "Note" ;
      <http://www.w3.org/2004/02/skos/core#scopeNote> "Notes are analyst-authored rather than machine-generated. They may express uncertainty, sourcing context, or interpretive observations that do not fit structured properties. Corresponds to STIX 2.1 Note SDO."@en .


###  https://cyberterrain.org/ns/stonework#OffensiveTactic
:OffensiveTactic rdf:type owl:Class ;
                 rdfs:subClassOf :Tactic ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A high-level adversary objective that groups related attack techniques by the goal they serve during an intrusion or operation." ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Offensive Tactic" ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Aligns with MITRE ATT&CK tactics (e.g. Initial Access, Execution, Lateral Movement) and D3FEND OffensiveTactic. Individuals are typically drawn from ATT&CK or similar offensive frameworks via the STONES or framework mapping layers."@en .


###  https://cyberterrain.org/ns/stonework#OnlineReference
:OnlineReference rdf:type owl:Class ;
                 rdfs:subClassOf :Provenance ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A reference to an external online resource (URL, article, post, etc.) used for provenance." ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Online Reference" .


###  https://cyberterrain.org/ns/stonework#Operation
:Operation rdf:type owl:Class ;
           rdfs:subClassOf :CyberActivity ;
           <http://www.w3.org/2004/02/skos/core#definition> "A coordinated set of activities conducted by one or more agents toward a defined objective, typically spanning multiple campaigns, incidents, or phases and characterized by unified command, intent, or resourcing."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Operation" ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Operations are broader in scope than Campaigns — a single Operation may encompass multiple Campaigns executed over an extended period. Applies to both offensive operations (e.g. state-sponsored cyber operations) and defensive operations (e.g. incident response operations, threat hunting operations)."@en .


###  https://cyberterrain.org/ns/stonework#OperationPlan
:OperationPlan rdf:type owl:Class ;
               rdfs:subClassOf :Playbook ;
               <http://www.w3.org/2004/02/skos/core#definition> "A Playbook specifically representing an adversary's operational plan — the offensive counterpart within the Playbook hierarchy."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Operation Plan" ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "Named to avoid colliding with the already-established stonework:AttackPattern and stonework:AttackTechnique, and to align with stonework:Operation, whose definition ('a coordinated set of activities... unified command, intent, or resourcing') describes the executed counterpart of an OperationPlan. Generic stonework:Playbook remains available for the undifferentiated or defensive case."@en .


###  https://cyberterrain.org/ns/stonework#Opinion
:Opinion rdf:type owl:Class ;
         rdfs:subClassOf :IntelligenceProduct ;
         <http://www.w3.org/2004/02/skos/core#definition> "An analyst's epistemological stance on the correctness or credibility of information asserted in another intelligence object."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Opinion"@en ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "Sibling to stonework:Assessment under IntelligenceProduct. Where Assessment evaluates risk or impact, Opinion evaluates the reliability or accuracy of existing intelligence — e.g., 'I disagree with this threat score' or 'I believe this indicator attribution is incorrect'. Corresponds to STIX 2.1 Opinion SDO. The opinion value (strongly-agree to strongly-disagree) and explanation are captured via stones: properties."@en .


###  https://cyberterrain.org/ns/stonework#Organization
:Organization rdf:type owl:Class ;
              rdfs:subClassOf :Agent ;
              rdfs:seeAlso <http://www.w3.org/ns/prov#Organization> ;
              <http://www.w3.org/2004/02/skos/core#definition> "A formal or semi-formal structured entity such as a company, government agency, non-profit, military unit, or consortium with defined boundaries and usually legal identity."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Organization" ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "Corresponds to STIX Identity with identity_class = 'organization'. Includes corporations, government bodies, NGOs, universities, etc. Distinguished from Group by having more persistent structure, roles, and often legal standing."@en .


###  https://cyberterrain.org/ns/stonework#Person
:Person rdf:type owl:Class ;
        rdfs:subClassOf :Agent ;
        rdfs:seeAlso <http://www.w3.org/ns/prov#Person> ;
        <http://www.w3.org/2004/02/skos/core#definition> "A single human individual."@en ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Person" ;
        <http://www.w3.org/2004/02/skos/core#scopeNote> "Represents real named people (e.g. employees, threat actors, researchers). Does not include legal entities or groups. Corresponds to STIX Identity with identity_class = 'individual'."@en .


###  https://cyberterrain.org/ns/stonework#PhoneNumber
:PhoneNumber rdf:type owl:Class ;
             rdfs:subClassOf :Identifier ;
             <http://www.w3.org/2004/02/skos/core#definition> "A telephone number used to contact or identify an Agent. Used for attribution, OSINT pivoting, and identity clustering."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Phone Number"@en .


###  https://cyberterrain.org/ns/stonework#Playbook
:Playbook rdf:type owl:Class ;
          rdfs:subClassOf :Behavior ;
          rdfs:comment "A Playbook is a plan specification; executing one produces instances of stonework:Process. Playbooks are often versioned and tested before use."@en ;
          rdfs:seeAlso <http://www.w3.org/ns/prov#Plan> ;
          <http://www.w3.org/2004/02/skos/core#definition> "A documented, structured Behavior that defines a sequenced set of steps, decisions, and actions to be executed in response to a specific type of event, incident, or operational need."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Playbook" ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "A Playbook may be offensive (an adversary's operational playbook — see stonework:OperationPlan) or defensive (an incident response, threat hunting, or recovery playbook) — both are action plans carried out by an interested party, as distinct from stonework:DetectionPlan, which plays a neutral, evaluative role. A Playbook decomposes into Steps via stonework:hasStep; its actual execution is recorded as a stonework:Process."@en .


###  https://cyberterrain.org/ns/stonework#Procedure
:Procedure rdf:type owl:Class ;
           rdfs:subClassOf :Behavior ;
           rdfs:comment "Procedures are instances or patterns of execution that realize a technique. They may include command lines, API calls, malware behaviors, or operator playbook steps. Procedures are distinct from techniques, which describe generalized methods." ;
           <http://www.w3.org/2004/02/skos/core#definition> "A concrete, observable sequence of actions, commands, or behaviors that implements a technique in a specific operational context." ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Procedure" ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Procedures describe the actual steps an adversary takes, such as specific commands, scripts, tools, or configurations. They represent the most granular level of adversary behavior. Links back to the AttackTechnique it operationalizes via stonework:implements (Procedure implements AttackTechnique); may itself decompose into stonework:Step individuals via stonework:hasStep." .


###  https://cyberterrain.org/ns/stonework#Process
:Process rdf:type owl:Class ;
         rdfs:subClassOf :CyberActivity ;
         rdfs:seeAlso <http://www.w3.org/ns/prov#Activity> ,
                      <https://www.opmw.org/model/p-plan/> ;
         <http://www.w3.org/2004/02/skos/core#definition> "An identifiable activity or sequence of activities performed over time by one or more agents to achieve an operational, security, or business objective. It transforms inputs (artifacts, data, configurations) into outputs and may be governed by plans, controls, or policies." ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Process"@en ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "This class operates at the enterprise/operational level and is distinct from low-level runtime Process objects (e.g., STIX SCO Process). It is the execution-side counterpart to Behavior-side plan specifications such as Playbook, ControlPlan, and ThreatScenario — e.g. executing a Playbook produces a Process instance."@en .


###  https://cyberterrain.org/ns/stonework#Product
:Product rdf:type owl:Class ;
         rdfs:subClassOf :CyberEntity ;
         owl:disjointWith :VersionedProduct ;
         rdfs:comment "Instances of stonework:Product represent product families or lines (e.g. 'Apache Log4j', 'Windows 10'). Specific releases are modeled as stonework:VersionedProduct individuals related via stonework:versionOf. CPE entries with wildcard version components map to stonework:Product; entries with concrete versions map to stonework:VersionedProduct."@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "An abstract software, hardware, or firmware product line identified by vendor and product name, independent of any specific version or release. Represents the collection of all versioned releases built under that product identity."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Product" ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "stonework:Product does not carry version, update, edition, or other release-specific attributes. Those belong on stonework:VersionedProduct. The two classes are disjoint."@en .


###  https://cyberterrain.org/ns/stonework#ProductInstallation
:ProductInstallation rdf:type owl:Class ;
                     rdfs:subClassOf :ComponentContext ;
                     rdfs:comment "Represents the most granular product identity level: not what software exists, but where and how it is installed. Multiple ProductInstallation individuals may reference the same VersionedProduct."@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "A specific installed instance of a VersionedProduct on a particular system or environment, as identified by a SWID tag or equivalent installation record."@en ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Product Installation" ;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "stonework:ProductInstallation is the intended target for SWID tag data. The installing system, path, licensee, and configuration details belong here rather than on stonework:VersionedProduct."@en .


###  https://cyberterrain.org/ns/stonework#Provenance
:Provenance rdf:type owl:Class ;
            rdfs:subClassOf :CyberEntity ;
            <http://www.w3.org/2004/02/skos/core#definition> "Structured source references used to record the origin and trustworthiness of data and relationships."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Provenance"@en ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Includes Feeds, Publications, and URL References."@en .


###  https://cyberterrain.org/ns/stonework#Publication
:Publication rdf:type owl:Class ;
             rdfs:subClassOf :Provenance ;
             <http://www.w3.org/2004/02/skos/core#definition> "A structured intelligence artifact such as a blog post, advisory, report, or news article." ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Publication" .


###  https://cyberterrain.org/ns/stonework#Region
:Region rdf:type owl:Class ;
        rdfs:subClassOf :Location ;
        <http://www.w3.org/2004/02/skos/core#definition> "A sub-national territorial division such as a state, province, region, or governorate." ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Region" .


###  https://cyberterrain.org/ns/stonework#Registry
:Registry rdf:type owl:Class ;
          rdfs:subClassOf :DigitalArtifact ;
          <http://www.w3.org/2004/02/skos/core#definition> "Describes elements within the Windows configuration Registry system." ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Registry" .


###  https://cyberterrain.org/ns/stonework#Report
:Report rdf:type owl:Class ;
        rdfs:subClassOf :IntelligenceProduct ;
        <http://www.w3.org/2004/02/skos/core#definition> "A collection of threat intelligence focused on one or more topics, such as a description of a threat actor, malware, or attack technique." ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Report" .


###  https://cyberterrain.org/ns/stonework#Risk
:Risk rdf:type owl:Class ;
      rdfs:subClassOf :RiskFactor ;
      rdfs:comment "Instances of stonework:Risk may reference the threat being considered, the assets affected, the expected impact of compromise, and the likelihood of occurrence. Risk values may be qualitative or quantitative, and SHOULD be represented using explicit properties rather than encoded in class IRIs or labels." ;
      <http://www.w3.org/2004/02/skos/core#definition> "A measure of the potential for loss or adverse effects arising from the realization of a threat, expressed as a function of the impact of compromise and the likelihood that the compromise will occur." ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "Risk" ;
      <http://www.w3.org/2004/02/skos/core#scopeNote> "This class represents the assessed or estimated level of exposure to harm for a specific asset, mission, or organization. Risk is typically derived from the combination of impact and likelihood, and may incorporate assumptions, uncertainty, and contextual factors." .


###  https://cyberterrain.org/ns/stonework#RiskFactor
:RiskFactor rdf:type owl:Class ;
            rdfs:subClassOf :CyberEntity ;
            <http://www.w3.org/2004/02/skos/core#definition> "A calculated or assessed component used to quantify or characterize security risk, including the potential for harm and the probability of its occurrence."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Risk Factor" ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Includes Risk (overall assessed exposure), Impact (magnitude of harm if realized), and Likelihood (probability of occurrence). These are analytical outputs derived from threat and vulnerability data, distinct from the conditions (SecurityCondition) that give rise to them and the countermeasures (Countermeasure) that address them."@en .


###  https://cyberterrain.org/ns/stonework#Role
:Role rdf:type owl:Class ;
      rdfs:subClassOf :CyberEntity ;
      <http://www.w3.org/2004/02/skos/core#definition> "A function, capacity, or part played by an entity in a specific context, relationship, or operation." ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "Role" ;
      <http://www.w3.org/2004/02/skos/core#scopeNote> "Roles are typically more stable and relational than Categories. An entity can play multiple Roles. Aligns with patterns in BFO, CCO, and D3FEND (e.g., functional roles of infrastructure or actors)."@en .


###  https://cyberterrain.org/ns/stonework#RuntimeProcess
:RuntimeProcess rdf:type owl:Class ;
                rdfs:subClassOf :DigitalArtifact ;
                <http://www.w3.org/2004/02/skos/core#definition> "A running or terminated process instance on a host, identified by PID, executable path, command line, parent process, and associated user account."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Runtime Process"@en ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Represents low-level OS process objects observed during execution — distinct from stonework:Process (enterprise-level workflows). Mutex objects created by a process are linked as stonework:Mutex individuals. Corresponds to STIX 2.1 Process SCO."@en .


###  https://cyberterrain.org/ns/stonework#SecurityCondition
:SecurityCondition rdf:type owl:Class ;
                   rdfs:subClassOf :CyberEntity ;
                   <http://www.w3.org/2004/02/skos/core#definition> "A state, circumstance, or disposition relevant to the security posture of a system, asset, or mission — existing independently of any measurement or assessment."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Security Condition" ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Includes Threats, Vulnerabilities, and Weaknesses. Risk, Impact, and Likelihood are assessed/calculated concepts and are modeled under stonework:RiskFactor."@en .


###  https://cyberterrain.org/ns/stonework#SecurityObservation
:SecurityObservation rdf:type owl:Class ;
                     rdfs:subClassOf :IntelligenceProduct ;
                     rdfs:seeAlso <https://www.w3.org/TR/vocab-ssn/#SOSAObservation> ;
                     <http://www.w3.org/2004/02/skos/core#definition> "A time-bounded record produced by a security sensor or automated tool capturing one or more cyber observables witnessed in a monitored environment, together with frequency metadata."@en ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Security Observation"@en ;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "Machine-produced intelligence: a sensor is not an analyst, but its output feeds the intelligence pipeline in the same way that SIGINT feeds human analysis. Key metadata: the time window the phenomenon was witnessed (first/last observed), how many times it was observed (number_observed), and which cyber observables were captured (hasObservable). Use stonework:madeBySensor to link to the producing stonework:Sensor. Distinct from stonework:Sighting, which records that a known CTI object (indicator, malware, threat actor) was seen; SecurityObservation is the raw sensor-layer record prior to attribution or indicator matching. Corresponds to STIX 2.1 observed-data SDO. Inspired by SOSA sosa:Observation — compatible in concept but does not formally import the SOSA ontology."@en .


###  https://cyberterrain.org/ns/stonework#Sensor
:Sensor rdf:type owl:Class ;
        rdfs:subClassOf :Infrastructure ;
        rdfs:seeAlso <https://www.w3.org/TR/vocab-ssn/#SOSASensor> ;
        <http://www.w3.org/2004/02/skos/core#definition> "A deployed system, appliance, agent, or network tap that collects data about digital artifacts, network activity, or adversary behavior for detection and investigation purposes."@en ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Sensor" ;
        <http://www.w3.org/2004/02/skos/core#scopeNote> "Applies DetectionRules via stonework:usesRule. May be a software agent, physical appliance, virtual instance, or network sensor. Examples: IDS/IPS, SIEM collector, endpoint agent, network tap, honeypot, vulnerability scanner. An AI-driven sensor that crosses into autonomous decision-making may be additionally typed as stonework:AIAgent. Aligns with D3FEND Sensor. Inspired by SOSA sosa:Sensor — compatible in concept but does not formally import the SOSA ontology. Produces stonework:SecurityObservation instances via stonework:madeBySensor."@en .


###  https://cyberterrain.org/ns/stonework#Sighting
:Sighting rdf:type owl:Class ;
          rdfs:subClassOf :IntelligenceProduct ;
          <http://www.w3.org/2004/02/skos/core#definition> "Records that a object such as an indicator, malware, tool, or threat actor was seen. Wraps observation metadata around a reference to the sighted object."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Sighting" .


###  https://cyberterrain.org/ns/stonework#Signature
:Signature rdf:type owl:Class ;
           rdfs:subClassOf :DetectionRule ;
           <http://www.w3.org/2004/02/skos/core#definition> "A content-centric detection rule that matches malicious activity by a specific pattern — a byte sequence, string, hash, regular expression, or network packet structure."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Signature"@en ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Includes YARA rules, Snort/Suricata rules, and AV signatures. Distinguished from broader DetectionRule subclasses (behavioral, correlation, analytic) by its tight binding to a specific known-bad indicator or artifact pattern."@en .


###  https://cyberterrain.org/ns/stonework#SoftwareBillOfMaterials
:SoftwareBillOfMaterials rdf:type owl:Class ;
                         rdfs:comment "An SBOM asserts that specific VersionedProduct instances are components of a containing artifact. Component entries are represented as stonework:BomEntry instances linked via stonework:hasBomEntry."@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "A formal, machine-readable inventory of VersionedProduct components that constitute a software artifact or system, expressed in a standard format such as CycloneDX or SPDX."@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Software Bill of Materials" ;
                         <http://www.w3.org/2004/02/skos/core#scopeNote> "SoftwareBillOfMaterials is a native STONEWORK class — not a subclass of any STIX domain object, as STIX 2.1 has no SBOM concept. Instances correspond to SBOM documents; format provenance (CycloneDX 1.6, SPDX 2.3, etc.) is expressed via stonework:bomFormat."@en .


###  https://cyberterrain.org/ns/stonework#Step
:Step rdf:type owl:Class ;
      rdfs:subClassOf :Behavior ;
      rdfs:seeAlso <http://purl.org/net/p-plan#Step> ;
      <http://www.w3.org/2004/02/skos/core#definition> "A single, individually addressable unit of action within a Behavior that models a multi-step process, such as a Procedure, Playbook, ThreatScenario, or Control."@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "Step" ;
      <http://www.w3.org/2004/02/skos/core#scopeNote> "A Step is itself a Behavior — a plan specification for a sub-action, not its execution — consistent with p-plan:Step subclassing prov:Plan rather than prov:Activity. Because Step is a Behavior, a Step MAY itself decompose into further Steps via stonework:hasStep, supporting nested sub-procedures (e.g. a Kill Chain phase decomposing into candidate technique attempts) without a separate composite class. The activity that executes a Step is a stonework:CyberActivity; it links back to the Step it realizes via stonework:correspondsToStep."@en .


###  https://cyberterrain.org/ns/stonework#Tactic
:Tactic rdf:type owl:Class ;
        rdfs:subClassOf :Behavior ;
        rdfs:comment "Instances of stonework:Tactic SHOULD correspond to high‑level adversary goals. Techniques are typically modeled as children or members of a tactic." ;
        <http://www.w3.org/2004/02/skos/core#definition> "A high‑level objective or strategic goal that groups related techniques by the purpose they serve during an operation." ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Tactic" ;
        <http://www.w3.org/2004/02/skos/core#scopeNote> "Superclass for OffensiveTactic and DefensiveTactic. Tactics represent the strategic intent behind behavior — gaining initial access, exfiltrating data, or hardening a system. They serve as conceptual categories for techniques." .


###  https://cyberterrain.org/ns/stonework#Technique
:Technique rdf:type owl:Class ;
           rdfs:subClassOf :Behavior ;
           rdfs:comment "Mirrors D3FEND's Technique class and reflects the PROV-O Plan philosophy: a technique is a plan that describes how an action should be carried out, distinct from the activity that executes it. Subclassed by stonework:CyberTechnique for cyber-specific methods." ;
           <http://www.w3.org/2004/02/skos/core#definition> "A reusable, prescribed method for achieving an objective, which may be instantiated as a concrete execution by an actor or system." ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Technique" ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Technique is intentionally not a subclass of stones:AttackPattern. Attack patterns (e.g. CAPEC) are abstract descriptions of attack classes in the STIX sense; techniques are operationalized plans. See stonework:CyberTechnique, stonework:AttackTechnique, stonework:DefendTechnique." .


###  https://cyberterrain.org/ns/stonework#Threat
:Threat rdf:type owl:Class ;
        rdfs:subClassOf :SecurityCondition ;
        rdfs:comment "Instances of stonework:Threat may describe adversary capabilities, strategic objectives, targeting patterns, or environmental conditions that increase the likelihood of harmful action. Threats may be linked to threat actors, campaigns, malware, TTPs, weaknesses, or assets, but are conceptually distinct from the actions or events that realize them." ;
        <http://www.w3.org/2004/02/skos/core#definition> "A potential or actual source of harm arising from an adversary's capability, intent, and opportunity to exploit weaknesses or create adverse effects within a system, organization, or mission." ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Threat" ;
        <http://www.w3.org/2004/02/skos/core#scopeNote> "This class represents the abstract notion of a cyber threat, independent of specific threat actors, campaigns, or events. It provides a semantic foundation for modeling adversary capabilities, intentions, targeting, and conditions that give rise to harmful outcomes." .


###  https://cyberterrain.org/ns/stonework#ThreatActor
:ThreatActor rdf:type owl:Class ;
             rdfs:subClassOf :Agent ;
             rdfs:seeAlso <http://www.w3.org/ns/prov#Agent> ;
             <http://www.w3.org/2004/02/skos/core#definition> "An entity that has the capability and intent to conduct harmful activities within a cyber or sociotechnical context." ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Threat Actor"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Parent class for stonework:ThreatActorIndividual (a single human) and stonework:ThreatActorGroup (a collective or organization). Threat actors are distinct from the threats they pose; they are the entities that carry out actions that realize threats. They may be linked to observed behaviors, techniques, targeting patterns, and strategic objectives."@en .


###  https://cyberterrain.org/ns/stonework#ThreatActorGroup
:ThreatActorGroup rdf:type owl:Class ;
                  rdfs:subClassOf :ThreatActor ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A collective, organization, or coordinated set of individuals operating with common intent to conduct adversarial cyber activities."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Threat Actor Group"@en ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers nation-state units, cybercriminal organizations, hacktivist collectives, and other named adversary groups (e.g., APT29, Lazarus Group). MITRE ATT&CK serializes these as STIX intrusion-set objects; in STONEWORK they are correctly typed as ThreatActorGroup — an adversary entity rather than an activity cluster. Distinguished from stonework:ThreatActorIndividual, which represents a single human actor, and from stonework:CyberActivityCluster, which is the attributed set of activity linked to the group."@en .


###  https://cyberterrain.org/ns/stonework#ThreatActorIndividual
:ThreatActorIndividual rdf:type owl:Class ;
                       rdfs:subClassOf :ThreatActor ;
                       <http://www.w3.org/2004/02/skos/core#definition> "A single, identifiable human actor with the capability and intent to conduct adversarial cyber activities."@en ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Threat Actor Individual"@en ;
                       <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers individual hackers, insiders, contractors, and other identified persons. Relevant for law enforcement and prosecution contexts where attribution to a specific individual — rather than a group — is required. Distinguished from stonework:ThreatActorGroup, which represents a collective or organization."@en .


###  https://cyberterrain.org/ns/stonework#ThreatScenario
:ThreatScenario rdf:type owl:Class ;
                rdfs:subClassOf :Behavior ;
                rdfs:seeAlso <http://www.w3.org/ns/prov#Plan> ;
                <http://www.w3.org/2004/02/skos/core#definition> "A plan specification describing how a threat could materialize against specific assets or missions — incorporating adversary intent, capability, opportunity, preconditions, attack path, and expected consequences."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Threat Scenario"@en ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "A ThreatScenario is prescriptive and forward-looking: it specifies a potential sequence of adversary behaviors and environmental conditions rather than recording observed events. Used to guide defensive planning, risk assessment, and Playbook development. Distinct from stonework:Incident (an observed occurrence) and stonework:Threat (an abstract source of harm). Aligns with prov:Plan and P-Plan scenario specifications."@en .


###  https://cyberterrain.org/ns/stonework#Tool
:Tool rdf:type owl:Class ;
      rdfs:subClassOf :Product ;
      <http://www.w3.org/2004/02/skos/core#definition> "Legitimate software that can be used offensively by threat actors or defensively by security practitioners. Distinguishable from malware by being designed for benign or dual-use purposes rather than being inherently malicious."@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "Tool"@en ;
      <http://www.w3.org/2004/02/skos/core#scopeNote> "Includes commercial penetration testing tools, remote administration utilities, and living-off-the-land binaries (LOLBins) repurposed by adversaries, as well as defender-operated tools such as scanners, EDR agents, and forensic utilities. Corresponds to STIX 2.1 Tool SDO."@en .


###  https://cyberterrain.org/ns/stonework#Transition
:Transition rdf:type owl:Class ;
            <http://www.w3.org/2004/02/skos/core#definition> "A directed edge between two Steps within the same parent Behavior's Step graph, representing progression from one Step to the next."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Transition" ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Unconditioned, a Transition expresses plain sequence — an alternative to stonework:precededByStep for the same purpose, used when a Step has more than one possible successor and the edges themselves need to be individually referenceable. When a Transition's stonework:toStep targets a Step already reached earlier in the same graph, it expresses a loop back-edge; looping is not a separate construct. Guard/condition properties for conditional branching (testing a bound Variable's value) are not yet defined — this class currently captures only the structural edge via stonework:fromStep and stonework:toStep."@en .


###  https://cyberterrain.org/ns/stonework#URI
:URI rdf:type owl:Class ;
     rdfs:subClassOf :Identifier ;
     <http://www.w3.org/2004/02/skos/core#definition> "Represents a Uniform Resource Identifier conforming to RFC 3986."@en ;
     <http://www.w3.org/2004/02/skos/core#prefLabel> "URI"@en .


###  https://cyberterrain.org/ns/stonework#UserAccount
:UserAccount rdf:type owl:Class ;
             rdfs:subClassOf :DigitalIdentity ;
             <http://www.w3.org/2004/02/skos/core#definition> "Represents a user account on a system or service, including local OS accounts, cloud accounts, and social media accounts."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "User Account"@en .


###  https://cyberterrain.org/ns/stonework#UserAgent
:UserAgent rdf:type owl:Class ;
           rdfs:subClassOf :Identifier ;
           <http://www.w3.org/2004/02/skos/core#definition> "A string identifier transmitted by a client application in HTTP requests declaring the software, version, and platform making the request. Used for fingerprinting clients, identifying malware C2 beaconing patterns, and clustering infrastructure by shared tooling."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "User Agent"@en ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "User-agent strings are observable in network traffic, proxy logs, and web server logs. Distinctive or spoofed user-agent values are commonly used as indicators in threat intelligence. Distinct from stonework:UserAccount (an identity credential) — a UserAgent describes software behavior, not a user identity."@en .


###  https://cyberterrain.org/ns/stonework#UserGroup
:UserGroup rdf:type owl:Class ;
           rdfs:subClassOf :DigitalIdentity ;
           <http://www.w3.org/2004/02/skos/core#definition> "Represents a user group on a system or service, including local OS groups, cloud groups, and social media groups."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "User Group" .


###  https://cyberterrain.org/ns/stonework#Variable
:Variable rdf:type owl:Class ;
          rdfs:subClassOf :CyberEntity ;
          rdfs:seeAlso <http://purl.org/net/p-plan#Variable> ;
          <http://www.w3.org/2004/02/skos/core#definition> "A named placeholder for a value declared by a Behavior or Step, bound to an actual value only once the corresponding execution occurs."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Variable" ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "Declared via stonework:hasInputVariable or stonework:hasOutputVariable. An input Variable is typically bound before its Step executes, from an already-known fact (e.g. a Vulnerability's CVSS score); an output Variable is bound only after its Step executes, from a result the execution produced (e.g. a Technique attempt's outcome). Bound via stonework:boundTo (an individual) or stonework:boundToLiteral (a scalar). The bound value is what stonework:Transition guard properties test, and — in a future deviation-detection layer — what an actual result is compared against what the Step declared as expected."@en .


###  https://cyberterrain.org/ns/stonework#VersionedProduct
:VersionedProduct rdf:type owl:Class ;
                  rdfs:comment "Instances of stonework:VersionedProduct may include operating systems, applications, libraries, devices, or embedded components at a specific release. Versioning, vendor attribution, and edition details SHOULD be represented using explicit properties rather than encoded strings."@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A specific versioned release or build of a Product, identified by a CPE name or equivalent product identifier. Represents the unit of software actually deployed and potentially affected by vulnerabilities."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "VersionedProduct" ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "Each CPE 2.3 entry with a concrete version component maps to a stonework:VersionedProduct individual. Wildcard-version CPEs map to stonework:Product. Related to its abstract product line via stonework:versionOf."@en .


###  https://cyberterrain.org/ns/stonework#Vulnerability
:Vulnerability rdf:type owl:Class ;
               rdfs:subClassOf :SecurityCondition ;
               <http://www.w3.org/2004/02/skos/core#definition> "A flaw or weakness in software, hardware, firmware, or system architecture that can be exploited by a threat actor to compromise confidentiality, integrity, or availability."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Vulnerability" ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "Represents specific exploitable instances (e.g., CVE-identified vulnerabilities) rather than weakness classes — those are modeled as stonework:Weakness. A Vulnerability is linked to its root Weakness via stonework:hasWeakness, to affected products via stonework:affected, to its fix via stonework:fixedInProduct, and to exploiting malware or actors via stonework:exploits. Aligns with D3FEND Vulnerability and NVD CVE."@en .


###  https://cyberterrain.org/ns/stonework#VulnerabilityAssessment
:VulnerabilityAssessment rdf:type owl:Class ;
                         rdfs:subClassOf :Assessment ;
                         <http://www.w3.org/2004/02/skos/core#definition> "A structured evaluation of a specific vulnerability's applicability and risk in a particular product or deployment context."@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Vulnerability Assessment"@en ;
                         <http://www.w3.org/2004/02/skos/core#scopeNote> "Captures VEX-style assessments: whether a product is affected, not affected, fixed, or under investigation, together with the justification and any remediation statement. Distinct from stonework:Vulnerability (which describes the flaw itself) — a VulnerabilityAssessment is an opinion about that flaw in a specific context."@en .


###  https://cyberterrain.org/ns/stonework#Weakness
:Weakness rdf:type owl:Class ;
          rdfs:subClassOf :SecurityCondition ;
          rdfs:comment "Instances of stonework:Weakness may represent base weaknesses, variant weaknesses, or compound weaknesses. CWE identifiers (e.g., \"CWE‑79\") SHOULD be modeled using explicit properties rather than encoded in the class IRI. Descriptions and extended details SHOULD be referenced via citations rather than reproduced verbatim." ;
          <http://www.w3.org/2004/02/skos/core#definition> "A type of flaw, fault, or design condition in software, hardware, or system architecture that can enable vulnerabilities, reduce security assurance, or increase the likelihood of exploitable behavior." ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Weakness" ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "This class provides a semantic representation of weakness types defined in the Common Weakness Enumeration (CWE). It supports hierarchical relationships, abstraction levels, and mappings to related attack patterns, vulnerabilities, and security controls." .


#################################################################
#    Individuals
#################################################################

###  https://cyberterrain.org/ns/stonework#Adware
:Adware rdf:type owl:NamedIndividual ,
                 :MalwareType ;
        <http://www.w3.org/2004/02/skos/core#definition> "Software that automatically displays or downloads advertising material, often without user consent."@en ;
        <http://www.w3.org/2004/02/skos/core#notation> "adware" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Adware"@en .


###  https://cyberterrain.org/ns/stonework#Backdoor
:Backdoor rdf:type owl:NamedIndividual ,
                   :MalwareType ;
          <http://www.w3.org/2004/02/skos/core#definition> "Malware that provides covert, persistent remote access to a compromised system, bypassing normal authentication."@en ;
          <http://www.w3.org/2004/02/skos/core#notation> "backdoor" ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Backdoor"@en .


###  https://cyberterrain.org/ns/stonework#Bootkit
:Bootkit rdf:type owl:NamedIndividual ,
                  :MalwareType ;
         <http://www.w3.org/2004/02/skos/core#definition> "Malware that infects the boot sector or master boot record to load before the operating system, enabling deep persistence and defense evasion."@en ;
         <http://www.w3.org/2004/02/skos/core#notation> "bootkit" ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Bootkit"@en .


###  https://cyberterrain.org/ns/stonework#Bot
:Bot rdf:type owl:NamedIndividual ,
              :MalwareType ;
     <http://www.w3.org/2004/02/skos/core#definition> "Malware that connects an infected host to a command-and-control network, enabling remote tasking as part of a botnet."@en ;
     <http://www.w3.org/2004/02/skos/core#notation> "bot" ;
     <http://www.w3.org/2004/02/skos/core#prefLabel> "Bot"@en .


###  https://cyberterrain.org/ns/stonework#DDoS
:DDoS rdf:type owl:NamedIndividual ,
               :MalwareType ;
      <http://www.w3.org/2004/02/skos/core#definition> "Malware designed to conduct or participate in distributed denial-of-service attacks against target systems or networks."@en ;
      <http://www.w3.org/2004/02/skos/core#notation> "ddos" ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "DDoS Malware"@en .


###  https://cyberterrain.org/ns/stonework#Downloader
:Downloader rdf:type owl:NamedIndividual ,
                     :MalwareType ;
            <http://www.w3.org/2004/02/skos/core#definition> "Malware whose primary function is to download and execute additional malicious payloads from a remote source."@en ;
            <http://www.w3.org/2004/02/skos/core#notation> "downloader" ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Downloader"@en .


###  https://cyberterrain.org/ns/stonework#Dropper
:Dropper rdf:type owl:NamedIndividual ,
                  :MalwareType ;
         <http://www.w3.org/2004/02/skos/core#definition> "Malware that carries and installs one or more secondary payloads onto a target system, often unpacking them from within itself."@en ;
         <http://www.w3.org/2004/02/skos/core#notation> "dropper" ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Dropper"@en .


###  https://cyberterrain.org/ns/stonework#Equals
:Equals rdf:type owl:NamedIndividual ,
                 :ComparisonOperator ;
        <http://www.w3.org/2004/02/skos/core#definition> "The guardVariable's bound value equals guardLiteralValue."@en ;
        <http://www.w3.org/2004/02/skos/core#notation> "eq" ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Equals"@en .


###  https://cyberterrain.org/ns/stonework#ExploitKit
:ExploitKit rdf:type owl:NamedIndividual ,
                     :MalwareType ;
            <http://www.w3.org/2004/02/skos/core#definition> "A toolkit that automates exploitation of client-side vulnerabilities to deliver malware, typically via drive-by download from compromised or malicious web pages."@en ;
            <http://www.w3.org/2004/02/skos/core#notation> "exploit-kit" ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Exploit Kit"@en .


