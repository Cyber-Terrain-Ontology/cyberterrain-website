#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( <https://cyberterrain.org/ns/stones#StixBundle>
                <https://cyberterrain.org/ns/stones#StixCoreObject>
                <https://cyberterrain.org/ns/stones#StixMetaObject>
              )
] .


