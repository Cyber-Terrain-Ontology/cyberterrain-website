@prefix : <https://cyberterrain.org/ns/stonework#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://cyberterrain.org/ns/stonework#> .

<https://cyberterrain.org/ns/stonework#> rdf:type owl:Ontology ;
                                          owl:versionIRI <https://cyberterrain.org/ns/stonework/0.10.0> ;
                                          <http://purl.org/dc/terms/creator> "Hohimer Intelligence Strategies LLC" ;
                                          <http://purl.org/dc/terms/license> <https://opensource.org/licenses/MIT> ;
                                          rdfs:label "STONEWORK"@en ;
                                          owl:versionInfo "0.10.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/isPartOf
<http://purl.org/dc/terms/isPartOf> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
<http://purl.org/dc/terms/source> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
<http://www.w3.org/2004/02/skos/core#altLabel> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
<http://www.w3.org/2004/02/skos/core#prefLabel> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#scopeNote
<http://www.w3.org/2004/02/skos/core#scopeNote> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://cyberterrain.org/ns/stonework#accessesFile
:accessesFile rdf:type owl:ObjectProperty ;
              rdfs:domain :RuntimeProcess ;
              rdfs:range :File ;
              <http://www.w3.org/2004/02/skos/core#definition> "Relates a RuntimeProcess to Files it reads, writes, or executes."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "accessesFile"@en .


###  https://cyberterrain.org/ns/stonework#accessesRegistry
:accessesRegistry rdf:type owl:ObjectProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( :MalwareSample
                                              :RuntimeProcess
                                            )
                              ] ;
                  rdfs:range :Registry ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Relates a RuntimeProcess or MalwareSample to Registry keys it reads or modifies."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "accessesRegistry"@en .


###  https://cyberterrain.org/ns/stonework#accountCurrency
:accountCurrency rdf:type owl:ObjectProperty ;
                 rdfs:domain :FinancialAccount ;
                 rdfs:range :Currency ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A currency or crypto asset that this financial account holds or is denominated in."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "accountCurrency"@en ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Intentionally multi-valued: an account, including a hosted exchange account or multi-asset wallet, may hold or support more than one currency."@en .


###  https://cyberterrain.org/ns/stonework#accountOf
:accountOf rdf:type owl:ObjectProperty ;
           rdfs:domain :Account ;
           rdfs:range :Agent ;
           <http://www.w3.org/2004/02/skos/core#definition> "The Agent that holds this Account, or to whom it is beneficially attributed. Inverse of stonework:hasAccount."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "accountOf" ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "For a UserAccount this is the account holder; for a FinancialAccount it is the accountholder or beneficial owner, which may differ from whoever operates it (an account-takeover attacker operating a victim's FinancialAccount is modeled with stonework:controls from the attacker-held UserAccount, leaving accountOf pointing at the victim)."@en .


###  https://cyberterrain.org/ns/stonework#actsOn
:actsOn rdf:type owl:ObjectProperty ;
        rdfs:domain :CyberActivity ;
        rdfs:range :CyberEntity ;
        rdfs:seeAlso <http://www.w3.org/ns/prov#used> ;
        <http://www.w3.org/2004/02/skos/core#definition> "Links a CyberActivity to the CyberEntity it acted upon — the asset, artifact, or resource the activity operated against."@en ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "actsOn" ;
        <http://www.w3.org/2004/02/skos/core#scopeNote> "Mirrors prov:used (an Activity used an Entity). Typical range instances are stonework:Host, stonework:RuntimeProcess, or other stonework:DigitalArtifact/stonework:Infrastructure individuals — e.g. the specific lsass.exe stonework:RuntimeProcess a credential-dumping attempt acted on. Distinct from stonework:targets: targets is a direct, open-domain/range lift of the STIX 2.1 relationship_type 'targets' shortcut, describing higher-level strategic targeting (a Sector, a Location, an Agent) by a Campaign/MalwareSample/ThreatActor. actsOn is purpose-built for the concrete technical asset one execution-trace Activity acted upon — the same distinction develop draws between stonework:mitigates (open, STIX-lifted) and stonework:mitigatesAttackPattern (purpose-built, controlled domain/range)."@en .


###  https://cyberterrain.org/ns/stonework#addressOf
:addressOf rdf:type owl:ObjectProperty ;
           rdfs:domain :IPAddress ;
           rdfs:range [ rdf:type owl:Class ;
                        owl:unionOf ( :Host
                                      :NetworkService
                                    )
                      ] ;
           <http://www.w3.org/2004/02/skos/core#definition> "Relates an IPAddress to the Host or NetworkService for which it serves as a network address."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "addressOf"@en .


###  https://cyberterrain.org/ns/stonework#addresses
:addresses rdf:type owl:ObjectProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :Playbook
                                       :ThreatScenario
                                     )
                       ] ;
           rdfs:range [ rdf:type owl:Class ;
                        owl:unionOf ( :AttackTechnique
                                      :MalwareFamily
                                      :ThreatActor
                                    )
                      ] ;
           <http://www.w3.org/2004/02/skos/core#definition> "Relates a Playbook or ThreatScenario to an AttackTechnique, MalwareFamily, or ThreatActor it is designed to address."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "addresses"@en .


###  https://cyberterrain.org/ns/stonework#addressesAttack
:addressesAttack rdf:type owl:ObjectProperty ;
                 rdfs:domain :CourseOfAction ;
                 rdfs:range :AttackPattern ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A CourseOfAction prescribes a defensive response to this AttackPattern."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "addressesAttack"@en .


###  https://cyberterrain.org/ns/stonework#adjacentTo
:adjacentTo rdf:type owl:ObjectProperty ,
                     owl:SymmetricProperty ;
            rdfs:domain :Location ;
            rdfs:range :Location ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates a Location to another Location with which it shares a border or boundary, e.g. two neighboring Countries or Regions."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "adjacentTo"@en ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Symmetric and not transitive. Use stonework:locatedWithin for containment rather than adjacency."@en .


###  https://cyberterrain.org/ns/stonework#affected
:affected rdf:type owl:ObjectProperty ;
          rdfs:domain :Vulnerability ;
          rdfs:range :VersionedProduct ;
          <http://www.w3.org/2004/02/skos/core#definition> "Relates a vulnerability to a product version known to be affected by it." ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "affected" ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "The range is a stonework:VersionedProduct individual whose IRI is derived deterministically from the CPE identifier. The product individual may be populated by a separate CPE ingest; references from CVE data precede that ingest and are resolved when CPE data is loaded." .


###  https://cyberterrain.org/ns/stonework#affectsAsset
:affectsAsset rdf:type owl:ObjectProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :Campaign
                                          :Impact
                                          :Incident
                                          :Risk
                                        )
                          ] ;
              rdfs:range [ rdf:type owl:Class ;
                           owl:unionOf ( :DataAsset
                                         :Infrastructure
                                       )
                         ] ;
              <http://www.w3.org/2004/02/skos/core#definition> "Relates an Incident, Campaign, Risk, or Impact to the assets it threatens or impacts."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "affectsAsset"@en .


###  https://cyberterrain.org/ns/stonework#affiliatedWith
:affiliatedWith rdf:type owl:ObjectProperty ;
                rdfs:range :Agent ;
                <http://www.w3.org/2004/02/skos/core#definition> "Associates an entity with a related Agent through organizational membership, alliance, sponsorship, or informal association."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "affiliatedWith" .


###  https://cyberterrain.org/ns/stonework#analysisOf
:analysisOf rdf:type owl:ObjectProperty ;
            rdfs:domain :Analysis ;
            rdfs:range [ rdf:type owl:Class ;
                         owl:unionOf ( :CyberActivity
                                       :CyberEntity
                                     )
                       ] ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates an Analysis to the CyberEntity or CyberActivity that it examines."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "analysisOf"@en .


###  https://cyberterrain.org/ns/stonework#appliesControl
:appliesControl rdf:type owl:ObjectProperty ;
                rdfs:domain :CourseOfAction ;
                rdfs:range :Control ;
                <http://www.w3.org/2004/02/skos/core#definition> "A CourseOfAction specifies this Control as part of its recommended defensive posture. Primary arc into the Control class."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "appliesControl"@en .


###  https://cyberterrain.org/ns/stonework#appliesCountermeasure
:appliesCountermeasure rdf:type owl:ObjectProperty ;
                       rdfs:domain :SecurityActuation ;
                       rdfs:range :Countermeasure ;
                       <http://www.w3.org/2004/02/skos/core#definition> "Relates a SecurityActuation to the Countermeasure, rule, control, or mitigation carried out during that activity."@en ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "appliesCountermeasure"@en .


###  https://cyberterrain.org/ns/stonework#appliesTo
:appliesTo rdf:type owl:ObjectProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :Control
                                       :DetectionRule
                                     )
                       ] ;
           rdfs:range [ rdf:type owl:Class ;
                        owl:unionOf ( :DataAsset
                                      :Host
                                      :Infrastructure
                                      :VersionedProduct
                                    )
                      ] ;
           <http://www.w3.org/2004/02/skos/core#definition> "Relates a Control or DetectionRule to the systems or assets it applies to."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "appliesTo"@en .


###  https://cyberterrain.org/ns/stonework#assertionObject
:assertionObject rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :QualifiedAssertion ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Identifies the resource in the object or target position of a qualified assertion."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "assertion object"@en ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Range is intentionally unset because framework relationships may target either a CyberEntity, a CyberActivity, or another externally defined resource."@en .


###  https://cyberterrain.org/ns/stonework#assertionSubject
:assertionSubject rdf:type owl:ObjectProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :QualifiedAssertion ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Identifies the resource in the subject or source position of a qualified assertion."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "assertion subject"@en ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "Range is intentionally unset because framework relationships may originate from either a CyberEntity, a CyberActivity, or another externally defined resource."@en .


###  https://cyberterrain.org/ns/stonework#assessmentOf
:assessmentOf rdf:type owl:ObjectProperty ;
              rdfs:domain :Assessment ;
              <http://www.w3.org/2004/02/skos/core#definition> "Relates an Assessment to the entity being assessed."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "assessmentOf"@en ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "Scheme-specific linking properties, such as stonework:cvssMetricFor, are declared rdfs:subPropertyOf this property, so a query over assessmentOf reaches every Assessment subclass regardless of scheme."@en .


###  https://cyberterrain.org/ns/stonework#assignedBy
:assignedBy rdf:type owl:ObjectProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :Vulnerability ;
            rdfs:range :Agent ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates a vulnerability to the numbering authority that assigned its primary vulnerability identifier."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "assignedBy"@en ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Resolve source-native names, UUIDs, or email addresses to an Agent individual. Like stonework:vulnerabilityId and stonework:dateAssigned, this property describes the vulnerability record's single primary identifier; represent independently assigned identifiers as distinct vulnerability records. The unresolved source string is preserved separately on cve:assigner regardless of whether resolution succeeds."@en .


###  https://cyberterrain.org/ns/stonework#assignedRole
:assignedRole rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :RoleAssignment ;
              rdfs:range :Role ;
              <http://www.w3.org/2004/02/skos/core#definition> "The Role assigned by a qualified RoleAssignment."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "assignedRole"@en .


###  https://cyberterrain.org/ns/stonework#associatedWith
:associatedWith rdf:type owl:ObjectProperty ;
                <http://www.w3.org/2004/02/skos/core#definition> "Generic association between two entities. Use a more specific property where one exists."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "associatedWith" .


###  https://cyberterrain.org/ns/stonework#attributedTo
:attributedTo rdf:type owl:ObjectProperty ;
              <http://www.w3.org/2004/02/skos/core#definition> "Links a CyberActivity to the Agent responsible for, or associated with, performing it." ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "attributedTo" ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain/range intentionally left unset: this property is a direct lift of the STIX 2.1 relationship_type 'attributed-to' shortcut. STIX does not schema-constrain which SDO/SCO types may appear as source_ref/target_ref for a given relationship_type — that's producer convention, not enforceable structure, and a closed domain/range here would misrepresent real STIX 2.1 data and mislead reasoner-based consumers. In practice the object is typically a stonework:Agent — most often a stonework:ThreatActor in the adversarial case, matching STIX's own convention for 'attributed-to' — but stonework:CyberActivity is a general occurrence class covering defensive and neutral activities too (Investigations, a ControlPlan's Process), so the performer need not be adversarial."@en .


###  https://cyberterrain.org/ns/stonework#attributedToAgent
:attributedToAgent rdf:type owl:ObjectProperty ;
                   rdfs:domain :DigitalIdentity ;
                   rdfs:range :Agent ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Links a digital identity to the real-world Agent it is believed to belong to." ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "attributedToAgent" .


###  https://cyberterrain.org/ns/stonework#authoredBy
:authoredBy rdf:type owl:ObjectProperty ;
            rdfs:domain :Provenance ;
            rdfs:range :Agent ;
            <http://www.w3.org/2004/02/skos/core#definition> "The Agent who authored or produced this provenance record, source document, or intelligence artifact."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "authoredBy"@en .


###  https://cyberterrain.org/ns/stonework#beneficiaryAccount
:beneficiaryAccount rdf:type owl:ObjectProperty ;
                    rdfs:domain :FinancialTransaction ;
                    rdfs:range :FinancialAccount ;
                    <http://www.w3.org/2004/02/skos/core#definition> "The account credited by this transaction — the destination of the transferred value."@en ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "beneficiaryAccount"@en .


###  https://cyberterrain.org/ns/stonework#beneficiaryMonetaryValue
:beneficiaryMonetaryValue rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf :hasMonetaryValue ;
                          rdfs:domain :FinancialTransaction ;
                          rdfs:range :MonetaryAmount ;
                          <http://www.w3.org/2004/02/skos/core#definition> "The monetary amount credited to the beneficiary account as this transaction's output."@en ;
                          <http://www.w3.org/2004/02/skos/core#prefLabel> "beneficiaryMonetaryValue"@en ;
                          <http://www.w3.org/2004/02/skos/core#scopeNote> "Use with stonework:originatorMonetaryValue when a transaction changes denomination, as in a currency exchange. Both properties remain queryable through their stonework:hasMonetaryValue superproperty."@en .


###  https://cyberterrain.org/ns/stonework#boundTo
:boundTo rdf:type owl:ObjectProperty ,
                  owl:FunctionalProperty ;
         rdfs:domain :Variable ;
         rdfs:range owl:Thing ;
         <http://www.w3.org/2004/02/skos/core#definition> "Binds a Variable, at execution time, to the individual it actually resolved to — e.g. the specific SecurityCondition instance a successful attempt produced."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "boundTo" ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "Used when the bound value is an instance of a class rather than a scalar; see stonework:boundToLiteral for scalar bindings. Tested by stonework:guardType on a Transition."@en .


###  https://cyberterrain.org/ns/stonework#categorizedBy
:categorizedBy rdf:type owl:ObjectProperty ;
               rdfs:range :Category ;
               <http://www.w3.org/2004/02/skos/core#definition> "Links any individual to one or more contextual categories." ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "categorizedBy" ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "This is the primary mechanism for flexible, context-sensitive classification (e.g., Evidence, HighValue, Suspect, etc.). Multiple categories per individual are allowed."@en .


###  https://cyberterrain.org/ns/stonework#circumvents
:circumvents rdf:type owl:ObjectProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :AITechnique
                                         :AttackPattern
                                       )
                         ] ;
             rdfs:range [ rdf:type owl:Class ;
                          owl:unionOf ( :AnalyticTechnique
                                        :DefendTechnique
                                      )
                        ] ;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates an AITechnique or AttackPattern to an AnalyticTechnique or DefendTechnique that it bypasses or evades."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "circumvents" .


###  https://cyberterrain.org/ns/stonework#clusteredWith
:clusteredWith rdf:type owl:ObjectProperty ;
               <http://www.w3.org/2004/02/skos/core#definition> "Indicates two entities have been analytically grouped together based on shared characteristics or behaviour, without implying a stronger semantic relationship."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "clusteredWith" .


###  https://cyberterrain.org/ns/stonework#collects
:collects rdf:type owl:ObjectProperty ;
          rdfs:domain :Investigation ;
          rdfs:range :DigitalArtifact ;
          <http://www.w3.org/2004/02/skos/core#definition> "Relates an Investigation to the digital artifacts it collects as evidence."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "collects"@en .


###  https://cyberterrain.org/ns/stonework#communicatesWith
:communicatesWith rdf:type owl:ObjectProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( :MalwareSample
                                              :Tool
                                            )
                              ] ;
                  rdfs:range [ rdf:type owl:Class ;
                               owl:unionOf ( :Infrastructure
                                             :URI
                                           )
                             ] ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Relates a MalwareSample or Tool to Infrastructure or a URI with which it exchanges command-and-control or exfiltration traffic. Distinct from stonework:deliveredVia, which covers initial delivery."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "communicatesWith" .


###  https://cyberterrain.org/ns/stonework#compromisedIn
:compromisedIn rdf:type owl:ObjectProperty ;
               rdfs:domain :Agent ;
               rdfs:range :Incident ;
               <http://www.w3.org/2004/02/skos/core#definition> "The Incident during which this Agent (user, system, or organization) was compromised."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "compromisedIn" .


###  https://cyberterrain.org/ns/stonework#conductedBy
:conductedBy rdf:type owl:ObjectProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :Campaign
                                         :Operation
                                       )
                         ] ;
             rdfs:range :Agent ;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a Campaign or Operation to an Agent that conducts it."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "conductedBy"@en .


###  https://cyberterrain.org/ns/stonework#consistsOf
:consistsOf rdf:type owl:ObjectProperty ;
            <http://www.w3.org/2004/02/skos/core#definition> "Generic composition relationship. Use stonework:consistsOfCampaign or a more specific property where possible."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "consistsOf" .


###  https://cyberterrain.org/ns/stonework#consistsOfCampaign
:consistsOfCampaign rdf:type owl:ObjectProperty ;
                    rdfs:domain :Operation ;
                    rdfs:range :Campaign ;
                    <http://www.w3.org/2004/02/skos/core#definition> "Relates an Operation to the Campaigns that compose it."@en ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "consistsOfCampaign"@en .


###  https://cyberterrain.org/ns/stonework#containedIn
:containedIn rdf:type owl:ObjectProperty ;
             owl:inverseOf :containsFile ;
             rdfs:domain :File ;
             rdfs:range :Directory ;
             <http://www.w3.org/2004/02/skos/core#definition> "A File resides in this Directory. Inverse of stonework:containsFile; enables upward traversal of the file system tree."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "containedIn"@en .


###  https://cyberterrain.org/ns/stonework#contains
:contains rdf:type owl:ObjectProperty ,
                   owl:TransitiveProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :AutonomousSystem
                                      :IPBlock
                                    )
                      ] ;
          rdfs:range [ rdf:type owl:Class ;
                       owl:unionOf ( :IPAddress
                                     :IPBlock
                                   )
                     ] ;
          <http://www.w3.org/2004/02/skos/core#definition> "Relates an AutonomousSystem or IPBlock to an IPAddress or more-specific IPBlock contained within its routed address space."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "contains" .


###  https://cyberterrain.org/ns/stonework#containsDirectory
:containsDirectory rdf:type owl:ObjectProperty ;
                   rdfs:domain :Directory ;
                   rdfs:range :Directory ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Relates a Directory to subdirectories it contains."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "containsDirectory"@en .


###  https://cyberterrain.org/ns/stonework#containsFile
:containsFile rdf:type owl:ObjectProperty ;
              rdfs:domain :Directory ;
              rdfs:range :File ;
              <http://www.w3.org/2004/02/skos/core#definition> "Relates a Directory to the Files it contains."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "containsFile"@en .


###  https://cyberterrain.org/ns/stonework#containsLocation
:containsLocation rdf:type owl:ObjectProperty ;
                  owl:inverseOf :locatedWithin ;
                  rdf:type owl:TransitiveProperty ;
                  rdfs:domain :Location ;
                  rdfs:range :Location ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Relates a Location to a narrower Location that lies within it, e.g. a Country to one of its Regions or Cities."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "containsLocation"@en ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "Inverse of stonework:locatedWithin; enables downward traversal of the geographic hierarchy."@en .


###  https://cyberterrain.org/ns/stonework#controls
:controls rdf:type owl:ObjectProperty ;
          rdfs:domain :UserAccount ;
          rdfs:range :FinancialAccount ;
          <http://www.w3.org/2004/02/skos/core#definition> "A stonework:FinancialAccount that this stonework:UserAccount, a login or credential, can operate."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "controls"@en ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "Distinct from stonework:accountOf, which records the holder or beneficial owner. One login often controls several financial accounts; a financial account seen in isolation, such as an IBAN in wire data, may have no associated login. An account-takeover attacker holding a victim's UserAccount controls the victim's FinancialAccount without being its accountOf."@en .


###  https://cyberterrain.org/ns/stonework#correspondsToStep
:correspondsToStep rdf:type owl:ObjectProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :CyberActivity ;
                   rdfs:range :Step ;
                   rdfs:seeAlso <http://purl.org/net/p-plan#correspondsToStep> ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Links an executing CyberActivity to the Step it is the concrete performance of."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "correspondsToStep" ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Directly mirrors p-plan:correspondsToStep (domain prov:Activity, range p-plan:Step), narrowed to stonework:CyberActivity/stonework:Step. Declared functional, matching p-plan: a single CyberActivity corresponds to at most one Step, but a Step may still be the target of many CyberActivity instances across retries or repeated executions. Fills the gap noted on stonework:Step: the property linking an executing Activity back to the Step it realizes."@en .


###  https://cyberterrain.org/ns/stonework#counters
:counters rdf:type owl:ObjectProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :AnalyticTechnique
                                      :DefendTechnique
                                    )
                      ] ;
          rdfs:range [ rdf:type owl:Class ;
                       owl:unionOf ( :AITechnique
                                     :AttackTechnique
                                   )
                     ] ;
          <http://www.w3.org/2004/02/skos/core#definition> "Relates an AnalyticTechnique or DefendTechnique to an AITechnique or AttackTechnique it detects, neutralizes, or mitigates."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "counters" .


###  https://cyberterrain.org/ns/stonework#covers
:covers rdf:type owl:ObjectProperty ;
        rdfs:domain [ rdf:type owl:Class ;
                      owl:unionOf ( :Assessment
                                    :Report
                                  )
                    ] ;
        <http://www.w3.org/2004/02/skos/core#definition> "Relates a Report or Assessment to the entities it describes."@en ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "covers"@en .


###  https://cyberterrain.org/ns/stonework#createdBy
:createdBy rdf:type owl:ObjectProperty ;
           rdfs:domain :IntelligenceProduct ;
           rdfs:range :Agent ;
           <http://www.w3.org/2004/02/skos/core#definition> "Relates an Intelligence Product to the Agent that created it."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "createdBy"@en .


###  https://cyberterrain.org/ns/stonework#createsMutex
:createsMutex rdf:type owl:ObjectProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :MalwareSample
                                          :RuntimeProcess
                                        )
                          ] ;
              rdfs:range :Mutex ;
              <http://www.w3.org/2004/02/skos/core#definition> "Relates a RuntimeProcess or MalwareSample to a Mutex it creates."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "createsMutex"@en .


###  https://cyberterrain.org/ns/stonework#currency
:currency rdf:type owl:ObjectProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :MonetaryAmount ;
          rdfs:range :Currency ;
          <http://www.w3.org/2004/02/skos/core#definition> "The currency that denominates a stonework:MonetaryAmount."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "currency"@en .


###  https://cyberterrain.org/ns/stonework#cvssMetricFor
:cvssMetricFor rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :assessmentOf ;
               rdf:type owl:FunctionalProperty ;
               rdfs:domain :CvssMetric ;
               rdfs:range :Vulnerability ;
               <http://www.w3.org/2004/02/skos/core#definition> "The vulnerability evaluated by a structured CVSS assessment."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "cvssMetricFor"@en ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "Declared rdfs:subPropertyOf stonework:assessmentOf so a query over assessmentOf returns every Assessment of a Vulnerability — CVSS metrics included — without needing to know each scheme's specific property name."@en .


###  https://cyberterrain.org/ns/stonework#deliveredVia
:deliveredVia rdf:type owl:ObjectProperty ;
              rdfs:domain :MalwareSample ;
              rdfs:range :Infrastructure ;
              <http://www.w3.org/2004/02/skos/core#definition> "Initial delivery Infrastructure for this MalwareSample. Semantically distinct from stonework:communicatesWith, which models C2 channels post-infection."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "deliveredVia"@en .


###  https://cyberterrain.org/ns/stonework#dependencyOf
:dependencyOf rdf:type owl:ObjectProperty ,
                       owl:TransitiveProperty ;
              rdfs:domain :VersionedProduct ;
              rdfs:range :VersionedProduct ;
              <http://www.w3.org/2004/02/skos/core#definition> "Relates a product to another product that depends on it. Transitive to support supply chain reasoning across deep dependency trees."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "dependencyOf"@en .


###  https://cyberterrain.org/ns/stonework#derivedFrom
:derivedFrom rdf:type owl:ObjectProperty ;
             rdfs:domain :DetectionRule ;
             rdfs:range [ rdf:type owl:Class ;
                          owl:unionOf ( :CyberActivity
                                        :DigitalArtifact
                                        :Infrastructure
                                      )
                        ] ;
             <http://www.w3.org/2004/02/skos/core#definition> "The observed CyberActivity, data source, or artifact from which this DetectionRule was written or derived."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "derivedFrom" .


###  https://cyberterrain.org/ns/stonework#describesInfrastructure
:describesInfrastructure rdf:type owl:ObjectProperty ;
                         rdfs:range :Infrastructure ;
                         <http://www.w3.org/2004/02/skos/core#definition> "Links a Software Bill of Materials to the enterprise infrastructure, system, or application whose component composition it inventories." ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "describes infrastructure" ;
                         <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain intentionally left unset. The primary subject is stonework:SoftwareBillOfMaterials, but other provenance-bearing artifacts may describe infrastructure without being SBOMs. Multiple SBOMs may describe the same Infrastructure over time, enabling historical component inventory."@en .


###  https://cyberterrain.org/ns/stonework#detectedBy
:detectedBy rdf:type owl:ObjectProperty ;
            rdfs:domain :Event ;
            rdfs:range [ rdf:type owl:Class ;
                         owl:unionOf ( :DetectionRule
                                       :Sensor
                                     )
                       ] ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates an Event to the Sensor or DetectionRule that identified it."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "detectedBy"@en .


###  https://cyberterrain.org/ns/stonework#detects
:detects rdf:type owl:ObjectProperty ;
         <http://www.w3.org/2004/02/skos/core#definition> "Relates a source DetectionRule, Sensor, Indicator, or defensive technique to the threat, activity, or artifact it is capable of detecting. Corresponds to STIX relationship_type 'detects'."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "detects" ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain/range intentionally left unset: this property is a direct lift of the STIX 2.1 relationship_type 'detects' shortcut. STIX does not schema-constrain which SDO/SCO types may appear as source_ref/target_ref for a given relationship_type — that's producer convention, not enforceable structure, and a closed domain/range here would misrepresent real STIX 2.1 data and mislead reasoner-based consumers."@en .


###  https://cyberterrain.org/ns/stonework#downloads
:downloads rdf:type owl:ObjectProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :File
                                       :MalwareSample
                                       :Tool
                                     )
                       ] ;
           rdfs:range [ rdf:type owl:Class ;
                        owl:unionOf ( :File
                                      :MalwareSample
                                      :Tool
                                    )
                      ] ;
           <http://www.w3.org/2004/02/skos/core#definition> "Relates a File, MalwareSample, or Tool to another File, MalwareSample, or Tool it retrieves during execution."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "downloads" .


###  https://cyberterrain.org/ns/stonework#drops
:drops rdf:type owl:ObjectProperty ;
       rdfs:domain :MalwareSample ;
       rdfs:range :DigitalArtifact ;
       <http://www.w3.org/2004/02/skos/core#definition> "A DigitalArtifact written to the filesystem or memory by this MalwareSample during execution."@en ;
       <http://www.w3.org/2004/02/skos/core#prefLabel> "drops" .


###  https://cyberterrain.org/ns/stonework#emailOf
:emailOf rdf:type owl:ObjectProperty ;
         owl:inverseOf :hasEmail ;
         rdfs:domain :EmailAddress ;
         rdfs:range :Agent ;
         <http://www.w3.org/2004/02/skos/core#definition> "The Agent that owns or is associated with this EmailAddress. Inverse of stonework:hasEmail."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "emailOf" .


###  https://cyberterrain.org/ns/stonework#employs
:employs rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf :uses ;
         rdfs:domain :ThreatActor ;
         rdfs:range [ rdf:type owl:Class ;
                      owl:unionOf ( :AttackPattern
                                    :Malware
                                    :Technique
                                    :Tool
                                  )
                    ] ;
         <http://www.w3.org/2004/02/skos/core#definition> "Relates a ThreatActor to an AttackPattern, Malware, Technique, or Tool it deliberately puts into operational use."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "employs"@en ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "Use for curated ThreatActor relationships where deliberate operational use is intended. As a subproperty of the open STIX-compatible stonework:uses relationship, employs assertions remain available to queries over the broader interoperability predicate."@en .


###  https://cyberterrain.org/ns/stonework#evidencedBy
:evidencedBy rdf:type owl:ObjectProperty ;
             rdfs:domain :Sighting ;
             rdfs:range :DigitalArtifact ;
             <http://www.w3.org/2004/02/skos/core#definition> "A Sighting is substantiated by this DigitalArtifact (memory dump, PCAP, log excerpt, sample). Connects analytical observation to forensic evidence."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "evidencedBy"@en .


###  https://cyberterrain.org/ns/stonework#executedOn
:executedOn rdf:type owl:ObjectProperty ;
            owl:inverseOf :runs ;
            rdfs:domain :RuntimeProcess ;
            rdfs:range :Host ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates a RuntimeProcess to the Host it ran on."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "executedOn"@en .


###  https://cyberterrain.org/ns/stonework#executionOf
:executionOf rdf:type owl:ObjectProperty ;
             owl:inverseOf :hasExecution ;
             rdfs:domain :CyberActivity ;
             rdfs:range :Behavior ;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a CyberActivity to the Behavior plan whose execution it represents."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "executionOf"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Links an overall execution to the Behavior it carries out. This may be a full plan — an Investigation to an InvestigationPlan, an Operation to an OperationPlan, a Process to a Playbook or ControlPlan — or, in the lightweight case, a bare method: a CyberActivity may point directly at the stonework:Technique (or stonework:AttackTechnique) it performs, with no intervening Procedure, Plan, or Step. The lightweight form is the common one for sightings and incident timelines ('actor performed T1003.001 against this host at this time'); it can be elaborated into a Step-decomposed Plan later without changing the executionOf assertion. Use stonework:correspondsToStep for the finer-grained link between an executing CyberActivity and an individual Step when a Plan is present."@en .


###  https://cyberterrain.org/ns/stonework#exploits
:exploits rdf:type owl:ObjectProperty ;
          <http://www.w3.org/2004/02/skos/core#definition> "Shortcut triple: source Malware or ThreatActor exploits target Vulnerability. Corresponds to STIX relationship_type 'exploits'." ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "exploits" ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain/range intentionally left unset: this property is a direct lift of the STIX 2.1 relationship_type 'exploits' shortcut. STIX does not schema-constrain which SDO/SCO types may appear as source_ref/target_ref for a given relationship_type — that's producer convention, not enforceable structure, and a closed domain/range here would misrepresent real STIX 2.1 data and mislead reasoner-based consumers."@en .


###  https://cyberterrain.org/ns/stonework#exploitsWeakness
:exploitsWeakness rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :hasWeakness ;
                  rdfs:domain :Vulnerability ;
                  rdfs:range :Weakness ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Relates a vulnerability to the weakness class it instantiates or exploits. Subproperty of stonework:hasWeakness, using the directional 'exploits' semantics aligned with CVE and CWE mapping conventions."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "exploitsWeakness"@en ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "The range is a stonework:Weakness individual whose IRI is derived from the CWE identifier. Used by cve:exploitsWeakness (rdfs:subPropertyOf this property) when CVE data is loaded; query this property directly for cross-source lookups."@en .


###  https://cyberterrain.org/ns/stonework#exposesService
:exposesService rdf:type owl:ObjectProperty ;
                rdfs:domain :Host ;
                rdfs:range :NetworkService ;
                <http://www.w3.org/2004/02/skos/core#definition> "Relates a Host to the NetworkServices it provides."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "exposesService"@en .


###  https://cyberterrain.org/ns/stonework#fixedInProduct
:fixedInProduct rdf:type owl:ObjectProperty ;
                rdfs:domain :Vulnerability ;
                rdfs:range :VersionedProduct ;
                <http://www.w3.org/2004/02/skos/core#definition> "Relates a vulnerability to the product version in which it was addressed."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "fixedInProduct"@en ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "The range is a stonework:VersionedProduct individual whose IRI is derived deterministically from the CPE identifier. Populated by CVE/patch ingest."@en .


###  https://cyberterrain.org/ns/stonework#fromStep
:fromStep rdf:type owl:ObjectProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :Transition ;
          rdfs:range :Step ;
          <http://www.w3.org/2004/02/skos/core#definition> "The Step a Transition leaves."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "fromStep" .


###  https://cyberterrain.org/ns/stonework#fundsActivity
:fundsActivity rdf:type owl:ObjectProperty ;
               rdfs:domain :FinancialTransaction ;
               rdfs:range :CyberActivity ;
               <http://www.w3.org/2004/02/skos/core#definition> "A cyber activity that this transaction finances — for example an infrastructure purchase linked to the campaign or operation it supports."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "fundsActivity"@en ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "This property asserts a financing relationship. For a payment made in response to an activity without financing it, such as a victim's ransom payment made because of an incident, use stonework:respondsToActivity."@en .


###  https://cyberterrain.org/ns/stonework#generatedBy
:generatedBy rdf:type owl:ObjectProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :Log
                                         :NetworkTraffic
                                       )
                         ] ;
             rdfs:range [ rdf:type owl:Class ;
                          owl:unionOf ( :Host
                                        :NetworkService
                                        :Sensor
                                      )
                        ] ;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a Log or NetworkTraffic to the system that produced it."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "generatedBy"@en .


###  https://cyberterrain.org/ns/stonework#generatedFrom
:generatedFrom rdf:type owl:ObjectProperty ;
               rdfs:domain :Event ;
               rdfs:range [ rdf:type owl:Class ;
                            owl:unionOf ( :Log
                                          :NetworkTraffic
                                        )
                          ] ;
               <http://www.w3.org/2004/02/skos/core#definition> "Links an Event to the raw log or network traffic from which it was derived."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "generatedFrom"@en .


###  https://cyberterrain.org/ns/stonework#grantedTo
:grantedTo rdf:type owl:ObjectProperty ;
           rdfs:domain :AccessControlList ;
           rdfs:range [ rdf:type owl:Class ;
                        owl:unionOf ( :UserAccount
                                      :UserGroup
                                    )
                      ] ;
           <http://www.w3.org/2004/02/skos/core#definition> "Relates an AccessControlList to a UserAccount or UserGroup whose permissions it records."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "grantedTo"@en .


###  https://cyberterrain.org/ns/stonework#guardOperator
:guardOperator rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Transition ;
               rdfs:range :ComparisonOperator ;
               <http://www.w3.org/2004/02/skos/core#definition> "The comparison operator applied between guardVariable's bound literal value and guardLiteralValue."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "guardOperator" ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "Omitted = Equals, preserving equality-only guard semantics without requiring this property on every Transition."@en .


###  https://cyberterrain.org/ns/stonework#guardType
:guardType rdf:type owl:ObjectProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :Transition ;
           rdfs:range rdfs:Class ;
           <http://www.w3.org/2004/02/skos/core#definition> "A Transition fires only if guardVariable's stonework:boundTo value is an instance of this class."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "guardType" ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Used for guards that test whether a Variable was bound to an instance of a particular class (e.g. testing that an attempt's outcome Variable was bound to a stonework:SecurityCondition instance) rather than testing equality against a scalar."@en .


###  https://cyberterrain.org/ns/stonework#guardVariable
:guardVariable rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Transition ;
               rdfs:range :Variable ;
               <http://www.w3.org/2004/02/skos/core#definition> "The Variable whose bound value is tested to decide whether a Transition is taken."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "guardVariable" .


###  https://cyberterrain.org/ns/stonework#hasAccount
:hasAccount rdf:type owl:ObjectProperty ;
            owl:inverseOf :accountOf ;
            rdfs:domain :Agent ;
            rdfs:range :Account ;
            <http://www.w3.org/2004/02/skos/core#definition> "An Account (user account or financial account) held by, or beneficially attributed to, this Agent."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "hasAccount"@en .


###  https://cyberterrain.org/ns/stonework#hasAccountType
:hasAccountType rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :categorizedBy ;
                rdfs:domain :UserAccount ;
                rdfs:range :AccountType ;
                <http://www.w3.org/2004/02/skos/core#definition> "Relates a user account to one or more classifications describing its authentication or deployment context."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "hasAccountType"@en .


###  https://cyberterrain.org/ns/stonework#hasArtifact
:hasArtifact rdf:type owl:ObjectProperty ;
             rdfs:domain :MalwareSample ;
             rdfs:range :DigitalArtifact ;
             <http://www.w3.org/2004/02/skos/core#definition> "Links a MalwareSample to a captured binary artifact (file, memory dump, or encoded payload) constituting the physical evidence of the sample."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "hasArtifact"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Optional — a MalwareSample may be known via hashes or threat reports without the binary being available. When present, the artifact provides retrievable binary evidence. Corresponds to the STIX 2.1 sample_refs property on the malware SDO."@en .


###  https://cyberterrain.org/ns/stonework#hasBehavior
:hasBehavior rdf:type owl:ObjectProperty ;
             rdfs:range :Behavior ;
             <http://www.w3.org/2004/02/skos/core#definition> "Associates a MalwareSample, AttackPattern, ThreatActor, or Campaign with an observed Behavior. Enables behavioral clustering and similarity reasoning."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "hasBehavior"@en .


###  https://cyberterrain.org/ns/stonework#hasBomEntry
:hasBomEntry rdf:type owl:ObjectProperty ;
             rdfs:domain :SoftwareBillOfMaterials ;
             rdfs:range :BomEntry ;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a Software Bill of Materials to one of its component entries."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "has BOM entry" ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Each BomEntry carries the component's VersionedProduct reference (via stonework:installationOf) and any component-specific metadata (PURL, license, hash, component type). Range is BomEntry rather than VersionedProduct directly because the same VersionedProduct may appear in multiple SBOMs with different component-level attributes."@en .


###  https://cyberterrain.org/ns/stonework#hasCvssMetric
:hasCvssMetric rdf:type owl:ObjectProperty ;
               owl:inverseOf :cvssMetricFor ;
               rdfs:domain :Vulnerability ;
               rdfs:range :CvssMetric ;
               <http://www.w3.org/2004/02/skos/core#definition> "Relates a vulnerability to a structured CVSS metric record carrying the version, vector string, and base/temporal/environmental scores."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "hasCvssMetric"@en ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "A single vulnerability may carry metrics for multiple CVSS versions (2.0, 3.1, 4.0) or scoring authorities. For a single headline score and severity, use stonework:cvssBaseScore and stonework:cvssSeverity directly on the Vulnerability. Core consumers can represent the common structured fields without an adapter; load the CVSS framework module for decomposed vector components and additional subscores."@en .


###  https://cyberterrain.org/ns/stonework#hasDependency
:hasDependency rdf:type owl:ObjectProperty ;
               owl:inverseOf :dependencyOf ;
               rdfs:domain :VersionedProduct ;
               rdfs:range :VersionedProduct ;
               <http://www.w3.org/2004/02/skos/core#definition> "Relates a product version to another product version it depends on."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "hasDependency"@en .


###  https://cyberterrain.org/ns/stonework#hasDestinationAddress
:hasDestinationAddress rdf:type owl:ObjectProperty ;
                       rdfs:domain :NetworkTraffic ;
                       rdfs:range :IPAddress ;
                       <http://www.w3.org/2004/02/skos/core#definition> "Relates NetworkTraffic to the destination IP address."@en ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "hasDestinationAddress"@en .


###  https://cyberterrain.org/ns/stonework#hasEmail
:hasEmail rdf:type owl:ObjectProperty ;
          rdfs:domain :Agent ;
          rdfs:range :EmailAddress ;
          <http://www.w3.org/2004/02/skos/core#definition> "An EmailAddress associated with this Agent."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "hasEmail" .


###  https://cyberterrain.org/ns/stonework#hasEvent
:hasEvent rdf:type owl:ObjectProperty ;
          rdfs:domain :Incident ;
          rdfs:range :Event ;
          <http://www.w3.org/2004/02/skos/core#definition> "Relates an Incident to an Event that forms part of its recorded activity."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "hasEvent"@en .


###  https://cyberterrain.org/ns/stonework#hasExecution
:hasExecution rdf:type owl:ObjectProperty ;
              rdfs:domain :Behavior ;
              rdfs:range :CyberActivity ;
              <http://www.w3.org/2004/02/skos/core#definition> "Relates a Behavior plan to a CyberActivity that executes it."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "hasExecution"@en .


###  https://cyberterrain.org/ns/stonework#hasFalsePositiveRate
:hasFalsePositiveRate rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :categorizedBy ;
                      rdfs:domain :DetectionRule ;
                      rdfs:range :FalsePositiveRate ;
                      <http://www.w3.org/2004/02/skos/core#definition> "Relates a detection rule to an ordinal assessment of its expected false-positive frequency."@en ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "hasFalsePositiveRate"@en .


###  https://cyberterrain.org/ns/stonework#hasHash
:hasHash rdf:type owl:ObjectProperty ;
         rdfs:range :Hash ;
         <http://www.w3.org/2004/02/skos/core#definition> "Relates an entity to its hash entries. The range is a stonework:Hash individual representing a single hash algorithm and digest value." ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "hasHash" .


###  https://cyberterrain.org/ns/stonework#hasHypothesisStatus
:hasHypothesisStatus rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :categorizedBy ;
                     rdfs:domain :Hypothesis ;
                     rdfs:range :HypothesisStatus ;
                     <http://www.w3.org/2004/02/skos/core#definition> "Relates a Hypothesis to its current status in the confirm/refute lifecycle."@en ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "hasHypothesisStatus"@en ;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "Kept explicit (rather than inferred from which Transition fired) so a Hypothesis's status is directly queryable without replaying the Step graph it was tested in."@en .


###  https://cyberterrain.org/ns/stonework#hasIPBlock
:hasIPBlock rdf:type owl:ObjectProperty ;
            rdfs:domain :AutonomousSystem ;
            rdfs:range :IPBlock ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates an AutonomousSystem to an IPBlock it originates or announces."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "hasIPBlock"@en .


###  https://cyberterrain.org/ns/stonework#hasIdentifier
:hasIdentifier rdf:type owl:ObjectProperty ;
               rdfs:domain :DigitalIdentity ;
               rdfs:range :Identifier ;
               <http://www.w3.org/2004/02/skos/core#definition> "Links a Digital Identity to one or more atomic Identifiers that belong to it." ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "hasIdentifier" .


###  https://cyberterrain.org/ns/stonework#hasImpact
:hasImpact rdf:type owl:ObjectProperty ;
           rdfs:domain :Risk ;
           rdfs:range :Impact ;
           <http://www.w3.org/2004/02/skos/core#definition> "Relates a Risk to its associated Impact component."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "hasImpact"@en .


###  https://cyberterrain.org/ns/stonework#hasImpactLevel
:hasImpactLevel rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :categorizedBy ;
                rdfs:domain :Impact ;
                rdfs:range :ImpactLevel ;
                <http://www.w3.org/2004/02/skos/core#definition> "Relates an impact assessment to its qualitative magnitude."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "hasImpactLevel"@en .


###  https://cyberterrain.org/ns/stonework#hasImpactType
:hasImpactType rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :categorizedBy ;
               rdfs:domain :Impact ;
               rdfs:range :ImpactType ;
               <http://www.w3.org/2004/02/skos/core#definition> "Relates an impact assessment to one or more affected security dimensions or consequence types."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "hasImpactType"@en .


###  https://cyberterrain.org/ns/stonework#hasIncidentStatus
:hasIncidentStatus rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :categorizedBy ;
                   rdfs:domain :Incident ;
                   rdfs:range :IncidentStatus ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Relates an incident to its current response-lifecycle status."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "hasIncidentStatus"@en .


###  https://cyberterrain.org/ns/stonework#hasInfrastructureType
:hasInfrastructureType rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf :categorizedBy ;
                       rdfs:domain :Infrastructure ;
                       rdfs:range :InfrastructureType ;
                       <http://www.w3.org/2004/02/skos/core#definition> "Relates an infrastructure individual to one or more classifications describing its operational role or purpose."@en ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "hasInfrastructureType"@en ;
                       <http://www.w3.org/2004/02/skos/core#scopeNote> "A piece of infrastructure may serve multiple roles (e.g. both C2 and staging). Aligns with the STIX 2.1 infrastructure-type open vocabulary."@en .


###  https://cyberterrain.org/ns/stonework#hasInput
:hasInput rdf:type owl:ObjectProperty ;
          rdfs:domain :Process ;
          <http://www.w3.org/2004/02/skos/core#definition> "Relates a Process to its input data or artifacts."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "hasInput"@en .


###  https://cyberterrain.org/ns/stonework#hasInputVariable
:hasInputVariable rdf:type owl:ObjectProperty ;
                  rdfs:domain :Behavior ;
                  rdfs:range :Variable ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Declares a Variable whose value must be bound before the Behavior or Step executes."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "hasInputVariable" .


###  https://cyberterrain.org/ns/stonework#hasInstalledProduct
:hasInstalledProduct rdf:type owl:ObjectProperty ;
                     rdfs:domain :Infrastructure ;
                     rdfs:range :VersionedProduct ;
                     <http://www.w3.org/2004/02/skos/core#definition> "Links an enterprise infrastructure to a versioned product known to be installed in that environment." ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "has installed product" ;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "Used in the user-data graph to assert enterprise inventory directly. Combined with stonework:versionOf and stonework:affected, enables traversal from installed software to applicable CVEs. For SBOM-based ingest with full component provenance, see stonework:SoftwareBillOfMaterials and stonework:hasBomEntry."@en .


###  https://cyberterrain.org/ns/stonework#hasLikelihood
:hasLikelihood rdf:type owl:ObjectProperty ;
               rdfs:domain :Risk ;
               rdfs:range :Likelihood ;
               <http://www.w3.org/2004/02/skos/core#definition> "Relates a Risk to its associated Likelihood component."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "hasLikelihood"@en .


###  https://cyberterrain.org/ns/stonework#hasLikelihoodLevel
:hasLikelihoodLevel rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :categorizedBy ;
                    rdfs:domain :Likelihood ;
                    rdfs:range :LikelihoodLevel ;
                    <http://www.w3.org/2004/02/skos/core#definition> "Relates a likelihood assessment to its qualitative ordinal level."@en ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "hasLikelihoodLevel"@en .


###  https://cyberterrain.org/ns/stonework#hasMalwareType
:hasMalwareType rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :categorizedBy ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :MalwareFamily
                                            :MalwareSample
                                          )
                            ] ;
                rdfs:range :MalwareType ;
                <http://www.w3.org/2004/02/skos/core#definition> "Relates a malware sample or family to one or more functional type classifications."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "hasMalwareType"@en ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "A malware sample may have multiple types (e.g. a trojan that also acts as a downloader). Aligns with the STIX 2.1 malware-type open vocabulary."@en .


###  https://cyberterrain.org/ns/stonework#hasMember
:hasMember rdf:type owl:ObjectProperty ;
           owl:inverseOf :memberOf ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :Group
                                       :Organization
                                       :ThreatActor
                                     )
                       ] ;
           <http://www.w3.org/2004/02/skos/core#definition> "Relates a Group, Organization, or ThreatActor to one of its members. Multiple members are represented by multiple triples."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "hasMember"@en .


###  https://cyberterrain.org/ns/stonework#hasMemberActivity
:hasMemberActivity rdf:type owl:ObjectProperty ;
                   owl:inverseOf :memberOfActivityCluster ;
                   rdfs:domain :CyberActivityCluster ;
                   rdfs:range :CyberActivity ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Relates a CyberActivityCluster to a CyberActivity analytically grouped within it."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "hasMemberActivity"@en .


###  https://cyberterrain.org/ns/stonework#hasMetricObservation
:hasMetricObservation rdf:type owl:ObjectProperty ;
                      owl:inverseOf :metricFor ;
                      rdfs:domain :CyberEntity ;
                      rdfs:range :MetricObservation ;
                      <http://www.w3.org/2004/02/skos/core#definition> "Relates an entity to a source- and time-qualified metric observation about it."@en ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "hasMetricObservation"@en .


###  https://cyberterrain.org/ns/stonework#hasMonetaryValue
:hasMonetaryValue rdf:type owl:ObjectProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( :FinancialAccount
                                              :FinancialTransaction
                                              :Impact
                                            )
                              ] ;
                  rdfs:range :MonetaryAmount ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Relates a transaction, account, or impact to a stonework:MonetaryAmount stating a sum of money and its currency."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "hasMonetaryValue"@en .


###  https://cyberterrain.org/ns/stonework#hasMotivation
:hasMotivation rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :categorizedBy ;
               rdfs:domain :ThreatActor ;
               rdfs:range :Motivation ;
               <http://www.w3.org/2004/02/skos/core#definition> "Relates a threat actor to one or more motivations that drive their actions and operations."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "hasMotivation"@en ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "A threat actor may have multiple motivations. Corresponds to the STIX 2.1 primary_motivation and secondary_motivations properties on ThreatActor."@en .


###  https://cyberterrain.org/ns/stonework#hasNetworkAddress
:hasNetworkAddress rdf:type owl:ObjectProperty ;
                   owl:inverseOf :addressOf ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :Host
                                               :NetworkService
                                             )
                               ] ;
                   rdfs:range :IPAddress ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Relates a Host or NetworkService to an IPAddress assigned to or used by it."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "hasNetworkAddress"@en .


###  https://cyberterrain.org/ns/stonework#hasObservable
:hasObservable rdf:type owl:ObjectProperty ;
               rdfs:domain :SecurityObservation ;
               rdfs:range :CyberEntity ;
               rdfs:seeAlso <https://www.w3.org/TR/vocab-ssn/#SOSAhasResult> ;
               <http://www.w3.org/2004/02/skos/core#definition> "Links a SecurityObservation to the cyber observable objects (SCOs) captured during the observation window."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "hasObservable"@en ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "The range covers any SCO type: stonework:IPAddress, stonework:Domain, stonework:File, stonework:NetworkTraffic, stonework:RuntimeProcess, stonework:UserAccount, etc. Corresponds to STIX observed-data object_refs. Inspired by SOSA sosa:hasResult."@en .


###  https://cyberterrain.org/ns/stonework#hasOnlineReference
:hasOnlineReference rdf:type owl:ObjectProperty ;
                    rdfs:range :OnlineReference ;
                    <http://www.w3.org/2004/02/skos/core#definition> "Associates any object with an OnlineReference (blog post, advisory URL, disclosure, vendor bulletin). Primary arc into the OnlineReference class."@en ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "hasOnlineReference"@en .


###  https://cyberterrain.org/ns/stonework#hasOutput
:hasOutput rdf:type owl:ObjectProperty ;
           rdfs:domain :Process ;
           <http://www.w3.org/2004/02/skos/core#definition> "Relates a Process to the data or artifacts it produces."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "hasOutput"@en .


###  https://cyberterrain.org/ns/stonework#hasOutputVariable
:hasOutputVariable rdf:type owl:ObjectProperty ;
                   rdfs:domain :Behavior ;
                   rdfs:range :Variable ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Declares a Variable whose value is bound only once the Behavior or Step has executed."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "hasOutputVariable" .


###  https://cyberterrain.org/ns/stonework#hasParentProcess
:hasParentProcess rdf:type owl:ObjectProperty ;
                  rdfs:domain :RuntimeProcess ;
                  rdfs:range :RuntimeProcess ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Relates a RuntimeProcess to the parent process that spawned it."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "hasParentProcess"@en .


###  https://cyberterrain.org/ns/stonework#hasPhoneNumber
:hasPhoneNumber rdf:type owl:ObjectProperty ;
                owl:inverseOf :phoneNumberOf ;
                rdfs:domain :Agent ;
                rdfs:range :PhoneNumber ;
                <http://www.w3.org/2004/02/skos/core#definition> "A PhoneNumber associated with this Agent."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "hasPhoneNumber"@en .


###  https://cyberterrain.org/ns/stonework#hasProductInstallation
:hasProductInstallation rdf:type owl:ObjectProperty ;
                        rdfs:domain :Infrastructure ;
                        rdfs:range :ProductInstallation ;
                        <http://www.w3.org/2004/02/skos/core#definition> "Relates an Infrastructure entity to a contextual record of a product installed on it."@en ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "hasProductInstallation"@en ;
                        <http://www.w3.org/2004/02/skos/core#scopeNote> "Use stonework:hasInstalledProduct for a direct Infrastructure-to-VersionedProduct inventory assertion. Use this property with stonework:installationOf when installation-specific identity, path, licensee, or configuration details must be preserved."@en .


###  https://cyberterrain.org/ns/stonework#hasProductType
:hasProductType rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :categorizedBy ;
                rdfs:domain :Product ;
                rdfs:range :ProductType ;
                <http://www.w3.org/2004/02/skos/core#definition> "Relates a product family to one or more product type classifications describing its functional category."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "hasProductType"@en ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "A product may have multiple types. Corresponds to the CPE component type field (a, o, h) but extends it with finer-grained vocabulary."@en .


###  https://cyberterrain.org/ns/stonework#hasProvenance
:hasProvenance rdf:type owl:ObjectProperty ;
               owl:inverseOf :provenanceOf ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( :IntelligenceProduct
                                           :QualifiedAssertion
                                         )
                           ] ;
               rdfs:range :Provenance ;
               <http://www.w3.org/2004/02/skos/core#definition> "Relates an IntelligenceProduct or QualifiedAssertion to a Provenance record documenting its origin or evidentiary basis."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "hasProvenance"@en .


###  https://cyberterrain.org/ns/stonework#hasResourceLevel
:hasResourceLevel rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :categorizedBy ;
                  rdfs:domain :ThreatActor ;
                  rdfs:range :ResourceLevel ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Relates a threat actor to an assessment of the organizational resources available to it."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "hasResourceLevel"@en .


###  https://cyberterrain.org/ns/stonework#hasRisk
:hasRisk rdf:type owl:ObjectProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :DataAsset
                                     :Infrastructure
                                     :Organization
                                   )
                     ] ;
         rdfs:range :Risk ;
         <http://www.w3.org/2004/02/skos/core#definition> "Relates an asset or organization to an assessed Risk."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "hasRisk"@en .


###  https://cyberterrain.org/ns/stonework#hasRiskLevel
:hasRiskLevel rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :categorizedBy ;
              rdfs:domain :Risk ;
              rdfs:range :RiskLevel ;
              <http://www.w3.org/2004/02/skos/core#definition> "Relates a risk assessment to its qualitative ordinal level."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "hasRiskLevel"@en .


###  https://cyberterrain.org/ns/stonework#hasRoleAssignment
:hasRoleAssignment rdf:type owl:ObjectProperty ;
                   rdfs:domain :CyberEntity ;
                   rdfs:range :RoleAssignment ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Relates an entity to a qualified assignment of a Role in a specific context."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "hasRoleAssignment"@en .


###  https://cyberterrain.org/ns/stonework#hasSignature
:hasSignature rdf:type owl:ObjectProperty ;
              rdfs:range :Signature ;
              <http://www.w3.org/2004/02/skos/core#definition> "Associates a Campaign, ThreatActor, MalwareSample, or Infrastructure with a detection Signature. Primary arc into the Signature class."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "hasSignature"@en .


###  https://cyberterrain.org/ns/stonework#hasSophisticationLevel
:hasSophisticationLevel rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf :categorizedBy ;
                        rdfs:domain :ThreatActor ;
                        rdfs:range :SophisticationLevel ;
                        <http://www.w3.org/2004/02/skos/core#definition> "Relates a threat actor to an assessment of its technical sophistication."@en ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "hasSophisticationLevel"@en .


###  https://cyberterrain.org/ns/stonework#hasSourceAddress
:hasSourceAddress rdf:type owl:ObjectProperty ;
                  rdfs:domain :NetworkTraffic ;
                  rdfs:range :IPAddress ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Relates NetworkTraffic to the source IP address."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "hasSourceAddress"@en .


###  https://cyberterrain.org/ns/stonework#hasStep
:hasStep rdf:type owl:ObjectProperty ;
         rdfs:domain :Behavior ;
         rdfs:range :Step ;
         <http://www.w3.org/2004/02/skos/core#definition> "Relates a Behavior (Procedure, Playbook, ThreatScenario, Control, or another Step) to a Step that decomposes it."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "hasStep" ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain is the general Behavior root rather than a specific subclass, so decomposition applies uniformly across Procedure, Playbook, ThreatScenario, and — recursively, since Step is itself a Behavior — Step."@en .


###  https://cyberterrain.org/ns/stonework#hasTechnique
:hasTechnique rdf:type owl:ObjectProperty ;
              owl:inverseOf :techniqueOf ;
              rdf:type owl:TransitiveProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :Tactic
                                          :Technique
                                        )
                          ] ;
              rdfs:range :Technique ;
              <http://www.w3.org/2004/02/skos/core#definition> "Relates a Tactic to a Technique that serves its goal, or a Technique to a more specific Technique it contains."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "hasTechnique" .


###  https://cyberterrain.org/ns/stonework#hasThreatActorType
:hasThreatActorType rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :categorizedBy ;
                    rdfs:domain :ThreatActor ;
                    rdfs:range :ThreatActorType ;
                    <http://www.w3.org/2004/02/skos/core#definition> "Relates a threat actor to one or more classifications describing their organizational form or primary mode of operation."@en ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "hasThreatActorType"@en ;
                    <http://www.w3.org/2004/02/skos/core#scopeNote> "A threat actor may have multiple types (e.g. nation-state actor who is also a spy). Aligns with the STIX 2.1 threat-actor-type open vocabulary."@en .


###  https://cyberterrain.org/ns/stonework#hasVendor
:hasVendor rdf:type owl:ObjectProperty ;
           owl:inverseOf :vendorOf ;
           rdfs:domain :Product ;
           rdfs:range :Agent ;
           <http://www.w3.org/2004/02/skos/core#definition> "Relates a product family to the Agent (organization or person) that develops or maintains it."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "hasVendor"@en .


###  https://cyberterrain.org/ns/stonework#hasVersion
:hasVersion rdf:type owl:ObjectProperty ;
            rdfs:domain :Product ;
            rdfs:range :VersionedProduct ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates a product family to a specific versioned product instance."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "hasVersion"@en .


###  https://cyberterrain.org/ns/stonework#hasWeakness
:hasWeakness rdf:type owl:ObjectProperty ,
                      owl:AsymmetricProperty ;
             rdfs:domain :Vulnerability ;
             rdfs:range :Weakness ;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a vulnerability to the weakness class it exploits or instantiates."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "hasWeakness" ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "The range is a stonework:Weakness individual whose IRI is derived from the CWE identifier. The weakness individual may be populated by a separate CWE ingest."@en .


###  https://cyberterrain.org/ns/stonework#hashOf
:hashOf rdf:type owl:ObjectProperty ;
        owl:inverseOf :hasHash ;
        rdfs:domain :Hash ;
        <http://www.w3.org/2004/02/skos/core#definition> "Relates a hash entry to the entity it describes. The domain is a stonework:Hash individual representing a single hash algorithm and digest value." ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "hashOf" .


###  https://cyberterrain.org/ns/stonework#headquarteredIn
:headquarteredIn rdf:type owl:ObjectProperty ;
                 rdfs:domain :Organization ;
                 rdfs:range :Location ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Relates an Organization to its primary headquarters Location."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "headquarteredIn"@en .


###  https://cyberterrain.org/ns/stonework#heldAt
:heldAt rdf:type owl:ObjectProperty ;
        rdfs:domain :FinancialAccount ;
        rdfs:range :FinancialInstitution ;
        <http://www.w3.org/2004/02/skos/core#definition> "The financial institution that maintains this account."@en ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "heldAt"@en ;
        <http://www.w3.org/2004/02/skos/core#scopeNote> "Optional. Absent for a self-custody crypto wallet or an account whose institution is unknown; present and pointing at a virtual asset service provider for a custodial wallet."@en .


###  https://cyberterrain.org/ns/stonework#hostedBy
:hostedBy rdf:type owl:ObjectProperty ;
          rdfs:domain :Infrastructure ;
          rdfs:range :Agent ;
          <http://www.w3.org/2004/02/skos/core#definition> "The Agent (hosting provider, organization, or individual) that operates or administers this Infrastructure."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "hostedBy" .


###  https://cyberterrain.org/ns/stonework#hostedOn
:hostedOn rdf:type owl:ObjectProperty ;
          rdfs:domain :Infrastructure ;
          rdfs:range :Host ;
          <http://www.w3.org/2004/02/skos/core#definition> "The logical Infrastructure entity runs on this physical or virtual Host. Bridges the abstract infrastructure layer to the concrete system for configuration and vulnerability queries."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "hostedOn"@en .


###  https://cyberterrain.org/ns/stonework#implants
:implants rdf:type owl:ObjectProperty ;
          rdfs:domain :MalwareSample ;
          rdfs:range :MalwareSample ;
          <http://www.w3.org/2004/02/skos/core#definition> "A dropper or loader MalwareSample installs another MalwareSample payload. Models multi-stage delivery chains for reasoners tracking infection sequences."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "implants"@en .


###  https://cyberterrain.org/ns/stonework#implementedBy
:implementedBy rdf:type owl:ObjectProperty ;
               owl:inverseOf :implements ;
               rdfs:domain :Behavior ;
               rdfs:range :Behavior ;
               <http://www.w3.org/2004/02/skos/core#definition> "Relates an abstract Behavior to a concrete, Step-decomposed Behavior that realizes it."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "implementedBy" .


###  https://cyberterrain.org/ns/stonework#implements
:implements rdf:type owl:ObjectProperty ,
                     owl:TransitiveProperty ;
            rdfs:domain :Behavior ;
            rdfs:range :Behavior ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates a concrete, Step-decomposed Behavior to the more abstract Behavior it is a specific realization of."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "implements" ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "General-purpose relationship covering both offense (a Procedure implements a Technique) and defense (a ControlPlan implements a Control) with one property rather than a bespoke one per pairing."@en .


###  https://cyberterrain.org/ns/stonework#implementsCountermeasure
:implementsCountermeasure rdf:type owl:ObjectProperty ;
                          rdfs:domain :SecurityActuator ;
                          rdfs:range :Countermeasure ;
                          owl:propertyChainAxiom ( :madeActuation
                                                   :appliesCountermeasure
                                                 ) ;
                          <http://www.w3.org/2004/02/skos/core#definition> "Relates a SecurityActuator to a Countermeasure it is configured or capable of applying."@en ;
                          <http://www.w3.org/2004/02/skos/core#prefLabel> "implementsCountermeasure"@en ;
                          <http://www.w3.org/2004/02/skos/core#scopeNote> "May be asserted directly for configured capabilities. It is also inferred when the actuator made a SecurityActuation that applies the Countermeasure."@en .


###  https://cyberterrain.org/ns/stonework#implementsTechnique
:implementsTechnique rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :uses ;
                     rdfs:domain [ rdf:type owl:Class ;
                                   owl:unionOf ( :Malware
                                                 :Product
                                                 :VersionedProduct
                                               )
                                 ] ;
                     rdfs:range :Technique ;
                     <http://www.w3.org/2004/02/skos/core#definition> "Relates malware or a product to a Technique embodied by its behavior or capabilities."@en ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "implementsTechnique" ;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "Specializes the open STIX-compatible stonework:uses relationship for malware- or product-to-technique assertions. Product covers abstract product families, including Tool; VersionedProduct covers specific releases or builds. stonework:implements remains the distinct Behavior-to-Behavior realization relationship."@en .


###  https://cyberterrain.org/ns/stonework#inBlock
:inBlock rdf:type owl:ObjectProperty ;
         rdfs:domain :IPAddress ;
         rdfs:range :IPBlock ;
         <http://www.w3.org/2004/02/skos/core#definition> "Relates an IPAddress to the IPBlock whose address space contains it."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "inBlock"@en .


###  https://cyberterrain.org/ns/stonework#indicates
:indicates rdf:type owl:ObjectProperty ;
           rdfs:domain :Indicator ;
           <http://www.w3.org/2004/02/skos/core#definition> "Asserts that when the source Indicator's pattern is matched, it signals the presence of the target adversary behavior, malware, campaign, or threat actor." ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "indicates"@en ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Corresponds to STIX relationship_type 'indicates'. Domain is stonework:Indicator — unlike the source side of other STIX relationship shortcuts, this is definitional rather than open-world convention: an object is only ever an Indicator because it indicates something, per STIX's own spec role for that object type. Range is intentionally left unset: an Indicator may indicate all sorts of things (AttackPattern/AttackTechnique, Malware, Campaign, CyberActivityCluster, ThreatActor, Infrastructure, Tool, and whatever else a producer's pattern targets), and STIX does not schema-constrain the target_ref type for a given relationship_type. A single Indicator may indicate multiple targets."@en .


###  https://cyberterrain.org/ns/stonework#initiatedBy
:initiatedBy rdf:type owl:ObjectProperty ;
             rdfs:domain :NetworkTraffic ;
             rdfs:range :RuntimeProcess ;
             <http://www.w3.org/2004/02/skos/core#definition> "The RuntimeProcess that opened this NetworkTraffic flow. Core process-to-network correlation arc for host-based forensics and lateral movement analysis."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "initiatedBy"@en .


###  https://cyberterrain.org/ns/stonework#installationOf
:installationOf rdf:type owl:ObjectProperty ;
                rdfs:range :VersionedProduct ;
                <http://www.w3.org/2004/02/skos/core#definition> "Relates a component context to the versioned product it references or instantiates."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "installation of" ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Used by stonework:BomEntry (declarative — a component listed in an SBOM), stonework:ProductInstallation (observational — a verified deployment on a specific system), and other stonework:ComponentContext subclasses. Domain is intentionally left unset to avoid restricting future component-context subclasses. Not declared owl:FunctionalProperty at the property level, because not every ComponentContext subclass is one-to-one with a product — a source-native advisory entry may legitimately name several. BomEntry and ProductInstallation instead carry a local owl:maxQualifiedCardinality 1 restriction on this property (onClass stonework:VersionedProduct), which gives those two classes the same at-most-one guarantee without constraining subclasses that don't share it."@en .


###  https://cyberterrain.org/ns/stonework#installedOn
:installedOn rdf:type owl:ObjectProperty ;
             owl:inverseOf :hasProductInstallation ;
             rdf:type owl:FunctionalProperty ;
             rdfs:domain :ProductInstallation ;
             rdfs:range :Infrastructure ;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a ProductInstallation to the Infrastructure entity on which that product instance is installed."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "installedOn"@en .


###  https://cyberterrain.org/ns/stonework#intermediaryAccount
:intermediaryAccount rdf:type owl:ObjectProperty ;
                     rdfs:domain :FinancialTransaction ;
                     rdfs:range :FinancialAccount ;
                     <http://www.w3.org/2004/02/skos/core#definition> "A correspondent or intermediary account through which this transaction is routed between originator and beneficiary."@en ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "intermediaryAccount"@en ;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "Multi-valued and unordered in this revision; a strict correspondent-banking chain order is deferred."@en .


###  https://cyberterrain.org/ns/stonework#investigatedBy
:investigatedBy rdf:type owl:ObjectProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :Campaign
                                            :Incident
                                            :MalwareSample
                                            :ThreatActor
                                          )
                            ] ;
                rdfs:range :Investigation ;
                <http://www.w3.org/2004/02/skos/core#definition> "Relates an Incident, Campaign, MalwareSample, or ThreatActor to an Investigation examining it."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "investigatedBy"@en .


###  https://cyberterrain.org/ns/stonework#investigates
:investigates rdf:type owl:ObjectProperty ;
              owl:inverseOf :investigatedBy ;
              rdfs:domain :Investigation ;
              rdfs:range [ rdf:type owl:Class ;
                           owl:unionOf ( :Campaign
                                         :Incident
                                         :MalwareSample
                                         :ThreatActor
                                       )
                         ] ;
              <http://www.w3.org/2004/02/skos/core#definition> "Relates an Investigation to the subject being investigated."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "investigates"@en .


###  https://cyberterrain.org/ns/stonework#involvesCampaign
:involvesCampaign rdf:type owl:ObjectProperty ;
                  rdfs:domain :Incident ;
                  rdfs:range :Campaign ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Links an Incident to a Campaign it is part of or attributed to."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "involvesCampaign"@en .


###  https://cyberterrain.org/ns/stonework#isSampleOf
:isSampleOf rdf:type owl:ObjectProperty ;
            owl:inverseOf :hasArtifact ;
            rdfs:domain :DigitalArtifact ;
            rdfs:range :MalwareSample ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates a DigitalArtifact representation, such as a File, to the MalwareSample it embodies or records."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "isSampleOf"@en .


###  https://cyberterrain.org/ns/stonework#isStepOf
:isStepOf rdf:type owl:ObjectProperty ;
          owl:inverseOf :hasStep ;
          rdfs:domain :Step ;
          rdfs:range :Behavior ;
          <http://www.w3.org/2004/02/skos/core#definition> "Relates a Step to the Behavior it decomposes."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "isStepOf" .


###  https://cyberterrain.org/ns/stonework#isVulnerableTo
:isVulnerableTo rdf:type owl:ObjectProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :Host
                                            :NetworkService
                                            :VersionedProduct
                                          )
                            ] ;
                rdfs:range :Vulnerability ;
                <http://www.w3.org/2004/02/skos/core#definition> "Relates infrastructure or a product version to known Vulnerabilities it contains."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "isVulnerableTo"@en .


###  https://cyberterrain.org/ns/stonework#issuedBy
:issuedBy rdf:type owl:ObjectProperty ;
          rdfs:domain :Certificate ;
          rdfs:range :Agent ;
          <http://www.w3.org/2004/02/skos/core#definition> "Relates a Certificate to the Certificate Authority that issued it."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "issuedBy"@en .


###  https://cyberterrain.org/ns/stonework#issuedTo
:issuedTo rdf:type owl:ObjectProperty ;
          rdfs:domain :Certificate ;
          rdfs:range [ rdf:type owl:Class ;
                       owl:unionOf ( :Agent
                                     :Domain
                                   )
                     ] ;
          <http://www.w3.org/2004/02/skos/core#definition> "Relates a Certificate to the entity (Agent or Domain) it was issued to."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "issuedTo"@en .


###  https://cyberterrain.org/ns/stonework#launchedBy
:launchedBy rdf:type owl:ObjectProperty ;
            rdfs:domain :RuntimeProcess ;
            rdfs:range :UserAccount ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates a RuntimeProcess to the UserAccount under whose context it was launched."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "launchedBy"@en .


###  https://cyberterrain.org/ns/stonework#linkedTo
:linkedTo rdf:type owl:ObjectProperty ;
          <http://www.w3.org/2004/02/skos/core#definition> "Generic link between two entities. Use a more specific property where one exists."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "linkedTo" .


###  https://cyberterrain.org/ns/stonework#locatedAt
:locatedAt rdf:type owl:ObjectProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :Host
                                       :Infrastructure
                                       :Organization
                                       :PhysicalArtifact
                                     )
                       ] ;
           rdfs:range :Location ;
           <http://www.w3.org/2004/02/skos/core#definition> "Relates an entity to its physical or logical location."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "locatedAt"@en .


###  https://cyberterrain.org/ns/stonework#locatedWithin
:locatedWithin rdf:type owl:ObjectProperty ,
                        owl:TransitiveProperty ;
               rdfs:domain :Location ;
               rdfs:range :Location ;
               <http://www.w3.org/2004/02/skos/core#definition> "Relates a Location to a broader Location that wholly contains it, e.g. a City to its Region or Country, or a Region to its Country."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "locatedWithin"@en ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "Transitive: a City locatedWithin a Region that is locatedWithin a Country is also locatedWithin that Country. Assert only the most direct containment and let reasoning supply the rest. Use stonework:locatedAt to place non-Location entities such as Hosts or Organizations at a Location."@en .


###  https://cyberterrain.org/ns/stonework#loggedInTo
:loggedInTo rdf:type owl:ObjectProperty ;
            rdfs:domain :UserAccount ;
            rdfs:range [ rdf:type owl:Class ;
                         owl:unionOf ( :Host
                                       :NetworkService
                                     )
                       ] ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates a UserAccount to the Hosts or NetworkServices it has authenticated to."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "loggedInTo"@en .


###  https://cyberterrain.org/ns/stonework#madeActuation
:madeActuation rdf:type owl:ObjectProperty ;
               owl:inverseOf :madeByActuator ;
               rdfs:domain :SecurityActuator ;
               rdfs:range :SecurityActuation ;
               rdfs:seeAlso <https://www.w3.org/TR/vocab-ssn/#SOSAmadeActuation> ;
               <http://www.w3.org/2004/02/skos/core#definition> "Relates a SecurityActuator to a SecurityActuation it performed."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "madeActuation"@en .


###  https://cyberterrain.org/ns/stonework#madeByActuator
:madeByActuator rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :SecurityActuation ;
                rdfs:range :SecurityActuator ;
                rdfs:seeAlso <https://www.w3.org/TR/vocab-ssn/#SOSAmadeByActuator> ;
                <http://www.w3.org/2004/02/skos/core#definition> "Relates a SecurityActuation to the SecurityActuator that performed it."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "madeByActuator"@en .


###  https://cyberterrain.org/ns/stonework#madeBySensor
:madeBySensor rdf:type owl:ObjectProperty ;
              rdfs:domain :SecurityObservation ;
              rdfs:range :Sensor ;
              rdfs:seeAlso <https://www.w3.org/TR/vocab-ssn/#SOSAmadeBySensor> ;
              <http://www.w3.org/2004/02/skos/core#definition> "Links a SecurityObservation to the Sensor that produced it."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "madeBySensor"@en ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "Inspired by SOSA sosa:madeBySensor. Enables queries such as 'which sensor produced this observation?' and 'what has this IDS sensor observed in the last 24 hours?' The producing sensor may also be the created_by_ref identity in the STIX wire format."@en .


###  https://cyberterrain.org/ns/stonework#manifestsAs
:manifestsAs rdf:type owl:ObjectProperty ;
             rdfs:domain :Threat ;
             rdfs:range :ThreatScenario ;
             <http://www.w3.org/2004/02/skos/core#definition> "A Threat is concretely expressed as a ThreatScenario with defined actor, asset, and technique. Connects abstract threat to actionable scenario modelling."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "manifestsAs"@en .


###  https://cyberterrain.org/ns/stonework#markingRef
:markingRef rdf:type owl:ObjectProperty ;
            rdfs:range :Markings ;
            <http://www.w3.org/2004/02/skos/core#definition> "Reference to the Markings applied by this marking entry." ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "markingRef" .


###  https://cyberterrain.org/ns/stonework#memberOf
:memberOf rdf:type owl:ObjectProperty ;
          rdfs:range [ rdf:type owl:Class ;
                       owl:unionOf ( :Group
                                     :Organization
                                     :ThreatActor
                                   )
                     ] ;
          <http://www.w3.org/2004/02/skos/core#definition> "Relates an entity to a Group, Organization, or ThreatActor to which it belongs."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "memberOf"@en .


###  https://cyberterrain.org/ns/stonework#memberOfActivityCluster
:memberOfActivityCluster rdf:type owl:ObjectProperty ;
                         rdfs:domain :CyberActivity ;
                         rdfs:range :CyberActivityCluster ;
                         <http://www.w3.org/2004/02/skos/core#definition> "Relates a Campaign or other CyberActivity to the CyberActivityCluster that analytically groups it."@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "memberOfActivityCluster"@en .


###  https://cyberterrain.org/ns/stonework#memberOfFamily
:memberOfFamily rdf:type owl:ObjectProperty ;
                rdfs:domain :MalwareSample ;
                rdfs:range :MalwareFamily ;
                <http://www.w3.org/2004/02/skos/core#definition> "Relates a specific malware sample to the malware family it has been classified as belonging to, based on shared behavioral patterns, code similarity, infrastructure overlap, or analyst attribution." ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "memberOfFamily" .


###  https://cyberterrain.org/ns/stonework#mentions
:mentions rdf:type owl:ObjectProperty ;
          rdfs:domain :Provenance ;
          <http://www.w3.org/2004/02/skos/core#definition> "An entity referenced or cited within this Provenance record."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "mentions" .


###  https://cyberterrain.org/ns/stonework#metricFor
:metricFor rdf:type owl:ObjectProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :MetricObservation ;
           rdfs:range :CyberEntity ;
           <http://www.w3.org/2004/02/skos/core#definition> "The entity whose value is recorded by a MetricObservation."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "metricFor"@en .


###  https://cyberterrain.org/ns/stonework#metricType
:metricType rdf:type owl:ObjectProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :MetricObservation ;
            rdfs:range :MetricType ;
            <http://www.w3.org/2004/02/skos/core#definition> "Identifies the meaning and scale of the recorded metric value."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "metricType"@en .


###  https://cyberterrain.org/ns/stonework#mitigates
:mitigates rdf:type owl:ObjectProperty ;
           <http://www.w3.org/2004/02/skos/core#definition> "Relates a Mitigation, CourseOfAction, or Control to the AttackPattern or Vulnerability it addresses. Corresponds to STIX relationship_type 'mitigates'."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "mitigates" ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain/range intentionally left unset: this property is a direct lift of the STIX 2.1 relationship_type 'mitigates' shortcut. STIX does not schema-constrain which SDO/SCO types may appear as source_ref/target_ref for a given relationship_type — that's producer convention, not enforceable structure, and a closed domain/range here would misrepresent real STIX 2.1 data and mislead reasoner-based consumers. Contrast with stonework:mitigatesAttackPattern, a purpose-built subproperty with a controlled domain/range, populated by materialize-technique-links.sparql rather than lifted directly from STIX."@en .


###  https://cyberterrain.org/ns/stonework#mitigatesAttackPattern
:mitigatesAttackPattern rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf :mitigates ;
                        rdfs:domain :Countermeasure ;
                        rdfs:range :AttackPattern ;
                        <http://www.w3.org/2004/02/skos/core#definition> "Relates a Countermeasure (e.g. a CIS Control safeguard) to the AttackPattern it mitigates, resolved from a shared technique identifier."@en ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "mitigatesAttackPattern" ;
                        <http://www.w3.org/2004/02/skos/core#scopeNote> "Materialized by joining a framework's technique-identifier literal (see stonework:relatedTechniqueIdentifier, e.g. cis:mitigatesTechniqueId) against the ATT&CK technique's external reference. Framework ontologies declare their concrete property (e.g. cis:mitigatesTechnique) as rdfs:subPropertyOf this."@en .


###  https://cyberterrain.org/ns/stonework#mitigatesVulnerability
:mitigatesVulnerability rdf:type owl:ObjectProperty ;
                        rdfs:domain :CourseOfAction ;
                        rdfs:range :Vulnerability ;
                        <http://www.w3.org/2004/02/skos/core#definition> "A CourseOfAction (patch, workaround, compensating control) addresses this Vulnerability. Distinct from stonework:mitigates (Countermeasure → AttackPattern)."@en ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "mitigatesVulnerability"@en .


###  https://cyberterrain.org/ns/stonework#noteAbout
:noteAbout rdf:type owl:ObjectProperty ;
           rdfs:domain :Note ;
           <http://www.w3.org/2004/02/skos/core#definition> "Relates a Note to the entities it annotates."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "noteAbout"@en .


###  https://cyberterrain.org/ns/stonework#observedIn
:observedIn rdf:type owl:ObjectProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :Behavior
                                        :DigitalArtifact
                                        :Identifier
                                        :Infrastructure
                                        :Malware
                                        :Product
                                        :SecurityCondition
                                      )
                        ] ;
            rdfs:range :CyberActivity ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates an observed entity, such as a DigitalArtifact, Infrastructure, Malware, Product, Behavior, Identifier, or SecurityCondition, to the CyberActivity (for example a Campaign, Incident, or Event) in which it was observed or collected."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "observedIn"@en ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "A general-purpose shortcut: the kind of context is conveyed by typing the CyberActivity, so narrower subproperties per activity type are unnecessary. Asserting this property does not imply that the object is a Campaign; type it explicitly when that matters. When an observation needs its own metadata, such as observer, time, location, count, or confidence, model it as a stonework:Sighting instead. Not an inverse of stonework:uses, which records that an actor, campaign, or malware employs a technique or tool rather than that an entity was seen in an activity."@en .


###  https://cyberterrain.org/ns/stonework#occursOn
:occursOn rdf:type owl:ObjectProperty ;
          rdfs:domain :Event ;
          rdfs:range :Host ;
          <http://www.w3.org/2004/02/skos/core#definition> "Relates an Event to the Host on which it was observed."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "occursOn"@en .


###  https://cyberterrain.org/ns/stonework#operatesIn
:operatesIn rdf:type owl:ObjectProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :Organization
                                        :ThreatActor
                                      )
                        ] ;
            rdfs:range [ rdf:type owl:Class ;
                         owl:unionOf ( :Location
                                       :Sector
                                     )
                       ] ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates an Organization or ThreatActor to the Locations or Sectors they operate in."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "operatesIn"@en .


###  https://cyberterrain.org/ns/stonework#opinionOf
:opinionOf rdf:type owl:ObjectProperty ;
           rdfs:domain :Opinion ;
           rdfs:range :IntelligenceProduct ;
           <http://www.w3.org/2004/02/skos/core#definition> "Relates an Opinion to the IntelligenceProduct whose correctness or credibility it evaluates."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "opinionOf"@en .


###  https://cyberterrain.org/ns/stonework#originatesFrom
:originatesFrom rdf:type owl:ObjectProperty ;
                rdfs:domain :Agent ;
                rdfs:range :Location ;
                <http://www.w3.org/2004/02/skos/core#definition> "Relates an Agent to the geographic Location from which it originates."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "originatesFrom" .


###  https://cyberterrain.org/ns/stonework#originatesInAS
:originatesInAS rdf:type owl:ObjectProperty ;
                rdfs:domain :IPAddress ;
                rdfs:range :AutonomousSystem ;
                <http://www.w3.org/2004/02/skos/core#definition> "Relates an IPAddress to the AutonomousSystem that originates its encompassing IP prefix in BGP."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "originatesInAS"@en .


###  https://cyberterrain.org/ns/stonework#originatorAccount
:originatorAccount rdf:type owl:ObjectProperty ;
                   rdfs:domain :FinancialTransaction ;
                   rdfs:range :FinancialAccount ;
                   <http://www.w3.org/2004/02/skos/core#definition> "The account debited by this transaction — the source of the transferred value."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "originatorAccount"@en ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Naming follows the FATF Travel Rule and ISO 20022 originator-beneficiary convention. Direction of value is carried by these roles, not by the sign of stonework:amount."@en .


###  https://cyberterrain.org/ns/stonework#originatorMonetaryValue
:originatorMonetaryValue rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf :hasMonetaryValue ;
                         rdfs:domain :FinancialTransaction ;
                         rdfs:range :MonetaryAmount ;
                         <http://www.w3.org/2004/02/skos/core#definition> "The monetary amount debited from the originator account as this transaction's input."@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "originatorMonetaryValue"@en ;
                         <http://www.w3.org/2004/02/skos/core#scopeNote> "Use with stonework:beneficiaryMonetaryValue when a transaction changes denomination, as in a currency exchange. Both properties remain queryable through their stonework:hasMonetaryValue superproperty."@en .


###  https://cyberterrain.org/ns/stonework#overlapsWith
:overlapsWith rdf:type owl:ObjectProperty ;
              <http://www.w3.org/2004/02/skos/core#definition> "Indicates two entities share common attributes, infrastructure, or behaviour, suggesting possible connection without asserting a specific relationship type."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "overlapsWith" .


###  https://cyberterrain.org/ns/stonework#ownedBy
:ownedBy rdf:type owl:ObjectProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :DataAsset
                                     :Infrastructure
                                   )
                     ] ;
         rdfs:range :Agent ;
         <http://www.w3.org/2004/02/skos/core#definition> "Relates a DataAsset or Infrastructure to its owning Agent."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "ownedBy"@en .


###  https://cyberterrain.org/ns/stonework#performedBy
:performedBy rdf:type owl:ObjectProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :Playbook
                                         :Process
                                       )
                         ] ;
             rdfs:range :Agent ;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a Process to the Agent that performs it, or a Playbook to the Agent responsible for carrying it out."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "performedBy"@en .


###  https://cyberterrain.org/ns/stonework#phoneNumberOf
:phoneNumberOf rdf:type owl:ObjectProperty ;
               rdfs:domain :PhoneNumber ;
               rdfs:range :Agent ;
               <http://www.w3.org/2004/02/skos/core#definition> "The Agent associated with this PhoneNumber. Inverse of stonework:hasPhoneNumber."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "phoneNumberOf" .


###  https://cyberterrain.org/ns/stonework#playsRole
:playsRole rdf:type owl:ObjectProperty ;
           rdfs:range :Role ;
           owl:propertyChainAxiom ( :hasRoleAssignment
                                    :assignedRole
                                  ) ;
           <http://www.w3.org/2004/02/skos/core#definition> "A context-free projection of a Role played by an entity."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "playsRole" ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Use stonework:RoleAssignment with stonework:roleContext when the campaign, operation, organization, provenance, or time interval matters. The qualified pattern infers this direct projection through a property chain."@en .


###  https://cyberterrain.org/ns/stonework#posesThreat
:posesThreat rdf:type owl:ObjectProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :Campaign
                                         :ThreatActor
                                       )
                         ] ;
             rdfs:range :Threat ;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a ThreatActor or Campaign to the Threats they represent."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "posesThreat"@en .


###  https://cyberterrain.org/ns/stonework#precededByStep
:precededByStep rdf:type owl:ObjectProperty ;
                rdfs:domain :Step ;
                rdfs:range :Step ;
                <http://www.w3.org/2004/02/skos/core#definition> "Relates a Step to another Step that must occur before it within the same parent Behavior."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "precededByStep" ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Deliberately distinct from stonework:precedes, whose domain and range are IntelligenceProduct (report-version succession) — an unrelated relationship. precededByStep expresses a graph that may contain cycles: an edge targeting an already-reached Step is a loop, not an error. Use stonework:Transition instead when the edge itself needs a guard condition or other structure attached."@en .


###  https://cyberterrain.org/ns/stonework#precedes
:precedes rdf:type owl:ObjectProperty ;
          rdfs:domain :IntelligenceProduct ;
          rdfs:range :IntelligenceProduct ;
          <http://www.w3.org/2004/02/skos/core#definition> "Temporal succession of Information (v1 precedes v2 of a report)"@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "precedes" .


###  https://cyberterrain.org/ns/stonework#predictedType
:predictedType rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Hypothesis ;
               rdfs:range rdfs:Class ;
               <http://www.w3.org/2004/02/skos/core#definition> "The class a Hypothesis predicts its stonework:predictsVariable will be bound to an instance of, once executed."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "predictedType" ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "Mirrors stonework:guardType on Transition. Exists because a Hypothesis is typically formed before the Variable's eventual value has been constructed — at prediction time there is usually no individual yet to name via stonework:predictedValue, only an expected class of outcome (e.g. 'this attempt will produce some stonework:SecurityCondition')."@en .


###  https://cyberterrain.org/ns/stonework#predictedValue
:predictedValue rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :Hypothesis ;
                rdfs:range owl:Thing ;
                <http://www.w3.org/2004/02/skos/core#definition> "The individual a Hypothesis predicts its stonework:predictsVariable will be bound to, once executed."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "predictedValue" ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Mirrors stonework:boundTo on the actual-result side; usable only when a specific pre-existing individual is predicted. See stonework:predictedType for the more common case of predicting a class of outcome rather than a specific not-yet-constructed individual, and stonework:predictedLiteral for predictions of a scalar."@en .


###  https://cyberterrain.org/ns/stonework#predictsVariable
:predictsVariable rdf:type owl:ObjectProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :Hypothesis ;
                  rdfs:range :Variable ;
                  <http://www.w3.org/2004/02/skos/core#definition> "The Variable whose eventual binding a Hypothesis is a prediction about."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "predictsVariable" ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "Because stonework:hasInputVariable/stonework:hasOutputVariable are declared on stonework:Behavior, and stonework:Step is itself a Behavior, a Hypothesis may predict a Variable declared at any level of a Step/Plan decomposition — a top-level Plan's overall outcome or a single Step's individual result — without a separate property per level."@en .


###  https://cyberterrain.org/ns/stonework#procedureFor
:procedureFor rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :implements ;
              rdfs:domain :Procedure ;
              rdfs:range :Technique ;
              <http://www.w3.org/2004/02/skos/core#definition> "Relates a Procedure to the Technique it implements; a specialized form of stonework:implements for procedure-to-technique links."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "procedureFor"@en .


###  https://cyberterrain.org/ns/stonework#produces
:produces rdf:type owl:ObjectProperty ;
          rdfs:domain :CyberActivity ;
          rdfs:range :CyberEntity ;
          <http://www.w3.org/2004/02/skos/core#definition> "Links an executing CyberActivity to a CyberEntity it constructed or generated in the course of executing."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "produces" ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "General-purpose construction/generation link — e.g. the CyberActivity realizing a Step is what actually constructs the value a Variable ends up stonework:boundTo, or a complex output artifact (a dataset, a report) that value refers to."@en .


###  https://cyberterrain.org/ns/stonework#producesReport
:producesReport rdf:type owl:ObjectProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :Investigation
                                            :Process
                                          )
                            ] ;
                rdfs:range [ rdf:type owl:Class ;
                             owl:unionOf ( :Assessment
                                           :Report
                                         )
                           ] ;
                <http://www.w3.org/2004/02/skos/core#definition> "Relates a Process or Investigation to the intelligence product it generates."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "producesReport"@en .


###  https://cyberterrain.org/ns/stonework#protects
:protects rdf:type owl:ObjectProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :AccessControlList
                                      :Countermeasure
                                    )
                      ] ;
          rdfs:range [ rdf:type owl:Class ;
                       owl:unionOf ( :DataAsset
                                     :DigitalArtifact
                                   )
                     ] ;
          <http://www.w3.org/2004/02/skos/core#definition> "Relates a Countermeasure or ACL to the resource it protects."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "protects"@en .


###  https://cyberterrain.org/ns/stonework#provenanceOf
:provenanceOf rdf:type owl:ObjectProperty ;
              rdfs:domain :Provenance ;
              rdfs:range [ rdf:type owl:Class ;
                           owl:unionOf ( :IntelligenceProduct
                                         :QualifiedAssertion
                                       )
                         ] ;
              <http://www.w3.org/2004/02/skos/core#definition> "Relates a Provenance record to the IntelligenceProduct or QualifiedAssertion whose origin or evidentiary basis it documents."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "provenanceOf"@en .


###  https://cyberterrain.org/ns/stonework#references
:references rdf:type owl:ObjectProperty ;
            <http://www.w3.org/2004/02/skos/core#definition> "Generic reference from one entity to another. Use a more specific property where one exists."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "references" .


###  https://cyberterrain.org/ns/stonework#refines
:refines rdf:type owl:ObjectProperty ;
         rdfs:domain :AttackTechnique ;
         rdfs:range :AttackPattern ;
         <http://www.w3.org/2004/02/skos/core#definition> "Relates an AttackTechnique to a broader or more abstract AttackPattern that it specializes, enabling roll-up from operational techniques to pattern families."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "refines"@en .


###  https://cyberterrain.org/ns/stonework#registeredTo
:registeredTo rdf:type owl:ObjectProperty ;
              rdfs:domain :Infrastructure ;
              rdfs:range :Agent ;
              <http://www.w3.org/2004/02/skos/core#definition> "Relates infrastructure to the Agent recorded as its owner or registrant of record — the entity in whose name the resource is officially registered."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "registeredTo" .


###  https://cyberterrain.org/ns/stonework#registeredWith
:registeredWith rdf:type owl:ObjectProperty ;
                rdfs:domain :Infrastructure ;
                rdfs:range :Agent ;
                <http://www.w3.org/2004/02/skos/core#definition> "Relates infrastructure to the registrar, registry, or administrative authority through which the registration was processed or is maintained."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "registeredWith" .


###  https://cyberterrain.org/ns/stonework#relatedAttackPattern
:relatedAttackPattern rdf:type owl:ObjectProperty ;
                      rdfs:range :AttackPattern ;
                      <http://www.w3.org/2004/02/skos/core#definition> "Relates an entity to an AttackPattern representing the same underlying technique in a different framework shape, resolved from a shared technique identifier (e.g. a CAPEC entry and the MITRE ATT&CK technique it maps to, or a CWE weakness and the CAPEC pattern that exploits it)."@en ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "relatedAttackPattern" ;
                      <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain intentionally left unset: subjects include stonework:Weakness (CWE → CAPEC) and stonework:AttackPattern itself (CAPEC → ATT&CK). Materialized by joining a framework's technique-identifier literal (see stonework:relatedTechniqueIdentifier) against the ATT&CK technique's external reference. Framework ontologies declare their concrete property (e.g. capec:relatedAttackTechnique, cwe:relatedAttackPattern) as rdfs:subPropertyOf this."@en .


###  https://cyberterrain.org/ns/stonework#relatedTechnique
:relatedTechnique rdf:type owl:ObjectProperty ;
                  rdfs:domain :CyberTechnique ;
                  rdfs:range :CyberTechnique ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Relates a CyberTechnique to another related CyberTechnique via a cross-framework or cross-abstraction-level association."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "relatedTechnique" ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "For technique-to-technique associations where both ends are already stonework:CyberTechnique individuals. Where the association instead crosses AttackPattern shapes (e.g. CWE weakness → CAPEC pattern, CAPEC pattern → ATT&CK technique), use stonework:relatedAttackPattern, whose domain is not restricted to CyberTechnique."@en .


###  https://cyberterrain.org/ns/stonework#relatedTo
:relatedTo rdf:type owl:ObjectProperty ;
           <http://www.w3.org/2004/02/skos/core#definition> "Shortcut triple: generic relationship. Corresponds to STIX relationship_type 'related-to'." ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "relatedTo" .


###  https://cyberterrain.org/ns/stonework#remediates
:remediates rdf:type owl:ObjectProperty ;
            rdfs:range [ rdf:type owl:Class ;
                         owl:unionOf ( :Vulnerability
                                       :Weakness
                                     )
                       ] ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates an entity that addresses or corrects a Vulnerability or Weakness to the condition it remediates."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "remediates" .


###  https://cyberterrain.org/ns/stonework#reportedBy
:reportedBy rdf:type owl:ObjectProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :Report
                                        :Sighting
                                      )
                        ] ;
            rdfs:range :Agent ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates a Report or Sighting to the Agent who created it."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "reportedBy"@en .


###  https://cyberterrain.org/ns/stonework#reportedIn
:reportedIn rdf:type owl:ObjectProperty ;
            rdfs:domain :Vulnerability ;
            rdfs:range :Publication ;
            <http://www.w3.org/2004/02/skos/core#definition> "A Vulnerability is formally disclosed in this Publication (advisory, CVE NVD entry, security bulletin). Primary arc into the Publication class."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "reportedIn"@en .


###  https://cyberterrain.org/ns/stonework#resolvedTo
:resolvedTo rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :resolvesTo ;
            rdfs:domain :Domain ;
            rdfs:range :IPAddress ;
            <http://www.w3.org/2004/02/skos/core#definition> "A Domain resolves to this IPAddress via DNS. More specific than stonework:resolvesTo (Infrastructure → Infrastructure); use this for explicit domain-to-IP mappings."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "resolvedTo"@en .


###  https://cyberterrain.org/ns/stonework#resolvesTo
:resolvesTo rdf:type owl:ObjectProperty ;
            rdfs:domain :Infrastructure ;
            rdfs:range :Infrastructure ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates one Infrastructure entity to another Infrastructure entity to which it resolves, such as a Domain resolving to an IPAddress."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "resolvesTo"@en .


###  https://cyberterrain.org/ns/stonework#respondsToActivity
:respondsToActivity rdf:type owl:ObjectProperty ;
                    rdfs:domain :FinancialTransaction ;
                    rdfs:range :CyberActivity ;
                    <http://www.w3.org/2004/02/skos/core#definition> "A cyber activity whose occurrence prompted or provides the context for this financial transaction, without asserting that the transaction financed the activity."@en ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "respondsToActivity"@en ;
                    <http://www.w3.org/2004/02/skos/core#scopeNote> "Use for a victim's ransom payment linked to the incident it responds to, restitution or remediation payments, and similar contextual relationships. Use stonework:fundsActivity only when the transaction finances the linked activity."@en .


###  https://cyberterrain.org/ns/stonework#revokedBy
:revokedBy rdf:type owl:ObjectProperty ;
           <http://www.w3.org/2004/02/skos/core#definition> "Shortcut triple: source STIX object is revoked and superseded by target. Corresponds to STIX relationship_type 'revoked-by'." ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "revokedBy" .


###  https://cyberterrain.org/ns/stonework#riskOfScenario
:riskOfScenario rdf:type owl:ObjectProperty ;
                rdfs:domain :Risk ;
                rdfs:range :ThreatScenario ;
                <http://www.w3.org/2004/02/skos/core#definition> "Relates an assessed Risk to the ThreatScenario whose realization gives rise to that risk."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "riskOfScenario"@en .


###  https://cyberterrain.org/ns/stonework#roleContext
:roleContext rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :RoleAssignment ;
             rdfs:range [ rdf:type owl:Class ;
                          owl:unionOf ( :CyberActivity
                                        :CyberEntity
                                      )
                        ] ;
             <http://www.w3.org/2004/02/skos/core#definition> "The campaign, operation, organization, or other context in which a RoleAssignment applies."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "roleContext"@en .


###  https://cyberterrain.org/ns/stonework#rolePlayer
:rolePlayer rdf:type owl:ObjectProperty ;
            owl:inverseOf :hasRoleAssignment ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain :RoleAssignment ;
            rdfs:range :CyberEntity ;
            <http://www.w3.org/2004/02/skos/core#definition> "The entity that bears the Role in a qualified RoleAssignment."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "rolePlayer"@en .


###  https://cyberterrain.org/ns/stonework#runs
:runs rdf:type owl:ObjectProperty ;
      rdfs:domain :Host ;
      rdfs:range :RuntimeProcess ;
      <http://www.w3.org/2004/02/skos/core#definition> "Relates a Host to the RuntimeProcesses executing on it."@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "runs"@en .


###  https://cyberterrain.org/ns/stonework#scenarioActor
:scenarioActor rdf:type owl:ObjectProperty ;
               rdfs:domain :ThreatScenario ;
               rdfs:range :ThreatActor ;
               <http://www.w3.org/2004/02/skos/core#definition> "Relates a ThreatScenario to the threat actor type or group it models."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "scenarioActor"@en .


###  https://cyberterrain.org/ns/stonework#scenarioAsset
:scenarioAsset rdf:type owl:ObjectProperty ;
               rdfs:domain :ThreatScenario ;
               rdfs:range [ rdf:type owl:Class ;
                            owl:unionOf ( :DataAsset
                                          :Infrastructure
                                        )
                          ] ;
               <http://www.w3.org/2004/02/skos/core#definition> "Relates a ThreatScenario to the targeted assets in the scenario."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "scenarioAsset"@en .


###  https://cyberterrain.org/ns/stonework#scenarioTechnique
:scenarioTechnique rdf:type owl:ObjectProperty ;
                   rdfs:domain :ThreatScenario ;
                   rdfs:range :AttackTechnique ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Relates a ThreatScenario to the AttackTechniques in the attack path."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "scenarioTechnique"@en .


###  https://cyberterrain.org/ns/stonework#sharesCertificate
:sharesCertificate rdf:type owl:ObjectProperty ;
                   rdfs:domain :Infrastructure ;
                   rdfs:range :Certificate ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Relates an Infrastructure entity to a TLS/SSL Certificate it presents or uses; shared certificate values may indicate common ownership or operation."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "sharesCertificate" .


###  https://cyberterrain.org/ns/stonework#sharesRegistrant
:sharesRegistrant rdf:type owl:ObjectProperty ;
                  rdfs:domain :Infrastructure ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Links Infrastructure entities sharing a common domain registrant record, supporting operator attribution clustering."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "sharesRegistrant" .


###  https://cyberterrain.org/ns/stonework#sightedAt
:sightedAt rdf:type owl:ObjectProperty ;
           rdfs:domain :Sighting ;
           rdfs:range [ rdf:type owl:Class ;
                        owl:unionOf ( :Infrastructure
                                      :Location
                                    )
                      ] ;
           <http://www.w3.org/2004/02/skos/core#definition> "Relates a Sighting to the infrastructure or location where the observation was made."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "sightedAt"@en .


###  https://cyberterrain.org/ns/stonework#sightedBy
:sightedBy rdf:type owl:ObjectProperty ;
           rdfs:domain :Sighting ;
           rdfs:range :Agent ;
           <http://www.w3.org/2004/02/skos/core#definition> "Relates a Sighting to the Agent who made the observation."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "sightedBy"@en .


###  https://cyberterrain.org/ns/stonework#sightedObject
:sightedObject rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Sighting ;
               <http://www.w3.org/2004/02/skos/core#definition> "Relates a Sighting to the entity that was observed."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "sightedObject"@en .


###  https://cyberterrain.org/ns/stonework#signedWith
:signedWith rdf:type owl:ObjectProperty ;
            rdfs:domain :File ;
            rdfs:range :Certificate ;
            <http://www.w3.org/2004/02/skos/core#definition> "A File is code-signed with this Certificate. Supports trust chain analysis, publisher attribution of binaries, and detection of certificate abuse or misuse."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "signedWith"@en .


###  https://cyberterrain.org/ns/stonework#spawns
:spawns rdf:type owl:ObjectProperty ;
        owl:inverseOf :hasParentProcess ;
        rdfs:domain :RuntimeProcess ;
        rdfs:range :RuntimeProcess ;
        <http://www.w3.org/2004/02/skos/core#definition> "A RuntimeProcess creates a child process. Inverse of stonework:hasParentProcess; enables top-down process tree traversal for execution chain analysis."@en ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "spawns"@en .


###  https://cyberterrain.org/ns/stonework#storedIn
:storedIn rdf:type owl:ObjectProperty ;
          rdfs:domain :DataAsset ;
          rdfs:range :Infrastructure ;
          <http://www.w3.org/2004/02/skos/core#definition> "Relates a DataAsset to the Infrastructure system that stores it."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "storedIn"@en .


###  https://cyberterrain.org/ns/stonework#storedOn
:storedOn rdf:type owl:ObjectProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :DigitalArtifact
                                      :File
                                      :Registry
                                    )
                      ] ;
          rdfs:range :Host ;
          <http://www.w3.org/2004/02/skos/core#definition> "Relates a DigitalArtifact to the Host on which it is stored."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "storedOn"@en .


###  https://cyberterrain.org/ns/stonework#subdomainOf
:subdomainOf rdf:type owl:ObjectProperty ,
                      owl:TransitiveProperty ;
             rdfs:domain :Domain ;
             rdfs:range :Domain ;
             <http://www.w3.org/2004/02/skos/core#definition> "This Domain is a subdomain of the specified parent Domain. Transitive: if A is a subdomain of B and B of C, then A is a subdomain of C."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "subdomainOf" .


###  https://cyberterrain.org/ns/stonework#subsidiary
:subsidiary rdf:type owl:ObjectProperty ;
            rdfs:domain :Organization ;
            rdfs:range :Organization ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates an Organization to a subsidiary organization it owns or controls."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "subsidiary"@en .


###  https://cyberterrain.org/ns/stonework#supersededBy
:supersededBy rdf:type owl:ObjectProperty ,
                       owl:TransitiveProperty ;
              rdfs:domain :Vulnerability ;
              rdfs:range :Vulnerability ;
              <http://www.w3.org/2004/02/skos/core#definition> "Relates a vulnerability to the vulnerability record that supersedes it, e.g. when a CVE is split, merged, or formally replaced by another identifier."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "supersededBy"@en ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "Corresponds to cve:replacedBy in CVE JSON 5.x, but as an object property linking to a stonework:Vulnerability individual rather than a string. The source-specific string form is preserved on cve:replacedBy regardless of whether resolution to this property succeeds."@en .


###  https://cyberterrain.org/ns/stonework#supersedes
:supersedes rdf:type owl:ObjectProperty ,
                     owl:TransitiveProperty ;
            rdfs:domain :VersionedProduct ;
            rdfs:range :VersionedProduct ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates a product version to an older version it replaces. Transitive to support full product lifecycle reasoning."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "supersedes"@en .


###  https://cyberterrain.org/ns/stonework#targets
:targets rdf:type owl:ObjectProperty ;
         <http://www.w3.org/2004/02/skos/core#definition> "Shortcut triple: source targets the target Identity, Vulnerability, or Location. Corresponds to STIX relationship_type 'targets'." ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "targets" ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain/range intentionally left unset: this property is a direct lift of the STIX 2.1 relationship_type 'targets' shortcut. STIX does not schema-constrain which SDO/SCO types may appear as source_ref/target_ref for a given relationship_type — that's producer convention, not enforceable structure, and a closed domain/range here would misrepresent real STIX 2.1 data and mislead reasoner-based consumers."@en .


###  https://cyberterrain.org/ns/stonework#targetsPlatform
:targetsPlatform rdf:type owl:ObjectProperty ;
                 rdfs:range :VersionedProduct ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A MalwareSample or Tool is engineered to run on or exploit this VersionedProduct (OS, application, firmware version). Supports exposure and blast-radius queries."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "targetsPlatform"@en .


###  https://cyberterrain.org/ns/stonework#targetsService
:targetsService rdf:type owl:ObjectProperty ;
                rdfs:domain :NetworkTraffic ;
                rdfs:range :NetworkService ;
                <http://www.w3.org/2004/02/skos/core#definition> "The NetworkService this traffic addresses."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "targetsService"@en ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "⚑ Category: service *type* (HTTP, SSH, RDP, SMB, DNS) is better expressed as stonework:categorizedBy → Category named individual than as subclasses of NetworkService. NetworkService as a class is appropriate only when the instance has its own properties (port, vulnerability linkage)." .


###  https://cyberterrain.org/ns/stonework#techniqueOf
:techniqueOf rdf:type owl:ObjectProperty ;
             rdfs:domain :Technique ;
             rdfs:range [ rdf:type owl:Class ;
                          owl:unionOf ( :Tactic
                                        :Technique
                                      )
                        ] ;
             rdfs:isDefinedBy <https://cyberterrain.org/ns/stonework#> ;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a Technique to a Tactic it supports or to a broader Technique of which it is a specialization."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "techniqueOf"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "This is the inverse of hasTechnique. A Technique may support multiple Tactics, and a sub-technique may identify its broader parent Technique through the same hierarchy."@en .


###  https://cyberterrain.org/ns/stonework#toStep
:toStep rdf:type owl:ObjectProperty ,
                 owl:FunctionalProperty ;
        rdfs:domain :Transition ;
        rdfs:range :Step ;
        <http://www.w3.org/2004/02/skos/core#definition> "The Step a Transition enters."@en ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "toStep" ;
        <http://www.w3.org/2004/02/skos/core#scopeNote> "A Transition whose toStep was already reached earlier in the same Behavior's Step graph expresses a loop back-edge; a self-loop (toStep equal to fromStep) is the degenerate case."@en .


###  https://cyberterrain.org/ns/stonework#transactionCurrency
:transactionCurrency rdf:type owl:ObjectProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :FinancialTransaction ;
                     rdfs:range :Currency ;
                     <http://www.w3.org/2004/02/skos/core#definition> "Convenience projection of the currency of a single-denomination transaction's stonework:MonetaryAmount, for consumers that need one value without traversing stonework:hasMonetaryValue."@en ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "transactionCurrency"@en ;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "Do not use for a currency exchange with distinct input and output currencies; traverse stonework:originatorMonetaryValue and stonework:beneficiaryMonetaryValue to their stonework:currency values instead."@en .


###  https://cyberterrain.org/ns/stonework#transfersFile
:transfersFile rdf:type owl:ObjectProperty ;
               rdfs:domain :NetworkTraffic ;
               rdfs:range :File ;
               <http://www.w3.org/2004/02/skos/core#definition> "A File carried as payload in this NetworkTraffic flow. Covers both delivery (malware download) and exfiltration scenarios."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "transfersFile"@en .


###  https://cyberterrain.org/ns/stonework#triggeredBy
:triggeredBy rdf:type owl:ObjectProperty ;
             owl:inverseOf :triggersPlaybook ;
             rdfs:domain :Playbook ;
             rdfs:range [ rdf:type owl:Class ;
                          owl:unionOf ( :Event
                                        :Incident
                                      )
                        ] ;
             <http://www.w3.org/2004/02/skos/core#definition> "Relates a Playbook to the Event or Incident that initiates its execution."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "triggeredBy"@en .


###  https://cyberterrain.org/ns/stonework#triggersPlaybook
:triggersPlaybook rdf:type owl:ObjectProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( :Event
                                              :Incident
                                            )
                              ] ;
                  rdfs:range :Playbook ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Relates an Event or Incident to a Playbook invoked in response."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "triggersPlaybook"@en .


###  https://cyberterrain.org/ns/stonework#urlOf
:urlOf rdf:type owl:ObjectProperty ;
       rdfs:domain :URI ;
       <http://www.w3.org/2004/02/skos/core#definition> "The entity this URI serves as a locator or persistent identifier for."@en ;
       <http://www.w3.org/2004/02/skos/core#prefLabel> "urlOf" .


###  https://cyberterrain.org/ns/stonework#uses
:uses rdf:type owl:ObjectProperty ;
      <http://www.w3.org/2004/02/skos/core#definition> "Relates a threat actor group, campaign, malware, or tool to an offensive technique, malware, or tool it is known to employ." ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "uses" ;
      <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain/range intentionally left unset: this property is a direct lift of the STIX 2.1 relationship_type 'uses' shortcut (sub-property stones:uses carries the shortcut triples emitted by the STIX 2.1 transform). STIX does not schema-constrain which SDO/SCO types may appear as source_ref/target_ref for a given relationship_type — that's producer convention, not enforceable structure. In the MITRE ATT&CK bundle alone, observed 'uses' sources include Campaign, IntrusionSet, Malware, and Tool, and observed targets include AttackTechnique, Malware, and Tool — a closed domain/range would misrepresent this real data and mislead reasoner-based consumers. Query-time discrimination (e.g. selecting only IntrusionSet users of a technique) should filter on the asserted stones:stixType literal or a specific rdf:type, not assume it from this property alone."@en .


###  https://cyberterrain.org/ns/stonework#usesDetectionRule
:usesDetectionRule rdf:type owl:ObjectProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :DetectionPlan
                                               :Step
                                             )
                               ] ;
                   rdfs:range :DetectionRule ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Relates a DetectionPlan or Step to a DetectionRule that it evaluates or invokes."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "usesDetectionRule"@en ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Use stonework:usesRule for the deployment-side relationship between a Sensor and a DetectionRule."@en .


###  https://cyberterrain.org/ns/stonework#usesInfrastructure
:usesInfrastructure rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :uses ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( :Agent
                                                :CyberActivity
                                                :Malware
                                                :Product
                                              )
                                ] ;
                    rdfs:range :Infrastructure ;
                    <http://www.w3.org/2004/02/skos/core#definition> "Relates malware, a product, cyber activity, or agent to infrastructure it uses."@en ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "usesInfrastructure"@en ;
                    <http://www.w3.org/2004/02/skos/core#scopeNote> "Use for an operational dependency on infrastructure, such as malware using command-and-control infrastructure, a CyberActivityCluster or Campaign using hosting infrastructure, a product using a supporting service, or an Agent using infrastructure in an operation. This relationship asserts use, not ownership, compromise, or attribution."@en .


###  https://cyberterrain.org/ns/stonework#usesInstrument
:usesInstrument rdf:type owl:ObjectProperty ;
                rdfs:domain :FinancialTransaction ;
                rdfs:range :PaymentInstrument ;
                <http://www.w3.org/2004/02/skos/core#definition> "The payment instrument or rail used to execute this transaction — wire, ACH, SEPA, card, cash, on-chain transfer, and so on."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "usesInstrument"@en .


###  https://cyberterrain.org/ns/stonework#usesRule
:usesRule rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :uses ;
          rdfs:domain :Sensor ;
          rdfs:range :DetectionRule ;
          <http://www.w3.org/2004/02/skos/core#definition> "Relates a Sensor to the Detection Rules it applies." ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "usesRule" .


###  https://cyberterrain.org/ns/stonework#valuationCurrency
:valuationCurrency rdf:type owl:ObjectProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :MetricObservation ;
                   rdfs:range :Currency ;
                   <http://www.w3.org/2004/02/skos/core#definition> "The currency in which a normalized monetary metric value is expressed."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "valuationCurrency"@en ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Required for a stonework:MetricObservation whose stonework:metricType is stonework:metricNormalizedValue. The source amount retains its own stonework:currency; this property identifies the output unit produced by the cited exchange-rate source."@en .


###  https://cyberterrain.org/ns/stonework#variantOf
:variantOf rdf:type owl:ObjectProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :MalwareFamily
                                       :MalwareSample
                                     )
                       ] ;
           rdfs:range [ rdf:type owl:Class ;
                        owl:unionOf ( :MalwareFamily
                                      :MalwareSample
                                    )
                      ] ;
           <http://www.w3.org/2004/02/skos/core#definition> "Relates a MalwareFamily or MalwareSample to another family or sample from which it is derived, modified, or evolved, indicating shared code lineage, forked development, or deliberate repackaging."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "variantOf" .


###  https://cyberterrain.org/ns/stonework#vendorOf
:vendorOf rdf:type owl:ObjectProperty ;
          rdfs:domain :Agent ;
          rdfs:range :Product ;
          <http://www.w3.org/2004/02/skos/core#definition> "Relates an Agent to a product family it develops or maintains."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "vendorOf"@en .


###  https://cyberterrain.org/ns/stonework#versionOf
:versionOf rdf:type owl:ObjectProperty ;
           owl:inverseOf :hasVersion ;
           rdf:type owl:FunctionalProperty ;
           rdfs:domain :VersionedProduct ;
           rdfs:range :Product ;
           <http://www.w3.org/2004/02/skos/core#definition> "Links a specific versioned product instance back to its abstract product family."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "versionOf"@en .


###  https://cyberterrain.org/ns/stonework#weaknessOf
:weaknessOf rdf:type owl:ObjectProperty ;
            owl:inverseOf :hasWeakness ;
            rdfs:domain :Weakness ;
            rdfs:range :Vulnerability ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relates a weakness to the vulnerability that exploits or instantiates it."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "weaknessOf"@en ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "The range is a vulnerability individual. The weakness individual (domain) is a stonework:Weakness whose IRI is derived from the CWE identifier. The weakness individual may be populated by a separate CWE ingest."@en .


###  https://cyberterrain.org/ns/stonework#worksFor
:worksFor rdf:type owl:ObjectProperty ;
          rdfs:domain :Person ;
          rdfs:range :Organization ;
          <http://www.w3.org/2004/02/skos/core#definition> "Relates a Person to the Organization they work for."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "worksFor"@en .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/dc/terms/abstract
<http://purl.org/dc/terms/abstract> rdf:type owl:DatatypeProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:DatatypeProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:DatatypeProperty .


###  http://purl.org/dc/terms/identifier
<http://purl.org/dc/terms/identifier> rdf:type owl:DatatypeProperty .


###  http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> rdf:type owl:DatatypeProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:DatatypeProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:DatatypeProperty .


###  http://www.w3.org/2004/02/skos/core#notation
<http://www.w3.org/2004/02/skos/core#notation> rdf:type owl:DatatypeProperty .


###  https://cyberterrain.org/ns/stonework#abaRoutingNumber
:abaRoutingNumber rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :FinancialInstitution ;
                  rdfs:range xsd:string ;
                  <http://www.w3.org/2004/02/skos/core#definition> "The US ABA routing transit number of this institution. National branch or bank codes from other schemes, for example a UK sort code, may be recorded with the same property pending scheme-specific refinement."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "abaRoutingNumber"@en .


###  https://cyberterrain.org/ns/stonework#accountName
:accountName rdf:type owl:DatatypeProperty ;
             rdfs:domain :UserAccount ;
             rdfs:range xsd:string ;
             <http://www.w3.org/2004/02/skos/core#definition> "The username or account identifier on the target system or service."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "accountName"@en .


###  https://cyberterrain.org/ns/stonework#accountNumber
:accountNumber rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :BankAccountNumber ;
               rdfs:range xsd:string ;
               <http://www.w3.org/2004/02/skos/core#definition> "The domestic account number string."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "accountNumber"@en .


###  https://cyberterrain.org/ns/stonework#amount
:amount rdf:type owl:DatatypeProperty ,
                 owl:FunctionalProperty ;
        rdfs:domain :MonetaryAmount ;
        rdfs:range xsd:decimal ;
        <http://www.w3.org/2004/02/skos/core#definition> "The magnitude of a stonework:MonetaryAmount, in the units of its stonework:currency. Negative values represent debit or overdrawn balances; transaction amounts are non-negative by convention, with direction carried by originator and beneficiary roles."@en ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "amount"@en .


###  https://cyberterrain.org/ns/stonework#asName
:asName rdf:type owl:DatatypeProperty ;
        rdfs:domain :AutonomousSystem ;
        rdfs:range xsd:string ;
        <http://www.w3.org/2004/02/skos/core#definition> "The registered name or handle of the autonomous system."@en ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "asName"@en .


###  https://cyberterrain.org/ns/stonework#asNumber
:asNumber rdf:type owl:DatatypeProperty ;
          rdfs:domain :AutonomousSystem ;
          rdfs:range xsd:unsignedInt ;
          <http://www.w3.org/2004/02/skos/core#definition> "The Autonomous System Number (ASN) assigned by IANA."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "asNumber"@en .


###  https://cyberterrain.org/ns/stonework#assertionRelationType
:assertionRelationType rdf:type owl:DatatypeProperty ,
                                owl:FunctionalProperty ;
                       rdfs:domain :QualifiedAssertion ;
                       rdfs:range xsd:string ;
                       <http://www.w3.org/2004/02/skos/core#definition> "The source vocabulary's wire-level name for the relation expressed by a qualified assertion."@en ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "assertion relation type"@en ;
                       <http://www.w3.org/2004/02/skos/core#scopeNote> "Preserves open relationship vocabularies such as STIX relationship_type strings. A separately materialized object property may provide a query-friendly projection of the same assertion."@en .


###  https://cyberterrain.org/ns/stonework#attackId
:attackId rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#notation> ;
          rdfs:range xsd:string ;
          <http://www.w3.org/2004/02/skos/core#definition> "The MITRE ATT&CK identifier of an ATT&CK object, as ATT&CK displays it: Txxxx or Txxxx.yyy (technique, sub-technique), TAxxxx (tactic), Gxxxx (group), Sxxxx (software), Mxxxx (mitigation), Cxxxx (campaign), DETxxxx (detection strategy), ANxxxx (analytic), DCxxxx (data component)."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "attackId"@en ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain deliberately unset: every kind of ATT&CK object has an ATT&CK ID. The canonical and source forms are the same, so attack:attackId specializes both this property and stonework:externalId. Not unique across object types (ATT&CK's deprecated mitigations reuse technique T-numbers): look an object up by its ID together with its class. Distinct from stonework:relatedTechniqueIdentifier, which carries an ATT&CK technique ID on another framework's entity (e.g. a CAPEC pattern) as a join key; attackId is the ATT&CK object's own identifier."@en .


###  https://cyberterrain.org/ns/stonework#bic
:bic rdf:type owl:DatatypeProperty ,
              owl:FunctionalProperty ;
     rdfs:domain :FinancialInstitution ;
     rdfs:range xsd:string ;
     <http://www.w3.org/2004/02/skos/core#definition> "The Business Identifier Code (SWIFT/BIC, ISO 9362) of this institution."@en ;
     <http://www.w3.org/2004/02/skos/core#prefLabel> "bic"@en .


###  https://cyberterrain.org/ns/stonework#blockchainNetwork
:blockchainNetwork rdf:type owl:DatatypeProperty ;
                   rdfs:domain :CryptoAsset ;
                   rdfs:range xsd:string ;
                   <http://www.w3.org/2004/02/skos/core#definition> "The distributed ledger a crypto asset is native to or issued on (e.g. Bitcoin, Ethereum, Tron, Monero). The same nominal token issued on more than one ledger is modeled as distinct CryptoAsset individuals."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "blockchainNetwork"@en .


###  https://cyberterrain.org/ns/stonework#bomFormat
:bomFormat rdf:type owl:DatatypeProperty ;
           rdfs:range xsd:string ;
           <http://www.w3.org/2004/02/skos/core#definition> "The exchange format and version in which a Bill of Materials was originally serialized (e.g. 'CycloneDX 1.6', 'SPDX 2.3')." ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "BOM format" ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain intentionally left unset. Serves as provenance metadata on stonework:SoftwareBillOfMaterials instances, distinguishing the source format from the STONEWORK representation." .


###  https://cyberterrain.org/ns/stonework#boundToLiteral
:boundToLiteral rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :Variable ;
                rdfs:range rdfs:Literal ;
                <http://www.w3.org/2004/02/skos/core#definition> "Binds a Variable, at execution time or at plan instantiation, to a scalar result value such as a boolean, count, or numeric score."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "boundToLiteral" ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Tested by stonework:guardLiteralValue and stonework:guardOperator on a Transition. When the guard uses an ordering operator (LessThan, GreaterThanOrEqual, etc.), this value MUST carry a numeric datatype (xsd:decimal, xsd:double, or xsd:integer) — untyped or string literals do not compare numerically under SPARQL."@en .


###  https://cyberterrain.org/ns/stonework#byteCount
:byteCount rdf:type owl:DatatypeProperty ;
           rdfs:domain :NetworkTraffic ;
           rdfs:range xsd:nonNegativeInteger ;
           <http://www.w3.org/2004/02/skos/core#definition> "The total number of bytes transmitted in the traffic flow."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "byteCount"@en .


###  https://cyberterrain.org/ns/stonework#capecId
:capecId rdf:type owl:DatatypeProperty ;
         rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#notation> ;
         rdfs:domain :AttackPattern ;
         rdfs:range xsd:string ;
         <http://www.w3.org/2004/02/skos/core#definition> "The CAPEC identifier in the format CAPEC-NNN."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "capecId"@en ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "The canonical form a person types and searches for. The source-native number (e.g. '66') is capec:capecId, which specializes stonework:externalId."@en .


###  https://cyberterrain.org/ns/stonework#certIssuerDN
:certIssuerDN rdf:type owl:DatatypeProperty ;
              rdfs:domain :Certificate ;
              rdfs:range xsd:string ;
              <http://www.w3.org/2004/02/skos/core#definition> "The Distinguished Name of the Certificate Authority that issued the certificate."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "certIssuerDN"@en .


###  https://cyberterrain.org/ns/stonework#certSerialNumber
:certSerialNumber rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Certificate ;
                  rdfs:range xsd:string ;
                  <http://www.w3.org/2004/02/skos/core#definition> "The unique serial number assigned to the certificate by the issuing CA."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "certSerialNumber"@en .


###  https://cyberterrain.org/ns/stonework#certSubjectDN
:certSubjectDN rdf:type owl:DatatypeProperty ;
               rdfs:domain :Certificate ;
               rdfs:range xsd:string ;
               <http://www.w3.org/2004/02/skos/core#definition> "The Distinguished Name of the certificate subject."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "certSubjectDN"@en .


###  https://cyberterrain.org/ns/stonework#certValidNotAfter
:certValidNotAfter rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Certificate ;
                   rdfs:range xsd:dateTime ;
                   <http://www.w3.org/2004/02/skos/core#definition> "The end of the certificate's validity period."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "certValidNotAfter"@en .


###  https://cyberterrain.org/ns/stonework#certValidNotBefore
:certValidNotBefore rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Certificate ;
                    rdfs:range xsd:dateTime ;
                    <http://www.w3.org/2004/02/skos/core#definition> "The start of the certificate's validity period."@en ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "certValidNotBefore"@en .


###  https://cyberterrain.org/ns/stonework#cidrNotation
:cidrNotation rdf:type owl:DatatypeProperty ;
              rdfs:domain :IPBlock ;
              rdfs:range xsd:string ;
              <http://www.w3.org/2004/02/skos/core#definition> "The CIDR notation representing the IP address block (e.g. 192.168.0.0/16)."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "cidrNotation"@en .


###  https://cyberterrain.org/ns/stonework#commandLine
:commandLine rdf:type owl:DatatypeProperty ;
             rdfs:domain :RuntimeProcess ;
             rdfs:range xsd:string ;
             <http://www.w3.org/2004/02/skos/core#definition> "The full command line string used to launch the process."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "commandLine"@en .


###  https://cyberterrain.org/ns/stonework#compilationTimestamp
:compilationTimestamp rdf:type owl:DatatypeProperty ;
                      rdfs:domain :MalwareSample ;
                      rdfs:range xsd:dateTime ;
                      <http://www.w3.org/2004/02/skos/core#definition> "The timestamp embedded in the binary indicating when the malware was compiled."@en ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "compilationTimestamp"@en .


###  https://cyberterrain.org/ns/stonework#confidence
:confidence rdf:type owl:DatatypeProperty ;
            rdfs:range xsd:integer ;
            <http://www.w3.org/2004/02/skos/core#definition> "An integer score from 0 to 100 representing confidence in the accuracy of an assertion or the expected outcome of a Hypothesis."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "confidence" ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain is intentionally unset because the property is shared by Hypotheses and STIX-derived intelligence objects. Matches the STIX 2.1 confidence scale for round-tripping. For source- and time-qualified confidence history, use stonework:MetricObservation with stonework:metricConfidence."@en .


###  https://cyberterrain.org/ns/stonework#content
:content rdf:type owl:DatatypeProperty ;
         rdfs:domain :Note ;
         rdfs:range xsd:string ;
         <http://www.w3.org/2004/02/skos/core#definition> "The full text content of the note."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "content"@en .


###  https://cyberterrain.org/ns/stonework#controlBaseline
:controlBaseline rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Control ;
                 rdfs:range xsd:string ;
                 <http://www.w3.org/2004/02/skos/core#definition> "The security baseline(s) in which this control is required (e.g. Low, Moderate, High for NIST 800-53)."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "controlBaseline"@en .


###  https://cyberterrain.org/ns/stonework#controlFamily
:controlFamily rdf:type owl:DatatypeProperty ;
               rdfs:domain :Control ;
               rdfs:range xsd:string ;
               <http://www.w3.org/2004/02/skos/core#definition> "The control family or category grouping (e.g. Access Control, Incident Response)."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "controlFamily"@en .


###  https://cyberterrain.org/ns/stonework#controlId
:controlId rdf:type owl:DatatypeProperty ;
           rdfs:domain :Control ;
           rdfs:range xsd:string ;
           <http://www.w3.org/2004/02/skos/core#definition> "The framework-specific identifier for the control (e.g. AC-2, CIS 4.1)."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "controlId"@en .


###  https://cyberterrain.org/ns/stonework#countryCode
:countryCode rdf:type owl:DatatypeProperty ;
             rdfs:domain :Country ;
             rdfs:range xsd:string ;
             <http://www.w3.org/2004/02/skos/core#definition> "The ISO 3166-1 alpha-2 country code (e.g. US, CN, RU)."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "countryCode"@en .


###  https://cyberterrain.org/ns/stonework#cpeUri
:cpeUri rdf:type owl:DatatypeProperty ;
        rdfs:domain :VersionedProduct ;
        rdfs:range xsd:string ;
        <http://www.w3.org/2004/02/skos/core#definition> "The CPE 2.3 formatted string identifying this product version."@en ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "cpeUri"@en .


###  https://cyberterrain.org/ns/stonework#created
:created rdf:type owl:DatatypeProperty ;
         rdfs:subPropertyOf <http://purl.org/dc/terms/created> ;
         rdfs:range xsd:dateTime ;
         <http://www.w3.org/2004/02/skos/core#definition> "The timestamp when this individual was first created or recorded."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "created"@en ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "Compatibility alias for dcterms:created. Prefer dcterms:created in newly authored data."@en .


###  https://cyberterrain.org/ns/stonework#cveId
:cveId rdf:type owl:DatatypeProperty ;
       rdfs:subPropertyOf :vulnerabilityId ;
       rdfs:domain :Vulnerability ;
       rdfs:range xsd:string ;
       <http://www.w3.org/2004/02/skos/core#definition> "The CVE identifier in the format CVE-YYYY-NNNNN."@en ;
       <http://www.w3.org/2004/02/skos/core#prefLabel> "cveId"@en ;
       <http://www.w3.org/2004/02/skos/core#scopeNote> "Retained as the STONEWORK-level CVE-specific identifier. cve:cveId (declared rdfs:subPropertyOf this property) is the source-native alias always present on data ingested from CVE JSON; query this property for cross-source lookups."@en .


###  https://cyberterrain.org/ns/stonework#cvssBaseScore
:cvssBaseScore rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Vulnerability ;
               rdfs:range xsd:decimal ;
               <http://www.w3.org/2004/02/skos/core#definition> "The headline context-neutral CVSS base score for this vulnerability, on a 0.0–10.0 scale."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "cvssBaseScore"@en ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "When multiple CVSS versions are present, this SHOULD reflect the highest available version (CVSS 4.0 preferred over 3.1, 3.1 over 2.0). For full structured metric data across all CVSS versions use stonework:hasCvssMetric."@en .


###  https://cyberterrain.org/ns/stonework#cvssMetricBaseScore
:cvssMetricBaseScore rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :CvssMetric ;
                     rdfs:range xsd:decimal ;
                     <http://www.w3.org/2004/02/skos/core#definition> "The base score calculated by a structured CVSS assessment, on a 0.0-10.0 scale."@en ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "cvssMetricBaseScore"@en ;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "cve:baseScore (on cve:CvssMetric) is declared rdfs:subPropertyOf this property (one-way)."@en .


###  https://cyberterrain.org/ns/stonework#cvssMetricBaseSeverity
:cvssMetricBaseSeverity rdf:type owl:DatatypeProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain :CvssMetric ;
                        rdfs:range xsd:string ;
                        <http://www.w3.org/2004/02/skos/core#definition> "The qualitative severity corresponding to a structured CVSS assessment's base score."@en ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "cvssMetricBaseSeverity"@en ;
                        <http://www.w3.org/2004/02/skos/core#scopeNote> "cve:baseSeverity (on cve:CvssMetric) is declared rdfs:subPropertyOf this property (one-way)."@en .


###  https://cyberterrain.org/ns/stonework#cvssMetricVector
:cvssMetricVector rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :CvssMetric ;
                  rdfs:range xsd:string ;
                  <http://www.w3.org/2004/02/skos/core#definition> "The complete vector string used by a structured CVSS assessment."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "cvssMetricVector"@en ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "cve:vectorString (on cve:CvssMetric) is declared rdfs:subPropertyOf this property (one-way)."@en .


###  https://cyberterrain.org/ns/stonework#cvssMetricVersion
:cvssMetricVersion rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :CvssMetric ;
                   rdfs:range xsd:string ;
                   <http://www.w3.org/2004/02/skos/core#definition> "The CVSS specification version used by a structured assessment, such as 3.1 or 4.0."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "cvssMetricVersion"@en ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "cve:version carries this same value on cve:CvssMetric as a plain string, but is not declared a subproperty of this property because cve:version is shared with cve:VersionRange, a class this property's domain does not cover."@en .


###  https://cyberterrain.org/ns/stonework#cvssScore
:cvssScore rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf :cvssBaseScore ;
           rdfs:domain :Vulnerability ;
           rdfs:range xsd:decimal ;
           <http://www.w3.org/2004/02/skos/core#definition> "The CVSS base score (0.0–10.0) for the vulnerability."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "cvssScore"@en ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Retained for compatibility with the original datatype-property vocabulary. Prefer stonework:cvssBaseScore for new data."@en .


###  https://cyberterrain.org/ns/stonework#cvssSeverity
:cvssSeverity rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Vulnerability ;
              rdfs:range xsd:string ;
              <http://www.w3.org/2004/02/skos/core#definition> "The qualitative CVSS severity rating corresponding to the headline base score: NONE, LOW, MEDIUM, HIGH, or CRITICAL."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "cvssSeverity"@en .


###  https://cyberterrain.org/ns/stonework#cvssVector
:cvssVector rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :Vulnerability ;
            rdfs:range xsd:string ;
            <http://www.w3.org/2004/02/skos/core#definition> "The CVSS vector string encoding the metric values used to compute the headline base score, e.g. 'CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:H/I:H/A:H'."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "cvssVector"@en .


###  https://cyberterrain.org/ns/stonework#cweAbstractionLevel
:cweAbstractionLevel rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Weakness ;
                     rdfs:range xsd:string ;
                     <http://www.w3.org/2004/02/skos/core#definition> "The CWE abstraction level: Pillar, Class, Base, or Variant."@en ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "cweAbstractionLevel"@en .


###  https://cyberterrain.org/ns/stonework#cweId
:cweId rdf:type owl:DatatypeProperty ;
       rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#notation> ;
       rdfs:domain :Weakness ;
       rdfs:range xsd:string ;
       <http://www.w3.org/2004/02/skos/core#definition> "The CWE identifier in the format CWE-NNN."@en ;
       <http://www.w3.org/2004/02/skos/core#prefLabel> "cweId"@en ;
       <http://www.w3.org/2004/02/skos/core#scopeNote> "The canonical form a person types and searches for. The source-native number (e.g. '79') is cwe:cweId, which specializes stonework:externalId."@en .


###  https://cyberterrain.org/ns/stonework#dateAssigned
:dateAssigned rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Vulnerability ;
              rdfs:range xsd:dateTime ;
              <http://www.w3.org/2004/02/skos/core#definition> "The date and time at which a vulnerability identifier was assigned by the relevant numbering authority."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "dateAssigned"@en ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "Corresponds to cveMetadata.dateReserved in CVE JSON 5.x and equivalent assignment timestamps from other vulnerability sources. cve:dateAssigned is declared rdfs:subPropertyOf this property (one-way)."@en .


###  https://cyberterrain.org/ns/stonework#datePublic
:datePublic rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :Vulnerability ;
            rdfs:range xsd:dateTime ;
            <http://www.w3.org/2004/02/skos/core#definition> "The date and time at which this vulnerability was publicly disclosed."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "datePublic"@en ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Corresponds to cveMetadata.datePublished in CVE JSON 5.x and equivalent disclosure timestamps from other vulnerability sources. cve:datePublic is declared rdfs:subPropertyOf this property (one-way)."@en .


###  https://cyberterrain.org/ns/stonework#dateUpdated
:dateUpdated rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Vulnerability ;
             rdfs:range xsd:dateTime ;
             <http://www.w3.org/2004/02/skos/core#definition> "The date and time at which the vulnerability record was last modified in its source database."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "dateUpdated"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Corresponds to cveMetadata.dateUpdated in CVE JSON 5.x and equivalent update timestamps from other vulnerability sources. cve:dateUpdated is declared rdfs:subPropertyOf this property (one-way)."@en .


###  https://cyberterrain.org/ns/stonework#description
:description rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf <http://purl.org/dc/terms/description> ;
             rdfs:range rdfs:Literal ;
             <http://www.w3.org/2004/02/skos/core#definition> "A human-readable description of the described resource."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "description"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain is intentionally unset so framework-specific descriptions for vulnerabilities, weaknesses, attack patterns, and threat objects can share this canonical property. Prefer stonework:description in newly authored data."@en .


###  https://cyberterrain.org/ns/stonework#displayName
:displayName rdf:type owl:DatatypeProperty ;
             rdfs:domain :EmailAddress ;
             rdfs:range xsd:string ;
             <http://www.w3.org/2004/02/skos/core#definition> "The display name associated with the email address."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "displayName"@en .


###  https://cyberterrain.org/ns/stonework#domainName
:domainName rdf:type owl:DatatypeProperty ;
            rdfs:domain :Domain ;
            rdfs:range xsd:string ;
            <http://www.w3.org/2004/02/skos/core#definition> "The fully qualified domain name string (e.g. malicious-site.com)."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "domainName"@en .


###  https://cyberterrain.org/ns/stonework#dstPort
:dstPort rdf:type owl:DatatypeProperty ;
         rdfs:domain :NetworkTraffic ;
         rdfs:range xsd:unsignedShort ;
         <http://www.w3.org/2004/02/skos/core#definition> "The destination TCP/UDP port number."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "dstPort"@en .


###  https://cyberterrain.org/ns/stonework#emailValue
:emailValue rdf:type owl:DatatypeProperty ;
            rdfs:domain :EmailAddress ;
            rdfs:range xsd:string ;
            <http://www.w3.org/2004/02/skos/core#definition> "The email address string (local@domain)."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "emailValue"@en .


###  https://cyberterrain.org/ns/stonework#endedAtTime
:endedAtTime rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :CyberActivity ;
             rdfs:range xsd:dateTime ;
             rdfs:seeAlso <http://www.w3.org/ns/prov#endedAtTime> ;
             <http://www.w3.org/2004/02/skos/core#definition> "The date and time at which a CyberActivity ended."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "endedAtTime" .


###  https://cyberterrain.org/ns/stonework#epssScore
:epssScore rdf:type owl:DatatypeProperty ;
           rdfs:domain :Vulnerability ;
           rdfs:range xsd:decimal ;
           <http://www.w3.org/2004/02/skos/core#definition> "The EPSS (Exploit Prediction Scoring System) score (0.0–1.0), estimating the probability of exploitation in the wild within 30 days."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "epssScore"@en ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Convenience projection for a current score. Preserve dated values, source, and EPSS model version with stonework:MetricObservation and stonework:metricEpssScore."@en .


###  https://cyberterrain.org/ns/stonework#executablePath
:executablePath rdf:type owl:DatatypeProperty ;
                rdfs:domain :RuntimeProcess ;
                rdfs:range xsd:string ;
                <http://www.w3.org/2004/02/skos/core#definition> "The filesystem path of the process executable image."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "executablePath"@en .


###  https://cyberterrain.org/ns/stonework#expirationDate
:expirationDate rdf:type owl:DatatypeProperty ;
                rdfs:domain :Domain ;
                rdfs:range xsd:date ;
                <http://www.w3.org/2004/02/skos/core#definition> "The date the domain registration expires."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "expirationDate"@en .


###  https://cyberterrain.org/ns/stonework#externalId
:externalId rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf <http://purl.org/dc/terms/identifier> ;
            rdfs:range xsd:string ;
            <http://www.w3.org/2004/02/skos/core#definition> "An identifier from an external system or framework (e.g. STIX ID, MITRE ATT&CK ID, NVD CVE ID)."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "externalId"@en ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Compatibility alias for dcterms:identifier when the value originates in an external system. Prefer dcterms:identifier when source context is already explicit."@en .


###  https://cyberterrain.org/ns/stonework#fileExtension
:fileExtension rdf:type owl:DatatypeProperty ;
               rdfs:domain :File ;
               rdfs:range xsd:string ;
               <http://www.w3.org/2004/02/skos/core#definition> "The file extension without the leading dot (e.g. exe, dll, ps1)."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "fileExtension"@en .


###  https://cyberterrain.org/ns/stonework#fileName
:fileName rdf:type owl:DatatypeProperty ;
          rdfs:domain :File ;
          rdfs:range xsd:string ;
          <http://www.w3.org/2004/02/skos/core#definition> "The name of the file without path."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "fileName"@en .


###  https://cyberterrain.org/ns/stonework#filePath
:filePath rdf:type owl:DatatypeProperty ;
          rdfs:domain :File ;
          rdfs:range xsd:string ;
          <http://www.w3.org/2004/02/skos/core#definition> "The full filesystem path of the file."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "filePath"@en .


###  https://cyberterrain.org/ns/stonework#fileSize
:fileSize rdf:type owl:DatatypeProperty ;
          rdfs:domain :File ;
          rdfs:range xsd:nonNegativeInteger ;
          <http://www.w3.org/2004/02/skos/core#definition> "The size of the file in bytes."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "fileSize"@en .


###  https://cyberterrain.org/ns/stonework#firstSeen
:firstSeen rdf:type owl:DatatypeProperty ;
           rdfs:range xsd:dateTime ;
           <http://www.w3.org/2004/02/skos/core#definition> "The timestamp when the entity was first observed."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "firstSeen"@en ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Use with stonework:lastSeen to delimit an observation window. For the execution interval of a stonework:CyberActivity, use stonework:startedAtTime and stonework:endedAtTime instead."@en .


###  https://cyberterrain.org/ns/stonework#fqdn
:fqdn rdf:type owl:DatatypeProperty ;
      rdfs:domain :Host ;
      rdfs:range xsd:string ;
      <http://www.w3.org/2004/02/skos/core#definition> "The fully qualified domain name of the host."@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "fqdn"@en .


###  https://cyberterrain.org/ns/stonework#groupName
:groupName rdf:type owl:DatatypeProperty ;
           rdfs:domain :UserGroup ;
           rdfs:range xsd:string ;
           <http://www.w3.org/2004/02/skos/core#definition> "The name of the user group."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "groupName"@en .


###  https://cyberterrain.org/ns/stonework#guardLiteralValue
:guardLiteralValue rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :Transition ;
                   rdfs:range rdfs:Literal ;
                   <http://www.w3.org/2004/02/skos/core#definition> "The literal value that guardVariable's bound value is compared against."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "guardLiteralValue" ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Compared using the operator given by stonework:guardOperator; if guardOperator is omitted, comparison defaults to Equals. Must share a compatible, numerically-typed datatype with the guardVariable's stonework:boundToLiteral value when an ordering operator is used."@en .


###  https://cyberterrain.org/ns/stonework#hashAlgorithm
:hashAlgorithm rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Hash ;
               rdfs:range xsd:string ;
               <http://www.w3.org/2004/02/skos/core#definition> "The cryptographic hash algorithm used (e.g. MD5, SHA-1, SHA-256, SHA-512, SSDEEP)."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "hashAlgorithm"@en .


###  https://cyberterrain.org/ns/stonework#hashValue
:hashValue rdf:type owl:DatatypeProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :Hash ;
           rdfs:range xsd:string ;
           <http://www.w3.org/2004/02/skos/core#definition> "The hex-encoded digest produced by the hash algorithm."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "hashValue"@en .


###  https://cyberterrain.org/ns/stonework#hostname
:hostname rdf:type owl:DatatypeProperty ;
          rdfs:domain :Host ;
          rdfs:range xsd:string ;
          <http://www.w3.org/2004/02/skos/core#definition> "The system hostname or NetBIOS name."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "hostname"@en .


###  https://cyberterrain.org/ns/stonework#iban
:iban rdf:type owl:DatatypeProperty ,
               owl:FunctionalProperty ;
      rdfs:domain :IBAN ;
      rdfs:range xsd:string ;
      <http://www.w3.org/2004/02/skos/core#definition> "The IBAN string, including country prefix and check digits."@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "iban"@en .


###  https://cyberterrain.org/ns/stonework#ipValue
:ipValue rdf:type owl:DatatypeProperty ;
         rdfs:domain :IPAddress ;
         rdfs:range xsd:string ;
         <http://www.w3.org/2004/02/skos/core#definition> "The dotted-decimal or colon-hex string representation of the IP address."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "ipValue"@en .


###  https://cyberterrain.org/ns/stonework#ipVersion
:ipVersion rdf:type owl:DatatypeProperty ;
           rdfs:domain :IPAddress ;
           rdfs:range [ rdf:type rdfs:Datatype ;
                        owl:oneOf [ rdf:type rdf:List ;
                                    rdf:first 4 ;
                                    rdf:rest [ rdf:type rdf:List ;
                                               rdf:first 6 ;
                                               rdf:rest rdf:nil
                                             ]
                                  ]
                      ] ;
           <http://www.w3.org/2004/02/skos/core#definition> "The IP protocol version: 4 or 6."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "ipVersion"@en .


###  https://cyberterrain.org/ns/stonework#isKnownExploited
:isKnownExploited rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Vulnerability ;
                  rdfs:range xsd:boolean ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Indicates whether this vulnerability appears in CISA's Known Exploited Vulnerabilities (KEV) catalog."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "isKnownExploited"@en ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "Convenience projection for a current catalog snapshot. A false value is only meaningful as of a specific time; preserve dated membership evidence with stonework:MetricObservation and stonework:metricKevMembership."@en .


###  https://cyberterrain.org/ns/stonework#isPacked
:isPacked rdf:type owl:DatatypeProperty ;
          rdfs:domain :MalwareSample ;
          rdfs:range xsd:boolean ;
          <http://www.w3.org/2004/02/skos/core#definition> "Indicates whether the sample has been packed or obfuscated."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "isPacked"@en .


###  https://cyberterrain.org/ns/stonework#isPrivileged
:isPrivileged rdf:type owl:DatatypeProperty ;
              rdfs:domain :UserAccount ;
              rdfs:range xsd:boolean ;
              <http://www.w3.org/2004/02/skos/core#definition> "Indicates whether the account has elevated or administrative privileges."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "isPrivileged"@en .


###  https://cyberterrain.org/ns/stonework#lastSeen
:lastSeen rdf:type owl:DatatypeProperty ;
          rdfs:range xsd:dateTime ;
          <http://www.w3.org/2004/02/skos/core#definition> "The most recent timestamp when the entity was observed."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "lastSeen"@en ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "Use with stonework:firstSeen to delimit an observation window. For the execution interval of a stonework:CyberActivity, use stonework:startedAtTime and stonework:endedAtTime instead."@en .


###  https://cyberterrain.org/ns/stonework#latitude
:latitude rdf:type owl:DatatypeProperty ;
          rdfs:domain :Location ;
          rdfs:range xsd:decimal ;
          <http://www.w3.org/2004/02/skos/core#definition> "The geographic latitude in decimal degrees (WGS 84)."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "latitude"@en .


###  https://cyberterrain.org/ns/stonework#lei
:lei rdf:type owl:DatatypeProperty ,
              owl:FunctionalProperty ;
     rdfs:domain :Organization ;
     rdfs:range xsd:string ;
     <http://www.w3.org/2004/02/skos/core#definition> "The Legal Entity Identifier (ISO 17442) of this organization — a general legal-entity identifier applicable to any organization party to a financial transaction, not only financial institutions."@en ;
     <http://www.w3.org/2004/02/skos/core#prefLabel> "lei"@en .


###  https://cyberterrain.org/ns/stonework#likelihoodScore
:likelihoodScore rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Likelihood ;
                 rdfs:range xsd:decimal ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A numeric score (0.0–1.0) representing the estimated probability of occurrence."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "likelihoodScore"@en ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Convenience projection for a current value. Use stonework:MetricObservation with stonework:metricLikelihoodScore when source, assessment time, or model version must be preserved."@en .


###  https://cyberterrain.org/ns/stonework#locationPrecision
:locationPrecision rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :Location ;
                   rdfs:range xsd:decimal ;
                   <http://www.w3.org/2004/02/skos/core#definition> "The radius, in meters, of uncertainty around this Location's stonework:latitude and stonework:longitude."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "locationPrecision"@en ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Corresponds to the STIX 2.1 Location precision property. Use it to distinguish an exact facility coordinate from a city- or region-level centroid, such as a geolocated IP address or an event geotagged from a news report. Omit it when the precision is unknown."@en .


###  https://cyberterrain.org/ns/stonework#logSource
:logSource rdf:type owl:DatatypeProperty ;
           rdfs:domain :Log ;
           rdfs:range xsd:string ;
           <http://www.w3.org/2004/02/skos/core#definition> "The system, component, or application that generated the log (e.g. Windows Security, syslog, Apache)."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "logSource"@en .


###  https://cyberterrain.org/ns/stonework#longitude
:longitude rdf:type owl:DatatypeProperty ;
           rdfs:domain :Location ;
           rdfs:range xsd:decimal ;
           <http://www.w3.org/2004/02/skos/core#definition> "The geographic longitude in decimal degrees (WGS 84)."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "longitude"@en .


###  https://cyberterrain.org/ns/stonework#metricValue
:metricValue rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :MetricObservation ;
             rdfs:range rdfs:Literal ;
             <http://www.w3.org/2004/02/skos/core#definition> "The typed literal value recorded by a MetricObservation."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "metricValue"@en .


###  https://cyberterrain.org/ns/stonework#mimeType
:mimeType rdf:type owl:DatatypeProperty ;
          rdfs:domain :File ;
          rdfs:range xsd:string ;
          <http://www.w3.org/2004/02/skos/core#definition> "The MIME type of the file (e.g. application/x-executable, text/html)."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "mimeType"@en .


###  https://cyberterrain.org/ns/stonework#minorUnitDigits
:minorUnitDigits rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :Currency ;
                 rdfs:range xsd:nonNegativeInteger ;
                 <http://www.w3.org/2004/02/skos/core#definition> "The number of decimal places in the currency's minor unit — 0 for JPY, 2 for USD, 3 for BHD — as defined by ISO 4217 for fiat currencies."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "minorUnitDigits"@en .


###  https://cyberterrain.org/ns/stonework#modelVersion
:modelVersion rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :MetricObservation ;
              rdfs:range xsd:string ;
              <http://www.w3.org/2004/02/skos/core#definition> "The version identifier of the scoring, prediction, or assessment model that produced a metric observation."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "modelVersion"@en .


###  https://cyberterrain.org/ns/stonework#modified
:modified rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf <http://purl.org/dc/terms/modified> ;
          rdfs:range xsd:dateTime ;
          <http://www.w3.org/2004/02/skos/core#definition> "The timestamp when this individual was last modified."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "modified"@en ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "Compatibility alias for dcterms:modified. Prefer dcterms:modified in newly authored data."@en .


###  https://cyberterrain.org/ns/stonework#mutexName
:mutexName rdf:type owl:DatatypeProperty ;
           rdfs:domain :Mutex ;
           rdfs:range xsd:string ;
           <http://www.w3.org/2004/02/skos/core#definition> "The name string of the mutex object."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "mutexName"@en .


###  https://cyberterrain.org/ns/stonework#networkProtocol
:networkProtocol rdf:type owl:DatatypeProperty ;
                 rdfs:domain :NetworkTraffic ;
                 rdfs:range xsd:string ;
                 <http://www.w3.org/2004/02/skos/core#definition> "The network or transport protocol (e.g. TCP, UDP, ICMP, HTTP, DNS)."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "networkProtocol"@en .


###  https://cyberterrain.org/ns/stonework#objective
:objective rdf:type owl:DatatypeProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :Campaign
                                       :Operation
                                       :ThreatActor
                                     )
                       ] ;
           rdfs:range xsd:string ;
           <http://www.w3.org/2004/02/skos/core#definition> "A description of the strategic goal or objective being pursued."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "objective"@en .


###  https://cyberterrain.org/ns/stonework#observedAt
:observedAt rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :MetricObservation ;
            rdfs:range xsd:dateTime ;
            <http://www.w3.org/2004/02/skos/core#definition> "The date and time at which a metric observation was made or calculated."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "observedAt"@en .


###  https://cyberterrain.org/ns/stonework#osName
:osName rdf:type owl:DatatypeProperty ;
        rdfs:domain :Host ;
        rdfs:range xsd:string ;
        <http://www.w3.org/2004/02/skos/core#definition> "The name of the operating system running on the host (e.g. Windows, Linux, macOS)."@en ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "osName"@en .


###  https://cyberterrain.org/ns/stonework#osVersion
:osVersion rdf:type owl:DatatypeProperty ;
           rdfs:domain :Host ;
           rdfs:range xsd:string ;
           <http://www.w3.org/2004/02/skos/core#definition> "The version string of the operating system."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "osVersion"@en .


###  https://cyberterrain.org/ns/stonework#packerName
:packerName rdf:type owl:DatatypeProperty ;
            rdfs:domain :MalwareSample ;
            rdfs:range xsd:string ;
            <http://www.w3.org/2004/02/skos/core#definition> "The name of the packer or obfuscator used (e.g. UPX, Themida)."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "packerName"@en .


###  https://cyberterrain.org/ns/stonework#packetCount
:packetCount rdf:type owl:DatatypeProperty ;
             rdfs:domain :NetworkTraffic ;
             rdfs:range xsd:nonNegativeInteger ;
             <http://www.w3.org/2004/02/skos/core#definition> "The total number of packets observed in the traffic flow."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "packetCount"@en .


###  https://cyberterrain.org/ns/stonework#parentPid
:parentPid rdf:type owl:DatatypeProperty ;
           rdfs:domain :RuntimeProcess ;
           rdfs:range xsd:nonNegativeInteger ;
           <http://www.w3.org/2004/02/skos/core#definition> "The process identifier of the parent process."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "parentPid"@en .


###  https://cyberterrain.org/ns/stonework#phoneValue
:phoneValue rdf:type owl:DatatypeProperty ;
            rdfs:domain :PhoneNumber ;
            rdfs:range xsd:string ;
            <http://www.w3.org/2004/02/skos/core#definition> "The phone number string in E.164 or local format."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "phoneValue"@en .


###  https://cyberterrain.org/ns/stonework#pid
:pid rdf:type owl:DatatypeProperty ;
     rdfs:domain :RuntimeProcess ;
     rdfs:range xsd:nonNegativeInteger ;
     <http://www.w3.org/2004/02/skos/core#definition> "The process identifier assigned by the OS."@en ;
     <http://www.w3.org/2004/02/skos/core#prefLabel> "pid"@en .


###  https://cyberterrain.org/ns/stonework#playbookFormat
:playbookFormat rdf:type owl:DatatypeProperty ;
                rdfs:domain :Playbook ;
                rdfs:range xsd:string ;
                <http://www.w3.org/2004/02/skos/core#definition> "The machine-readable format of the playbook (e.g. CACAO JSON, BPMN, YAML)."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "playbookFormat"@en .


###  https://cyberterrain.org/ns/stonework#playbookVersion
:playbookVersion rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Playbook ;
                 rdfs:range xsd:string ;
                 <http://www.w3.org/2004/02/skos/core#definition> "The version string of the playbook."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "playbookVersion"@en .


###  https://cyberterrain.org/ns/stonework#port
:port rdf:type owl:DatatypeProperty ;
      rdfs:domain :NetworkService ;
      rdfs:range xsd:unsignedShort ;
      <http://www.w3.org/2004/02/skos/core#definition> "The TCP/UDP port number on which the service listens."@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "port"@en .


###  https://cyberterrain.org/ns/stonework#postalCode
:postalCode rdf:type owl:DatatypeProperty ;
            rdfs:domain :Location ;
            rdfs:range xsd:string ;
            <http://www.w3.org/2004/02/skos/core#definition> "The postal or ZIP code of the location."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "postalCode"@en .


###  https://cyberterrain.org/ns/stonework#predictedLiteral
:predictedLiteral rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :Hypothesis ;
                  rdfs:range rdfs:Literal ;
                  <http://www.w3.org/2004/02/skos/core#definition> "The scalar value a Hypothesis predicts its stonework:predictsVariable will be bound to, once executed."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "predictedLiteral" ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "Mirrors stonework:boundToLiteral on the actual-result side; see stonework:predictedValue for predictions of an individual rather than a scalar."@en .


###  https://cyberterrain.org/ns/stonework#productName
:productName rdf:type owl:DatatypeProperty ;
             rdfs:domain :Product ;
             rdfs:range xsd:string ;
             <http://www.w3.org/2004/02/skos/core#definition> "The canonical product name."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "productName"@en .


###  https://cyberterrain.org/ns/stonework#publishedDate
:publishedDate rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf <http://purl.org/dc/terms/issued> ;
               rdfs:range xsd:date ;
               <http://www.w3.org/2004/02/skos/core#definition> "The date the item was first publicly published or disclosed."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "publishedDate"@en ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "Compatibility alias for dcterms:issued. Prefer dcterms:issued in newly authored data."@en .


###  https://cyberterrain.org/ns/stonework#purl
:purl rdf:type owl:DatatypeProperty ;
      rdfs:domain :VersionedProduct ;
      rdfs:range xsd:anyURI ;
      <http://www.w3.org/2004/02/skos/core#definition> "The Package URL (PURL) identifying this software package version."@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "purl"@en .


###  https://cyberterrain.org/ns/stonework#rawEntry
:rawEntry rdf:type owl:DatatypeProperty ;
          rdfs:domain :Log ;
          rdfs:range xsd:string ;
          <http://www.w3.org/2004/02/skos/core#definition> "The raw, unprocessed log line or record."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "rawEntry"@en .


###  https://cyberterrain.org/ns/stonework#regionCode
:regionCode rdf:type owl:DatatypeProperty ;
            rdfs:domain :Region ;
            rdfs:range xsd:string ;
            <http://www.w3.org/2004/02/skos/core#definition> "The ISO 3166-2 region code (e.g. US-CA, GB-ENG)."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "regionCode"@en .


###  https://cyberterrain.org/ns/stonework#registrationDate
:registrationDate rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Domain ;
                  rdfs:range xsd:dateTime ;
                  <http://www.w3.org/2004/02/skos/core#definition> "The date and time when the domain was first registered."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "registrationDate"@en ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "Uses xsd:dateTime so source-native registration timestamps, including dns:registeredOn, can map without losing precision."@en .


###  https://cyberterrain.org/ns/stonework#registryKeyPath
:registryKeyPath rdf:type owl:DatatypeProperty ;
                 rdfs:domain :RegistryKey ;
                 rdfs:range xsd:string ;
                 <http://www.w3.org/2004/02/skos/core#definition> "The full registry key path (e.g. HKEY_LOCAL_MACHINE\\SOFTWARE\\...)."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "registryKeyPath"@en .


###  https://cyberterrain.org/ns/stonework#registryValueData
:registryValueData rdf:type owl:DatatypeProperty ;
                   rdfs:domain :RegistryValue ;
                   rdfs:range rdfs:Literal ;
                   <http://www.w3.org/2004/02/skos/core#definition> "The typed literal data stored in the registry value."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "registryValueData"@en ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "The broad literal range preserves string, numeric, multi-string, and binary-valued source representations. Use stonework:registryValueType to record the Windows registry type explicitly."@en .


###  https://cyberterrain.org/ns/stonework#registryValueName
:registryValueName rdf:type owl:DatatypeProperty ;
                   rdfs:domain :RegistryValue ;
                   rdfs:range xsd:string ;
                   <http://www.w3.org/2004/02/skos/core#definition> "The name of the registry value."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "registryValueName"@en .


###  https://cyberterrain.org/ns/stonework#registryValueType
:registryValueType rdf:type owl:DatatypeProperty ;
                   rdfs:domain :RegistryValue ;
                   rdfs:range xsd:string ;
                   <http://www.w3.org/2004/02/skos/core#definition> "The type of the registry value (e.g. REG_SZ, REG_DWORD, REG_BINARY)."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "registryValueType"@en .


###  https://cyberterrain.org/ns/stonework#relatedTechniqueIdentifier
:relatedTechniqueIdentifier rdf:type owl:DatatypeProperty ;
                            rdfs:range xsd:string ;
                            <http://www.w3.org/2004/02/skos/core#definition> "A framework-native technique identifier string (e.g. a MITRE ATT&CK technique ID such as 'T1003.001') carried on an entity from another framework, both for provenance and as the join key used to materialize the corresponding stonework:relatedAttackPattern or stonework:mitigatesAttackPattern edge."@en ;
                            <http://www.w3.org/2004/02/skos/core#prefLabel> "relatedTechniqueIdentifier" ;
                            <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain intentionally left unset: populated on entities as different as capec:AttackPattern and cis:Control. Framework-specific subproperties (e.g. capec:attackTechniqueId, cis:mitigatesTechniqueId) carry the concrete literal. Retained after materialization — it records the source string as ingested, distinct from the resolved object-property edge."@en .


###  https://cyberterrain.org/ns/stonework#reliability
:reliability rdf:type owl:DatatypeProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :HumanSource
                                         :Provenance
                                       )
                         ] ;
             rdfs:range xsd:string ;
             <http://www.w3.org/2004/02/skos/core#definition> "The assessed reliability of the source (e.g. using the NATO Admiralty Code A–F)."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "reliability"@en .


###  https://cyberterrain.org/ns/stonework#riskScore
:riskScore rdf:type owl:DatatypeProperty ;
           rdfs:domain :Risk ;
           rdfs:range xsd:decimal ;
           <http://www.w3.org/2004/02/skos/core#definition> "A numeric risk score expressing combined impact and likelihood."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "riskScore"@en ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Convenience projection for a current score. Use stonework:MetricObservation with stonework:metricRiskScore when methodology, source, model version, or assessment time must be preserved."@en .


###  https://cyberterrain.org/ns/stonework#ruleContent
:ruleContent rdf:type owl:DatatypeProperty ;
             rdfs:domain :DetectionRule ;
             rdfs:range xsd:string ;
             <http://www.w3.org/2004/02/skos/core#definition> "The full text content of the detection rule."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "ruleContent"@en .


###  https://cyberterrain.org/ns/stonework#ruleFormat
:ruleFormat rdf:type owl:DatatypeProperty ;
            rdfs:domain :DetectionRule ;
            rdfs:range xsd:string ;
            <http://www.w3.org/2004/02/skos/core#definition> "The format or language of the rule (e.g. YARA, Sigma, Snort, KQL, SPL)."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "ruleFormat"@en .


###  https://cyberterrain.org/ns/stonework#ruleName
:ruleName rdf:type owl:DatatypeProperty ;
          rdfs:domain :DetectionRule ;
          rdfs:range xsd:string ;
          <http://www.w3.org/2004/02/skos/core#definition> "The human-readable name of the detection rule."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "ruleName"@en .


###  https://cyberterrain.org/ns/stonework#ruleVersion
:ruleVersion rdf:type owl:DatatypeProperty ;
             rdfs:domain :DetectionRule ;
             rdfs:range xsd:string ;
             <http://www.w3.org/2004/02/skos/core#definition> "The version string of the detection rule."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "ruleVersion"@en .


###  https://cyberterrain.org/ns/stonework#serialNumber
:serialNumber rdf:type owl:DatatypeProperty ;
              rdfs:range xsd:string ;
              <http://www.w3.org/2004/02/skos/core#definition> "A globally unique identifier for a BOM document, typically expressed as a URN UUID (e.g. urn:uuid:...) per the CycloneDX specification or as a document namespace per SPDX." ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "serial number" ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain intentionally left unset. Primary subject is stonework:SoftwareBillOfMaterials. Use dcterms:created for the BOM timestamp."@en .


###  https://cyberterrain.org/ns/stonework#serviceBanner
:serviceBanner rdf:type owl:DatatypeProperty ;
               rdfs:domain :NetworkService ;
               rdfs:range xsd:string ;
               <http://www.w3.org/2004/02/skos/core#definition> "The banner string returned by the service upon connection."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "serviceBanner"@en .


###  https://cyberterrain.org/ns/stonework#serviceName
:serviceName rdf:type owl:DatatypeProperty ;
             rdfs:domain :NetworkService ;
             rdfs:range xsd:string ;
             <http://www.w3.org/2004/02/skos/core#definition> "The name of the network service (e.g. HTTP, SSH, RDP, SMB)."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "serviceName"@en .


###  https://cyberterrain.org/ns/stonework#serviceProtocol
:serviceProtocol rdf:type owl:DatatypeProperty ;
                 rdfs:domain :NetworkService ;
                 rdfs:range xsd:string ;
                 <http://www.w3.org/2004/02/skos/core#definition> "The transport protocol used by the service (e.g. TCP, UDP)."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "serviceProtocol"@en .


###  https://cyberterrain.org/ns/stonework#serviceVersion
:serviceVersion rdf:type owl:DatatypeProperty ;
                rdfs:domain :NetworkService ;
                rdfs:range xsd:string ;
                <http://www.w3.org/2004/02/skos/core#definition> "The version string of the service software."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "serviceVersion"@en .


###  https://cyberterrain.org/ns/stonework#severity
:severity rdf:type owl:DatatypeProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :Event
                                      :Incident
                                    )
                      ] ;
          rdfs:range xsd:string ;
          <http://www.w3.org/2004/02/skos/core#definition> "The assessed severity of the incident or event (e.g. critical, high, medium, low, informational)."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "severity"@en .


###  https://cyberterrain.org/ns/stonework#sightingCount
:sightingCount rdf:type owl:DatatypeProperty ;
               rdfs:domain :Sighting ;
               rdfs:range xsd:nonNegativeInteger ;
               <http://www.w3.org/2004/02/skos/core#definition> "The number of times the sighted object was observed."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "sightingCount"@en .


###  https://cyberterrain.org/ns/stonework#srcPort
:srcPort rdf:type owl:DatatypeProperty ;
         rdfs:domain :NetworkTraffic ;
         rdfs:range xsd:unsignedShort ;
         <http://www.w3.org/2004/02/skos/core#definition> "The source TCP/UDP port number."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "srcPort"@en .


###  https://cyberterrain.org/ns/stonework#startedAtTime
:startedAtTime rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :CyberActivity ;
               rdfs:range xsd:dateTime ;
               rdfs:seeAlso <http://www.w3.org/ns/prov#startedAtTime> ;
               <http://www.w3.org/2004/02/skos/core#definition> "The date and time at which a CyberActivity began."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "startedAtTime" .


###  https://cyberterrain.org/ns/stonework#stepOrder
:stepOrder rdf:type owl:DatatypeProperty ;
           rdfs:domain :Step ;
           rdfs:range xsd:integer ;
           <http://www.w3.org/2004/02/skos/core#definition> "An optional ordinal position for a Step within a strictly linear Behavior, where the full precededByStep graph is unnecessary."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "stepOrder" ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Most CTI procedure write-ups (a numbered list of adversary actions) are linear. stepOrder is a low-overhead alternative to precededByStep for that common case; the two are not mutually exclusive."@en .


###  https://cyberterrain.org/ns/stonework#streetAddress
:streetAddress rdf:type owl:DatatypeProperty ;
               rdfs:domain :Location ;
               rdfs:range xsd:string ;
               <http://www.w3.org/2004/02/skos/core#definition> "The street address of the location, such as a building number and street name."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "streetAddress"@en ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "Corresponds to the STIX 2.1 Location street_address property. Record the postal code with stonework:postalCode and the enclosing City, Region, or Country with stonework:locatedWithin rather than repeating them in this string."@en .


###  https://cyberterrain.org/ns/stonework#summary
:summary rdf:type owl:DatatypeProperty ;
         rdfs:subPropertyOf <http://purl.org/dc/terms/abstract> ;
         rdfs:domain :IntelligenceProduct ;
         rdfs:range xsd:string ;
         <http://www.w3.org/2004/02/skos/core#definition> "A brief summary of the intelligence product's key findings."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "summary"@en .


###  https://cyberterrain.org/ns/stonework#timestamp
:timestamp rdf:type owl:DatatypeProperty ;
           rdfs:range xsd:dateTime ;
           <http://www.w3.org/2004/02/skos/core#definition> "The date and time at which this observation or event occurred."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "timestamp"@en ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain is intentionally unset for point-in-time records. Use stonework:firstSeen and stonework:lastSeen for observation windows, and stonework:startedAtTime and stonework:endedAtTime for CyberActivity execution intervals."@en .


###  https://cyberterrain.org/ns/stonework#title
:title rdf:type owl:DatatypeProperty ;
       rdfs:subPropertyOf <http://purl.org/dc/terms/title> ;
       rdfs:range rdfs:Literal ;
       <http://www.w3.org/2004/02/skos/core#definition> "A human-readable title for the described resource."@en ;
       <http://www.w3.org/2004/02/skos/core#prefLabel> "title"@en ;
       <http://www.w3.org/2004/02/skos/core#scopeNote> "Domain is intentionally unset so framework-specific titles for controls, products, publications, and intelligence products can share this canonical property. Prefer dcterms:title in newly authored data."@en .


###  https://cyberterrain.org/ns/stonework#transactionAmount
:transactionAmount rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain :FinancialTransaction ;
                   rdfs:range xsd:decimal ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Convenience projection of the magnitude of a single-denomination transaction's stonework:MonetaryAmount, paired with stonework:transactionCurrency."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "transactionAmount"@en ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Do not use for a currency exchange with distinct input and output amounts; use stonework:originatorMonetaryValue and stonework:beneficiaryMonetaryValue instead."@en .


###  https://cyberterrain.org/ns/stonework#transactionReference
:transactionReference rdf:type owl:DatatypeProperty ;
                      rdfs:domain :FinancialTransaction ;
                      rdfs:range xsd:string ;
                      <http://www.w3.org/2004/02/skos/core#definition> "A reference string carried by this transaction — a wire reference or end-to-end identifier, a payment memo, or an on-chain transaction hash."@en ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "transactionReference"@en .


###  https://cyberterrain.org/ns/stonework#updateFrequency
:updateFrequency rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Feed ;
                 rdfs:range xsd:string ;
                 <http://www.w3.org/2004/02/skos/core#definition> "How often the feed is updated (e.g. hourly, daily, real-time)."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "updateFrequency"@en .


###  https://cyberterrain.org/ns/stonework#uriValue
:uriValue rdf:type owl:DatatypeProperty ;
          rdfs:domain :URI ;
          rdfs:range xsd:anyURI ;
          <http://www.w3.org/2004/02/skos/core#definition> "The full URI string conforming to RFC 3986."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "uriValue"@en .


###  https://cyberterrain.org/ns/stonework#url
:url rdf:type owl:DatatypeProperty ;
     rdfs:domain [ rdf:type owl:Class ;
                   owl:unionOf ( :Feed
                                 :OnlineReference
                                 :Publication
                               )
                 ] ;
     rdfs:range xsd:anyURI ;
     <http://www.w3.org/2004/02/skos/core#definition> "The URL of the online resource."@en ;
     <http://www.w3.org/2004/02/skos/core#prefLabel> "url"@en .


###  https://cyberterrain.org/ns/stonework#userAgentString
:userAgentString rdf:type owl:DatatypeProperty ;
                 rdfs:domain :UserAgent ;
                 rdfs:range xsd:string ;
                 <http://www.w3.org/2004/02/skos/core#definition> "The raw HTTP User-Agent header string."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "userAgentString"@en .


###  https://cyberterrain.org/ns/stonework#validFrom
:validFrom rdf:type owl:DatatypeProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :QualifiedAssertion ;
           rdfs:range xsd:dateTime ;
           <http://www.w3.org/2004/02/skos/core#definition> "The start of the interval during which a qualified assertion is considered applicable."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "validFrom"@en .


###  https://cyberterrain.org/ns/stonework#validUntil
:validUntil rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :QualifiedAssertion ;
            rdfs:range xsd:dateTime ;
            <http://www.w3.org/2004/02/skos/core#definition> "The end of the interval during which a qualified assertion is considered applicable."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "validUntil"@en .


###  https://cyberterrain.org/ns/stonework#variableName
:variableName rdf:type owl:DatatypeProperty ;
              rdfs:domain :Variable ;
              rdfs:range xsd:string ;
              <http://www.w3.org/2004/02/skos/core#definition> "A short name identifying a Variable within the scope of its declaring Behavior, allowing it to be referenced consistently across Steps and Transitions."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "variableName" .


###  https://cyberterrain.org/ns/stonework#version
:version rdf:type owl:DatatypeProperty ;
         rdfs:domain :VersionedProduct ;
         rdfs:range xsd:string ;
         <http://www.w3.org/2004/02/skos/core#definition> "The version string for this specific product release."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "version"@en .


###  https://cyberterrain.org/ns/stonework#vulnerabilityId
:vulnerabilityId rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :Vulnerability ;
                 rdfs:range xsd:string ;
                 <http://www.w3.org/2004/02/skos/core#definition> "The canonical identifier assigned to this vulnerability by its originating numbering authority, e.g. 'CVE-2021-44228', 'GHSA-jfh8-c2jp-hdp9', or 'OSV-2021-1'."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "vulnerabilityId"@en ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Identifier-specific core properties such as stonework:cveId are declared as subproperties (and source-native framework aliases such as cve:cveId are declared subproperties of those), enabling cross-source queries on a single predicate. Each vulnerability record SHOULD carry exactly one identifier from its primary numbering authority."@en .


###  https://cyberterrain.org/ns/stonework#walletAddress
:walletAddress rdf:type owl:DatatypeProperty ;
               rdfs:domain :CryptoAddress ;
               rdfs:range xsd:string ;
               <http://www.w3.org/2004/02/skos/core#definition> "The on-chain address string (e.g. a Bitcoin or Ethereum address)."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "walletAddress"@en ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "Resolve the address's asset through ^stonework:hasIdentifier/stonework:accountCurrency and then its ledger through stonework:blockchainNetwork on a stonework:CryptoAsset. Do not rely on the address string alone to identify the asset or network."@en .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/2000/01/rdf-schema#Class
rdfs:Class rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#Concept
<http://www.w3.org/2004/02/skos/core#Concept> rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
<http://www.w3.org/2004/02/skos/core#ConceptScheme> rdf:type owl:Class .


###  https://cyberterrain.org/ns/stonework#AIAgent
:AIAgent rdf:type owl:Class ;
         rdfs:subClassOf :Agent ;
         <http://www.w3.org/2004/02/skos/core#definition> "An autonomous or semi-autonomous system driven by AI/ML that can act, make decisions, or be attributed responsibility in a cyber or sociotechnical context." ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "AI Agent" ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers both offensive uses (AI-assisted or autonomous threat actors) and defensive uses (AI-driven detection, response, or hunting systems). Distinct from Tool — an AIAgent has a degree of autonomous decision-making rather than being a passively invoked artifact."@en .


###  https://cyberterrain.org/ns/stonework#AITechnique
:AITechnique rdf:type owl:Class ;
             rdfs:subClassOf :Technique ;
             <http://www.w3.org/2004/02/skos/core#definition> "A specific method by which adversaries attack AI/ML systems (e.g., training data poisoning, adversarial examples, model extraction)."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "AI Technique"@en .


###  https://cyberterrain.org/ns/stonework#AccessControlList
:AccessControlList rdf:type owl:Class ;
                   rdfs:subClassOf :DigitalArtifact ;
                   <http://www.w3.org/2004/02/skos/core#definition> "A structured list of access control entries (ACEs) that governs which principals (users, groups, or system accounts) are permitted or denied specific operations on a resource."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Access Control List"@en ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Applies across filesystems, operating system objects (registry keys, processes), network devices (firewall rules), cloud IAM policies, and APIs. In a CTI context, adversaries frequently modify ACLs to establish persistence, escalate privileges, or deny defenders access to compromised resources. Framework-specific extensions (e.g. Windows DACL/SACL structure) are modeled at the framework layer."@en .


###  https://cyberterrain.org/ns/stonework#Account
:Account rdf:type owl:Class ;
         rdfs:subClassOf :DigitalIdentity ;
         <http://www.w3.org/2004/02/skos/core#definition> "A named account held by an Agent with a provider — an authenticated-access identity, a value-holding ledger position, or both aspects together — identified by one or more Identifiers and optionally attributed to a known Agent."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Account"@en ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "Abstract parent of stonework:UserAccount (authenticated access) and stonework:FinancialAccount (value custody and movement). It exists chiefly to give stonework:hasAccount and stonework:accountOf a range spanning both without widening to every DigitalIdentity. A single real-world account often has both natures; model them as two individuals linked by stonework:controls rather than one individual of both types, since one login commonly governs several ledgers."@en .


###  https://cyberterrain.org/ns/stonework#AccountType
:AccountType rdf:type owl:Class ;
             rdfs:subClassOf :Category ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                               owl:hasValue :accountTypeScheme
                             ] ;
             <http://www.w3.org/2004/02/skos/core#definition> "A classification of a user account by its authentication or deployment context."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Account Type"@en .


###  https://cyberterrain.org/ns/stonework#Actuator
:Actuator rdf:type owl:Class ;
          rdfs:subClassOf :PhysicalArtifact ;
          <http://www.w3.org/2004/02/skos/core#definition> "A physical device that effects a change in a physical process or plant — for example a valve, motor, relay, or servo — as distinct from a cyber security safeguard mechanism."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Actuator"@en ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "Use for ICS and OT field devices that act on a physical process. Distinct from stonework:SecurityActuator, which is deployed infrastructure that applies a countermeasure. A PLC or motor starter is an Actuator; an EDR agent or firewall is a SecurityActuator. An ICS device that also runs processes and participates in networks may additionally be typed as stonework:Host."@en .


###  https://cyberterrain.org/ns/stonework#Agent
:Agent rdf:type owl:Class ;
       rdfs:subClassOf :CyberEntity ;
       <http://www.w3.org/2004/02/skos/core#definition> "Any entity that can act, perform actions, or be attributed responsibility in a cyber or sociotechnical context."@en ;
       <http://www.w3.org/2004/02/skos/core#prefLabel> "Agent" ;
       <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers AI, human individuals, groups, organizations, and other actors (e.g. threat actors, vendors, government bodies). Used as the top-level superclass for identity-related objects in alignment with STIX Identity."@en .


###  https://cyberterrain.org/ns/stonework#Analysis
:Analysis rdf:type owl:Class ;
          rdfs:subClassOf :IntelligenceProduct ;
          <http://www.w3.org/2004/02/skos/core#definition> "A systematic examination of a cyber entity, artifact, or event that produces structured findings about its nature, behavior, or properties."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Analysis"@en ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "Sibling to stonework:Assessment under IntelligenceProduct. Where Assessment answers 'how bad/likely/risky?', Analysis answers 'what is it and what does it do?' Superclass for domain-specific analyses such as MalwareAnalysis. Aligns with STIX MalwareAnalysis SDO at the subclass level."@en .


###  https://cyberterrain.org/ns/stonework#AnalyticTechnique
:AnalyticTechnique rdf:type owl:Class ;
                   rdfs:subClassOf :Technique ;
                   <http://www.w3.org/2004/02/skos/core#definition> "A prescribed analytical method used to process, evaluate, or reason over data to produce intelligence, detections, or assessments."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Analytic Technique" ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers structured analytic techniques (e.g., analysis of competing hypotheses, kill chain analysis, diamond model analysis) and computational analytic methods (e.g., clustering, anomaly detection). Distinct from DetectionRule — an AnalyticTechnique describes the method; a DetectionRule is a deployable artifact implementing it."@en .


###  https://cyberterrain.org/ns/stonework#Assessment
:Assessment rdf:type owl:Class ;
            rdfs:subClassOf :IntelligenceProduct ;
            <http://www.w3.org/2004/02/skos/core#definition> "A structured knowledge artifact capturing the evaluation, analysis, or estimation of risk, likelihood, impact, or other security-relevant attributes."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Assessment" ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers risk assessments, vulnerability assessments, and impact analyses. Assessment is an Information artifact — the output of an evaluative process — not the process itself. The process producing an Assessment may be modeled as a stonework:Process or stonework:Investigation."@en .


###  https://cyberterrain.org/ns/stonework#AttackPattern
:AttackPattern rdf:type owl:Class ;
               rdfs:subClassOf :Behavior ;
               <http://www.w3.org/2004/02/skos/core#definition> "A type of Tactics, Techniques, and Procedures (TTP) that describes ways that adversaries attempt to compromise targets. Often maps to MITRE ATT&CK techniques."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Attack Pattern"@en ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "The abstract concept spanning framework-specific shapes that are not structurally identical: CAPEC's shape (capec:AttackPattern) is a taxonomy entry with severity/likelihood/prerequisite fields; MITRE ATT&CK's shape (stonework:AttackTechnique) is an operationalized technique with sub-techniques, procedures, mitigations, and detections. Both are AttackPatterns; stonework:relatedAttackPattern links instances across shapes that describe the same underlying technique."@en .


###  https://cyberterrain.org/ns/stonework#AttackTechnique
:AttackTechnique rdf:type owl:Class ;
                 rdfs:subClassOf :AttackPattern ,
                                 :CyberTechnique ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A prescribed offensive method used by an adversary to achieve a specific tactical objective within a target environment."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Attack Technique"@en ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Aligns with MITRE ATT&CK techniques and D3FEND OffensiveTechnique. The MITRE ATT&CK-shaped realization of stonework:AttackPattern — operationalized for execution, as distinct from CAPEC's more abstract taxonomy-entry shape (capec:AttackPattern, also a stonework:AttackPattern). Framework-specific subclasses (e.g. attack:Technique) provide the concrete individuals. A specific, concrete realization of this technique is modeled as a stonework:Procedure, linked back via stonework:implementedBy."@en .


###  https://cyberterrain.org/ns/stonework#AutonomousSystem
:AutonomousSystem rdf:type owl:Class ;
                  rdfs:subClassOf :Infrastructure ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Represents an Autonomous System (AS), a collection of IP routing prefixes under the control of a single administrative entity, identified by its AS number." ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Autonomous System"@en .


###  https://cyberterrain.org/ns/stonework#BankAccountNumber
:BankAccountNumber rdf:type owl:Class ;
                   rdfs:subClassOf :Identifier ;
                   <http://www.w3.org/2004/02/skos/core#definition> "A domestic bank account number as issued under a national scheme, without IBAN normalization."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Bank Account Number"@en ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "The value is stonework:accountNumber. The routing context (US ABA routing number, UK sort code) is recorded on the holding stonework:FinancialInstitution via stonework:abaRoutingNumber or an equivalent, not on this identifier."@en .


###  https://cyberterrain.org/ns/stonework#Behavior
:Behavior rdf:type owl:Class ;
          rdfs:subClassOf :CyberEntity ;
          <http://www.w3.org/2004/02/skos/core#definition> "A pattern of actions or methods characteristic of an entity, particularly adversaries."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Behavior" ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "Groups TTP-related classes: Tactic, Technique (and subclasses), and Procedure. In BFO terms, Behaviors are GenericallyDependentContinuants — specifications or patterns describing how actions are carried out. The execution of a Technique is a CyberActivity; the Technique itself is a Behavior. Aligns with IAO PlanSpecification."@en .


###  https://cyberterrain.org/ns/stonework#BomEntry
:BomEntry rdf:type owl:Class ;
          rdfs:subClassOf :ComponentContext ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :installationOf ;
                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :VersionedProduct
                          ] ;
          rdfs:comment "BomEntry is the STONEWORK representation of a CycloneDX component element or SPDX package entry. It links a VersionedProduct into the context of a particular SBOM document via stonework:installationOf, and may carry component-specific metadata (PURL, license, hash, component type) that does not belong on the VersionedProduct itself."@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "A single component entry within a Software Bill of Materials, asserting that a specific VersionedProduct is included in the artifact or system described by the SBOM."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "BOM Entry" ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "An SBOM import creates one BomEntry per declared component. The BomEntry IRI is scoped to the SBOM (e.g. <sbom-iri/entry/<component-ref>>). Multiple BomEntry instances across different SBOMs may reference the same VersionedProduct via stonework:installationOf."@en .


###  https://cyberterrain.org/ns/stonework#Campaign
:Campaign rdf:type owl:Class ;
          rdfs:subClassOf :CyberActivity ;
          <http://www.w3.org/2004/02/skos/core#definition> "A grouping of adversary behaviours and resources with a common objective pursued over a period of time. Campaigns may be attributed to ThreatActors and may form part of a broader CyberActivityCluster." ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Campaign"@en ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "A Campaign is organized around an objective and time period, while a CyberActivityCluster is organized by analytic correlation. A Campaign that is one episode within a broader activity cluster is linked to it with stonework:memberOfActivityCluster. The same body of activity may be typed as both classes when both descriptions apply."@en .


###  https://cyberterrain.org/ns/stonework#Category
:Category rdf:type owl:Class ;
          rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ,
                          :CyberEntity ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                            owl:hasValue :categoryScheme
                          ] ;
          <http://www.w3.org/2004/02/skos/core#definition> "A classification or tagging concept used to group or qualify other individuals in a particular context."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Category"@en ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "Categories are reified so they can be referenced, versioned, or scoped. They are not rigid types."@en .


###  https://cyberterrain.org/ns/stonework#Certificate
:Certificate rdf:type owl:Class ;
             rdfs:subClassOf :DigitalArtifact ;
             <http://www.w3.org/2004/02/skos/core#definition> "A structured digital document binding a public key to an identity, issued and signed by a certificate authority. Used for authentication, encryption, and trust establishment in networked systems."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Certificate"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Primarily represents X.509 certificates. May be used to cluster infrastructure sharing the same certificate or to link observed TLS/SSL artifacts to their issuing authority. Referenced by stonework:sharesCertificate on Infrastructure. Represent certificate fingerprints through stonework:hasHash and a stonework:Hash individual rather than algorithm-specific fingerprint literals."@en .


###  https://cyberterrain.org/ns/stonework#City
:City rdf:type owl:Class ;
      rdfs:subClassOf :Location ;
      <http://www.w3.org/2004/02/skos/core#definition> "A significant urban settlement, municipality, or metropolitan area." ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "City" .


###  https://cyberterrain.org/ns/stonework#ComparisonOperator
:ComparisonOperator rdf:type owl:Class ;
                    <http://www.w3.org/2004/02/skos/core#definition> "A controlled vocabulary of operators used to compare a Variable's bound value against a threshold in a Transition guard."@en ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Comparison Operator" ;
                    <http://www.w3.org/2004/02/skos/core#scopeNote> "Individuals are stonework:Equals, stonework:NotEquals, stonework:LessThan, stonework:LessThanOrEqual, stonework:GreaterThan, and stonework:GreaterThanOrEqual. Referenced by stonework:guardOperator; omitting an operator on a guard defaults to Equals semantics."@en .


###  https://cyberterrain.org/ns/stonework#ComponentContext
:ComponentContext rdf:type owl:Class ;
                  <http://www.w3.org/2004/02/skos/core#definition> "An abstract class representing a context-specific reference to a VersionedProduct: the same product version appears differently depending on whether it is declared in a bill of materials or observed as a running installation on a specific system."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Component Context" ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "Subclassed by stonework:BomEntry (declarative — listed in an SBOM document), stonework:ProductInstallation (observational — verified deployment via SWID tag or scan), and framework-specific subclasses such as cve:AffectedProduct (advisory — named in a source vulnerability record, possibly against several VersionedProduct individuals at once). Unifies these evidence bases under a single superclass so that stonework:installationOf can span all of them without domain restrictions forcing incorrect inferences. BomEntry and ProductInstallation are additionally restricted to at most one installationOf value each; ComponentContext itself imposes no such limit, since not every subclass shares that one-to-one shape."@en .


###  https://cyberterrain.org/ns/stonework#Control
:Control rdf:type owl:Class ;
         rdfs:subClassOf :Behavior ,
                         :Countermeasure ;
         rdfs:comment "Instances of stonework:Control may represent individual controls, control enhancements, or sub‑controls. Framework‑specific identifiers (e.g., \"AC‑2\", \"CIS 4.1\") SHOULD be modeled using explicit properties rather than encoded in the class IRI. Control text SHOULD be referenced via citations rather than reproduced verbatim." ;
         <http://www.w3.org/2004/02/skos/core#definition> "A prescribed security or privacy safeguard that specifies an action, capability, or condition intended to reduce risk, enforce policy, or achieve a defined protection objective within an information system or organization." ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Control" ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "This class provides a semantic representation of security and privacy controls from frameworks such as NIST SP 800‑53 and the CIS Controls. It supports mapping to external control identifiers and families without embedding copyrighted control text." .


###  https://cyberterrain.org/ns/stonework#ControlPlan
:ControlPlan rdf:type owl:Class ;
             rdfs:subClassOf :Behavior ;
             <http://www.w3.org/2004/02/skos/core#definition> "A concrete, Step-decomposed sequence of actions that implements a Control in a specific operational context."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Control Plan" ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Mirrors the Technique/Procedure split on the defensive side: stonework:Control is the abstract prescribed safeguard (a catalog entry, e.g. NIST AC-2 or a CIS control); ControlPlan is its concrete implementation as a Step sequence, linked back via stonework:implements. A ControlPlan is typically invoked from within a Playbook or DetectionPlan by a Step that stonework:implements it."@en .


###  https://cyberterrain.org/ns/stonework#Countermeasure
:Countermeasure rdf:type owl:Class ;
                rdfs:subClassOf :CyberEntity ;
                <http://www.w3.org/2004/02/skos/core#definition> "Any control, mitigation, or safeguard applied to protect against, reduce, or respond to security risks."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Countermeasure" ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Includes Controls, Mitigations, CoursesOfAction, and DetectionRules. The two primary branches are preventive/reactive measures (Mitigation, CourseOfAction, Control) and detection logic (DetectionRule, Signature). A Countermeasure describes the safeguard or procedure; the deployed mechanism that can apply it is a stonework:SecurityActuator, and a particular application is a stonework:SecurityActuation."@en .


###  https://cyberterrain.org/ns/stonework#Country
:Country rdf:type owl:Class ;
         rdfs:subClassOf :Location ;
         <http://www.w3.org/2004/02/skos/core#definition> "A sovereign state or top-level administrative entity recognized internationally." ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Country" .


###  https://cyberterrain.org/ns/stonework#CourseOfAction
:CourseOfAction rdf:type owl:Class ;
                rdfs:subClassOf :Mitigation ;
                <http://www.w3.org/2004/02/skos/core#definition> "A specific, contextualized recommended action or set of steps to prevent or respond to a threat, attack, or incident."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Course of Action"@en ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "More prescriptive and situational than a general Mitigation — a CourseOfAction packages guidance for a specific threat context. Corresponds to the STIX 2.1 CourseOfAction SDO. General reusable controls (e.g. ATT&CK mitigations) are modeled as Mitigation; specific incident response actions are CourseOfAction."@en .


###  https://cyberterrain.org/ns/stonework#CryptoAddress
:CryptoAddress rdf:type owl:Class ;
               rdfs:subClassOf :Identifier ;
               <http://www.w3.org/2004/02/skos/core#definition> "An on-chain address that identifies a destination for value on a distributed ledger."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Crypto Address"@en ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "The address string is stonework:walletAddress. Attach a CryptoAddress to the wallet it identifies, a stonework:FinancialAccount, with stonework:hasIdentifier; the address's asset and network are then traversable through ^stonework:hasIdentifier/stonework:accountCurrency and stonework:blockchainNetwork. Sibling of stonework:EmailAddress and stonework:MACAddress."@en .


###  https://cyberterrain.org/ns/stonework#CryptoAsset
:CryptoAsset rdf:type owl:Class ;
             rdfs:subClassOf :Currency ;
             <http://www.w3.org/2004/02/skos/core#altLabel> "virtual asset"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "A cryptocurrency, stablecoin, or other token that serves as a unit of value on a distributed ledger."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Crypto Asset"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Instances are the assets themselves (e.g. Bitcoin, Ether, a specific ERC-20 token) — not wallets, addresses, or holdings. A wallet is modeled as a stonework:FinancialAccount and its address as a stonework:CryptoAddress; an amount of a crypto asset is a stonework:MonetaryAmount whose stonework:currency is the CryptoAsset. The same nominal token issued on multiple ledgers is modeled as distinct individuals distinguished by stonework:blockchainNetwork. 'Virtual asset' is the FATF term; a service that custodies or exchanges them is a virtual asset service provider (stonework:FinancialInstitution categorized accordingly)."@en .


###  https://cyberterrain.org/ns/stonework#Currency
:Currency rdf:type owl:Class ;
          rdfs:subClassOf :CyberEntity ;
          <http://www.w3.org/2004/02/skos/core#definition> "A unit in which monetary value is denominated — a fiat currency or a crypto asset."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Currency"@en ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "The range of stonework:currency on stonework:MonetaryAmount. Fiat units are supplied as a closed controlled vocabulary in stonework:fiatCurrencyScheme (ISO 4217). Crypto units are stonework:CryptoAsset individuals, created as needed rather than pre-enumerated. Currency itself carries no instances directly."@en .


###  https://cyberterrain.org/ns/stonework#CvssMetric
:CvssMetric rdf:type owl:Class ;
            rdfs:subClassOf :Assessment ;
            <http://www.w3.org/2004/02/skos/core#definition> "A structured technical-severity assessment of a vulnerability using the Common Vulnerability Scoring System, carrying a version, vector, base score, and qualitative severity."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "CVSS Metric"@en ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Use stonework:hasCvssMetric to attach one or more source-specific assessments to a Vulnerability. Identify the scoring authority with stonework:createdBy and preserve the source record with stonework:hasProvenance. The direct stonework:cvssBaseScore, stonework:cvssSeverity, and stonework:cvssVector properties are query-friendly headline projections. CVSS base metrics are context-neutral; environmental metrics may adjust technical severity for a deployment context, but CVSS does not establish whether the vulnerable product is present or constitute a full enterprise risk assessment. Use stonework:VulnerabilityAssessment for that contextual judgment. A plan that calculates or consumes a CVSS assessment may bind a Variable to this assessment, but the Variable is an execution-time value and does not replace the vulnerability-to-metric relationship."@en .


###  https://cyberterrain.org/ns/stonework#CyberActivity
:CyberActivity rdf:type owl:Class ;
               <http://www.w3.org/2004/02/skos/core#definition> "A specific occurrence or performance of actions by one or more agents over time within a cyber or sociotechnical context."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Cyber Activity" ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "One of two root classes in STONEWORK alongside CyberEntity. Superclass for Campaigns, CyberActivityClusters, Incidents, Operations, Events, and Processes. Aligns with BFO Occurrent and BFO Process."@en .


###  https://cyberterrain.org/ns/stonework#CyberActivityCluster
:CyberActivityCluster rdf:type owl:Class ;
                      rdfs:subClassOf :CyberActivity ;
                      <http://www.w3.org/2004/02/skos/core#definition> "An analytically identified aggregate of cyber activities grouped because available evidence suggests a common source, mechanism, or operational thread."@en ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Cyber Activity Cluster"@en ;
                      <http://www.w3.org/2004/02/skos/core#scopeNote> "A CyberActivityCluster is unified by analytic correlation rather than the objective and time period of a Campaign, the unified command or intent of an Operation, the execution sequence of a Process, or the inquiry purpose of an Investigation. It does not require a known objective, responsible Agent, precise boundaries, or a conclusion that the activity is adversarial. It denotes the body of activity believed to be related, not the intelligence artifact recording that judgment; use stonework:Grouping, stonework:Report, or stonework:Assessment for the artifact. Only CyberActivity instances are members through stonework:memberOfActivityCluster and stonework:hasMemberActivity; relate tools, malware, infrastructure, and responsible participants through their specific relationships. The STIX adapter maps its narrower intrusion-set source class to CyberActivityCluster."@en .


###  https://cyberterrain.org/ns/stonework#CyberEntity
:CyberEntity rdf:type owl:Class ;
             <http://www.w3.org/2004/02/skos/core#definition> "Any concept, object, or resource that exists or operates within a cyber or sociotechnical domain."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Cyber Entity" ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "One of two root classes in STONEWORK. Groups all persistent entities — Agents, Infrastructure, DigitalArtifacts, PhysicalArtifacts, Behaviors, IntelligenceProducts, SecurityConditions, RiskFactors, Countermeasures, and related classes. Aligns with BFO Continuant. The sibling root class CyberActivity covers happenings (Campaigns, Incidents, Operations, etc.)."@en .


###  https://cyberterrain.org/ns/stonework#CyberTechnique
:CyberTechnique rdf:type owl:Class ;
                rdfs:subClassOf :Technique ;
                <http://www.w3.org/2004/02/skos/core#definition> "A technique performed within or against cyberspace, encompassing both offensive and defensive cyber operations." ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Cyber Technique" ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Mirrors D3FEND's CyberTechnique class. Subclassed by stonework:AttackTechnique (offensive) and stonework:DefendTechnique (defensive), enabling a single property chain to span both ATT&CK and D3FEND individuals." .


###  https://cyberterrain.org/ns/stonework#DataAsset
:DataAsset rdf:type owl:Class ;
           rdfs:subClassOf :CyberEntity ;
           <http://www.w3.org/2004/02/skos/core#definition> "A defender-owned collection of data or information with organizational value, such as databases, intellectual property, credentials stores, or PII collections."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Asset" ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Represents data as a targetable resource distinct from the systems that store or process it. Used to model what adversaries seek to access, exfiltrate, or destroy rather than the infrastructure they exploit to reach it."@en .


###  https://cyberterrain.org/ns/stonework#DefendTechnique
:DefendTechnique rdf:type owl:Class ;
                 rdfs:subClassOf :CyberTechnique ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A prescribed defensive method used to detect, prevent, or respond to adversary behavior within a target environment." ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Defend Technique" ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Aligns with MITRE D3FEND DefensiveTechnique. Framework-specific subclasses (e.g. d3fend:DefensiveTechnique) extend this class when D3FEND data is loaded." .


###  https://cyberterrain.org/ns/stonework#DefensiveTactic
:DefensiveTactic rdf:type owl:Class ;
                 rdfs:subClassOf :Tactic ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A high-level defensive objective that groups related countermeasure techniques by the protection goal they serve." ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Defensive Tactic" ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Aligns with MITRE D3FEND defensive tactics (e.g. Harden, Detect, Isolate, Evict, Restore). Individuals are typically drawn from D3FEND or similar defensive frameworks via the framework mapping layer."@en .


###  https://cyberterrain.org/ns/stonework#DetectionPlan
:DetectionPlan rdf:type owl:Class ;
               rdfs:subClassOf :InvestigationPlan ;
               <http://www.w3.org/2004/02/skos/core#definition> "A Step-decomposed sequence of actions for determining whether observed activity constitutes a security-relevant violation, as distinct from the offensive or defensive action plans that respond to one."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Detection Plan" ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "A specialization of stonework:InvestigationPlan narrowly scoped to violation triage: orchestrating DetectionRule/Signature evaluation and analytic logic to identify whether a violation occurred, typically triggering a defensive Playbook or ControlPlan via a guarded Transition once one is confirmed. Where a Playbook is an action plan carried out by an interested party — offensive (an adversary's operational playbook) or defensive (an incident responder's playbook) — a DetectionPlan plays a neutral, evaluative role, watching for the kind of changes an InvestigationPlan more broadly investigates."@en .


###  https://cyberterrain.org/ns/stonework#DetectionRule
:DetectionRule rdf:type owl:Class ;
               rdfs:subClassOf :Countermeasure ;
               <http://www.w3.org/2004/02/skos/core#definition> "A structured, machine-readable rule designed to detect malicious or suspicious activity, techniques, or indicators. It may be signature-based, behavioral, correlation-based, or analytic."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Detection Rule" ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "Encompasses pattern-matching signatures (YARA, Snort, Suricata), behavioral rules (Sigma), SIEM correlation logic, and analytic detections. Signature is a subclass for content-centric, indicator-matching rules."@en .


###  https://cyberterrain.org/ns/stonework#DigitalArtifact
:DigitalArtifact rdf:type owl:Class ;
                 rdfs:subClassOf :CyberEntity ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Any discrete digital object or content entity that can be observed, transmitted, stored, or acted upon in a cyber environment."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Digital Artifact" ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Includes files, hashes, malware samples, network traffic captures, and other content-bearing items. Aligns with D3FEND DigitalArtifact concepts. Sibling of stonework:PhysicalArtifact."@en .


###  https://cyberterrain.org/ns/stonework#DigitalIdentity
:DigitalIdentity rdf:type owl:Class ;
                 rdfs:subClassOf :Agent ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A digital representation or persona of an Agent, inferred from one or more identifiers (email, phone, account, etc.). It may or may not be attributed to a known real-world Agent." ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Digital Identity" ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Useful when you observe identifiers without confirmed attribution. Can aggregate multiple Identifiers and later be linked to a real-worldAgent."@en .


###  https://cyberterrain.org/ns/stonework#Directory
:Directory rdf:type owl:Class ;
           rdfs:subClassOf :DigitalArtifact ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Directory" .


###  https://cyberterrain.org/ns/stonework#Domain
:Domain rdf:type owl:Class ;
        rdfs:subClassOf :Infrastructure ;
        <http://www.w3.org/2004/02/skos/core#definition> "Represents a network domain name. Can reference the IP addresses it resolves to." ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Domain"@en .


###  https://cyberterrain.org/ns/stonework#EmailAddress
:EmailAddress rdf:type owl:Class ;
              rdfs:subClassOf :Identifier ;
              <http://www.w3.org/2004/02/skos/core#definition> "Represents a single email address, optionally associating it with a display name and a user account." ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Email Address"@en .


###  https://cyberterrain.org/ns/stonework#EmailMessage
:EmailMessage rdf:type owl:Class ;
              rdfs:subClassOf :DigitalArtifact ;
              <http://www.w3.org/2004/02/skos/core#definition> "A discrete email communication, including headers, body content, and optional attachments, transmitted over an email protocol."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Email Message"@en ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "Distinct from stonework:EmailAddress, which represents the sender/recipient identifier. An EmailMessage is the content artifact itself. Used to represent phishing lures, spear-phishing emails, or other email-borne threat delivery mechanisms. Corresponds to STIX EmailMessage SCO."@en .


###  https://cyberterrain.org/ns/stonework#Event
:Event rdf:type owl:Class ;
       rdfs:subClassOf :CyberActivity ;
       <http://www.w3.org/2004/02/skos/core#definition> "An atomic, observable occurrence in a system, network, or environment that has potential security relevance but has not yet been assessed or declared as an Incident."@en ;
       <http://www.w3.org/2004/02/skos/core#prefLabel> "Event"@en ;
       <http://www.w3.org/2004/02/skos/core#scopeNote> "Represents the pre-triage state — a raw log entry, alert, or sensor observation. Distinguished from Incident by the absence of human or automated assessment declaring it significant and adverse. Useful for SIEM, log-based, and threat hunting use cases."@en .


###  https://cyberterrain.org/ns/stonework#FalsePositiveRate
:FalsePositiveRate rdf:type owl:Class ;
                   rdfs:subClassOf :Category ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                     owl:hasValue :falsePositiveRateScheme
                                   ] ;
                   <http://www.w3.org/2004/02/skos/core#definition> "An ordinal classification of the expected false-positive frequency of a detection rule."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "False Positive Rate"@en .


###  https://cyberterrain.org/ns/stonework#Feed
:Feed rdf:type owl:Class ;
      rdfs:subClassOf :Provenance ;
      <http://www.w3.org/2004/02/skos/core#definition> "A structured data source that provides indicators, intelligence, or enrichment data on a regular or continuous basis." ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "Feed" ;
      <http://www.w3.org/2004/02/skos/core#scopeNote> "Examples: URLHaus, AlienVault OTX, Abuse.ch, commercial threat feeds, etc."@en .


###  https://cyberterrain.org/ns/stonework#File
:File rdf:type owl:Class ;
      rdfs:subClassOf :DigitalArtifact ;
      <http://www.w3.org/2004/02/skos/core#definition> "A discrete unit of data stored on a filesystem, identified by name, path, and cryptographic hash. Includes executable binaries, scripts, documents, archives, and other file types relevant to cyber threat analysis."@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "File"@en ;
      <http://www.w3.org/2004/02/skos/core#scopeNote> "Linked to hash values via stonework:hasHash. A MalwareSample may be associated with its File representation. Framework-specific extensions (PE headers, NTFS streams, archive contents) are modeled at the framework layer."@en .


###  https://cyberterrain.org/ns/stonework#FinancialAccount
:FinancialAccount rdf:type owl:Class ;
                  rdfs:subClassOf :Account ;
                  <http://www.w3.org/2004/02/skos/core#definition> "An account that can hold a balance of, or transfer, economic value — fiat currency, cryptocurrency, or monetary-equivalent stored value such as gift-card credit, gaming currency, or loyalty points redeemable for goods."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Financial Account"@en ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "Defined by function, not by the holder: an account at a regulated bank, brokerage, or exchange and a stored-value balance at a non-financial merchant are both FinancialAccounts. Whether it is held at a regulated institution is recorded with the optional stonework:heldAt link, not by the class. Account kind (checking, custodial wallet, prepaid card, exchange account) is asserted with stonework:categorizedBy a stonework:FinancialAccountType. Identifiers such as an IBAN, domestic account number, or crypto address attach with stonework:hasIdentifier. Use stonework:accountCurrency for each currency or crypto asset the account holds or is denominated in; it is intentionally multi-valued. Balance over time is a stonework:MetricObservation. A crypto wallet is a FinancialAccount; its on-chain address is a stonework:CryptoAddress."@en .


###  https://cyberterrain.org/ns/stonework#FinancialAccountType
:FinancialAccountType rdf:type owl:Class ;
                      rdfs:subClassOf :Category ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                        owl:hasValue :financialAccountTypeScheme
                                      ] ;
                      <http://www.w3.org/2004/02/skos/core#definition> "A classification of a financial account by the kind of value custody or service it represents."@en ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Financial Account Type"@en .


###  https://cyberterrain.org/ns/stonework#FinancialInstitution
:FinancialInstitution rdf:type owl:Class ;
                      rdfs:subClassOf :Organization ;
                      <http://www.w3.org/2004/02/skos/core#definition> "An organization whose business is holding, moving, exchanging, or safeguarding financial assets on behalf of others — a bank, credit union, broker-dealer, payment processor, money services business, or virtual asset service provider."@en ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Financial Institution"@en ;
                      <http://www.w3.org/2004/02/skos/core#scopeNote> "The natural bearer of institution identifiers (stonework:bic, stonework:abaRoutingNumber) that should not broaden bare stonework:Organization, and the range of stonework:heldAt. Institution kind is asserted with stonework:categorizedBy a stonework:FinancialInstitutionType. The Legal Entity Identifier is a general organization identifier (stonework:lei), not institution-specific."@en .


###  https://cyberterrain.org/ns/stonework#FinancialInstitutionType
:FinancialInstitutionType rdf:type owl:Class ;
                          rdfs:subClassOf :Category ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                            owl:hasValue :financialInstitutionTypeScheme
                                          ] ;
                          <http://www.w3.org/2004/02/skos/core#definition> "A classification of a financial institution by its regulatory form and the service it provides."@en ;
                          <http://www.w3.org/2004/02/skos/core#prefLabel> "Financial Institution Type"@en .


###  https://cyberterrain.org/ns/stonework#FinancialTransaction
:FinancialTransaction rdf:type owl:Class ;
                      rdfs:subClassOf :CyberActivity ;
                      <http://www.w3.org/2004/02/skos/core#definition> "A movement of economic value from one financial account to another, occurring over a definite period and optionally attributed to the agents responsible for initiating it."@en ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Financial Transaction"@en ;
                      <http://www.w3.org/2004/02/skos/core#scopeNote> "An occurrent: it starts and settles at a time (stonework:startedAtTime and stonework:endedAtTime), is attributed with stonework:attributedTo, and can be sighted, investigated, and grouped into a stonework:CyberActivityCluster. Originator and beneficiary are given by stonework:originatorAccount and stonework:beneficiaryAccount; correspondent hops by stonework:intermediaryAccount. The transferred value is a stonework:MonetaryAmount via stonework:hasMonetaryValue. Use stonework:originatorMonetaryValue and stonework:beneficiaryMonetaryValue when the debited input and credited output differ, as in a currency exchange. Flat stonework:transactionAmount and stonework:transactionCurrency are convenience projections only for a single-denomination transfer. A blockchain transaction is a FinancialTransaction whose accounts are crypto wallets. Divergent source records of one economic event are handled through stonework:hasProvenance and stonework:Sighting rather than a distinct record class. Use stonework:hasBehavior to link a transaction, or a cluster of them, to a stonework:IllicitFinanceTechnique it exhibits. Use stonework:fundsActivity only when the transaction finances an activity; use stonework:respondsToActivity when a transaction occurs in response to an activity, such as a victim's ransom payment."@en .


###  https://cyberterrain.org/ns/stonework#GranularMarking
:GranularMarking rdf:type owl:Class ;
                 rdfs:subClassOf :CyberEntity ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A marking application that assigns a data-handling marking to selected fields or portions of another cyber entity."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Granular Marking"@en ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Represents the structural application of a marking, including its selectors and referenced marking definition. It is distinct from a stonework:Markings category value, which expresses the handling designation itself."@en .


###  https://cyberterrain.org/ns/stonework#Group
:Group rdf:type owl:Class ;
       rdfs:subClassOf :Agent ;
       <http://www.w3.org/2004/02/skos/core#definition> "Any collection of Persons, Organizations, or other Groups that share a common purpose or identity but do not necessarily have formal legal structure."@en ;
       <http://www.w3.org/2004/02/skos/core#prefLabel> "Group" ;
       <http://www.w3.org/2004/02/skos/core#scopeNote> "Used for informal collectives, communities, ad-hoc teams, criminal syndicates, or loose alliances. More general than Organization. Can contain other Groups or Organizations."@en .


###  https://cyberterrain.org/ns/stonework#Grouping
:Grouping rdf:type owl:Class ;
          rdfs:subClassOf :IntelligenceProduct ;
          <http://www.w3.org/2004/02/skos/core#definition> "A structured intelligence product that asserts shared context among a set of referenced cyber threat intelligence entities."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Grouping"@en ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "Use when related objects need to be collected without the narrative and publication semantics of a Report. Corresponds to the STIX 2.1 Grouping SDO."@en .


###  https://cyberterrain.org/ns/stonework#Hash
:Hash rdf:type owl:Class ;
      rdfs:subClassOf :Identifier ;
      <http://www.w3.org/2004/02/skos/core#definition> "A single cryptographic hash entry associating a hashing algorithm with its hex-encoded digest value. Used to represent entries in the STIX hashes dictionary." ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "Hash"@en .


###  https://cyberterrain.org/ns/stonework#Host
:Host rdf:type owl:Class ;
      rdfs:subClassOf :Infrastructure ;
      <http://www.w3.org/2004/02/skos/core#definition> "A computing system, device, or endpoint (physical, virtual, container, or cloud instance) that can run processes, host files, and participate in networks."@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "Host"@en .


###  https://cyberterrain.org/ns/stonework#HumanSource
:HumanSource rdf:type owl:Class ;
             rdfs:subClassOf :Provenance ;
             <http://www.w3.org/2004/02/skos/core#definition> "A person who provides information, intelligence, or a report (as opposed to automated feeds or technical artifacts)." ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Human Source" ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Often used in HUMINT or OSINT contexts. Reliability scoring is commonly applied to human sources."@en .


###  https://cyberterrain.org/ns/stonework#Hypothesis
:Hypothesis rdf:type owl:Class ;
            rdfs:subClassOf :IntelligenceProduct ;
            <http://www.w3.org/2004/02/skos/core#definition> "A structured, falsifiable prediction about the value a Variable will resolve to once the Behavior or Step declaring that Variable executes."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Hypothesis" ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Formalizes the anticipated side of the Variable lifecycle described in stonework:Variable's scopeNote: a Hypothesis names, in advance, the value an output Variable is predicted to be bound to. Linked to the Variable it predicts via stonework:predictsVariable, and to the prediction itself via stonework:predictedType (a class, the common case — mirrors stonework:guardType), stonework:predictedValue (a specific individual), or stonework:predictedLiteral (a scalar) — mirroring stonework:boundTo/stonework:boundToLiteral on the actual-result side. A Transition's guard properties, which test a Variable's actual bound value, implicitly test agreement with whichever Hypothesis predicted that Variable — confirming it if they match, refuting it otherwise. May attach at any level of a Step/Plan decomposition, since stonework:Step is itself a stonework:Behavior."@en .


###  https://cyberterrain.org/ns/stonework#HypothesisStatus
:HypothesisStatus rdf:type owl:Class ;
                  rdfs:subClassOf :Category ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                    owl:hasValue :hypothesisStatusScheme
                                  ] ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A classification of a Hypothesis's position in the confirm/refute lifecycle."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Hypothesis Status"@en ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "Applied via stonework:hasHypothesisStatus to Hypothesis individuals. Named individuals: pending (not yet tested), confirmed (actual result matched the prediction), refuted (actual result did not match the prediction)."@en .


###  https://cyberterrain.org/ns/stonework#IBAN
:IBAN rdf:type owl:Class ;
      rdfs:subClassOf :Identifier ;
      <http://www.w3.org/2004/02/skos/core#definition> "An International Bank Account Number (ISO 13616): the cross-jurisdiction normalized identifier for a bank account."@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "IBAN"@en ;
      <http://www.w3.org/2004/02/skos/core#scopeNote> "The value is stonework:iban. A single stonework:FinancialAccount may carry both an IBAN and one or more domestic identifiers (stonework:BankAccountNumber) via stonework:hasIdentifier; the IBAN is the normalized form that reconciles differing national account-number formats."@en .


###  https://cyberterrain.org/ns/stonework#IPAddress
:IPAddress rdf:type owl:Class ;
           rdfs:subClassOf :Infrastructure ;
           <http://www.w3.org/2004/02/skos/core#definition> "Represents a single IP address (IPv4 or IPv6)."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "IP Address"@en .


###  https://cyberterrain.org/ns/stonework#IPBlock
:IPBlock rdf:type owl:Class ;
         rdfs:subClassOf :Infrastructure ;
         <http://www.w3.org/2004/02/skos/core#definition> "A Classless Inter-Domain Routing (CIDR) block used to represent an IP network range."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "IP Block"@en .


###  https://cyberterrain.org/ns/stonework#Identifier
:Identifier rdf:type owl:Class ;
            rdfs:subClassOf :CyberEntity ;
            <http://www.w3.org/2004/02/skos/core#definition> "A first-class representation of a security-relevant identifier value, such as an email address, cryptographic hash, MAC address, phone number, URI, or user-agent string."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Identifier" ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Identifier does not provide the RDF identity of every CyberEntity and does not imply that every CyberEntity has an Identifier. Named RDF resources are identified by their IRIs; identifiers originating in external systems are recorded with dcterms:identifier or stonework:externalId. Use the most specific available subclass, such as EmailAddress, Hash, MACAddress, PhoneNumber, URI, or UserAgent. Instantiate Identifier directly only when the identifier type is unknown or no suitable subclass exists."@en .


###  https://cyberterrain.org/ns/stonework#IllicitFinanceTechnique
:IllicitFinanceTechnique rdf:type owl:Class ;
                         rdfs:subClassOf :Technique ;
                         <http://www.w3.org/2004/02/skos/core#definition> "A prescribed method for disguising the origin, ownership, or destination of illicitly obtained funds, or for moving value while evading financial controls."@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Illicit Finance Technique"@en ;
                         <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers money-laundering typologies and the adjacent methods of terrorist financing, sanctions evasion, and financial fraud. A neutral structural slot: STONEWORK defines the class but not its individuals. A starter set of FATF-derived typology individuals is supplied by the optional frameworks/fatf.ttl module; other bodies' typology sets can populate the same class. Link an exhibiting stonework:FinancialTransaction or stonework:CyberActivityCluster with stonework:hasBehavior. Because the class sits under stonework:Technique, a concrete laundering chain can later be modeled as a stonework:Procedure that stonework:implements a typology, with no rework."@en .


###  https://cyberterrain.org/ns/stonework#Impact
:Impact rdf:type owl:Class ;
        rdfs:subClassOf :RiskFactor ;
        rdfs:comment "Instances of stonework:Impact SHOULD specify the affected asset or mission, the type of consequence, and the severity level. Impact SHOULD be represented using explicit properties rather than encoded in class IRIs or labels." ;
        <http://www.w3.org/2004/02/skos/core#definition> "The magnitude of harm, loss, or adverse effects that would result if a threat were realized and a compromise occurred, expressed in terms of mission, business, operational, or technical consequences." ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Impact" ;
        <http://www.w3.org/2004/02/skos/core#scopeNote> "Impact represents the severity of consequences associated with a compromise. It may include effects on confidentiality, integrity, availability, safety, mission success, financial loss, or reputational damage. Impact values may be qualitative or quantitative." .


###  https://cyberterrain.org/ns/stonework#ImpactLevel
:ImpactLevel rdf:type owl:Class ;
             rdfs:subClassOf :Category ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                               owl:hasValue :impactLevelScheme
                             ] ;
             <http://www.w3.org/2004/02/skos/core#definition> "An ordinal classification of the magnitude of a security impact."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Impact Level"@en .


###  https://cyberterrain.org/ns/stonework#ImpactType
:ImpactType rdf:type owl:Class ;
            rdfs:subClassOf :Category ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                              owl:hasValue :impactTypeScheme
                            ] ;
            <http://www.w3.org/2004/02/skos/core#definition> "A classification of the security dimension or consequence affected by an impact."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Impact Type"@en .


###  https://cyberterrain.org/ns/stonework#Incident
:Incident rdf:type owl:Class ;
          rdfs:subClassOf :CyberActivity ;
          <http://www.w3.org/2004/02/skos/core#definition> "A significant adverse event or series of related events that has caused, or has the potential to cause, harm to an organization’s operations, assets, or people."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Incident" ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "Distinguished from stonework:Event (a raw, unassessed occurrence) by the presence of human or automated triage declaring significance and adversity. An Incident may aggregate multiple Events, involve one or more Campaigns, and trigger Investigation and Playbook execution."@en .


###  https://cyberterrain.org/ns/stonework#IncidentStatus
:IncidentStatus rdf:type owl:Class ;
                rdfs:subClassOf :Category ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                  owl:hasValue :incidentStatusScheme
                                ] ;
                <http://www.w3.org/2004/02/skos/core#definition> "A classification of an incident's position in the response lifecycle."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Incident Status"@en .


###  https://cyberterrain.org/ns/stonework#Indicator
:Indicator rdf:type owl:Class ;
           rdfs:subClassOf :IntelligenceProduct ;
           <http://www.w3.org/2004/02/skos/core#definition> "An intelligence assertion that a pattern — atomic, expression-based, or behavioral — when matched in an observed environment, indicates the presence of threat activity attributable to a specific adversary behavior, malware, or campaign."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Indicator"@en ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "The central concept in operational CTI. The term is used by the community in three overlapping senses, all of which stonework:Indicator covers: (1) IOC sense — an atomic observable (IP address, domain, file hash, URL) that has been assessed as malicious or suspicious and tagged for detection; in STONEWORK the underlying observable is the SCO (stonework:IPAddress, stonework:Domain, stonework:Hash), and the Indicator wraps it with the assertion, confidence, and validity window. (2) Pattern sense — a STIX patterning expression over one or more SCOs (e.g., [ipv4-addr:value = ‘198.51.100.0/24’]). (3) Behavioral sense — a multi-step or TTPs-based pattern asserting that an observed sequence of behaviors indicates a technique or campaign. Distinct from stonework:DetectionRule: an Indicator is the intelligence claim (‘look for this’); a DetectionRule is the operational artifact that implements the check (‘here is the Sigma/Snort/YARA rule that looks for it’). Indicators are produced by threat intelligence analysts and consumed by detection pipelines; DetectionRules are deployed in SIEMs, EDRs, and network sensors. Corresponds to STIX 2.1 Indicator SDO. Use stonework:indicates to link an Indicator to the AttackPattern, Malware, Campaign, or ThreatActor it asserts."@en .


###  https://cyberterrain.org/ns/stonework#Industry
:Industry rdf:type owl:Class ;
          rdfs:subClassOf :Sector ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                            owl:hasValue :industryScheme
                          ] ;
          <http://www.w3.org/2004/02/skos/core#definition> "A specific branch of economic activity or commercial sector (typically modeled using NAICS or similar codes)."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Industry"@en ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "Examples: Financial Services, Manufacturing, Retail, Pharmaceuticals."@en .


###  https://cyberterrain.org/ns/stonework#Infrastructure
:Infrastructure rdf:type owl:Class ;
                rdfs:subClassOf :CyberEntity ;
                <http://www.w3.org/2004/02/skos/core#definition> "Represents systems, software services, or any group of resources used to conduct cyber operations. Infrastructure is used by threat actors and intrusion sets both offensively and defensively." ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Infrastructure"@en .


###  https://cyberterrain.org/ns/stonework#InfrastructureType
:InfrastructureType rdf:type owl:Class ;
                    rdfs:subClassOf :Category ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                      owl:hasValue :infrastructureTypeScheme
                                    ] ;
                    <http://www.w3.org/2004/02/skos/core#definition> "A classification of infrastructure by its operational role or purpose within a cyber operation."@en ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Infrastructure Type"@en ;
                    <http://www.w3.org/2004/02/skos/core#scopeNote> "Applied via stonework:categorizedBy to Infrastructure individuals. Covers both adversary-controlled infrastructure (C2, staging, phishing) and defender infrastructure (firewall, workstation). Aligns with the STIX 2.1 infrastructure-type open vocabulary."@en .


###  https://cyberterrain.org/ns/stonework#IntelligenceProduct
:IntelligenceProduct rdf:type owl:Class ;
                     rdfs:subClassOf :CyberEntity ;
                     <http://www.w3.org/2004/02/skos/core#definition> "A structured artifact produced by an intelligence or analytical process, intended to convey findings, assessments, observations, or sourcing context to support decision-making."@en ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Intelligence Product"@en ;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "The intelligence product hierarchy covers the outputs of the intelligence lifecycle: Reports, Assessments, Sightings, Notes, and Provenance records. Distinguished from stonework:DigitalArtifact (raw observable technical data) and stonework:Behavior (plan specifications and TTP patterns). Intelligence products are the result of human or automated analytical work applied to raw data — they carry judgment, context, and traceability that raw artifacts do not."@en .


###  https://cyberterrain.org/ns/stonework#Investigation
:Investigation rdf:type owl:Class ;
               rdfs:subClassOf :Process ;
               <http://www.w3.org/2004/02/skos/core#definition> "A systematic Process of inquiry, evidence collection, analysis, hypothesis testing, and conclusion to understand, attribute, or resolve security incidents, threats, anomalies, or other matters of interest." ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Investigation" ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "Includes digital forensics, threat hunting, root cause analysis, and incident investigations. Links to Sightings, Evidence (via categorizedBy), Sensors, and produces Findings or updated Assessments."@en .


###  https://cyberterrain.org/ns/stonework#InvestigationPlan
:InvestigationPlan rdf:type owl:Class ;
                   rdfs:subClassOf :Behavior ;
                   rdfs:comment "An InvestigationPlan is a plan specification; executing one produces an instance of stonework:Investigation."@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "A Step-decomposed sequence of actions for systematically examining a cyber entity, artifact, or event to determine its nature, extent, or significance."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Investigation Plan" ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "The general assessment-plan counterpart to stonework:Playbook on the production side: where a Playbook's execution changes state in the world, an InvestigationPlan's execution (a stonework:Investigation) produces judgment about something that already exists or happened — typically a stonework:Analysis or stonework:Assessment. stonework:DetectionPlan is a specialized subclass, narrowly scoped to determining whether observed activity constitutes a security-relevant violation; broader analytical work (forensic analysis, malware analysis, vulnerability assessment) is modeled directly as InvestigationPlan."@en .


###  https://cyberterrain.org/ns/stonework#KillChainPhase
:KillChainPhase rdf:type owl:Class ;
                rdfs:subClassOf :Category ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                  owl:hasValue :killChainPhaseScheme
                                ] ;
                <http://www.w3.org/2004/02/skos/core#definition> "A named phase within a kill chain or attack lifecycle framework used to categorize the stage of an offensive or defensive operation."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Kill Chain Phase"@en ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Applies to both offensive frameworks (Lockheed Martin Cyber Kill Chain, MITRE ATT&CK) and defensive lifecycle models. Used to tag AttackTechniques, Procedures, or Events with their operational phase."@en .


###  https://cyberterrain.org/ns/stonework#LaunderingStage
:LaunderingStage rdf:type owl:Class ;
                 rdfs:subClassOf :Tactic ;
                 <http://www.w3.org/2004/02/skos/core#definition> "One of the classic phases of a money-laundering scheme — placement, layering, or integration — grouping the techniques that serve that phase's objective."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Laundering Stage"@en ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "The illicit-finance counterpart of stonework:OffensiveTactic: a high-level objective that groups stonework:IllicitFinanceTechnique individuals via stonework:hasTechnique. A neutral structural slot; the three canonical individuals are supplied by frameworks/fatf.ttl."@en .


###  https://cyberterrain.org/ns/stonework#Likelihood
:Likelihood rdf:type owl:Class ;
            rdfs:subClassOf :RiskFactor ;
            rdfs:comment "Instances of stonework:Likelihood may incorporate assumptions, uncertainty, adversary behavior, historical frequency, or environmental conditions. Likelihood SHOULD be represented using explicit properties rather than encoded in class IRIs or labels." ;
            <http://www.w3.org/2004/02/skos/core#definition> "The estimated probability, plausibility, or frequency with which a threat could be realized and lead to a compromise under specified conditions." ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Likelihood" ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Likelihood reflects the chance that a compromise will occur, considering adversary capability, intent, opportunity, preconditions, and environmental factors. Likelihood values may be qualitative, ordinal, or quantitative." .


###  https://cyberterrain.org/ns/stonework#LikelihoodLevel
:LikelihoodLevel rdf:type owl:Class ;
                 rdfs:subClassOf :Category ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                   owl:hasValue :likelihoodLevelScheme
                                 ] ;
                 <http://www.w3.org/2004/02/skos/core#definition> "An ordinal classification of the assessed likelihood that a security outcome will occur."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Likelihood Level"@en .


###  https://cyberterrain.org/ns/stonework#Location
:Location rdf:type owl:Class ;
          rdfs:subClassOf :CyberEntity ;
          <http://www.w3.org/2004/02/skos/core#definition> "Represents a geographic location. May be as specific as a latitude/longitude coordinate or as broad as a continent. At least one of region, country, or latitude/longitude must be provided." ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Location"@en ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "STONEWORK Location is a STIX-style geographic designator, not a BFO Site of occupancy. The BFO adapter maps it to an information content entity that denotes a place."@en .


###  https://cyberterrain.org/ns/stonework#Log
:Log rdf:type owl:Class ;
     rdfs:subClassOf :DigitalArtifact ;
     <http://www.w3.org/2004/02/skos/core#definition> "A structured or semi-structured record of events, actions, or state changes generated by a system, application, or network component over time."@en ;
     <http://www.w3.org/2004/02/skos/core#prefLabel> "Log"@en ;
     <http://www.w3.org/2004/02/skos/core#scopeNote> "Logs are primary data sources for detection, investigation, and threat hunting. Examples include system event logs, authentication logs, DNS query logs, firewall logs, and application logs. Distinct from NetworkTraffic (which captures raw packet data) and from Event (which represents a parsed, security-relevant occurrence derived from log data)."@en .


###  https://cyberterrain.org/ns/stonework#MACAddress
:MACAddress rdf:type owl:Class ;
            rdfs:subClassOf :Identifier ;
            <http://www.w3.org/2004/02/skos/core#definition> "A media access control address that identifies a network interface at the data-link layer."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "MAC Address"@en ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers 48-bit and 64-bit MAC address representations, including values carried by the STIX 2.1 MAC Address SCO."@en .


###  https://cyberterrain.org/ns/stonework#Malware
:Malware rdf:type owl:Class ;
         rdfs:subClassOf :CyberEntity ;
         <http://www.w3.org/2004/02/skos/core#definition> "A software object intended to perform malicious functions within, or on behalf of, a threat actor. Encompasses both abstract family-level concepts and concrete specimen-level artifacts."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Malware"@en ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "Parent class for stonework:MalwareFamily (STIX is_family=true) and stonework:MalwareSample (STIX is_family=false). Corresponds to the STIX 2.1 malware SDO. Use stonework:categorizedBy to assert behavioral type (e.g., stonework:Ransomware). Use stonework:hasArtifact to link a sample to its captured binary."@en .


###  https://cyberterrain.org/ns/stonework#MalwareAnalysis
:MalwareAnalysis rdf:type owl:Class ;
                 rdfs:subClassOf :Analysis ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A structured record of findings from static or dynamic analysis performed on a malware specimen or family, including the tool used, analysis configuration, and verdict."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Malware Analysis"@en ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Captures the output of a single analysis run: antivirus scan, sandbox execution, reverse-engineering session, etc. Key properties include the analysis product and version, the result verdict (malicious/suspicious/benign/unknown), and references to SCOs observed during analysis. Corresponds to STIX 2.1 MalwareAnalysis SDO."@en .


###  https://cyberterrain.org/ns/stonework#MalwareFamily
:MalwareFamily rdf:type owl:Class ;
               rdfs:subClassOf :Malware ,
                               :Product ;
               <http://www.w3.org/2004/02/skos/core#definition> "An abstract malware concept representing a named strain, lineage, or campaign of malicious software sharing common behavioral patterns, code ancestry, or infrastructure. Corresponds to STIX 2.1 malware SDO with is_family=true."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Malware Family"@en ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "Examples: Cobalt Strike, Mimikatz, WannaCry, BlackCat. A MalwareFamily does not have a specific hash or binary but may be linked to MalwareSample instances via the inverse of stonework:memberOfFamily. Use stonework:categorizedBy to assert behavioral type (e.g., stonework:Ransomware, stonework:Backdoor)."@en .


###  https://cyberterrain.org/ns/stonework#MalwareSample
:MalwareSample rdf:type owl:Class ;
               rdfs:subClassOf :Malware ,
                               :VersionedProduct ;
               <http://www.w3.org/2004/02/skos/core#definition> "A discrete, observable instance of malicious code — a specific binary, script, or executable artifact that can be identified by cryptographic hash, file characteristics, or behavioral signature."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Malware Sample"@en ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "Represents a concrete sample rather than an abstract family concept. A single MalwareFamily may have thousands of associated samples across versions, packers, and dropper variants. Samples are linked to their family via stonework:memberOfFamily and to their file representation via stonework:hasHash or a direct stonework:File association. Properties such as stonework:drops, stonework:downloads, and stonework:communicatesWith describe the behavior of this specific sample, not the family in general."@en .


###  https://cyberterrain.org/ns/stonework#MalwareType
:MalwareType rdf:type owl:Class ;
             rdfs:subClassOf :Category ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                               owl:hasValue :malwareTypeScheme
                             ] ;
             <http://www.w3.org/2004/02/skos/core#definition> "A behavioral or functional classification of malware, describing what the malware does rather than what it is. Corresponds to the STIX 2.1 malware-type open vocabulary."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Malware Type"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Instances (e.g., stonework:Ransomware, stonework:Trojan) are assigned via stonework:categorizedBy. A malware object may carry multiple types. The skos:notation value gives the STIX 2.1 wire-format string for aspirational round-trip export."@en .


###  https://cyberterrain.org/ns/stonework#Markings
:Markings rdf:type owl:Class ;
          rdfs:subClassOf :Category ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                            owl:hasValue :markingScheme
                          ] ;
          <http://www.w3.org/2004/02/skos/core#definition> "Defines a data handling marking used to restrict or label how data can be shared or handled, such as TLP markings. Referenced by object_marking_refs or granular_markings."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Markings"@en .


###  https://cyberterrain.org/ns/stonework#MetricObservation
:MetricObservation rdf:type owl:Class ;
                   rdfs:subClassOf :QualifiedAssertion ;
                   <http://www.w3.org/2004/02/skos/core#definition> "A qualified, time-stamped metric value about a cyber entity, carrying its metric type, source provenance, and optional calculation-model version."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Metric Observation"@en ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Use for values that change over time or differ by source, including EPSS probability, KEV membership, confidence, likelihood, risk scores, and normalized monetary valuations. A stonework:metricNormalizedValue observation records its output currency with stonework:valuationCurrency. Direct datatype properties remain convenience projections for consumers that need a single current value."@en .


###  https://cyberterrain.org/ns/stonework#MetricType
:MetricType rdf:type owl:Class ;
            rdfs:subClassOf :Category ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                              owl:hasValue :metricTypeScheme
                            ] ;
            <http://www.w3.org/2004/02/skos/core#definition> "A controlled classification identifying the meaning and scale of a qualified metric observation."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Metric Type"@en .


###  https://cyberterrain.org/ns/stonework#Mitigation
:Mitigation rdf:type owl:Class ;
            rdfs:subClassOf :Countermeasure ;
            rdfs:seeAlso <https://csrc.nist.gov/glossary/term/mitigation> ;
            <http://www.w3.org/2004/02/skos/core#definition> "A deliberate action or control intended to reduce the likelihood, impact, or severity of a risk, threat, vulnerability, or adverse event."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Mitigation" ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Mitigations are proactive or reactive measures applied to address weaknesses or threats. Examples include: applying a security patch, enabling MFA, deploying a firewall rule, isolating a compromised host, or training users. A Mitigation may be a reusable control (ATT&CK sense) or a specific situational action. CourseOfAction is a subclass for contextualized, packaged response actions."@en .


###  https://cyberterrain.org/ns/stonework#MobileDevice
:MobileDevice rdf:type owl:Class ;
              rdfs:subClassOf :Host ;
              <http://www.w3.org/2004/02/skos/core#definition> "A portable computing device with wireless connectivity, typically used for communication, data processing, and accessing networks (e.g., smartphones, tablets, or laptops with cellular capability)."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Mobile Device" ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "In a cyber threat context, Mobile Devices are often treated as both endpoints (Infrastructure) and vectors for attacks (e.g., mobile malware, phishing, lost/stolen device risks). They may host UserAccounts, run Mobile Applications, and connect via cellular, Wi-Fi, or Bluetooth."@en .


###  https://cyberterrain.org/ns/stonework#MonetaryAmount
:MonetaryAmount rdf:type owl:Class ;
                rdfs:subClassOf :CyberEntity ;
                <http://www.w3.org/2004/02/skos/core#definition> "A quantity of money: a decimal magnitude paired with the currency that denominates it."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Monetary Amount"@en ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Reified so magnitude and currency always travel together, mirroring how stonework:Hash pairs algorithm and digest. Attached to a transaction, account, impact, or demand with stonework:hasMonetaryValue or a monetary-value role subproperty. The magnitude is stonework:amount and the unit is stonework:currency. A currency-normalized valuation of the same amount, for example its USD equivalent at a stated time and rate source, is a stonework:MetricObservation on this amount with stonework:valuationCurrency identifying the output currency."@en .


###  https://cyberterrain.org/ns/stonework#Motivation
:Motivation rdf:type owl:Class ;
            rdfs:subClassOf :Category ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                              owl:hasValue :motivationScheme
                            ] ;
            <http://www.w3.org/2004/02/skos/core#definition> "The reason or driving force behind an adversary's decision to conduct an attack or operation."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Motivation"@en ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Applied via stonework:categorizedBy to ThreatActor, Campaign, or Operation individuals. Named individuals cover the STIX 2.1 attack-motivation open vocabulary. Custom motivations may be added as additional individuals."@en .


###  https://cyberterrain.org/ns/stonework#Mutex
:Mutex rdf:type owl:Class ;
       rdfs:subClassOf :DigitalArtifact ;
       <http://www.w3.org/2004/02/skos/core#definition> "A named mutual exclusion object (mutex or semaphore) used by a process to prevent concurrent access to a shared resource. Commonly used as a malware indicator — malware families often create uniquely named mutexes to avoid re-infecting a host."@en ;
       <http://www.w3.org/2004/02/skos/core#prefLabel> "Mutex"@en ;
       <http://www.w3.org/2004/02/skos/core#scopeNote> "Mutex names serve as host-based indicators of compromise. A specific mutex name found on a system can be attributed to a known malware family. Corresponds to the STIX 2.1 Mutex SCO."@en .


###  https://cyberterrain.org/ns/stonework#NetworkService
:NetworkService rdf:type owl:Class ;
                rdfs:subClassOf :Infrastructure ;
                <http://www.w3.org/2004/02/skos/core#definition> "A network-accessible service or endpoint provided by infrastructure, such as HTTP, DNS, or SSH servers."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Network Service" .


###  https://cyberterrain.org/ns/stonework#NetworkTraffic
:NetworkTraffic rdf:type owl:Class ;
                rdfs:subClassOf :DigitalArtifact ;
                <http://www.w3.org/2004/02/skos/core#definition> "A captured or observed network traffic flow between source and destination endpoints, including protocol, ports, payload characteristics, and timing."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Network Traffic"@en ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Distinct from stonework:Log (which captures parsed event records) and stonework:Event (a security-relevant occurrence). NetworkTraffic is the raw flow artifact. May carry indicators such as user-agent strings, URI patterns, or certificate fingerprints observable in transit."@en .


###  https://cyberterrain.org/ns/stonework#Note
:Note rdf:type owl:Class ;
      rdfs:subClassOf :IntelligenceProduct ;
      <http://www.w3.org/2004/02/skos/core#definition> "A free-text annotation attached to one or more individuals to provide additional context, analyst commentary, caveats, or confidence assessments."@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "Note" ;
      <http://www.w3.org/2004/02/skos/core#scopeNote> "Notes are analyst-authored rather than machine-generated. They may express uncertainty, sourcing context, or interpretive observations that do not fit structured properties. Corresponds to STIX 2.1 Note SDO."@en .


###  https://cyberterrain.org/ns/stonework#OffensiveTactic
:OffensiveTactic rdf:type owl:Class ;
                 rdfs:subClassOf :Tactic ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A high-level adversary objective that groups related attack techniques by the goal they serve during an intrusion or operation." ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Offensive Tactic" ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Aligns with MITRE ATT&CK tactics (e.g. Initial Access, Execution, Lateral Movement) and D3FEND OffensiveTactic. Individuals are typically drawn from ATT&CK or similar offensive frameworks via the STONES or framework mapping layers."@en .


###  https://cyberterrain.org/ns/stonework#OnlineReference
:OnlineReference rdf:type owl:Class ;
                 rdfs:subClassOf :Provenance ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A reference to an external online resource (URL, article, post, etc.) used for provenance." ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Online Reference" .


###  https://cyberterrain.org/ns/stonework#Operation
:Operation rdf:type owl:Class ;
           rdfs:subClassOf :CyberActivity ;
           <http://www.w3.org/2004/02/skos/core#definition> "A coordinated set of activities conducted by one or more agents toward a defined objective, typically spanning multiple campaigns, incidents, or phases and characterized by unified command, intent, or resourcing."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Operation" ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Operations are broader in scope than Campaigns — a single Operation may encompass multiple Campaigns executed over an extended period. Applies to both offensive operations (e.g. state-sponsored cyber operations) and defensive operations (e.g. incident response operations, threat hunting operations)."@en .


###  https://cyberterrain.org/ns/stonework#OperationPlan
:OperationPlan rdf:type owl:Class ;
               rdfs:subClassOf :Playbook ;
               <http://www.w3.org/2004/02/skos/core#definition> "A Playbook specifically representing an adversary's operational plan — the offensive counterpart within the Playbook hierarchy."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Operation Plan" ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "Named to avoid colliding with the already-established stonework:AttackPattern and stonework:AttackTechnique, and to align with stonework:Operation, whose definition ('a coordinated set of activities... unified command, intent, or resourcing') describes the executed counterpart of an OperationPlan. Generic stonework:Playbook remains available for the undifferentiated or defensive case."@en .


###  https://cyberterrain.org/ns/stonework#Opinion
:Opinion rdf:type owl:Class ;
         rdfs:subClassOf :IntelligenceProduct ;
         <http://www.w3.org/2004/02/skos/core#definition> "An analyst's epistemological stance on the correctness or credibility of information asserted in another intelligence object."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Opinion"@en ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "Sibling to stonework:Assessment under IntelligenceProduct. Where Assessment evaluates risk or impact, Opinion evaluates the reliability or accuracy of existing intelligence — e.g., 'I disagree with this threat score' or 'I believe this indicator attribution is incorrect'. Corresponds to STIX 2.1 Opinion SDO. The opinion value (strongly-agree to strongly-disagree) and explanation are captured via stones: properties."@en .


###  https://cyberterrain.org/ns/stonework#Organization
:Organization rdf:type owl:Class ;
              rdfs:subClassOf :Agent ;
              rdfs:seeAlso <http://www.w3.org/ns/prov#Organization> ;
              <http://www.w3.org/2004/02/skos/core#definition> "A formal or semi-formal structured entity such as a company, government agency, non-profit, military unit, or consortium with defined boundaries and usually legal identity."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Organization" ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "Corresponds to STIX Identity with identity_class = 'organization'. Includes corporations, government bodies, NGOs, universities, etc. Distinguished from Group by having more persistent structure, roles, and often legal standing."@en .


###  https://cyberterrain.org/ns/stonework#PaymentInstrument
:PaymentInstrument rdf:type owl:Class ;
                   rdfs:subClassOf :Category ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                     owl:hasValue :paymentInstrumentScheme
                                   ] ;
                   <http://www.w3.org/2004/02/skos/core#definition> "A classification of the instrument or rail used to move value in a financial transaction."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Payment Instrument"@en .


###  https://cyberterrain.org/ns/stonework#Person
:Person rdf:type owl:Class ;
        rdfs:subClassOf :Agent ;
        rdfs:seeAlso <http://www.w3.org/ns/prov#Person> ;
        <http://www.w3.org/2004/02/skos/core#definition> "A single human individual."@en ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Person" ;
        <http://www.w3.org/2004/02/skos/core#scopeNote> "Represents real named people (e.g. employees, threat actors, researchers). Does not include legal entities or groups. Corresponds to STIX Identity with identity_class = 'individual'."@en .


###  https://cyberterrain.org/ns/stonework#PhoneNumber
:PhoneNumber rdf:type owl:Class ;
             rdfs:subClassOf :Identifier ;
             <http://www.w3.org/2004/02/skos/core#definition> "A telephone number used to contact or identify an Agent. Used for attribution, OSINT pivoting, and identity clustering."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Phone Number"@en .


###  https://cyberterrain.org/ns/stonework#PhysicalArtifact
:PhysicalArtifact rdf:type owl:Class ;
                  rdfs:subClassOf :CyberEntity ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A discrete material object relevant to cyber operations — a device, appliance, plant component, or other physical artifact that can be observed, located, or acted upon."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Physical Artifact"@en ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "Sibling of stonework:DigitalArtifact. Covers ICS and OT assets such as PLCs, RTUs, safety systems, and HMIs, as well as other tangible devices in a cyber-physical environment. An ICS device that runs processes and participates in networks may also be typed as stonework:Host. Distinct from stonework:Infrastructure, which groups resources used to conduct cyber operations."@en .


###  https://cyberterrain.org/ns/stonework#Playbook
:Playbook rdf:type owl:Class ;
          rdfs:subClassOf :Behavior ;
          rdfs:comment "A Playbook is a plan specification; executing one produces instances of stonework:Process. Playbooks are often versioned and tested before use."@en ;
          rdfs:seeAlso <http://www.w3.org/ns/prov#Plan> ;
          <http://www.w3.org/2004/02/skos/core#definition> "A documented, structured Behavior that defines a sequenced set of steps, decisions, and actions to be executed in response to a specific type of event, incident, or operational need."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Playbook" ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "A Playbook may be offensive (an adversary's operational playbook — see stonework:OperationPlan) or defensive (an incident response, threat hunting, or recovery playbook) — both are action plans carried out by an interested party, as distinct from stonework:DetectionPlan, which plays a neutral, evaluative role. A Playbook decomposes into Steps via stonework:hasStep; its actual execution is recorded as a stonework:Process."@en .


###  https://cyberterrain.org/ns/stonework#Procedure
:Procedure rdf:type owl:Class ;
           rdfs:subClassOf :Behavior ;
           rdfs:comment "Procedures are instances or patterns of execution that realize a technique. They may include command lines, API calls, malware behaviors, or operator playbook steps. Procedures are distinct from techniques, which describe generalized methods." ;
           <http://www.w3.org/2004/02/skos/core#definition> "A concrete, observable sequence of actions, commands, or behaviors that implements a technique in a specific operational context." ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Procedure" ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "One realization path for a single Technique — the specific commands, scripts, tools, or configuration that carry it out (e.g. the comsvcs.dll MiniDump way of doing OS Credential Dumping: LSASS Memory). Technique-scoped and typically linear. A Procedure may be only a prose description — the common case when ingesting MITRE ATT&CK procedure examples — or decomposed into stonework:Step individuals via stonework:hasStep for sub-step depth. Links to the Technique it operationalizes via stonework:implements or its specialization stonework:procedureFor. Distinct from stonework:Playbook / stonework:OperationPlan / stonework:ControlPlan, which are objective-scoped plans that orchestrate several Procedures or Techniques with branching, retry, and control flow; a Plan's Step commonly stonework:implements a Procedure." .


###  https://cyberterrain.org/ns/stonework#Process
:Process rdf:type owl:Class ;
         rdfs:subClassOf :CyberActivity ;
         rdfs:seeAlso <http://www.w3.org/ns/prov#Activity> ,
                      <https://www.opmw.org/model/p-plan/> ;
         <http://www.w3.org/2004/02/skos/core#definition> "An identifiable activity or sequence of activities performed over time by one or more agents to achieve an operational, security, or business objective. It transforms inputs (artifacts, data, configurations) into outputs and may be governed by plans, controls, or policies." ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Process"@en ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "This class operates at the enterprise/operational level and is distinct from low-level runtime Process objects (e.g., STIX SCO Process). It is the execution-side counterpart to Behavior-side plan specifications such as Playbook, ControlPlan, and ThreatScenario — e.g. executing a Playbook produces a Process instance."@en .


###  https://cyberterrain.org/ns/stonework#Product
:Product rdf:type owl:Class ;
         rdfs:subClassOf :CyberEntity ;
         owl:disjointWith :VersionedProduct ;
         rdfs:comment "Instances of stonework:Product represent product families or lines (e.g. 'Apache Log4j', 'Windows 10'). Specific releases are modeled as stonework:VersionedProduct individuals related via stonework:versionOf. CPE entries with wildcard version components map to stonework:Product; entries with concrete versions map to stonework:VersionedProduct."@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "An abstract software, hardware, or firmware product line identified by vendor and product name, independent of any specific version or release. Represents the collection of all versioned releases built under that product identity."@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Product" ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "stonework:Product does not carry version, update, edition, or other release-specific attributes. Those belong on stonework:VersionedProduct. The two classes are disjoint."@en .


###  https://cyberterrain.org/ns/stonework#ProductInstallation
:ProductInstallation rdf:type owl:Class ;
                     rdfs:subClassOf :ComponentContext ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :installationOf ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass :VersionedProduct
                                     ] ;
                     rdfs:comment "Represents the most granular product identity level: not what software exists, but where and how it is installed. Multiple ProductInstallation individuals may reference the same VersionedProduct."@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "A specific installed instance of a VersionedProduct on a particular system or environment, as identified by a SWID tag or equivalent installation record."@en ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Product Installation" ;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "stonework:ProductInstallation is the intended target for SWID tag data. The installing system, path, licensee, and configuration details belong here rather than on stonework:VersionedProduct."@en .


###  https://cyberterrain.org/ns/stonework#ProductType
:ProductType rdf:type owl:Class ;
             rdfs:subClassOf :Category ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                               owl:hasValue :productTypeScheme
                             ] ;
             <http://www.w3.org/2004/02/skos/core#definition> "A classification of a product by its primary functional category within a system or architecture."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Product Type"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Applied via stonework:hasProductType to Product individuals. Aligns with CPE component type designations. A product may have more than one type (e.g. an embedded OS is both firmware and operating-system)."@en .


###  https://cyberterrain.org/ns/stonework#Provenance
:Provenance rdf:type owl:Class ;
            rdfs:subClassOf :CyberEntity ;
            <http://www.w3.org/2004/02/skos/core#definition> "Structured source references used to record the origin and trustworthiness of data and relationships."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Provenance"@en ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Includes Feeds, Publications, and URL References."@en .


###  https://cyberterrain.org/ns/stonework#Publication
:Publication rdf:type owl:Class ;
             rdfs:subClassOf :Provenance ;
             <http://www.w3.org/2004/02/skos/core#definition> "A structured intelligence artifact such as a blog post, advisory, report, or news article." ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Publication" .


###  https://cyberterrain.org/ns/stonework#QualifiedAssertion
:QualifiedAssertion rdf:type owl:Class ;
                    rdfs:subClassOf :CyberEntity ;
                    <http://www.w3.org/2004/02/skos/core#definition> "A first-class record of an assertion or relationship that may carry provenance, time, and other context not represented by an unqualified binary property or scalar value."@en ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Qualified Assertion"@en ;
                    <http://www.w3.org/2004/02/skos/core#scopeNote> "Use assertionSubject, assertionObject, and assertionRelationType for generic directed relationships; subclasses may provide more specific structure. Use direct properties as query-friendly projections when their loss of source, time, or relationship context is acceptable. Provenance is optional in the baseline interoperability profile and required by the strict SHACL overlay."@en .


###  https://cyberterrain.org/ns/stonework#Region
:Region rdf:type owl:Class ;
        rdfs:subClassOf :Location ;
        <http://www.w3.org/2004/02/skos/core#definition> "A sub-national territorial division such as a state, province, region, or governorate." ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Region" .


###  https://cyberterrain.org/ns/stonework#Registry
:Registry rdf:type owl:Class ;
          rdfs:subClassOf :DigitalArtifact ;
          <http://www.w3.org/2004/02/skos/core#definition> "Describes elements within the Windows configuration Registry system." ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Registry" .


###  https://cyberterrain.org/ns/stonework#RegistryKey
:RegistryKey rdf:type owl:Class ;
             rdfs:subClassOf :Registry ;
             <http://www.w3.org/2004/02/skos/core#definition> "A named key in a Windows Registry hierarchy that may contain subordinate keys and registry values."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Registry Key"@en .


###  https://cyberterrain.org/ns/stonework#RegistryValue
:RegistryValue rdf:type owl:Class ;
               rdfs:subClassOf :Registry ;
               <http://www.w3.org/2004/02/skos/core#definition> "A named or default value stored beneath a Windows Registry key, including its value type and literal data."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Registry Value"@en .


###  https://cyberterrain.org/ns/stonework#Report
:Report rdf:type owl:Class ;
        rdfs:subClassOf :IntelligenceProduct ;
        <http://www.w3.org/2004/02/skos/core#definition> "A collection of threat intelligence focused on one or more topics, such as a description of a threat actor, malware, or attack technique." ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Report" .


###  https://cyberterrain.org/ns/stonework#ResourceLevel
:ResourceLevel rdf:type owl:Class ;
               rdfs:subClassOf :Category ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                 owl:hasValue :resourceLevelScheme
                               ] ;
               <http://www.w3.org/2004/02/skos/core#definition> "A classification of the organizational resources available to a threat actor."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Resource Level"@en .


###  https://cyberterrain.org/ns/stonework#Risk
:Risk rdf:type owl:Class ;
      rdfs:subClassOf :RiskFactor ;
      rdfs:comment "Instances of stonework:Risk may reference the threat being considered, the assets affected, the expected impact of compromise, and the likelihood of occurrence. Risk values may be qualitative or quantitative, and SHOULD be represented using explicit properties rather than encoded in class IRIs or labels." ;
      <http://www.w3.org/2004/02/skos/core#definition> "A measure of the potential for loss or adverse effects arising from the realization of a threat, expressed as a function of the impact of compromise and the likelihood that the compromise will occur." ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "Risk" ;
      <http://www.w3.org/2004/02/skos/core#scopeNote> "This class represents the assessed or estimated level of exposure to harm for a specific asset, mission, or organization. Risk is typically derived from the combination of impact and likelihood, and may incorporate assumptions, uncertainty, and contextual factors." .


###  https://cyberterrain.org/ns/stonework#RiskFactor
:RiskFactor rdf:type owl:Class ;
            rdfs:subClassOf :CyberEntity ;
            <http://www.w3.org/2004/02/skos/core#definition> "A calculated or assessed component used to quantify or characterize security risk, including the potential for harm and the probability of its occurrence."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Risk Factor" ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Includes Risk (overall assessed exposure), Impact (magnitude of harm if realized), and Likelihood (probability of occurrence). These are analytical outputs derived from threat and vulnerability data, distinct from the conditions (SecurityCondition) that give rise to them and the countermeasures (Countermeasure) that address them."@en .


###  https://cyberterrain.org/ns/stonework#RiskLevel
:RiskLevel rdf:type owl:Class ;
           rdfs:subClassOf :Category ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                             owl:hasValue :riskLevelScheme
                           ] ;
           <http://www.w3.org/2004/02/skos/core#definition> "An ordinal classification of the assessed magnitude of a security risk."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Risk Level"@en .


###  https://cyberterrain.org/ns/stonework#Role
:Role rdf:type owl:Class ;
      rdfs:subClassOf :CyberEntity ;
      <http://www.w3.org/2004/02/skos/core#definition> "A function, capacity, or part played by an entity in a specific context, relationship, or operation." ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "Role" ;
      <http://www.w3.org/2004/02/skos/core#scopeNote> "Roles are typically more stable and relational than Categories. An entity can play multiple Roles. Aligns with patterns in BFO, CCO, and D3FEND (e.g., functional roles of infrastructure or actors)."@en .


###  https://cyberterrain.org/ns/stonework#RoleAssignment
:RoleAssignment rdf:type owl:Class ;
                rdfs:subClassOf :QualifiedAssertion ;
                <http://www.w3.org/2004/02/skos/core#definition> "A qualified record assigning a Role to an entity within a particular campaign, operation, organization, or other context."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Role Assignment"@en ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Create separate assignments when the same entity plays different roles in different contexts or time intervals. The assignment can infer the context-free stonework:playsRole projection through the declared property chain."@en .


###  https://cyberterrain.org/ns/stonework#RuntimeProcess
:RuntimeProcess rdf:type owl:Class ;
                rdfs:subClassOf :DigitalArtifact ;
                <http://www.w3.org/2004/02/skos/core#definition> "A running or terminated process instance on a host, identified by PID, executable path, command line, parent process, and associated user account."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Runtime Process"@en ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Represents low-level OS process objects observed during execution — distinct from stonework:Process (enterprise-level workflows). Mutex objects created by a process are linked as stonework:Mutex individuals. Corresponds to STIX 2.1 Process SCO."@en .


###  https://cyberterrain.org/ns/stonework#Sector
:Sector rdf:type owl:Class ;
        rdfs:subClassOf :Category ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                          owl:hasValue :sectorScheme
                        ] ;
        <http://www.w3.org/2004/02/skos/core#definition> "A broad division or category of economic activity, infrastructure, or society used for classification and targeting purposes."@en ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Sector"@en ;
        <http://www.w3.org/2004/02/skos/core#scopeNote> "Can represent both commercial industries and critical infrastructure sectors (e.g., from CISA or NIST frameworks)."@en .


###  https://cyberterrain.org/ns/stonework#SecurityActuation
:SecurityActuation rdf:type owl:Class ;
                   rdfs:subClassOf :CyberActivity ;
                   rdfs:seeAlso <https://www.w3.org/TR/vocab-ssn/#SOSAActuation> ;
                   <http://www.w3.org/2004/02/skos/core#definition> "A specific cyber activity in which a deployed security mechanism changes the security state of one or more cyber entities."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Security Actuation"@en ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Use stonework:madeByActuator for the deployed mechanism, stonework:appliesCountermeasure for the safeguard or procedure being carried out, and stonework:actsOn for each affected entity. Unlike a Countermeasure specification, a SecurityActuation is an occurrence and may carry execution times and produced results. Inspired by SOSA sosa:Actuation without formally importing SOSA. The baseline SHACL profile requires madeByActuator at violation severity — the acting tool's own identity is always self-asserted and known at creation time — but only warns on a missing actsOn: the tooling that performed an actuation typically knows what it acted on in source-native terms (an IP, a hostname, a process ID) before that reference resolves to a canonical CyberEntity individual, the same resolution lag as stonework:RoleAssignment's roleContext or stonework:MetricObservation's metricFor. A SecurityActuation with no actsOn yet is incomplete, not malformed."@en .


###  https://cyberterrain.org/ns/stonework#SecurityActuator
:SecurityActuator rdf:type owl:Class ;
                  rdfs:subClassOf :Infrastructure ;
                  rdfs:seeAlso <https://www.w3.org/TR/vocab-ssn/#SOSAActuator> ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A deployed system, service, appliance, or software agent capable of changing the security state of a cyber environment by applying a countermeasure."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Security Actuator"@en ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "A SecurityActuator is the mechanism that applies a safeguard, not the safeguard specification itself. Firewalls, EDR agents, access-control services, and patch-management systems are typical examples. A mechanism such as an IPS or EDR agent may be both a stonework:Sensor and a SecurityActuator. Distinct from stonework:Actuator, which is a physical process or plant actuator. Inspired by SOSA sosa:Actuator without formally importing SOSA."@en .


###  https://cyberterrain.org/ns/stonework#SecurityCondition
:SecurityCondition rdf:type owl:Class ;
                   rdfs:subClassOf :CyberEntity ;
                   <http://www.w3.org/2004/02/skos/core#definition> "A state, circumstance, or disposition relevant to the security posture of a system, asset, or mission — existing independently of any measurement or assessment."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Security Condition" ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Includes Threats, Vulnerabilities, and Weaknesses. Risk, Impact, and Likelihood are assessed/calculated concepts and are modeled under stonework:RiskFactor."@en .


###  https://cyberterrain.org/ns/stonework#SecurityObservation
:SecurityObservation rdf:type owl:Class ;
                     rdfs:subClassOf :IntelligenceProduct ;
                     rdfs:seeAlso <https://www.w3.org/TR/vocab-ssn/#SOSAObservation> ;
                     <http://www.w3.org/2004/02/skos/core#definition> "A time-bounded record produced by a security sensor or automated tool capturing one or more cyber observables witnessed in a monitored environment, together with frequency metadata."@en ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Security Observation"@en ;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "Machine-produced intelligence: a sensor is not an analyst, but its output feeds the intelligence pipeline in the same way that SIGINT feeds human analysis. Key metadata: the time window the phenomenon was witnessed (first/last observed), how many times it was observed (number_observed), and which cyber observables were captured (hasObservable). Use stonework:madeBySensor to link to the producing stonework:Sensor. Distinct from stonework:Sighting, which records that a known CTI object (indicator, malware, threat actor) was seen; SecurityObservation is the raw sensor-layer record prior to attribution or indicator matching. Corresponds to STIX 2.1 observed-data SDO. Inspired by SOSA sosa:Observation — compatible in concept but does not formally import the SOSA ontology."@en .


###  https://cyberterrain.org/ns/stonework#Sensor
:Sensor rdf:type owl:Class ;
        rdfs:subClassOf :Infrastructure ;
        rdfs:seeAlso <https://www.w3.org/TR/vocab-ssn/#SOSASensor> ;
        <http://www.w3.org/2004/02/skos/core#definition> "A deployed system, appliance, agent, or network tap that collects data about digital artifacts, network activity, or adversary behavior for detection and investigation purposes."@en ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Sensor" ;
        <http://www.w3.org/2004/02/skos/core#scopeNote> "Applies DetectionRules via stonework:usesRule. May be a software agent, physical appliance, virtual instance, or network sensor. Examples: IDS/IPS, SIEM collector, endpoint agent, network tap, honeypot, vulnerability scanner. An AI-driven sensor that crosses into autonomous decision-making may be additionally typed as stonework:AIAgent. Aligns with D3FEND Sensor. Inspired by SOSA sosa:Sensor — compatible in concept but does not formally import the SOSA ontology. Produces stonework:SecurityObservation instances via stonework:madeBySensor."@en .


###  https://cyberterrain.org/ns/stonework#Sighting
:Sighting rdf:type owl:Class ;
          rdfs:subClassOf :IntelligenceProduct ;
          <http://www.w3.org/2004/02/skos/core#definition> "Records that a object such as an indicator, malware, tool, or threat actor was seen. Wraps observation metadata around a reference to the sighted object."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Sighting" .


###  https://cyberterrain.org/ns/stonework#Signature
:Signature rdf:type owl:Class ;
           rdfs:subClassOf :DetectionRule ;
           <http://www.w3.org/2004/02/skos/core#definition> "A content-centric detection rule that matches malicious activity by a specific pattern — a byte sequence, string, hash, regular expression, or network packet structure."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Signature"@en ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Includes YARA rules, Snort/Suricata rules, and AV signatures. Distinguished from broader DetectionRule subclasses (behavioral, correlation, analytic) by its tight binding to a specific known-bad indicator or artifact pattern."@en .


###  https://cyberterrain.org/ns/stonework#SoftwareBillOfMaterials
:SoftwareBillOfMaterials rdf:type owl:Class ;
                         rdfs:comment "An SBOM asserts that specific VersionedProduct instances are components of a containing artifact. Component entries are represented as stonework:BomEntry instances linked via stonework:hasBomEntry."@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "A formal, machine-readable inventory of VersionedProduct components that constitute a software artifact or system, expressed in a standard format such as CycloneDX or SPDX."@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Software Bill of Materials" ;
                         <http://www.w3.org/2004/02/skos/core#scopeNote> "SoftwareBillOfMaterials is a native STONEWORK class — not a subclass of any STIX domain object, as STIX 2.1 has no SBOM concept. Instances correspond to SBOM documents; format provenance (CycloneDX 1.6, SPDX 2.3, etc.) is expressed via stonework:bomFormat."@en .


###  https://cyberterrain.org/ns/stonework#SophisticationLevel
:SophisticationLevel rdf:type owl:Class ;
                     rdfs:subClassOf :Category ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                       owl:hasValue :sophisticationLevelScheme
                                     ] ;
                     <http://www.w3.org/2004/02/skos/core#definition> "A classification of a threat actor's assessed technical sophistication."@en ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Sophistication Level"@en .


###  https://cyberterrain.org/ns/stonework#Step
:Step rdf:type owl:Class ;
      rdfs:subClassOf :Behavior ;
      rdfs:seeAlso <http://purl.org/net/p-plan#Step> ;
      <http://www.w3.org/2004/02/skos/core#definition> "A single, individually addressable unit of action within a Behavior that models a multi-step process, such as a Procedure, Playbook, ThreatScenario, or Control."@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "Step" ;
      <http://www.w3.org/2004/02/skos/core#scopeNote> "A Step is itself a Behavior — a plan specification for a sub-action, not its execution — consistent with p-plan:Step subclassing prov:Plan rather than prov:Activity. Because Step is a Behavior, a Step MAY itself decompose into further Steps via stonework:hasStep, supporting nested sub-procedures (e.g. a Kill Chain phase decomposing into candidate technique attempts) without a separate composite class. The activity that executes a Step is a stonework:CyberActivity; it links back to the Step it realizes via stonework:correspondsToStep."@en .


###  https://cyberterrain.org/ns/stonework#Tactic
:Tactic rdf:type owl:Class ;
        rdfs:subClassOf :Behavior ;
        rdfs:comment "Instances of stonework:Tactic SHOULD correspond to high‑level adversary goals. Techniques are typically modeled as children or members of a tactic." ;
        <http://www.w3.org/2004/02/skos/core#definition> "A high‑level objective or strategic goal that groups related techniques by the purpose they serve during an operation." ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Tactic" ;
        <http://www.w3.org/2004/02/skos/core#scopeNote> "Superclass for OffensiveTactic and DefensiveTactic. Tactics represent the strategic intent behind behavior — gaining initial access, exfiltrating data, or hardening a system. They serve as conceptual categories for techniques." .


###  https://cyberterrain.org/ns/stonework#Technique
:Technique rdf:type owl:Class ;
           rdfs:subClassOf :Behavior ;
           rdfs:comment "Mirrors D3FEND's Technique class and reflects the PROV-O Plan philosophy: a technique is a plan that describes how an action should be carried out, distinct from the activity that executes it. Subclassed by stonework:CyberTechnique for cyber-specific methods." ;
           <http://www.w3.org/2004/02/skos/core#definition> "A reusable, prescribed method for achieving an objective, which may be instantiated as a concrete execution by an actor or system." ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Technique" ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "A method specification, not a plan: a Technique describes an approach ('access credential material in LSASS process memory') without prescribing an ordered, branched sequence of steps. Concrete step structure appears one level down, in a stonework:Procedure that realizes the Technique, or in a stonework:Playbook / stonework:OperationPlan that orchestrates several. An execution links to the Technique it performs directly with stonework:executionOf — no Procedure, Plan, or Step is required for the lightweight case. Technique is intentionally not a subclass of stones:AttackPattern: attack patterns such as CAPEC are abstract taxonomy entries, while Techniques are operationalized methods closer to execution. See stonework:CyberTechnique, stonework:AttackTechnique, stonework:DefendTechnique, and docs/technique-modeling.md." .


###  https://cyberterrain.org/ns/stonework#Threat
:Threat rdf:type owl:Class ;
        rdfs:subClassOf :SecurityCondition ;
        rdfs:comment "Instances of stonework:Threat may describe adversary capabilities, strategic objectives, targeting patterns, or environmental conditions that increase the likelihood of harmful action. Threats may be linked to threat actors, campaigns, malware, TTPs, weaknesses, or assets, but are conceptually distinct from the actions or events that realize them." ;
        <http://www.w3.org/2004/02/skos/core#definition> "A potential or actual source of harm arising from an adversary's capability, intent, and opportunity to exploit weaknesses or create adverse effects within a system, organization, or mission." ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Threat" ;
        <http://www.w3.org/2004/02/skos/core#scopeNote> "This class represents the abstract notion of a cyber threat, independent of specific threat actors, campaigns, or events. It provides a semantic foundation for modeling adversary capabilities, intentions, targeting, and conditions that give rise to harmful outcomes." .


###  https://cyberterrain.org/ns/stonework#ThreatActor
:ThreatActor rdf:type owl:Class ;
             rdfs:subClassOf :Agent ;
             rdfs:seeAlso <http://www.w3.org/ns/prov#Agent> ;
             <http://www.w3.org/2004/02/skos/core#definition> "An entity that has the capability and intent to conduct harmful activities within a cyber or sociotechnical context." ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Threat Actor"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Parent class for stonework:ThreatActorIndividual (a single human) and stonework:ThreatActorGroup (a collective or organization). Threat actors are distinct from the threats they pose; they are the entities that carry out actions that realize threats. They may be linked to observed behaviors, techniques, targeting patterns, and strategic objectives."@en .


###  https://cyberterrain.org/ns/stonework#ThreatActorGroup
:ThreatActorGroup rdf:type owl:Class ;
                  rdfs:subClassOf :ThreatActor ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A collective, organization, or coordinated set of individuals operating with common intent to conduct adversarial cyber activities."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Threat Actor Group"@en ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers nation-state units, cybercriminal organizations, hacktivist collectives, and other named adversary groups. Industry names such as APT20 or APT29 are often used for both a tracked body of activity and the presumed group behind it. Model the activity as a separate stonework:CyberActivityCluster and link it to the ThreatActorGroup with stonework:attributedTo when supported. MITRE ATT&CK serializes tracked Groups as STIX intrusion-set objects; that source representation alone does not establish that the activity cluster and responsible group are the same entity. Distinguished from stonework:ThreatActorIndividual, which represents a single human actor."@en .


###  https://cyberterrain.org/ns/stonework#ThreatActorIndividual
:ThreatActorIndividual rdf:type owl:Class ;
                       rdfs:subClassOf :ThreatActor ;
                       <http://www.w3.org/2004/02/skos/core#definition> "A single, identifiable human actor with the capability and intent to conduct adversarial cyber activities."@en ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Threat Actor Individual"@en ;
                       <http://www.w3.org/2004/02/skos/core#scopeNote> "Covers individual hackers, insiders, contractors, and other identified persons. Relevant for law enforcement and prosecution contexts where attribution to a specific individual — rather than a group — is required. Distinguished from stonework:ThreatActorGroup, which represents a collective or organization."@en .


###  https://cyberterrain.org/ns/stonework#ThreatActorRole
:ThreatActorRole rdf:type owl:Class ;
                 rdfs:subClassOf :Category ,
                                 :Role ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                   owl:hasValue :threatActorRoleScheme
                                 ] ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A controlled role type describing the function played by a threat actor within a specific operation, campaign, or criminal organization."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Threat Actor Role"@en ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "A threat actor may play different roles across operations — a nation-state actor may be a sponsor in one campaign and a director in another. Use stonework:RoleAssignment for contextual modeling; stonework:playsRole is the context-free STIX-compatible projection."@en .


###  https://cyberterrain.org/ns/stonework#ThreatActorType
:ThreatActorType rdf:type owl:Class ;
                 rdfs:subClassOf :Category ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                   owl:hasValue :threatActorTypeScheme
                                 ] ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A classification of a threat actor by their organizational form, affiliation, or primary mode of operation."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Threat Actor Type"@en ;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Applied via stonework:categorizedBy to ThreatActor individuals. A threat actor may have multiple types. Aligns with the STIX 2.1 threat-actor-type open vocabulary."@en .


###  https://cyberterrain.org/ns/stonework#ThreatScenario
:ThreatScenario rdf:type owl:Class ;
                rdfs:subClassOf :Behavior ;
                rdfs:seeAlso <http://www.w3.org/ns/prov#Plan> ;
                <http://www.w3.org/2004/02/skos/core#definition> "A plan specification describing how a threat could materialize against specific assets or missions — incorporating adversary intent, capability, opportunity, preconditions, attack path, and expected consequences."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Threat Scenario"@en ;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "A ThreatScenario is prescriptive and forward-looking: it specifies a potential sequence of adversary behaviors and environmental conditions rather than recording observed events. Used to guide defensive planning, risk assessment, and Playbook development. Distinct from stonework:Incident (an observed occurrence) and stonework:Threat (an abstract source of harm). Aligns with prov:Plan and P-Plan scenario specifications."@en .


###  https://cyberterrain.org/ns/stonework#Tool
:Tool rdf:type owl:Class ;
      rdfs:subClassOf :Product ;
      <http://www.w3.org/2004/02/skos/core#definition> "Legitimate software that can be used offensively by threat actors or defensively by security practitioners. Distinguishable from malware by being designed for benign or dual-use purposes rather than being inherently malicious."@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "Tool"@en ;
      <http://www.w3.org/2004/02/skos/core#scopeNote> "Includes commercial penetration testing tools, remote administration utilities, and living-off-the-land binaries (LOLBins) repurposed by adversaries, as well as defender-operated tools such as scanners, EDR agents, and forensic utilities. Corresponds to STIX 2.1 Tool SDO."@en .


###  https://cyberterrain.org/ns/stonework#TransactionType
:TransactionType rdf:type owl:Class ;
                 rdfs:subClassOf :Category ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                   owl:hasValue :transactionTypeScheme
                                 ] ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A classification of a financial transaction by the kind of movement it represents."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Transaction Type"@en .


###  https://cyberterrain.org/ns/stonework#Transition
:Transition rdf:type owl:Class ;
            <http://www.w3.org/2004/02/skos/core#definition> "A directed edge between two Steps within the same parent Behavior's Step graph, representing progression from one Step to the next."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Transition" ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Unconditioned, a Transition expresses plain sequence — an alternative to stonework:precededByStep for the same purpose, used when a Step has more than one possible successor and the edges themselves need to be individually referenceable. When a Transition's stonework:toStep targets a Step already reached earlier in the same graph, it expresses a loop back-edge; looping is not a separate construct. Conditional branching is expressed with the guard properties stonework:guardVariable (the Variable tested), stonework:guardType (a class the bound value must be an instance of) or stonework:guardLiteralValue (a scalar it must equal), and stonework:guardOperator (the comparison; omitting it defaults to equality). The Transition fires when its guard holds against the from-Step's bound Variable."@en .


###  https://cyberterrain.org/ns/stonework#URI
:URI rdf:type owl:Class ;
     rdfs:subClassOf :Identifier ;
     <http://www.w3.org/2004/02/skos/core#definition> "Represents a Uniform Resource Identifier conforming to RFC 3986."@en ;
     <http://www.w3.org/2004/02/skos/core#prefLabel> "URI"@en .


###  https://cyberterrain.org/ns/stonework#UserAccount
:UserAccount rdf:type owl:Class ;
             rdfs:subClassOf :Account ;
             <http://www.w3.org/2004/02/skos/core#definition> "An authenticated-access identity on a system or service — a local OS account, cloud or directory account, application account, or social media account — through which a principal logs in and acts."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "User Account"@en ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "The access/authentication sibling of stonework:FinancialAccount under stonework:Account. Where a login governs a value-holding ledger (online banking, an exchange account, a marketplace wallet), model the ledger as a separate stonework:FinancialAccount and link the two with stonework:controls — one login commonly controls several accounts."@en .


###  https://cyberterrain.org/ns/stonework#UserAgent
:UserAgent rdf:type owl:Class ;
           rdfs:subClassOf :Identifier ;
           <http://www.w3.org/2004/02/skos/core#definition> "A string identifier transmitted by a client application in HTTP requests declaring the software, version, and platform making the request. Used for fingerprinting clients, identifying malware C2 beaconing patterns, and clustering infrastructure by shared tooling."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "User Agent"@en ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "User-agent strings are observable in network traffic, proxy logs, and web server logs. Distinctive or spoofed user-agent values are commonly used as indicators in threat intelligence. Distinct from stonework:UserAccount (an identity credential) — a UserAgent describes software behavior, not a user identity."@en .


###  https://cyberterrain.org/ns/stonework#UserGroup
:UserGroup rdf:type owl:Class ;
           rdfs:subClassOf :DigitalIdentity ;
           <http://www.w3.org/2004/02/skos/core#definition> "Represents a user group on a system or service, including local OS groups, cloud groups, and social media groups."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "User Group" .


###  https://cyberterrain.org/ns/stonework#Variable
:Variable rdf:type owl:Class ;
          rdfs:subClassOf :CyberEntity ;
          rdfs:seeAlso <http://purl.org/net/p-plan#Variable> ;
          <http://www.w3.org/2004/02/skos/core#definition> "A named placeholder for a value declared by a Behavior or Step, bound to an actual value only once the corresponding execution occurs."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Variable" ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "Declared via stonework:hasInputVariable or stonework:hasOutputVariable. An input Variable is typically bound before its Step executes from an already-known fact; for example, a plan may bind to an existing stonework:CvssMetric assessment. An output Variable is bound only after its Step executes, such as when an Investigation constructs a stonework:VulnerabilityAssessment. Variables carry execution-time values and do not replace persistent domain relationships. Bound via stonework:boundTo (an individual) or stonework:boundToLiteral (a scalar). The bound value is what stonework:Transition guard properties test, and — in a future deviation-detection layer — what an actual result is compared against what the Step declared as expected."@en .


###  https://cyberterrain.org/ns/stonework#VersionedProduct
:VersionedProduct rdf:type owl:Class ;
                  rdfs:comment "Instances of stonework:VersionedProduct may include operating systems, applications, libraries, devices, or embedded components at a specific release. Versioning, vendor attribution, and edition details SHOULD be represented using explicit properties rather than encoded strings."@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A specific versioned release or build of a Product, identified by a CPE name or equivalent product identifier. Represents the unit of software actually deployed and potentially affected by vulnerabilities."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Versioned Product" ;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "Each CPE 2.3 entry with a concrete version component maps to a stonework:VersionedProduct individual. Wildcard-version CPEs map to stonework:Product. Related to its abstract product line via stonework:versionOf."@en .


###  https://cyberterrain.org/ns/stonework#Vulnerability
:Vulnerability rdf:type owl:Class ;
               rdfs:subClassOf :SecurityCondition ;
               <http://www.w3.org/2004/02/skos/core#definition> "A flaw or weakness in software, hardware, firmware, or system architecture that can be exploited by a threat actor to compromise confidentiality, integrity, or availability."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Vulnerability" ;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "Represents specific exploitable instances (e.g., CVE-identified vulnerabilities) rather than weakness classes — those are modeled as stonework:Weakness. A Vulnerability is linked to its root Weakness via stonework:hasWeakness, to affected products via stonework:affected, to its fix via stonework:fixedInProduct, and to exploiting malware or actors via stonework:exploits. Aligns with D3FEND Vulnerability and NVD CVE."@en .


###  https://cyberterrain.org/ns/stonework#VulnerabilityAssessment
:VulnerabilityAssessment rdf:type owl:Class ;
                         rdfs:subClassOf :Assessment ;
                         <http://www.w3.org/2004/02/skos/core#definition> "A structured evaluation of a specific vulnerability's applicability and risk in a particular product or deployment context."@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Vulnerability Assessment"@en ;
                         <http://www.w3.org/2004/02/skos/core#scopeNote> "Captures VEX-style assessments: whether a product is affected, not affected, fixed, or under investigation, together with the justification and any remediation statement. Distinct from stonework:Vulnerability (which describes the flaw itself) and stonework:CvssMetric (which gives context-neutral technical severity): a VulnerabilityAssessment is a judgment about applicability and risk in a specific product, deployment, or enterprise context. It may be constructed by an Investigation executing a Plan whose inputs include the vulnerability, its CVSS assessment, and current enterprise graph state."@en .


###  https://cyberterrain.org/ns/stonework#Weakness
:Weakness rdf:type owl:Class ;
          rdfs:subClassOf :SecurityCondition ;
          rdfs:comment "Instances of stonework:Weakness may represent base weaknesses, variant weaknesses, or compound weaknesses. CWE identifiers (e.g., \"CWE‑79\") SHOULD be modeled using explicit properties rather than encoded in the class IRI. Descriptions and extended details SHOULD be referenced via citations rather than reproduced verbatim." ;
          <http://www.w3.org/2004/02/skos/core#definition> "A type of flaw, fault, or design condition in software, hardware, or system architecture that can enable vulnerabilities, reduce security assurance, or increase the likelihood of exploitable behavior." ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Weakness" ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "This class provides a semantic representation of weakness types defined in the Common Weakness Enumeration (CWE). It supports hierarchical relationships, abstraction levels, and mappings to related attack patterns, vulnerabilities, and security controls." .


#################################################################
#    Individuals
#################################################################

###  https://cyberterrain.org/ns/stonework#
<https://cyberterrain.org/ns/stonework#> rdf:type owl:NamedIndividual ;
                                         <http://purl.org/dc/terms/description> "A semantic threat ontology and research framework that serves as the ground-truth model for cyber threat intelligence in the CyberTerrain ecosystem. It provides an extensible foundation for modeling cyber threat intelligence concepts, objects, relationships, workflows, and knowledge, and aligns with established CTI framework ontologies — including STONES (STIX 2.1), ATT&CK, CAPEC, CWE, CVE, and CPE — as authoritative reference vocabularies rather than ontologies it imports and extends." ;
                                         <http://purl.org/dc/terms/title> "STONEWORK — Semantic Threat Ontology and Research Framework"@en .


###  https://cyberterrain.org/ns/stonework#Adware
:Adware rdf:type owl:NamedIndividual ,
                 <http://www.w3.org/2004/02/skos/core#Concept> ,
                 :MalwareType ;
        <http://www.w3.org/2004/02/skos/core#notation> "adware" ;
        <http://www.w3.org/2004/02/skos/core#definition> "Software that automatically displays or downloads advertising material, often without user consent."@en ;
        <http://www.w3.org/2004/02/skos/core#inScheme> :categoryScheme ,
                                                       :malwareTypeScheme ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Adware"@en .


###  https://cyberterrain.org/ns/stonework#Backdoor
:Backdoor rdf:type owl:NamedIndividual ,
                   <http://www.w3.org/2004/02/skos/core#Concept> ,
                   :MalwareType ;
          <http://www.w3.org/2004/02/skos/core#notation> "backdoor" ;
          <http://www.w3.org/2004/02/skos/core#definition> "Malware that provides covert, persistent remote access to a compromised system, bypassing normal authentication."@en ;
          <http://www.w3.org/2004/02/skos/core#inScheme> :categoryScheme ,
                                                         :malwareTypeScheme ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Backdoor"@en .


###  https://cyberterrain.org/ns/stonework#Bootkit
:Bootkit rdf:type owl:NamedIndividual ,
                  <http://www.w3.org/2004/02/skos/core#Concept> ,
                  :MalwareType ;
         <http://www.w3.org/2004/02/skos/core#notation> "bootkit" ;
         <http://www.w3.org/2004/02/skos/core#definition> "Malware that infects the boot sector or master boot record to load before the operating system, enabling deep persistence and defense evasion."@en ;
         <http://www.w3.org/2004/02/skos/core#inScheme> :categoryScheme ,
                                                        :malwareTypeScheme ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Bootkit"@en .


###  https://cyberterrain.org/ns/stonework#Bot
:Bot rdf:type owl:NamedIndividual ,
              <http://www.w3.org/2004/02/skos/core#Concept> ,
              :MalwareType ;
     <http://www.w3.org/2004/02/skos/core#notation> "bot" ;
     <http://www.w3.org/2004/02/skos/core#definition> "Malware that connects an infected host to a command-and-control network, enabling remote tasking as part of a botnet."@en ;
     <http://www.w3.org/2004/02/skos/core#inScheme> :categoryScheme ,
                                                    :malwareTypeScheme ;
     <http://www.w3.org/2004/02/skos/core#prefLabel> "Bot"@en .


###  https://cyberterrain.org/ns/stonework#DDoS
:DDoS rdf:type owl:NamedIndividual ,
               <http://www.w3.org/2004/02/skos/core#Concept> ,
               :MalwareType ;
      <http://www.w3.org/2004/02/skos/core#notation> "ddos" ;
      <http://www.w3.org/2004/02/skos/core#definition> "Malware designed to conduct or participate in distributed denial-of-service attacks against target systems or networks."@en ;
      <http://www.w3.org/2004/02/skos/core#inScheme> :categoryScheme ,
                                                     :malwareTypeScheme ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "DDoS Malware"@en .


###  https://cyberterrain.org/ns/stonework#Downloader
:Downloader rdf:type owl:NamedIndividual ,
                     <http://www.w3.org/2004/02/skos/core#Concept> ,
                     :MalwareType ;
            <http://www.w3.org/2004/02/skos/core#notation> "downloader" ;
            <http://www.w3.org/2004/02/skos/core#definition> "Malware whose primary function is to download and execute additional malicious payloads from a remote source."@en ;
            <http://www.w3.org/2004/02/skos/core#inScheme> :categoryScheme ,
                                                           :malwareTypeScheme ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Downloader"@en .


###  https://cyberterrain.org/ns/stonework#Dropper
:Dropper rdf:type owl:NamedIndividual ,
                  <http://www.w3.org/2004/02/skos/core#Concept> ,
                  :MalwareType ;
         <http://www.w3.org/2004/02/skos/core#notation> "dropper" ;
         <http://www.w3.org/2004/02/skos/core#definition> "Malware that carries and installs one or more secondary payloads onto a target system, often unpacking them from within itself."@en ;
         <http://www.w3.org/2004/02/skos/core#inScheme> :categoryScheme ,
                                                        :malwareTypeScheme ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Dropper"@en .


###  https://cyberterrain.org/ns/stonework#Equals
:Equals rdf:type owl:NamedIndividual ,
                 :ComparisonOperator ;
        <http://www.w3.org/2004/02/skos/core#notation> "eq" ;
        <http://www.w3.org/2004/02/skos/core#definition> "The guardVariable's bound value equals guardLiteralValue."@en ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Equals"@en .


###  https://cyberterrain.org/ns/stonework#ExploitKit
:ExploitKit rdf:type owl:NamedIndividual ,
                     <http://www.w3.org/2004/02/skos/core#Concept> ,
                     :MalwareType ;
            <http://www.w3.org/2004/02/skos/core#notation> "exploit-kit" ;
            <http://www.w3.org/2004/02/skos/core#definition> "A toolkit that automates exploitation of client-side vulnerabilities to deliver malware, typically via drive-by download from compromised or malicious web pages."@en ;
            <http://www.w3.org/2004/02/skos/core#inScheme> :categoryScheme ,
                                                           :malwareTypeScheme ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Exploit Kit"@en .


###  https://cyberterrain.org/ns/stonework#GreaterThan
:GreaterThan rdf:type owl:NamedIndividual ,
                      :ComparisonOperator ;
             <http://www.w3.org/2004/02/skos/core#notation> "gt" ;
             <http://www.w3.org/2004/02/skos/core#definition> "The guardVariable's bound value is greater than guardLiteralValue."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Greater Than"@en .


###  https://cyberterrain.org/ns/stonework#GreaterThanOrEqual
:GreaterThanOrEqual rdf:type owl:NamedIndividual ,
                             :ComparisonOperator ;
                    <http://www.w3.org/2004/02/skos/core#notation> "ge" ;
                    <http://www.w3.org/2004/02/skos/core#definition> "The guardVariable's bound value is greater than or equal to guardLiteralValue."@en ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Greater Than Or Equal"@en .


###  https://cyberterrain.org/ns/stonework#Keylogger
:Keylogger rdf:type owl:NamedIndividual ,
                    <http://www.w3.org/2004/02/skos/core#Concept> ,
                    :MalwareType ;
           <http://www.w3.org/2004/02/skos/core#notation> "keylogger" ;
           <http://www.w3.org/2004/02/skos/core#definition> "Malware that records keystrokes on an infected system to capture credentials, sensitive data, or communications."@en ;
           <http://www.w3.org/2004/02/skos/core#inScheme> :categoryScheme ,
                                                          :malwareTypeScheme ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Keylogger"@en .


###  https://cyberterrain.org/ns/stonework#LessThan
:LessThan rdf:type owl:NamedIndividual ,
                   :ComparisonOperator ;
          <http://www.w3.org/2004/02/skos/core#notation> "lt" ;
          <http://www.w3.org/2004/02/skos/core#definition> "The guardVariable's bound value is less than guardLiteralValue."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Less Than"@en .


###  https://cyberterrain.org/ns/stonework#LessThanOrEqual
:LessThanOrEqual rdf:type owl:NamedIndividual ,
                          :ComparisonOperator ;
                 <http://www.w3.org/2004/02/skos/core#notation> "le" ;
                 <http://www.w3.org/2004/02/skos/core#definition> "The guardVariable's bound value is less than or equal to guardLiteralValue."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Less Than Or Equal"@en .


###  https://cyberterrain.org/ns/stonework#NotEquals
:NotEquals rdf:type owl:NamedIndividual ,
                    :ComparisonOperator ;
           <http://www.w3.org/2004/02/skos/core#notation> "ne" ;
           <http://www.w3.org/2004/02/skos/core#definition> "The guardVariable's bound value does not equal guardLiteralValue."@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Not Equals"@en .


###  https://cyberterrain.org/ns/stonework#Ransomware
:Ransomware rdf:type owl:NamedIndividual ,
                     <http://www.w3.org/2004/02/skos/core#Concept> ,
                     :MalwareType ;
            <http://www.w3.org/2004/02/skos/core#notation> "ransomware" ;
            <http://www.w3.org/2004/02/skos/core#definition> "Malware that encrypts or locks victim data or systems and demands payment for restoration of access."@en ;
            <http://www.w3.org/2004/02/skos/core#inScheme> :categoryScheme ,
                                                           :malwareTypeScheme ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Ransomware"@en .


###  https://cyberterrain.org/ns/stonework#RemoteAccessTrojan
:RemoteAccessTrojan rdf:type owl:NamedIndividual ,
                             <http://www.w3.org/2004/02/skos/core#Concept> ,
                             :MalwareType ;
                    <http://www.w3.org/2004/02/skos/core#notation> "remote-access-trojan" ;
                    <http://www.w3.org/2004/02/skos/core#definition> "Malware providing covert remote control of an infected host, typically including capabilities such as file access, screen capture, keylogging, and command execution."@en ;
                    <http://www.w3.org/2004/02/skos/core#inScheme> :categoryScheme ,
                                                                   :malwareTypeScheme ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Remote Access Trojan"@en .


###  https://cyberterrain.org/ns/stonework#ResourceExploitation
:ResourceExploitation rdf:type owl:NamedIndividual ,
                               <http://www.w3.org/2004/02/skos/core#Concept> ,
                               :MalwareType ;
                      <http://www.w3.org/2004/02/skos/core#notation> "resource-exploitation" ;
                      <http://www.w3.org/2004/02/skos/core#definition> "Malware that abuses the computational resources of an infected host, such as for cryptocurrency mining or proxying network traffic."@en ;
                      <http://www.w3.org/2004/02/skos/core#inScheme> :categoryScheme ,
                                                                     :malwareTypeScheme ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Resource Exploitation"@en .


###  https://cyberterrain.org/ns/stonework#RogueSecuritySoftware
:RogueSecuritySoftware rdf:type owl:NamedIndividual ,
                                <http://www.w3.org/2004/02/skos/core#Concept> ,
                                :MalwareType ;
                       <http://www.w3.org/2004/02/skos/core#notation> "rogue-security-software" ;
                       <http://www.w3.org/2004/02/skos/core#definition> "Malware that masquerades as legitimate security software to deceive users into paying for fake threat removal or granting elevated privileges."@en ;
                       <http://www.w3.org/2004/02/skos/core#inScheme> :categoryScheme ,
                                                                      :malwareTypeScheme ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Rogue Security Software"@en .


###  https://cyberterrain.org/ns/stonework#Rootkit
:Rootkit rdf:type owl:NamedIndividual ,
                  <http://www.w3.org/2004/02/skos/core#Concept> ,
                  :MalwareType ;
         <http://www.w3.org/2004/02/skos/core#notation> "rootkit" ;
         <http://www.w3.org/2004/02/skos/core#definition> "Malware that conceals itself and other malicious software by subverting operating system or hypervisor mechanisms, typically to maintain privileged persistence."@en ;
         <http://www.w3.org/2004/02/skos/core#inScheme> :categoryScheme ,
                                                        :malwareTypeScheme ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Rootkit"@en .


###  https://cyberterrain.org/ns/stonework#ScreenCapture
:ScreenCapture rdf:type owl:NamedIndividual ,
                        <http://www.w3.org/2004/02/skos/core#Concept> ,
                        :MalwareType ;
               <http://www.w3.org/2004/02/skos/core#notation> "screen-capture" ;
               <http://www.w3.org/2004/02/skos/core#definition> "Malware that periodically or continuously captures screenshots of the victim's display and exfiltrates them to an attacker."@en ;
               <http://www.w3.org/2004/02/skos/core#inScheme> :categoryScheme ,
                                                              :malwareTypeScheme ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Screen Capture"@en .


###  https://cyberterrain.org/ns/stonework#Spyware
:Spyware rdf:type owl:NamedIndividual ,
                  <http://www.w3.org/2004/02/skos/core#Concept> ,
