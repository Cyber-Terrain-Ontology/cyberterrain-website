        <skos:prefLabel xml:lang="en">STIX Bundle</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stones#StixCoreObject -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stones#StixCoreObject">
