        <rdfs:isDefinedBy rdf:resource="https://cyberterrain.org/ns/stones#"/>
        <skos:definition>A type of TTP that represents malicious code. Captures both malware families (when is_family is true) and specific instances or samples.</skos:definition>
        <skos:prefLabel xml:lang="en">Malware</skos:prefLabel>
    </owl:Class>
    


