<?xml version="1.0"?>
<rdf:RDF xmlns="https://cyberterrain.org/ns/stonework#"
     xml:base="https://cyberterrain.org/ns/stonework"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://cyberterrain.org/ns/stonework#">
        <owl:versionIRI rdf:resource="https://cyberterrain.org/ns/stonework/0.2.0"/>
        <owl:imports rdf:resource="https://cyberterrain.org/ns/stones#"/>
        <terms:creator>Hohimer Intelligence Strategies LLC</terms:creator>
        <terms:description>A semantic threat ontology and research framework that serves as the evolutionary successor to the STONES ontology. It provides a forward-looking, extensible foundation for modeling next-generation cyber threat intelligence concepts, objects, relationships, workflows, and knowledge beyond the scope of STIX 2.1.</terms:description>
        <terms:license rdf:resource="https://opensource.org/licenses/MIT"/>
        <terms:title xml:lang="en">STONEWORK — Semantic Threat Ontology and Research Framework</terms:title>
        <rdfs:label xml:lang="en">STONEWORK</rdfs:label>
        <owl:versionInfo>0.2.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://cyberterrain.org/ns/stones#attributed_to -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stones#attributed_to">
        <skos:definition>Shortcut triple: source Campaign or IntrusionSet is attributed to target ThreatActor or IntrusionSet. Corresponds to STIX relationship_type &apos;attributed-to&apos;.</skos:definition>
        <skos:prefLabel>attributed_to</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stones#detects -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stones#detects">
        <skos:definition>Shortcut triple: source CourseOfAction or Indicator detects target. Corresponds to STIX relationship_type &apos;detects&apos;.</skos:definition>
        <skos:prefLabel>detects</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stones#exploits -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stones#exploits">
        <skos:definition>Shortcut triple: source Malware or ThreatActor exploits target Vulnerability. Corresponds to STIX relationship_type &apos;exploits&apos;.</skos:definition>
        <skos:prefLabel>exploits</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stones#indicates -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stones#indicates">
        <skos:definition>Shortcut triple: source Indicator indicates presence of target. Corresponds to STIX relationship_type &apos;indicates&apos;.</skos:definition>
        <skos:prefLabel>indicates</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stones#mitigates -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stones#mitigates">
        <skos:definition>Shortcut triple: source CourseOfAction mitigates target AttackPattern or Vulnerability. Corresponds to STIX relationship_type &apos;mitigates&apos;.</skos:definition>
        <skos:prefLabel>mitigates</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stones#related_to -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stones#related_to">
        <skos:definition>Shortcut triple: generic relationship. Corresponds to STIX relationship_type &apos;related-to&apos;.</skos:definition>
        <skos:prefLabel>related_to</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stones#revoked_by -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stones#revoked_by">
        <skos:definition>Shortcut triple: source STIX object is revoked and superseded by target. Corresponds to STIX relationship_type &apos;revoked-by&apos;.</skos:definition>
        <skos:prefLabel>revoked_by</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stones#subtechnique_of -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stones#subtechnique_of">
        <skos:definition>Shortcut triple: source AttackPattern is a sub-technique of target AttackPattern. Corresponds to STIX relationship_type &apos;subtechnique-of&apos; (hyphens converted to underscores in the predicate IRI).</skos:definition>
        <skos:prefLabel>subtechnique_of</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stones#targets -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stones#targets">
        <skos:definition>Shortcut triple: source targets the target Identity, Vulnerability, or Location. Corresponds to STIX relationship_type &apos;targets&apos;.</skos:definition>
        <skos:prefLabel>targets</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stones#uses -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stones#uses">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#uses"/>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#affected -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#affected">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stones#Vulnerability"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Product"/>
        <skos:definition>Relates a vulnerability to a product known to be affected by it.</skos:definition>
        <skos:prefLabel>affected</skos:prefLabel>
        <skos:scopeNote>The range is a stonework:Product individual whose IRI is derived deterministically from the CPE identifier. The product individual may be populated by a separate CPE ingest; references from CVE data precede that ingest and are resolved when CPE data is loaded.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#exploitsWeakness -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#exploitsWeakness">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stones#Vulnerability"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Weakness"/>
        <skos:definition>Relates a vulnerability to the weakness class it exploits or instantiates.</skos:definition>
        <skos:prefLabel>exploitsWeakness</skos:prefLabel>
        <skos:scopeNote>The range is a stonework:Weakness individual whose IRI is derived from the CWE identifier. The weakness individual may be populated by a separate CWE ingest.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasMembers -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasMembers">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Group"/>
        <skos:prefLabel>hasMembers</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasTechnique -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasTechnique">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Tactic"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#AttackTechnique"/>
        <skos:definition>Relates a tactic to an offensive technique that serves that tactic&apos;s goal.</skos:definition>
        <skos:prefLabel>hasTechnique</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasWeakness -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasWeakness">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stones#Vulnerability"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Weakness"/>
        <skos:definition xml:lang="en">Relates a vulnerability to the weakness class it exploits or instantiates.</skos:definition>
        <skos:prefLabel>hasWeakness</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The range is a stonework:Weakness individual whose IRI is derived from the CWE identifier. The weakness individual may be populated by a separate CWE ingest.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#membersOf -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#membersOf">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#hasMembers"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Group"/>
        <skos:prefLabel>membersOf</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#mitigatesAttackPattern -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#mitigatesAttackPattern">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Control"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stones#AttackPattern"/>
        <skos:definition>Relates a security control to an attack pattern or technique it helps mitigate or counter.</skos:definition>
        <skos:prefLabel>mitigatesAttackPattern</skos:prefLabel>
        <skos:scopeNote>Range is stones:AttackPattern, which covers both abstract attack pattern classes (e.g. CAPEC) and operationalized techniques (e.g. ATT&amp;CK), both of which are typed attack-pattern in STIX 2.1.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#relatedAttackPattern -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#relatedAttackPattern">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stones#StixObject"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stones#AttackPattern"/>
        <skos:definition>Relates any STIX object to an attack pattern it exploits, instantiates, or operationalizes.</skos:definition>
        <skos:prefLabel>relatedAttackPattern</skos:prefLabel>
        <skos:scopeNote>Covers two cross-dataset links: (1) CWE weakness → CAPEC attack pattern (exploits/instantiates), and (2) CAPEC attack pattern → ATT&amp;CK technique (operationalizes). Both subjects are stones:StixObject individuals.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#techniqueOf -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#techniqueOf">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#hasTechnique"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Technique"/>
        <skos:prefLabel xml:lang="en">techniqueOf</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#uses -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#uses">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stones#IntrusionSet"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stones#AttackPattern"/>
        <skos:definition>Relates a threat actor group or campaign to an offensive technique they are known to employ.</skos:definition>
        <skos:prefLabel>uses</skos:prefLabel>
        <skos:scopeNote>Sub-property stones:uses carries the shortcut triples emitted by the STIX 2.1 transform for relationship_type &apos;uses&apos;.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#weaknessOf -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#weaknessOf">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#hasWeakness"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Weakness"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stones#Vulnerability"/>
        <skos:definition xml:lang="en">Relates a weakness to the vulnerability that exploits or instantiates it.</skos:definition>
        <skos:prefLabel xml:lang="en">weaknessOf</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The range is a vulnerability individual. The weakness individual (domain) is a stonework:Weakness whose IRI is derived from the CWE identifier. The weakness individual may be populated by a separate CWE ingest.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://cyberterrain.org/ns/stones#relationshipType -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stones#relationshipType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stones#Relationship"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition>The relationship_type string value from the STIX 2.1 SRO (e.g. &apos;uses&apos;, &apos;mitigates&apos;, &apos;subtechnique-of&apos;). Drawn from the STIX 2.1 open vocabulary; corresponding named individuals are declared as stones:RelationshipTypeVocabulary instances in vocabularies.ttl. A shortcut object property is also asserted: stones:&lt;type_underscored&gt; from source to target.</skos:definition>
        <skos:prefLabel>relationshipType</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://cyberterrain.org/ns/stones#AlternateDataStream -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stones#AlternateDataStream">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stones#StixSubType"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://cyberterrain.org/ns/stones#name"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://cyberterrain.org/ns/stones#"/>
        <skos:definition>An NTFS Alternate Data Stream (ADS) attached to a file, identified by name with optional hashes and size.</skos:definition>
        <skos:prefLabel xml:lang="en">Alternate Data Stream</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stones#ArtifactObject -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stones#ArtifactObject">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stones#StixObject"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://cyberterrain.org/ns/stones#stixType"/>
                        <owl:hasValue>artifact</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stones#StixCyberobservableObject"/>
        <rdfs:isDefinedBy rdf:resource="https://cyberterrain.org/ns/stones#"/>
        <skos:definition>Represents a sequence of bytes, such as the content of a file, a raw stream of network traffic, or a data blob captured from memory. The content may be embedded directly via payload_bin or referenced via url.</skos:definition>
        <skos:prefLabel xml:lang="en">Artifact Object</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stones#AttackPattern -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stones#AttackPattern">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stones#StixObject"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://cyberterrain.org/ns/stones#stixType"/>
                        <owl:hasValue>attack-pattern</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stones#StixDomainObject"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://cyberterrain.org/ns/stones#name"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://cyberterrain.org/ns/stones#"/>
        <skos:definition>A type of Tactics, Techniques, and Procedures (TTP) that describes ways that adversaries attempt to compromise targets. Often maps to MITRE ATT&amp;CK techniques.</skos:definition>
        <skos:prefLabel xml:lang="en">Attack Pattern</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stones#AutonomousSystemObject -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stones#AutonomousSystemObject">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stones#StixObject"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://cyberterrain.org/ns/stones#stixType"/>
                        <owl:hasValue>autonomous-system</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stones#StixCyberobservableObject"/>
        <rdfs:isDefinedBy rdf:resource="https://cyberterrain.org/ns/stones#"/>
        <skos:definition>Represents an Autonomous System (AS), a collection of IP routing prefixes under the control of a single administrative entity, identified by its AS number.</skos:definition>
        <skos:prefLabel xml:lang="en">Autonomous System Object</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stones#Campaign -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stones#Campaign">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stones#StixObject"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://cyberterrain.org/ns/stones#stixType"/>
                        <owl:hasValue>campaign</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stones#StixDomainObject"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://cyberterrain.org/ns/stones#name"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://cyberterrain.org/ns/stones#"/>
        <skos:definition>A grouping of adversary behaviours and resources with a common objective pursued over a period of time. Campaigns may be attributed to intrusion sets or threat actors.</skos:definition>
        <skos:prefLabel xml:lang="en">Campaign</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stones#CourseOfAction -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stones#CourseOfAction">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stones#StixObject"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://cyberterrain.org/ns/stones#stixType"/>
                        <owl:hasValue>course-of-action</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stones#StixDomainObject"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://cyberterrain.org/ns/stones#name"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://cyberterrain.org/ns/stones#"/>
        <skos:definition>A recommendation for a specific measure to be taken in response to an attack. May describe automated responses, playbook steps, or manual mitigations.</skos:definition>
        <skos:prefLabel xml:lang="en">Course of Action</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stones#DirectoryObject -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stones#DirectoryObject">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stones#StixObject"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://cyberterrain.org/ns/stones#stixType"/>
                        <owl:hasValue>directory</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stones#StixCyberobservableObject"/>
        <rdfs:isDefinedBy rdf:resource="https://cyberterrain.org/ns/stones#"/>
        <skos:definition>Represents a file system directory, conveying its path and timestamps. May reference the files and sub-directories it contains.</skos:definition>
        <skos:prefLabel xml:lang="en">Directory Object</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stones#DomainNameObject -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stones#DomainNameObject">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stones#StixObject"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://cyberterrain.org/ns/stones#stixType"/>
                        <owl:hasValue>domain-name</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stones#StixCyberobservableObject"/>
        <rdfs:isDefinedBy rdf:resource="https://cyberterrain.org/ns/stones#"/>
        <skos:definition>Represents a network domain name. Can reference the IP addresses it resolves to.</skos:definition>
        <skos:prefLabel xml:lang="en">Domain Name Object</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stones#EmailAddressObject -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stones#EmailAddressObject">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stones#StixObject"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://cyberterrain.org/ns/stones#stixType"/>
                        <owl:hasValue>email-addr</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stones#StixCyberobservableObject"/>
        <rdfs:isDefinedBy rdf:resource="https://cyberterrain.org/ns/stones#"/>
        <skos:definition>Represents a single email address, optionally associating it with a display name and a user account.</skos:definition>
        <skos:prefLabel xml:lang="en">Email Address Object</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stones#EmailMessageObject -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stones#EmailMessageObject">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stones#StixObject"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://cyberterrain.org/ns/stones#stixType"/>
                        <owl:hasValue>email-message</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stones#StixCyberobservableObject"/>
        <rdfs:isDefinedBy rdf:resource="https://cyberterrain.org/ns/stones#"/>
        <skos:definition>Represents an email message, including its headers, body, and any MIME parts.</skos:definition>
        <skos:prefLabel xml:lang="en">Email Message Object</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stones#EmailMimePart -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stones#EmailMimePart">
