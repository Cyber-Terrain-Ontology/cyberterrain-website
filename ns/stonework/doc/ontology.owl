        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:prefLabel xml:lang="en">Evidence</skos:prefLabel>
        <skos:scopeNote xml:lang="en">This is a reusable category instance. It is *not* a class. Use stonework:categorizedBy to assert that something is evidence in a given context.</skos:scopeNote>
    </owl:NamedIndividual>
    


