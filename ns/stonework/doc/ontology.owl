        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#PaymentInstrument"/>
        <skos:notation>money-order</skos:notation>
        <skos:definition xml:lang="en">A prepaid negotiable instrument issued by a bank or money services business.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#paymentInstrumentScheme"/>
        <skos:prefLabel xml:lang="en">Money Order</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#paymentInstrumentOnChainTransfer -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#paymentInstrumentOnChainTransfer">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#PaymentInstrument"/>
        <skos:notation>on-chain-transfer</skos:notation>
        <skos:definition xml:lang="en">A transfer of a crypto asset recorded on a distributed ledger.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#paymentInstrumentScheme"/>
        <skos:prefLabel xml:lang="en">On-Chain Transfer</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#paymentInstrumentScheme -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#paymentInstrumentScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <terms:title xml:lang="en">STONEWORK Payment Instrument Scheme</terms:title>
        <terms:isPartOf rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <terms:source rdf:resource="https://www.iso20022.org/"/>
        <skos:definition xml:lang="en">The controlled vocabulary of payment instruments and rails, informed by ISO 20022 payment-type semantics.</skos:definition>
        <skos:prefLabel xml:lang="en">STONEWORK Payment Instrument Scheme</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#paymentInstrumentSepaTransfer -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#paymentInstrumentSepaTransfer">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#PaymentInstrument"/>
        <skos:notation>sepa-transfer</skos:notation>
        <skos:definition xml:lang="en">A euro-denominated credit transfer within the Single Euro Payments Area.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#paymentInstrumentScheme"/>
        <skos:prefLabel xml:lang="en">SEPA Transfer</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#paymentInstrumentWireTransfer -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#paymentInstrumentWireTransfer">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#PaymentInstrument"/>
        <skos:notation>wire-transfer</skos:notation>
        <skos:definition xml:lang="en">An interbank credit transfer settled individually, such as Fedwire, CHAPS, or a cross-border SWIFT payment.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#paymentInstrumentScheme"/>
        <skos:prefLabel xml:lang="en">Wire Transfer</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#productTypeAIModel -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#productTypeAIModel">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#ProductType"/>
        <skos:notation>ai-model</skos:notation>
        <skos:definition xml:lang="en">A trained machine learning or AI model distributed as a deployable artifact, subject to threats such as model poisoning, extraction, inversion, and adversarial evasion.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#productTypeScheme"/>
        <skos:prefLabel xml:lang="en">AI Model</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#productTypeApplication -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#productTypeApplication">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#ProductType"/>
        <skos:notation>application</skos:notation>
        <skos:definition xml:lang="en">A software application designed to perform specific tasks for end users or other systems. Corresponds to CPE component type &apos;a&apos;.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#productTypeScheme"/>
        <skos:prefLabel xml:lang="en">Application</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#productTypeContainerImage -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#productTypeContainerImage">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#ProductType"/>
        <skos:notation>container-image</skos:notation>
        <skos:definition xml:lang="en">A packaged, layered filesystem image used to instantiate containers. Subject to threats including image tampering, malicious base layers, and registry poisoning.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#productTypeScheme"/>
        <skos:prefLabel xml:lang="en">Container Image</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#productTypeFirmware -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#productTypeFirmware">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#ProductType"/>
        <skos:notation>firmware</skos:notation>
        <skos:definition xml:lang="en">Software permanently programmed into a hardware device, typically stored in non-volatile memory and providing low-level control of the device. Corresponds to CPE component type &apos;o&apos; when used in embedded contexts.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#productTypeScheme"/>
        <skos:prefLabel xml:lang="en">Firmware</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#productTypeHardware -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#productTypeHardware">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#ProductType"/>
        <skos:notation>hardware</skos:notation>
        <skos:definition xml:lang="en">A physical computing device, component, or peripheral. Corresponds to CPE component type &apos;h&apos;.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#productTypeScheme"/>
        <skos:prefLabel xml:lang="en">Hardware</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#productTypeLibrary -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#productTypeLibrary">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#ProductType"/>
        <skos:notation>library</skos:notation>
        <skos:definition xml:lang="en">A reusable collection of code, routines, or resources linked into applications or other software components, often a source of transitive vulnerabilities.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#productTypeScheme"/>
        <skos:prefLabel xml:lang="en">Library</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#productTypeOperatingSystem -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#productTypeOperatingSystem">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#ProductType"/>
        <skos:notation>operating-system</skos:notation>
        <skos:definition xml:lang="en">System software that manages hardware resources and provides common services for application software. Corresponds to CPE component type &apos;o&apos;.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#productTypeScheme"/>
        <skos:prefLabel xml:lang="en">Operating System</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#productTypePackage -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#productTypePackage">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#ProductType"/>
        <skos:notation>package</skos:notation>
        <skos:definition xml:lang="en">A distributable unit of software published to a package registry (e.g. npm, PyPI, Maven, NuGet). The primary unit of supply chain attack surface — distinct from Library in that a package has its own versioning, signing, provenance chain, and registry identity.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#productTypeScheme"/>
        <skos:prefLabel xml:lang="en">Package</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#productTypeSDK -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#productTypeSDK">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#ProductType"/>
        <skos:notation>sdk</skos:notation>
        <skos:definition xml:lang="en">A software development kit providing tools, libraries, and APIs used to build applications for a specific platform or framework.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#productTypeScheme"/>
        <skos:prefLabel xml:lang="en">SDK</skos:prefLabel>
    </owl:NamedIndividual>
    


