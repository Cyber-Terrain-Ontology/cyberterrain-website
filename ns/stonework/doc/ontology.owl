<?xml version="1.0"?>
<rdf:RDF xmlns="https://cyberterrain.org/ns/stonework#"
     xml:base="https://cyberterrain.org/ns/stonework"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:stonework="https://cyberterrain.org/ns/stonework#">
    <owl:Ontology rdf:about="https://cyberterrain.org/ns/stonework#">
        <owl:versionIRI rdf:resource="https://cyberterrain.org/ns/stonework/0.10.0"/>
        <terms:creator>Hohimer Intelligence Strategies LLC</terms:creator>
        <terms:license rdf:resource="https://opensource.org/licenses/MIT"/>
        <rdfs:label xml:lang="en">STONEWORK</rdfs:label>
        <owl:versionInfo>0.10.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/isPartOf -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/isPartOf"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/source -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#prefLabel -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#scopeNote -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#scopeNote"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://cyberterrain.org/ns/stonework#accessesFile -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#accessesFile">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#RuntimeProcess"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#File"/>
        <skos:definition xml:lang="en">Relates a RuntimeProcess to Files it reads, writes, or executes.</skos:definition>
        <skos:prefLabel xml:lang="en">accessesFile</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#accessesRegistry -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#accessesRegistry">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#MalwareSample"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#RuntimeProcess"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Registry"/>
        <skos:definition xml:lang="en">Relates a RuntimeProcess or MalwareSample to Registry keys it reads or modifies.</skos:definition>
        <skos:prefLabel xml:lang="en">accessesRegistry</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#accountCurrency -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#accountCurrency">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#FinancialAccount"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Currency"/>
        <skos:definition xml:lang="en">A currency or crypto asset that this financial account holds or is denominated in.</skos:definition>
        <skos:prefLabel xml:lang="en">accountCurrency</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Intentionally multi-valued: an account, including a hosted exchange account or multi-asset wallet, may hold or support more than one currency.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#accountOf -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#accountOf">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Account"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <skos:definition xml:lang="en">The Agent that holds this Account, or to whom it is beneficially attributed. Inverse of stonework:hasAccount.</skos:definition>
        <skos:prefLabel>accountOf</skos:prefLabel>
        <skos:scopeNote xml:lang="en">For a UserAccount this is the account holder; for a FinancialAccount it is the accountholder or beneficial owner, which may differ from whoever operates it (an account-takeover attacker operating a victim&apos;s FinancialAccount is modeled with stonework:controls from the attacker-held UserAccount, leaving accountOf pointing at the victim).</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#actsOn -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#actsOn">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#CyberActivity"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#used"/>
        <skos:definition xml:lang="en">Links a CyberActivity to the CyberEntity it acted upon — the asset, artifact, or resource the activity operated against.</skos:definition>
        <skos:prefLabel>actsOn</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Mirrors prov:used (an Activity used an Entity). Typical range instances are stonework:Host, stonework:RuntimeProcess, or other stonework:DigitalArtifact/stonework:Infrastructure individuals — e.g. the specific lsass.exe stonework:RuntimeProcess a credential-dumping attempt acted on. Distinct from stonework:targets: targets is a direct, open-domain/range lift of the STIX 2.1 relationship_type &apos;targets&apos; shortcut, describing higher-level strategic targeting (a Sector, a Location, an Agent) by a Campaign/MalwareSample/ThreatActor. actsOn is purpose-built for the concrete technical asset one execution-trace Activity acted upon — the same distinction develop draws between stonework:mitigates (open, STIX-lifted) and stonework:mitigatesAttackPattern (purpose-built, controlled domain/range).</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#addressOf -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#addressOf">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#IPAddress"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Host"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#NetworkService"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates an IPAddress to the Host or NetworkService for which it serves as a network address.</skos:definition>
        <skos:prefLabel xml:lang="en">addressOf</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#addresses -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#addresses">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Playbook"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#ThreatScenario"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#AttackTechnique"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#MalwareFamily"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#ThreatActor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates a Playbook or ThreatScenario to an AttackTechnique, MalwareFamily, or ThreatActor it is designed to address.</skos:definition>
        <skos:prefLabel xml:lang="en">addresses</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#addressesAttack -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#addressesAttack">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#CourseOfAction"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#AttackPattern"/>
        <skos:definition xml:lang="en">A CourseOfAction prescribes a defensive response to this AttackPattern.</skos:definition>
        <skos:prefLabel xml:lang="en">addressesAttack</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#adjacentTo -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#adjacentTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Location"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Location"/>
        <skos:definition xml:lang="en">Relates a Location to another Location with which it shares a border or boundary, e.g. two neighboring Countries or Regions.</skos:definition>
        <skos:prefLabel xml:lang="en">adjacentTo</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Symmetric and not transitive. Use stonework:locatedWithin for containment rather than adjacency.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#affected -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#affected">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Vulnerability"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#VersionedProduct"/>
        <skos:definition>Relates a vulnerability to a product version known to be affected by it.</skos:definition>
        <skos:prefLabel>affected</skos:prefLabel>
        <skos:scopeNote>The range is a stonework:VersionedProduct individual whose IRI is derived deterministically from the CPE identifier. The product individual may be populated by a separate CPE ingest; references from CVE data precede that ingest and are resolved when CPE data is loaded.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#affectsAsset -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#affectsAsset">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Campaign"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Impact"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Incident"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Risk"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#DataAsset"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Infrastructure"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates an Incident, Campaign, Risk, or Impact to the assets it threatens or impacts.</skos:definition>
        <skos:prefLabel xml:lang="en">affectsAsset</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#affiliatedWith -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#affiliatedWith">
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <skos:definition xml:lang="en">Associates an entity with a related Agent through organizational membership, alliance, sponsorship, or informal association.</skos:definition>
        <skos:prefLabel>affiliatedWith</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#analysisOf -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#analysisOf">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Analysis"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#CyberActivity"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#CyberEntity"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates an Analysis to the CyberEntity or CyberActivity that it examines.</skos:definition>
        <skos:prefLabel xml:lang="en">analysisOf</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#appliesControl -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#appliesControl">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#CourseOfAction"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Control"/>
        <skos:definition xml:lang="en">A CourseOfAction specifies this Control as part of its recommended defensive posture. Primary arc into the Control class.</skos:definition>
        <skos:prefLabel xml:lang="en">appliesControl</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#appliesCountermeasure -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#appliesCountermeasure">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#SecurityActuation"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Countermeasure"/>
        <skos:definition xml:lang="en">Relates a SecurityActuation to the Countermeasure, rule, control, or mitigation carried out during that activity.</skos:definition>
        <skos:prefLabel xml:lang="en">appliesCountermeasure</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#appliesTo -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#appliesTo">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Control"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#DetectionRule"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#DataAsset"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Host"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Infrastructure"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#VersionedProduct"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates a Control or DetectionRule to the systems or assets it applies to.</skos:definition>
        <skos:prefLabel xml:lang="en">appliesTo</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#assertionObject -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#assertionObject">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#QualifiedAssertion"/>
        <skos:definition xml:lang="en">Identifies the resource in the object or target position of a qualified assertion.</skos:definition>
        <skos:prefLabel xml:lang="en">assertion object</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Range is intentionally unset because framework relationships may target either a CyberEntity, a CyberActivity, or another externally defined resource.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#assertionSubject -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#assertionSubject">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#QualifiedAssertion"/>
        <skos:definition xml:lang="en">Identifies the resource in the subject or source position of a qualified assertion.</skos:definition>
        <skos:prefLabel xml:lang="en">assertion subject</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Range is intentionally unset because framework relationships may originate from either a CyberEntity, a CyberActivity, or another externally defined resource.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#assessmentOf -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#assessmentOf">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Assessment"/>
        <skos:definition xml:lang="en">Relates an Assessment to the entity being assessed.</skos:definition>
        <skos:prefLabel xml:lang="en">assessmentOf</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Scheme-specific linking properties, such as stonework:cvssMetricFor, are declared rdfs:subPropertyOf this property, so a query over assessmentOf reaches every Assessment subclass regardless of scheme.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#assignedBy -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#assignedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Vulnerability"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <skos:definition xml:lang="en">Relates a vulnerability to the numbering authority that assigned its primary vulnerability identifier.</skos:definition>
        <skos:prefLabel xml:lang="en">assignedBy</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Resolve source-native names, UUIDs, or email addresses to an Agent individual. Like stonework:vulnerabilityId and stonework:dateAssigned, this property describes the vulnerability record&apos;s single primary identifier; represent independently assigned identifiers as distinct vulnerability records. The unresolved source string is preserved separately on cve:assigner regardless of whether resolution succeeds.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#assignedRole -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#assignedRole">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#RoleAssignment"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Role"/>
        <skos:definition xml:lang="en">The Role assigned by a qualified RoleAssignment.</skos:definition>
        <skos:prefLabel xml:lang="en">assignedRole</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#associatedWith -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#associatedWith">
        <skos:definition xml:lang="en">Generic association between two entities. Use a more specific property where one exists.</skos:definition>
        <skos:prefLabel>associatedWith</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#attributedTo -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#attributedTo">
        <skos:definition>Links a CyberActivity to the Agent responsible for, or associated with, performing it.</skos:definition>
        <skos:prefLabel>attributedTo</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Domain/range intentionally left unset: this property is a direct lift of the STIX 2.1 relationship_type &apos;attributed-to&apos; shortcut. STIX does not schema-constrain which SDO/SCO types may appear as source_ref/target_ref for a given relationship_type — that&apos;s producer convention, not enforceable structure, and a closed domain/range here would misrepresent real STIX 2.1 data and mislead reasoner-based consumers. In practice the object is typically a stonework:Agent — most often a stonework:ThreatActor in the adversarial case, matching STIX&apos;s own convention for &apos;attributed-to&apos; — but stonework:CyberActivity is a general occurrence class covering defensive and neutral activities too (Investigations, a ControlPlan&apos;s Process), so the performer need not be adversarial.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#attributedToAgent -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#attributedToAgent">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#DigitalIdentity"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <skos:definition>Links a digital identity to the real-world Agent it is believed to belong to.</skos:definition>
        <skos:prefLabel>attributedToAgent</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#authoredBy -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#authoredBy">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Provenance"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <skos:definition xml:lang="en">The Agent who authored or produced this provenance record, source document, or intelligence artifact.</skos:definition>
        <skos:prefLabel xml:lang="en">authoredBy</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#beneficiaryAccount -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#beneficiaryAccount">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#FinancialTransaction"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#FinancialAccount"/>
        <skos:definition xml:lang="en">The account credited by this transaction — the destination of the transferred value.</skos:definition>
        <skos:prefLabel xml:lang="en">beneficiaryAccount</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#beneficiaryMonetaryValue -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#beneficiaryMonetaryValue">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#hasMonetaryValue"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#FinancialTransaction"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#MonetaryAmount"/>
        <skos:definition xml:lang="en">The monetary amount credited to the beneficiary account as this transaction&apos;s output.</skos:definition>
        <skos:prefLabel xml:lang="en">beneficiaryMonetaryValue</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Use with stonework:originatorMonetaryValue when a transaction changes denomination, as in a currency exchange. Both properties remain queryable through their stonework:hasMonetaryValue superproperty.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#boundTo -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#boundTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Variable"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <skos:definition xml:lang="en">Binds a Variable, at execution time, to the individual it actually resolved to — e.g. the specific SecurityCondition instance a successful attempt produced.</skos:definition>
        <skos:prefLabel>boundTo</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Used when the bound value is an instance of a class rather than a scalar; see stonework:boundToLiteral for scalar bindings. Tested by stonework:guardType on a Transition.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#categorizedBy -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#categorizedBy">
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
        <skos:definition>Links any individual to one or more contextual categories.</skos:definition>
        <skos:prefLabel>categorizedBy</skos:prefLabel>
        <skos:scopeNote xml:lang="en">This is the primary mechanism for flexible, context-sensitive classification (e.g., Evidence, HighValue, Suspect, etc.). Multiple categories per individual are allowed.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#circumvents -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#circumvents">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#AITechnique"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#AttackPattern"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#AnalyticTechnique"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#DefendTechnique"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates an AITechnique or AttackPattern to an AnalyticTechnique or DefendTechnique that it bypasses or evades.</skos:definition>
        <skos:prefLabel>circumvents</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#clusteredWith -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#clusteredWith">
        <skos:definition xml:lang="en">Indicates two entities have been analytically grouped together based on shared characteristics or behaviour, without implying a stronger semantic relationship.</skos:definition>
        <skos:prefLabel>clusteredWith</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#collects -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#collects">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Investigation"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#DigitalArtifact"/>
        <skos:definition xml:lang="en">Relates an Investigation to the digital artifacts it collects as evidence.</skos:definition>
        <skos:prefLabel xml:lang="en">collects</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#communicatesWith -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#communicatesWith">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#MalwareSample"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Tool"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Infrastructure"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#URI"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates a MalwareSample or Tool to Infrastructure or a URI with which it exchanges command-and-control or exfiltration traffic. Distinct from stonework:deliveredVia, which covers initial delivery.</skos:definition>
        <skos:prefLabel>communicatesWith</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#compromisedIn -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#compromisedIn">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Incident"/>
        <skos:definition xml:lang="en">The Incident during which this Agent (user, system, or organization) was compromised.</skos:definition>
        <skos:prefLabel>compromisedIn</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#conductedBy -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#conductedBy">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Campaign"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Operation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <skos:definition xml:lang="en">Relates a Campaign or Operation to an Agent that conducts it.</skos:definition>
        <skos:prefLabel xml:lang="en">conductedBy</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#consistsOf -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#consistsOf">
        <skos:definition xml:lang="en">Generic composition relationship. Use stonework:consistsOfCampaign or a more specific property where possible.</skos:definition>
        <skos:prefLabel>consistsOf</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#consistsOfCampaign -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#consistsOfCampaign">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Operation"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Campaign"/>
        <skos:definition xml:lang="en">Relates an Operation to the Campaigns that compose it.</skos:definition>
        <skos:prefLabel xml:lang="en">consistsOfCampaign</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#containedIn -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#containedIn">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#containsFile"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#File"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Directory"/>
        <skos:definition xml:lang="en">A File resides in this Directory. Inverse of stonework:containsFile; enables upward traversal of the file system tree.</skos:definition>
        <skos:prefLabel xml:lang="en">containedIn</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#contains -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#contains">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#AutonomousSystem"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#IPBlock"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#IPAddress"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#IPBlock"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates an AutonomousSystem or IPBlock to an IPAddress or more-specific IPBlock contained within its routed address space.</skos:definition>
        <skos:prefLabel>contains</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#containsDirectory -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#containsDirectory">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Directory"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Directory"/>
        <skos:definition xml:lang="en">Relates a Directory to subdirectories it contains.</skos:definition>
        <skos:prefLabel xml:lang="en">containsDirectory</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#containsFile -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#containsFile">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Directory"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#File"/>
        <skos:definition xml:lang="en">Relates a Directory to the Files it contains.</skos:definition>
        <skos:prefLabel xml:lang="en">containsFile</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#containsLocation -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#containsLocation">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#locatedWithin"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Location"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Location"/>
        <skos:definition xml:lang="en">Relates a Location to a narrower Location that lies within it, e.g. a Country to one of its Regions or Cities.</skos:definition>
        <skos:prefLabel xml:lang="en">containsLocation</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Inverse of stonework:locatedWithin; enables downward traversal of the geographic hierarchy.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#controls -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#controls">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#UserAccount"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#FinancialAccount"/>
        <skos:definition xml:lang="en">A stonework:FinancialAccount that this stonework:UserAccount, a login or credential, can operate.</skos:definition>
        <skos:prefLabel xml:lang="en">controls</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Distinct from stonework:accountOf, which records the holder or beneficial owner. One login often controls several financial accounts; a financial account seen in isolation, such as an IBAN in wire data, may have no associated login. An account-takeover attacker holding a victim&apos;s UserAccount controls the victim&apos;s FinancialAccount without being its accountOf.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#correspondsToStep -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#correspondsToStep">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#CyberActivity"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Step"/>
        <rdfs:seeAlso rdf:resource="http://purl.org/net/p-plan#correspondsToStep"/>
        <skos:definition xml:lang="en">Links an executing CyberActivity to the Step it is the concrete performance of.</skos:definition>
        <skos:prefLabel>correspondsToStep</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Directly mirrors p-plan:correspondsToStep (domain prov:Activity, range p-plan:Step), narrowed to stonework:CyberActivity/stonework:Step. Declared functional, matching p-plan: a single CyberActivity corresponds to at most one Step, but a Step may still be the target of many CyberActivity instances across retries or repeated executions. Fills the gap noted on stonework:Step: the property linking an executing Activity back to the Step it realizes.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#counters -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#counters">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#AnalyticTechnique"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#DefendTechnique"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#AITechnique"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#AttackTechnique"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates an AnalyticTechnique or DefendTechnique to an AITechnique or AttackTechnique it detects, neutralizes, or mitigates.</skos:definition>
        <skos:prefLabel>counters</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#covers -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#covers">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Assessment"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Report"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <skos:definition xml:lang="en">Relates a Report or Assessment to the entities it describes.</skos:definition>
        <skos:prefLabel xml:lang="en">covers</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#createdBy -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#createdBy">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#IntelligenceProduct"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <skos:definition xml:lang="en">Relates an Intelligence Product to the Agent that created it.</skos:definition>
        <skos:prefLabel xml:lang="en">createdBy</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#createsMutex -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#createsMutex">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#MalwareSample"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#RuntimeProcess"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Mutex"/>
        <skos:definition xml:lang="en">Relates a RuntimeProcess or MalwareSample to a Mutex it creates.</skos:definition>
        <skos:prefLabel xml:lang="en">createsMutex</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#currency -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#currency">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#MonetaryAmount"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Currency"/>
        <skos:definition xml:lang="en">The currency that denominates a stonework:MonetaryAmount.</skos:definition>
        <skos:prefLabel xml:lang="en">currency</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#cvssMetricFor -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#cvssMetricFor">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#assessmentOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#CvssMetric"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Vulnerability"/>
        <skos:definition xml:lang="en">The vulnerability evaluated by a structured CVSS assessment.</skos:definition>
        <skos:prefLabel xml:lang="en">cvssMetricFor</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Declared rdfs:subPropertyOf stonework:assessmentOf so a query over assessmentOf returns every Assessment of a Vulnerability — CVSS metrics included — without needing to know each scheme&apos;s specific property name.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#deliveredVia -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#deliveredVia">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#MalwareSample"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Infrastructure"/>
        <skos:definition xml:lang="en">Initial delivery Infrastructure for this MalwareSample. Semantically distinct from stonework:communicatesWith, which models C2 channels post-infection.</skos:definition>
        <skos:prefLabel xml:lang="en">deliveredVia</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#dependencyOf -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#dependencyOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#VersionedProduct"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#VersionedProduct"/>
        <skos:definition xml:lang="en">Relates a product to another product that depends on it. Transitive to support supply chain reasoning across deep dependency trees.</skos:definition>
        <skos:prefLabel xml:lang="en">dependencyOf</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#derivedFrom -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#derivedFrom">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#DetectionRule"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#CyberActivity"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#DigitalArtifact"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Infrastructure"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">The observed CyberActivity, data source, or artifact from which this DetectionRule was written or derived.</skos:definition>
        <skos:prefLabel>derivedFrom</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#describesInfrastructure -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#describesInfrastructure">
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Infrastructure"/>
        <skos:definition>Links a Software Bill of Materials to the enterprise infrastructure, system, or application whose component composition it inventories.</skos:definition>
        <skos:prefLabel>describes infrastructure</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Domain intentionally left unset. The primary subject is stonework:SoftwareBillOfMaterials, but other provenance-bearing artifacts may describe infrastructure without being SBOMs. Multiple SBOMs may describe the same Infrastructure over time, enabling historical component inventory.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#detectedBy -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#detectedBy">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Event"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#DetectionRule"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Sensor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates an Event to the Sensor or DetectionRule that identified it.</skos:definition>
        <skos:prefLabel xml:lang="en">detectedBy</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#detects -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#detects">
        <skos:definition xml:lang="en">Relates a source DetectionRule, Sensor, Indicator, or defensive technique to the threat, activity, or artifact it is capable of detecting. Corresponds to STIX relationship_type &apos;detects&apos;.</skos:definition>
        <skos:prefLabel>detects</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Domain/range intentionally left unset: this property is a direct lift of the STIX 2.1 relationship_type &apos;detects&apos; shortcut. STIX does not schema-constrain which SDO/SCO types may appear as source_ref/target_ref for a given relationship_type — that&apos;s producer convention, not enforceable structure, and a closed domain/range here would misrepresent real STIX 2.1 data and mislead reasoner-based consumers.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#downloads -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#downloads">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#File"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#MalwareSample"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Tool"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#File"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#MalwareSample"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Tool"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates a File, MalwareSample, or Tool to another File, MalwareSample, or Tool it retrieves during execution.</skos:definition>
        <skos:prefLabel>downloads</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#drops -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#drops">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#MalwareSample"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#DigitalArtifact"/>
        <skos:definition xml:lang="en">A DigitalArtifact written to the filesystem or memory by this MalwareSample during execution.</skos:definition>
        <skos:prefLabel>drops</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#emailOf -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#emailOf">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#hasEmail"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#EmailAddress"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <skos:definition xml:lang="en">The Agent that owns or is associated with this EmailAddress. Inverse of stonework:hasEmail.</skos:definition>
        <skos:prefLabel>emailOf</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#employs -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#employs">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#uses"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#ThreatActor"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#AttackPattern"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Malware"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Technique"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Tool"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates a ThreatActor to an AttackPattern, Malware, Technique, or Tool it deliberately puts into operational use.</skos:definition>
        <skos:prefLabel xml:lang="en">employs</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Use for curated ThreatActor relationships where deliberate operational use is intended. As a subproperty of the open STIX-compatible stonework:uses relationship, employs assertions remain available to queries over the broader interoperability predicate.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#evidencedBy -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#evidencedBy">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Sighting"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#DigitalArtifact"/>
        <skos:definition xml:lang="en">A Sighting is substantiated by this DigitalArtifact (memory dump, PCAP, log excerpt, sample). Connects analytical observation to forensic evidence.</skos:definition>
        <skos:prefLabel xml:lang="en">evidencedBy</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#executedOn -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#executedOn">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#runs"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#RuntimeProcess"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Host"/>
        <skos:definition xml:lang="en">Relates a RuntimeProcess to the Host it ran on.</skos:definition>
        <skos:prefLabel xml:lang="en">executedOn</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#executionOf -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#executionOf">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#hasExecution"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#CyberActivity"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Behavior"/>
        <skos:definition xml:lang="en">Relates a CyberActivity to the Behavior plan whose execution it represents.</skos:definition>
        <skos:prefLabel xml:lang="en">executionOf</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Links an overall execution to the Behavior it carries out. This may be a full plan — an Investigation to an InvestigationPlan, an Operation to an OperationPlan, a Process to a Playbook or ControlPlan — or, in the lightweight case, a bare method: a CyberActivity may point directly at the stonework:Technique (or stonework:AttackTechnique) it performs, with no intervening Procedure, Plan, or Step. The lightweight form is the common one for sightings and incident timelines (&apos;actor performed T1003.001 against this host at this time&apos;); it can be elaborated into a Step-decomposed Plan later without changing the executionOf assertion. Use stonework:correspondsToStep for the finer-grained link between an executing CyberActivity and an individual Step when a Plan is present.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#exploits -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#exploits">
        <skos:definition>Shortcut triple: source Malware or ThreatActor exploits target Vulnerability. Corresponds to STIX relationship_type &apos;exploits&apos;.</skos:definition>
        <skos:prefLabel>exploits</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Domain/range intentionally left unset: this property is a direct lift of the STIX 2.1 relationship_type &apos;exploits&apos; shortcut. STIX does not schema-constrain which SDO/SCO types may appear as source_ref/target_ref for a given relationship_type — that&apos;s producer convention, not enforceable structure, and a closed domain/range here would misrepresent real STIX 2.1 data and mislead reasoner-based consumers.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#exploitsWeakness -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#exploitsWeakness">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#hasWeakness"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Vulnerability"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Weakness"/>
        <skos:definition xml:lang="en">Relates a vulnerability to the weakness class it instantiates or exploits. Subproperty of stonework:hasWeakness, using the directional &apos;exploits&apos; semantics aligned with CVE and CWE mapping conventions.</skos:definition>
        <skos:prefLabel xml:lang="en">exploitsWeakness</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The range is a stonework:Weakness individual whose IRI is derived from the CWE identifier. Used by cve:exploitsWeakness (rdfs:subPropertyOf this property) when CVE data is loaded; query this property directly for cross-source lookups.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#exposesService -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#exposesService">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Host"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#NetworkService"/>
        <skos:definition xml:lang="en">Relates a Host to the NetworkServices it provides.</skos:definition>
        <skos:prefLabel xml:lang="en">exposesService</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#fixedInProduct -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#fixedInProduct">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Vulnerability"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#VersionedProduct"/>
        <skos:definition xml:lang="en">Relates a vulnerability to the product version in which it was addressed.</skos:definition>
        <skos:prefLabel xml:lang="en">fixedInProduct</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The range is a stonework:VersionedProduct individual whose IRI is derived deterministically from the CPE identifier. Populated by CVE/patch ingest.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#fromStep -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#fromStep">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Transition"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Step"/>
        <skos:definition xml:lang="en">The Step a Transition leaves.</skos:definition>
        <skos:prefLabel>fromStep</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#fundsActivity -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#fundsActivity">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#FinancialTransaction"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#CyberActivity"/>
        <skos:definition xml:lang="en">A cyber activity that this transaction finances — for example an infrastructure purchase linked to the campaign or operation it supports.</skos:definition>
        <skos:prefLabel xml:lang="en">fundsActivity</skos:prefLabel>
        <skos:scopeNote xml:lang="en">This property asserts a financing relationship. For a payment made in response to an activity without financing it, such as a victim&apos;s ransom payment made because of an incident, use stonework:respondsToActivity.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#generatedBy -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#generatedBy">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Log"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#NetworkTraffic"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Host"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#NetworkService"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Sensor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates a Log or NetworkTraffic to the system that produced it.</skos:definition>
        <skos:prefLabel xml:lang="en">generatedBy</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#generatedFrom -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#generatedFrom">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Event"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Log"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#NetworkTraffic"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Links an Event to the raw log or network traffic from which it was derived.</skos:definition>
        <skos:prefLabel xml:lang="en">generatedFrom</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#grantedTo -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#grantedTo">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#AccessControlList"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#UserAccount"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#UserGroup"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates an AccessControlList to a UserAccount or UserGroup whose permissions it records.</skos:definition>
        <skos:prefLabel xml:lang="en">grantedTo</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#guardOperator -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#guardOperator">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Transition"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#ComparisonOperator"/>
        <skos:definition xml:lang="en">The comparison operator applied between guardVariable&apos;s bound literal value and guardLiteralValue.</skos:definition>
        <skos:prefLabel>guardOperator</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Omitted = Equals, preserving equality-only guard semantics without requiring this property on every Transition.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#guardType -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#guardType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Transition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
        <skos:definition xml:lang="en">A Transition fires only if guardVariable&apos;s stonework:boundTo value is an instance of this class.</skos:definition>
        <skos:prefLabel>guardType</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Used for guards that test whether a Variable was bound to an instance of a particular class (e.g. testing that an attempt&apos;s outcome Variable was bound to a stonework:SecurityCondition instance) rather than testing equality against a scalar.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#guardVariable -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#guardVariable">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Transition"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Variable"/>
        <skos:definition xml:lang="en">The Variable whose bound value is tested to decide whether a Transition is taken.</skos:definition>
        <skos:prefLabel>guardVariable</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasAccount -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasAccount">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#accountOf"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Account"/>
        <skos:definition xml:lang="en">An Account (user account or financial account) held by, or beneficially attributed to, this Agent.</skos:definition>
        <skos:prefLabel xml:lang="en">hasAccount</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasAccountType -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasAccountType">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#categorizedBy"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#UserAccount"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#AccountType"/>
        <skos:definition xml:lang="en">Relates a user account to one or more classifications describing its authentication or deployment context.</skos:definition>
        <skos:prefLabel xml:lang="en">hasAccountType</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasArtifact -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasArtifact">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#MalwareSample"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#DigitalArtifact"/>
        <skos:definition xml:lang="en">Links a MalwareSample to a captured binary artifact (file, memory dump, or encoded payload) constituting the physical evidence of the sample.</skos:definition>
        <skos:prefLabel xml:lang="en">hasArtifact</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Optional — a MalwareSample may be known via hashes or threat reports without the binary being available. When present, the artifact provides retrievable binary evidence. Corresponds to the STIX 2.1 sample_refs property on the malware SDO.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasBehavior -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasBehavior">
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Behavior"/>
        <skos:definition xml:lang="en">Associates a MalwareSample, AttackPattern, ThreatActor, or Campaign with an observed Behavior. Enables behavioral clustering and similarity reasoning.</skos:definition>
        <skos:prefLabel xml:lang="en">hasBehavior</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasBomEntry -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasBomEntry">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#SoftwareBillOfMaterials"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#BomEntry"/>
        <skos:definition xml:lang="en">Relates a Software Bill of Materials to one of its component entries.</skos:definition>
        <skos:prefLabel>has BOM entry</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Each BomEntry carries the component&apos;s VersionedProduct reference (via stonework:installationOf) and any component-specific metadata (PURL, license, hash, component type). Range is BomEntry rather than VersionedProduct directly because the same VersionedProduct may appear in multiple SBOMs with different component-level attributes.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasCvssMetric -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasCvssMetric">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#cvssMetricFor"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Vulnerability"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#CvssMetric"/>
        <skos:definition xml:lang="en">Relates a vulnerability to a structured CVSS metric record carrying the version, vector string, and base/temporal/environmental scores.</skos:definition>
        <skos:prefLabel xml:lang="en">hasCvssMetric</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A single vulnerability may carry metrics for multiple CVSS versions (2.0, 3.1, 4.0) or scoring authorities. For a single headline score and severity, use stonework:cvssBaseScore and stonework:cvssSeverity directly on the Vulnerability. Core consumers can represent the common structured fields without an adapter; load the CVSS framework module for decomposed vector components and additional subscores.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasDependency -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasDependency">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#dependencyOf"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#VersionedProduct"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#VersionedProduct"/>
        <skos:definition xml:lang="en">Relates a product version to another product version it depends on.</skos:definition>
        <skos:prefLabel xml:lang="en">hasDependency</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasDestinationAddress -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasDestinationAddress">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#NetworkTraffic"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#IPAddress"/>
        <skos:definition xml:lang="en">Relates NetworkTraffic to the destination IP address.</skos:definition>
        <skos:prefLabel xml:lang="en">hasDestinationAddress</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasEmail -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasEmail">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#EmailAddress"/>
        <skos:definition xml:lang="en">An EmailAddress associated with this Agent.</skos:definition>
        <skos:prefLabel>hasEmail</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasEvent -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasEvent">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Incident"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Event"/>
        <skos:definition xml:lang="en">Relates an Incident to an Event that forms part of its recorded activity.</skos:definition>
        <skos:prefLabel xml:lang="en">hasEvent</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasExecution -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasExecution">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Behavior"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#CyberActivity"/>
        <skos:definition xml:lang="en">Relates a Behavior plan to a CyberActivity that executes it.</skos:definition>
        <skos:prefLabel xml:lang="en">hasExecution</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasFalsePositiveRate -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasFalsePositiveRate">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#categorizedBy"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#DetectionRule"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#FalsePositiveRate"/>
        <skos:definition xml:lang="en">Relates a detection rule to an ordinal assessment of its expected false-positive frequency.</skos:definition>
        <skos:prefLabel xml:lang="en">hasFalsePositiveRate</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasHash -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasHash">
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Hash"/>
        <skos:definition>Relates an entity to its hash entries. The range is a stonework:Hash individual representing a single hash algorithm and digest value.</skos:definition>
        <skos:prefLabel>hasHash</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasHypothesisStatus -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasHypothesisStatus">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#categorizedBy"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Hypothesis"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#HypothesisStatus"/>
        <skos:definition xml:lang="en">Relates a Hypothesis to its current status in the confirm/refute lifecycle.</skos:definition>
        <skos:prefLabel xml:lang="en">hasHypothesisStatus</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Kept explicit (rather than inferred from which Transition fired) so a Hypothesis&apos;s status is directly queryable without replaying the Step graph it was tested in.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasIPBlock -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasIPBlock">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#AutonomousSystem"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#IPBlock"/>
        <skos:definition xml:lang="en">Relates an AutonomousSystem to an IPBlock it originates or announces.</skos:definition>
        <skos:prefLabel xml:lang="en">hasIPBlock</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasIdentifier -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasIdentifier">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#DigitalIdentity"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Identifier"/>
        <skos:definition>Links a Digital Identity to one or more atomic Identifiers that belong to it.</skos:definition>
        <skos:prefLabel>hasIdentifier</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasImpact -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasImpact">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Risk"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Impact"/>
        <skos:definition xml:lang="en">Relates a Risk to its associated Impact component.</skos:definition>
        <skos:prefLabel xml:lang="en">hasImpact</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasImpactLevel -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasImpactLevel">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#categorizedBy"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Impact"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#ImpactLevel"/>
        <skos:definition xml:lang="en">Relates an impact assessment to its qualitative magnitude.</skos:definition>
        <skos:prefLabel xml:lang="en">hasImpactLevel</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasImpactType -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasImpactType">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#categorizedBy"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Impact"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#ImpactType"/>
        <skos:definition xml:lang="en">Relates an impact assessment to one or more affected security dimensions or consequence types.</skos:definition>
        <skos:prefLabel xml:lang="en">hasImpactType</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasIncidentStatus -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasIncidentStatus">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#categorizedBy"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Incident"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#IncidentStatus"/>
        <skos:definition xml:lang="en">Relates an incident to its current response-lifecycle status.</skos:definition>
        <skos:prefLabel xml:lang="en">hasIncidentStatus</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasInfrastructureType -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasInfrastructureType">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#categorizedBy"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Infrastructure"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#InfrastructureType"/>
        <skos:definition xml:lang="en">Relates an infrastructure individual to one or more classifications describing its operational role or purpose.</skos:definition>
        <skos:prefLabel xml:lang="en">hasInfrastructureType</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A piece of infrastructure may serve multiple roles (e.g. both C2 and staging). Aligns with the STIX 2.1 infrastructure-type open vocabulary.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasInput -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasInput">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Process"/>
        <skos:definition xml:lang="en">Relates a Process to its input data or artifacts.</skos:definition>
        <skos:prefLabel xml:lang="en">hasInput</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasInputVariable -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasInputVariable">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Behavior"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Variable"/>
        <skos:definition xml:lang="en">Declares a Variable whose value must be bound before the Behavior or Step executes.</skos:definition>
        <skos:prefLabel>hasInputVariable</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasInstalledProduct -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasInstalledProduct">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Infrastructure"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#VersionedProduct"/>
        <skos:definition>Links an enterprise infrastructure to a versioned product known to be installed in that environment.</skos:definition>
        <skos:prefLabel>has installed product</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Used in the user-data graph to assert enterprise inventory directly. Combined with stonework:versionOf and stonework:affected, enables traversal from installed software to applicable CVEs. For SBOM-based ingest with full component provenance, see stonework:SoftwareBillOfMaterials and stonework:hasBomEntry.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasLikelihood -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasLikelihood">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Risk"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Likelihood"/>
        <skos:definition xml:lang="en">Relates a Risk to its associated Likelihood component.</skos:definition>
        <skos:prefLabel xml:lang="en">hasLikelihood</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasLikelihoodLevel -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasLikelihoodLevel">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#categorizedBy"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Likelihood"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#LikelihoodLevel"/>
        <skos:definition xml:lang="en">Relates a likelihood assessment to its qualitative ordinal level.</skos:definition>
        <skos:prefLabel xml:lang="en">hasLikelihoodLevel</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasMalwareType -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasMalwareType">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#categorizedBy"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#MalwareFamily"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#MalwareSample"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#MalwareType"/>
        <skos:definition xml:lang="en">Relates a malware sample or family to one or more functional type classifications.</skos:definition>
        <skos:prefLabel xml:lang="en">hasMalwareType</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A malware sample may have multiple types (e.g. a trojan that also acts as a downloader). Aligns with the STIX 2.1 malware-type open vocabulary.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasMember -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasMember">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#memberOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Group"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Organization"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#ThreatActor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <skos:definition xml:lang="en">Relates a Group, Organization, or ThreatActor to one of its members. Multiple members are represented by multiple triples.</skos:definition>
        <skos:prefLabel xml:lang="en">hasMember</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasMemberActivity -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasMemberActivity">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#memberOfActivityCluster"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#CyberActivityCluster"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#CyberActivity"/>
        <skos:definition xml:lang="en">Relates a CyberActivityCluster to a CyberActivity analytically grouped within it.</skos:definition>
        <skos:prefLabel xml:lang="en">hasMemberActivity</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasMetricObservation -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasMetricObservation">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#metricFor"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#MetricObservation"/>
        <skos:definition xml:lang="en">Relates an entity to a source- and time-qualified metric observation about it.</skos:definition>
        <skos:prefLabel xml:lang="en">hasMetricObservation</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasMonetaryValue -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasMonetaryValue">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#FinancialAccount"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#FinancialTransaction"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Impact"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#MonetaryAmount"/>
        <skos:definition xml:lang="en">Relates a transaction, account, or impact to a stonework:MonetaryAmount stating a sum of money and its currency.</skos:definition>
        <skos:prefLabel xml:lang="en">hasMonetaryValue</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasMotivation -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasMotivation">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#categorizedBy"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#ThreatActor"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Motivation"/>
        <skos:definition xml:lang="en">Relates a threat actor to one or more motivations that drive their actions and operations.</skos:definition>
        <skos:prefLabel xml:lang="en">hasMotivation</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A threat actor may have multiple motivations. Corresponds to the STIX 2.1 primary_motivation and secondary_motivations properties on ThreatActor.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasNetworkAddress -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasNetworkAddress">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#addressOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Host"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#NetworkService"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#IPAddress"/>
        <skos:definition xml:lang="en">Relates a Host or NetworkService to an IPAddress assigned to or used by it.</skos:definition>
        <skos:prefLabel xml:lang="en">hasNetworkAddress</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasObservable -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasObservable">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#SecurityObservation"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/vocab-ssn/#SOSAhasResult"/>
        <skos:definition xml:lang="en">Links a SecurityObservation to the cyber observable objects (SCOs) captured during the observation window.</skos:definition>
        <skos:prefLabel xml:lang="en">hasObservable</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The range covers any SCO type: stonework:IPAddress, stonework:Domain, stonework:File, stonework:NetworkTraffic, stonework:RuntimeProcess, stonework:UserAccount, etc. Corresponds to STIX observed-data object_refs. Inspired by SOSA sosa:hasResult.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasOnlineReference -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasOnlineReference">
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#OnlineReference"/>
        <skos:definition xml:lang="en">Associates any object with an OnlineReference (blog post, advisory URL, disclosure, vendor bulletin). Primary arc into the OnlineReference class.</skos:definition>
        <skos:prefLabel xml:lang="en">hasOnlineReference</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasOutput -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasOutput">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Process"/>
        <skos:definition xml:lang="en">Relates a Process to the data or artifacts it produces.</skos:definition>
        <skos:prefLabel xml:lang="en">hasOutput</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasOutputVariable -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasOutputVariable">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Behavior"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Variable"/>
        <skos:definition xml:lang="en">Declares a Variable whose value is bound only once the Behavior or Step has executed.</skos:definition>
        <skos:prefLabel>hasOutputVariable</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasParentProcess -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasParentProcess">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#RuntimeProcess"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#RuntimeProcess"/>
        <skos:definition xml:lang="en">Relates a RuntimeProcess to the parent process that spawned it.</skos:definition>
        <skos:prefLabel xml:lang="en">hasParentProcess</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasPhoneNumber -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasPhoneNumber">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#phoneNumberOf"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#PhoneNumber"/>
        <skos:definition xml:lang="en">A PhoneNumber associated with this Agent.</skos:definition>
        <skos:prefLabel xml:lang="en">hasPhoneNumber</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasProductInstallation -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasProductInstallation">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Infrastructure"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#ProductInstallation"/>
        <skos:definition xml:lang="en">Relates an Infrastructure entity to a contextual record of a product installed on it.</skos:definition>
        <skos:prefLabel xml:lang="en">hasProductInstallation</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Use stonework:hasInstalledProduct for a direct Infrastructure-to-VersionedProduct inventory assertion. Use this property with stonework:installationOf when installation-specific identity, path, licensee, or configuration details must be preserved.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasProductType -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasProductType">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#categorizedBy"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Product"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#ProductType"/>
        <skos:definition xml:lang="en">Relates a product family to one or more product type classifications describing its functional category.</skos:definition>
        <skos:prefLabel xml:lang="en">hasProductType</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A product may have multiple types. Corresponds to the CPE component type field (a, o, h) but extends it with finer-grained vocabulary.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasProvenance -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasProvenance">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#provenanceOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#IntelligenceProduct"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#QualifiedAssertion"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Provenance"/>
        <skos:definition xml:lang="en">Relates an IntelligenceProduct or QualifiedAssertion to a Provenance record documenting its origin or evidentiary basis.</skos:definition>
        <skos:prefLabel xml:lang="en">hasProvenance</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasResourceLevel -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasResourceLevel">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#categorizedBy"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#ThreatActor"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#ResourceLevel"/>
        <skos:definition xml:lang="en">Relates a threat actor to an assessment of the organizational resources available to it.</skos:definition>
        <skos:prefLabel xml:lang="en">hasResourceLevel</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasRisk -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasRisk">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#DataAsset"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Infrastructure"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Organization"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Risk"/>
        <skos:definition xml:lang="en">Relates an asset or organization to an assessed Risk.</skos:definition>
        <skos:prefLabel xml:lang="en">hasRisk</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasRiskLevel -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasRiskLevel">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#categorizedBy"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Risk"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#RiskLevel"/>
        <skos:definition xml:lang="en">Relates a risk assessment to its qualitative ordinal level.</skos:definition>
        <skos:prefLabel xml:lang="en">hasRiskLevel</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasRoleAssignment -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasRoleAssignment">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#RoleAssignment"/>
        <skos:definition xml:lang="en">Relates an entity to a qualified assignment of a Role in a specific context.</skos:definition>
        <skos:prefLabel xml:lang="en">hasRoleAssignment</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasSignature -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasSignature">
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Signature"/>
        <skos:definition xml:lang="en">Associates a Campaign, ThreatActor, MalwareSample, or Infrastructure with a detection Signature. Primary arc into the Signature class.</skos:definition>
        <skos:prefLabel xml:lang="en">hasSignature</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasSophisticationLevel -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasSophisticationLevel">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#categorizedBy"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#ThreatActor"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#SophisticationLevel"/>
        <skos:definition xml:lang="en">Relates a threat actor to an assessment of its technical sophistication.</skos:definition>
        <skos:prefLabel xml:lang="en">hasSophisticationLevel</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasSourceAddress -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasSourceAddress">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#NetworkTraffic"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#IPAddress"/>
        <skos:definition xml:lang="en">Relates NetworkTraffic to the source IP address.</skos:definition>
        <skos:prefLabel xml:lang="en">hasSourceAddress</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasStep -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasStep">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Behavior"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Step"/>
        <skos:definition xml:lang="en">Relates a Behavior (Procedure, Playbook, ThreatScenario, Control, or another Step) to a Step that decomposes it.</skos:definition>
        <skos:prefLabel>hasStep</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Domain is the general Behavior root rather than a specific subclass, so decomposition applies uniformly across Procedure, Playbook, ThreatScenario, and — recursively, since Step is itself a Behavior — Step.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasTechnique -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasTechnique">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#techniqueOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Tactic"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Technique"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Technique"/>
        <skos:definition xml:lang="en">Relates a Tactic to a Technique that serves its goal, or a Technique to a more specific Technique it contains.</skos:definition>
        <skos:prefLabel>hasTechnique</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasThreatActorType -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasThreatActorType">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#categorizedBy"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#ThreatActor"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#ThreatActorType"/>
        <skos:definition xml:lang="en">Relates a threat actor to one or more classifications describing their organizational form or primary mode of operation.</skos:definition>
        <skos:prefLabel xml:lang="en">hasThreatActorType</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A threat actor may have multiple types (e.g. nation-state actor who is also a spy). Aligns with the STIX 2.1 threat-actor-type open vocabulary.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasVendor -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasVendor">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#vendorOf"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Product"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <skos:definition xml:lang="en">Relates a product family to the Agent (organization or person) that develops or maintains it.</skos:definition>
        <skos:prefLabel xml:lang="en">hasVendor</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasVersion -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasVersion">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Product"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#VersionedProduct"/>
        <skos:definition xml:lang="en">Relates a product family to a specific versioned product instance.</skos:definition>
        <skos:prefLabel xml:lang="en">hasVersion</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hasWeakness -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hasWeakness">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Vulnerability"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Weakness"/>
        <skos:definition xml:lang="en">Relates a vulnerability to the weakness class it exploits or instantiates.</skos:definition>
        <skos:prefLabel>hasWeakness</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The range is a stonework:Weakness individual whose IRI is derived from the CWE identifier. The weakness individual may be populated by a separate CWE ingest.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hashOf -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hashOf">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#hasHash"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Hash"/>
        <skos:definition>Relates a hash entry to the entity it describes. The domain is a stonework:Hash individual representing a single hash algorithm and digest value.</skos:definition>
        <skos:prefLabel>hashOf</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#headquarteredIn -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#headquarteredIn">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Organization"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Location"/>
        <skos:definition xml:lang="en">Relates an Organization to its primary headquarters Location.</skos:definition>
        <skos:prefLabel xml:lang="en">headquarteredIn</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#heldAt -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#heldAt">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#FinancialAccount"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#FinancialInstitution"/>
        <skos:definition xml:lang="en">The financial institution that maintains this account.</skos:definition>
        <skos:prefLabel xml:lang="en">heldAt</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Optional. Absent for a self-custody crypto wallet or an account whose institution is unknown; present and pointing at a virtual asset service provider for a custodial wallet.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hostedBy -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hostedBy">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Infrastructure"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <skos:definition xml:lang="en">The Agent (hosting provider, organization, or individual) that operates or administers this Infrastructure.</skos:definition>
        <skos:prefLabel>hostedBy</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hostedOn -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#hostedOn">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Infrastructure"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Host"/>
        <skos:definition xml:lang="en">The logical Infrastructure entity runs on this physical or virtual Host. Bridges the abstract infrastructure layer to the concrete system for configuration and vulnerability queries.</skos:definition>
        <skos:prefLabel xml:lang="en">hostedOn</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#implants -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#implants">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#MalwareSample"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#MalwareSample"/>
        <skos:definition xml:lang="en">A dropper or loader MalwareSample installs another MalwareSample payload. Models multi-stage delivery chains for reasoners tracking infection sequences.</skos:definition>
        <skos:prefLabel xml:lang="en">implants</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#implementedBy -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#implementedBy">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#implements"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Behavior"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Behavior"/>
        <skos:definition xml:lang="en">Relates an abstract Behavior to a concrete, Step-decomposed Behavior that realizes it.</skos:definition>
        <skos:prefLabel>implementedBy</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#implements -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#implements">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Behavior"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Behavior"/>
        <skos:definition xml:lang="en">Relates a concrete, Step-decomposed Behavior to the more abstract Behavior it is a specific realization of.</skos:definition>
        <skos:prefLabel>implements</skos:prefLabel>
        <skos:scopeNote xml:lang="en">General-purpose relationship covering both offense (a Procedure implements a Technique) and defense (a ControlPlan implements a Control) with one property rather than a bespoke one per pairing.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#implementsCountermeasure -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#implementsCountermeasure">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#SecurityActuator"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Countermeasure"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#madeActuation"/>
            <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#appliesCountermeasure"/>
        </owl:propertyChainAxiom>
        <skos:definition xml:lang="en">Relates a SecurityActuator to a Countermeasure it is configured or capable of applying.</skos:definition>
        <skos:prefLabel xml:lang="en">implementsCountermeasure</skos:prefLabel>
        <skos:scopeNote xml:lang="en">May be asserted directly for configured capabilities. It is also inferred when the actuator made a SecurityActuation that applies the Countermeasure.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#implementsTechnique -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#implementsTechnique">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#uses"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Malware"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Product"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#VersionedProduct"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Technique"/>
        <skos:definition xml:lang="en">Relates malware or a product to a Technique embodied by its behavior or capabilities.</skos:definition>
        <skos:prefLabel>implementsTechnique</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Specializes the open STIX-compatible stonework:uses relationship for malware- or product-to-technique assertions. Product covers abstract product families, including Tool; VersionedProduct covers specific releases or builds. stonework:implements remains the distinct Behavior-to-Behavior realization relationship.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#inBlock -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#inBlock">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#IPAddress"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#IPBlock"/>
        <skos:definition xml:lang="en">Relates an IPAddress to the IPBlock whose address space contains it.</skos:definition>
        <skos:prefLabel xml:lang="en">inBlock</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#indicates -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#indicates">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Indicator"/>
        <skos:definition>Asserts that when the source Indicator&apos;s pattern is matched, it signals the presence of the target adversary behavior, malware, campaign, or threat actor.</skos:definition>
        <skos:prefLabel xml:lang="en">indicates</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Corresponds to STIX relationship_type &apos;indicates&apos;. Domain is stonework:Indicator — unlike the source side of other STIX relationship shortcuts, this is definitional rather than open-world convention: an object is only ever an Indicator because it indicates something, per STIX&apos;s own spec role for that object type. Range is intentionally left unset: an Indicator may indicate all sorts of things (AttackPattern/AttackTechnique, Malware, Campaign, CyberActivityCluster, ThreatActor, Infrastructure, Tool, and whatever else a producer&apos;s pattern targets), and STIX does not schema-constrain the target_ref type for a given relationship_type. A single Indicator may indicate multiple targets.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#initiatedBy -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#initiatedBy">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#NetworkTraffic"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#RuntimeProcess"/>
        <skos:definition xml:lang="en">The RuntimeProcess that opened this NetworkTraffic flow. Core process-to-network correlation arc for host-based forensics and lateral movement analysis.</skos:definition>
        <skos:prefLabel xml:lang="en">initiatedBy</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#installationOf -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#installationOf">
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#VersionedProduct"/>
        <skos:definition xml:lang="en">Relates a component context to the versioned product it references or instantiates.</skos:definition>
        <skos:prefLabel>installation of</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Used by stonework:BomEntry (declarative — a component listed in an SBOM), stonework:ProductInstallation (observational — a verified deployment on a specific system), and other stonework:ComponentContext subclasses. Domain is intentionally left unset to avoid restricting future component-context subclasses. Not declared owl:FunctionalProperty at the property level, because not every ComponentContext subclass is one-to-one with a product — a source-native advisory entry may legitimately name several. BomEntry and ProductInstallation instead carry a local owl:maxQualifiedCardinality 1 restriction on this property (onClass stonework:VersionedProduct), which gives those two classes the same at-most-one guarantee without constraining subclasses that don&apos;t share it.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#installedOn -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#installedOn">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#hasProductInstallation"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#ProductInstallation"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Infrastructure"/>
        <skos:definition xml:lang="en">Relates a ProductInstallation to the Infrastructure entity on which that product instance is installed.</skos:definition>
        <skos:prefLabel xml:lang="en">installedOn</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#intermediaryAccount -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#intermediaryAccount">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#FinancialTransaction"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#FinancialAccount"/>
        <skos:definition xml:lang="en">A correspondent or intermediary account through which this transaction is routed between originator and beneficiary.</skos:definition>
        <skos:prefLabel xml:lang="en">intermediaryAccount</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Multi-valued and unordered in this revision; a strict correspondent-banking chain order is deferred.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#investigatedBy -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#investigatedBy">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Campaign"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Incident"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#MalwareSample"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#ThreatActor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Investigation"/>
        <skos:definition xml:lang="en">Relates an Incident, Campaign, MalwareSample, or ThreatActor to an Investigation examining it.</skos:definition>
        <skos:prefLabel xml:lang="en">investigatedBy</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#investigates -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#investigates">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#investigatedBy"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Investigation"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Campaign"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Incident"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#MalwareSample"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#ThreatActor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates an Investigation to the subject being investigated.</skos:definition>
        <skos:prefLabel xml:lang="en">investigates</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#involvesCampaign -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#involvesCampaign">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Incident"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Campaign"/>
        <skos:definition xml:lang="en">Links an Incident to a Campaign it is part of or attributed to.</skos:definition>
        <skos:prefLabel xml:lang="en">involvesCampaign</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#isSampleOf -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#isSampleOf">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#hasArtifact"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#DigitalArtifact"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#MalwareSample"/>
        <skos:definition xml:lang="en">Relates a DigitalArtifact representation, such as a File, to the MalwareSample it embodies or records.</skos:definition>
        <skos:prefLabel xml:lang="en">isSampleOf</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#isStepOf -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#isStepOf">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#hasStep"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Step"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Behavior"/>
        <skos:definition xml:lang="en">Relates a Step to the Behavior it decomposes.</skos:definition>
        <skos:prefLabel>isStepOf</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#isVulnerableTo -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#isVulnerableTo">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Host"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#NetworkService"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#VersionedProduct"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Vulnerability"/>
        <skos:definition xml:lang="en">Relates infrastructure or a product version to known Vulnerabilities it contains.</skos:definition>
        <skos:prefLabel xml:lang="en">isVulnerableTo</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#issuedBy -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#issuedBy">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Certificate"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <skos:definition xml:lang="en">Relates a Certificate to the Certificate Authority that issued it.</skos:definition>
        <skos:prefLabel xml:lang="en">issuedBy</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#issuedTo -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#issuedTo">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Certificate"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Agent"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Domain"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates a Certificate to the entity (Agent or Domain) it was issued to.</skos:definition>
        <skos:prefLabel xml:lang="en">issuedTo</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#launchedBy -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#launchedBy">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#RuntimeProcess"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#UserAccount"/>
        <skos:definition xml:lang="en">Relates a RuntimeProcess to the UserAccount under whose context it was launched.</skos:definition>
        <skos:prefLabel xml:lang="en">launchedBy</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#linkedTo -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#linkedTo">
        <skos:definition xml:lang="en">Generic link between two entities. Use a more specific property where one exists.</skos:definition>
        <skos:prefLabel>linkedTo</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#locatedAt -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#locatedAt">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Host"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Infrastructure"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Organization"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#PhysicalArtifact"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Location"/>
        <skos:definition xml:lang="en">Relates an entity to its physical or logical location.</skos:definition>
        <skos:prefLabel xml:lang="en">locatedAt</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#locatedWithin -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#locatedWithin">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Location"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Location"/>
        <skos:definition xml:lang="en">Relates a Location to a broader Location that wholly contains it, e.g. a City to its Region or Country, or a Region to its Country.</skos:definition>
        <skos:prefLabel xml:lang="en">locatedWithin</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Transitive: a City locatedWithin a Region that is locatedWithin a Country is also locatedWithin that Country. Assert only the most direct containment and let reasoning supply the rest. Use stonework:locatedAt to place non-Location entities such as Hosts or Organizations at a Location.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#loggedInTo -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#loggedInTo">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#UserAccount"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Host"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#NetworkService"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates a UserAccount to the Hosts or NetworkServices it has authenticated to.</skos:definition>
        <skos:prefLabel xml:lang="en">loggedInTo</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#madeActuation -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#madeActuation">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#madeByActuator"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#SecurityActuator"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#SecurityActuation"/>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/vocab-ssn/#SOSAmadeActuation"/>
        <skos:definition xml:lang="en">Relates a SecurityActuator to a SecurityActuation it performed.</skos:definition>
        <skos:prefLabel xml:lang="en">madeActuation</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#madeByActuator -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#madeByActuator">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#SecurityActuation"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#SecurityActuator"/>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/vocab-ssn/#SOSAmadeByActuator"/>
        <skos:definition xml:lang="en">Relates a SecurityActuation to the SecurityActuator that performed it.</skos:definition>
        <skos:prefLabel xml:lang="en">madeByActuator</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#madeBySensor -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#madeBySensor">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#SecurityObservation"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Sensor"/>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/vocab-ssn/#SOSAmadeBySensor"/>
        <skos:definition xml:lang="en">Links a SecurityObservation to the Sensor that produced it.</skos:definition>
        <skos:prefLabel xml:lang="en">madeBySensor</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Inspired by SOSA sosa:madeBySensor. Enables queries such as &apos;which sensor produced this observation?&apos; and &apos;what has this IDS sensor observed in the last 24 hours?&apos; The producing sensor may also be the created_by_ref identity in the STIX wire format.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#manifestsAs -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#manifestsAs">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Threat"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#ThreatScenario"/>
        <skos:definition xml:lang="en">A Threat is concretely expressed as a ThreatScenario with defined actor, asset, and technique. Connects abstract threat to actionable scenario modelling.</skos:definition>
        <skos:prefLabel xml:lang="en">manifestsAs</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#markingRef -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#markingRef">
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Markings"/>
        <skos:definition>Reference to the Markings applied by this marking entry.</skos:definition>
        <skos:prefLabel>markingRef</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#memberOf -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#memberOf">
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Group"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Organization"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#ThreatActor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates an entity to a Group, Organization, or ThreatActor to which it belongs.</skos:definition>
        <skos:prefLabel xml:lang="en">memberOf</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#memberOfActivityCluster -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#memberOfActivityCluster">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#CyberActivity"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#CyberActivityCluster"/>
        <skos:definition xml:lang="en">Relates a Campaign or other CyberActivity to the CyberActivityCluster that analytically groups it.</skos:definition>
        <skos:prefLabel xml:lang="en">memberOfActivityCluster</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#memberOfFamily -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#memberOfFamily">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#MalwareSample"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#MalwareFamily"/>
        <skos:definition>Relates a specific malware sample to the malware family it has been classified as belonging to, based on shared behavioral patterns, code similarity, infrastructure overlap, or analyst attribution.</skos:definition>
        <skos:prefLabel>memberOfFamily</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#mentions -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#mentions">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Provenance"/>
        <skos:definition xml:lang="en">An entity referenced or cited within this Provenance record.</skos:definition>
        <skos:prefLabel>mentions</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#metricFor -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#metricFor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#MetricObservation"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <skos:definition xml:lang="en">The entity whose value is recorded by a MetricObservation.</skos:definition>
        <skos:prefLabel xml:lang="en">metricFor</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#metricType -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#metricType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#MetricObservation"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#MetricType"/>
        <skos:definition xml:lang="en">Identifies the meaning and scale of the recorded metric value.</skos:definition>
        <skos:prefLabel xml:lang="en">metricType</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#mitigates -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#mitigates">
        <skos:definition xml:lang="en">Relates a Mitigation, CourseOfAction, or Control to the AttackPattern or Vulnerability it addresses. Corresponds to STIX relationship_type &apos;mitigates&apos;.</skos:definition>
        <skos:prefLabel>mitigates</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Domain/range intentionally left unset: this property is a direct lift of the STIX 2.1 relationship_type &apos;mitigates&apos; shortcut. STIX does not schema-constrain which SDO/SCO types may appear as source_ref/target_ref for a given relationship_type — that&apos;s producer convention, not enforceable structure, and a closed domain/range here would misrepresent real STIX 2.1 data and mislead reasoner-based consumers. Contrast with stonework:mitigatesAttackPattern, a purpose-built subproperty with a controlled domain/range, populated by materialize-technique-links.sparql rather than lifted directly from STIX.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#mitigatesAttackPattern -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#mitigatesAttackPattern">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#mitigates"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Countermeasure"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#AttackPattern"/>
        <skos:definition xml:lang="en">Relates a Countermeasure (e.g. a CIS Control safeguard) to the AttackPattern it mitigates, resolved from a shared technique identifier.</skos:definition>
        <skos:prefLabel>mitigatesAttackPattern</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Materialized by joining a framework&apos;s technique-identifier literal (see stonework:relatedTechniqueIdentifier, e.g. cis:mitigatesTechniqueId) against the ATT&amp;CK technique&apos;s external reference. Framework ontologies declare their concrete property (e.g. cis:mitigatesTechnique) as rdfs:subPropertyOf this.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#mitigatesVulnerability -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#mitigatesVulnerability">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#CourseOfAction"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Vulnerability"/>
        <skos:definition xml:lang="en">A CourseOfAction (patch, workaround, compensating control) addresses this Vulnerability. Distinct from stonework:mitigates (Countermeasure → AttackPattern).</skos:definition>
        <skos:prefLabel xml:lang="en">mitigatesVulnerability</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#noteAbout -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#noteAbout">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Note"/>
        <skos:definition xml:lang="en">Relates a Note to the entities it annotates.</skos:definition>
        <skos:prefLabel xml:lang="en">noteAbout</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#observedIn -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#observedIn">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Behavior"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#DigitalArtifact"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Identifier"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Infrastructure"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Malware"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Product"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#SecurityCondition"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#CyberActivity"/>
        <skos:definition xml:lang="en">Relates an observed entity, such as a DigitalArtifact, Infrastructure, Malware, Product, Behavior, Identifier, or SecurityCondition, to the CyberActivity (for example a Campaign, Incident, or Event) in which it was observed or collected.</skos:definition>
        <skos:prefLabel xml:lang="en">observedIn</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A general-purpose shortcut: the kind of context is conveyed by typing the CyberActivity, so narrower subproperties per activity type are unnecessary. Asserting this property does not imply that the object is a Campaign; type it explicitly when that matters. When an observation needs its own metadata, such as observer, time, location, count, or confidence, model it as a stonework:Sighting instead. Not an inverse of stonework:uses, which records that an actor, campaign, or malware employs a technique or tool rather than that an entity was seen in an activity.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#occursOn -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#occursOn">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Event"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Host"/>
        <skos:definition xml:lang="en">Relates an Event to the Host on which it was observed.</skos:definition>
        <skos:prefLabel xml:lang="en">occursOn</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#operatesIn -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#operatesIn">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Organization"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#ThreatActor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Location"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Sector"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates an Organization or ThreatActor to the Locations or Sectors they operate in.</skos:definition>
        <skos:prefLabel xml:lang="en">operatesIn</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#opinionOf -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#opinionOf">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Opinion"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#IntelligenceProduct"/>
        <skos:definition xml:lang="en">Relates an Opinion to the IntelligenceProduct whose correctness or credibility it evaluates.</skos:definition>
        <skos:prefLabel xml:lang="en">opinionOf</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#originatesFrom -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#originatesFrom">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Location"/>
        <skos:definition xml:lang="en">Relates an Agent to the geographic Location from which it originates.</skos:definition>
        <skos:prefLabel>originatesFrom</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#originatesInAS -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#originatesInAS">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#IPAddress"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#AutonomousSystem"/>
        <skos:definition xml:lang="en">Relates an IPAddress to the AutonomousSystem that originates its encompassing IP prefix in BGP.</skos:definition>
        <skos:prefLabel xml:lang="en">originatesInAS</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#originatorAccount -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#originatorAccount">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#FinancialTransaction"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#FinancialAccount"/>
        <skos:definition xml:lang="en">The account debited by this transaction — the source of the transferred value.</skos:definition>
        <skos:prefLabel xml:lang="en">originatorAccount</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Naming follows the FATF Travel Rule and ISO 20022 originator-beneficiary convention. Direction of value is carried by these roles, not by the sign of stonework:amount.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#originatorMonetaryValue -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#originatorMonetaryValue">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#hasMonetaryValue"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#FinancialTransaction"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#MonetaryAmount"/>
        <skos:definition xml:lang="en">The monetary amount debited from the originator account as this transaction&apos;s input.</skos:definition>
        <skos:prefLabel xml:lang="en">originatorMonetaryValue</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Use with stonework:beneficiaryMonetaryValue when a transaction changes denomination, as in a currency exchange. Both properties remain queryable through their stonework:hasMonetaryValue superproperty.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#overlapsWith -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#overlapsWith">
        <skos:definition xml:lang="en">Indicates two entities share common attributes, infrastructure, or behaviour, suggesting possible connection without asserting a specific relationship type.</skos:definition>
        <skos:prefLabel>overlapsWith</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#ownedBy -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#ownedBy">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#DataAsset"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Infrastructure"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <skos:definition xml:lang="en">Relates a DataAsset or Infrastructure to its owning Agent.</skos:definition>
        <skos:prefLabel xml:lang="en">ownedBy</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#performedBy -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#performedBy">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Playbook"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Process"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <skos:definition xml:lang="en">Relates a Process to the Agent that performs it, or a Playbook to the Agent responsible for carrying it out.</skos:definition>
        <skos:prefLabel xml:lang="en">performedBy</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#phoneNumberOf -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#phoneNumberOf">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#PhoneNumber"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <skos:definition xml:lang="en">The Agent associated with this PhoneNumber. Inverse of stonework:hasPhoneNumber.</skos:definition>
        <skos:prefLabel>phoneNumberOf</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#playsRole -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#playsRole">
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Role"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#hasRoleAssignment"/>
            <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#assignedRole"/>
        </owl:propertyChainAxiom>
        <skos:definition xml:lang="en">A context-free projection of a Role played by an entity.</skos:definition>
        <skos:prefLabel>playsRole</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Use stonework:RoleAssignment with stonework:roleContext when the campaign, operation, organization, provenance, or time interval matters. The qualified pattern infers this direct projection through a property chain.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#posesThreat -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#posesThreat">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Campaign"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#ThreatActor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Threat"/>
        <skos:definition xml:lang="en">Relates a ThreatActor or Campaign to the Threats they represent.</skos:definition>
        <skos:prefLabel xml:lang="en">posesThreat</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#precededByStep -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#precededByStep">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Step"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Step"/>
        <skos:definition xml:lang="en">Relates a Step to another Step that must occur before it within the same parent Behavior.</skos:definition>
        <skos:prefLabel>precededByStep</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Deliberately distinct from stonework:precedes, whose domain and range are IntelligenceProduct (report-version succession) — an unrelated relationship. precededByStep expresses a graph that may contain cycles: an edge targeting an already-reached Step is a loop, not an error. Use stonework:Transition instead when the edge itself needs a guard condition or other structure attached.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#precedes -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#precedes">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#IntelligenceProduct"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#IntelligenceProduct"/>
        <skos:definition xml:lang="en">Temporal succession of Information (v1 precedes v2 of a report)</skos:definition>
        <skos:prefLabel>precedes</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#predictedType -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#predictedType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Hypothesis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
        <skos:definition xml:lang="en">The class a Hypothesis predicts its stonework:predictsVariable will be bound to an instance of, once executed.</skos:definition>
        <skos:prefLabel>predictedType</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Mirrors stonework:guardType on Transition. Exists because a Hypothesis is typically formed before the Variable&apos;s eventual value has been constructed — at prediction time there is usually no individual yet to name via stonework:predictedValue, only an expected class of outcome (e.g. &apos;this attempt will produce some stonework:SecurityCondition&apos;).</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#predictedValue -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#predictedValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Hypothesis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <skos:definition xml:lang="en">The individual a Hypothesis predicts its stonework:predictsVariable will be bound to, once executed.</skos:definition>
        <skos:prefLabel>predictedValue</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Mirrors stonework:boundTo on the actual-result side; usable only when a specific pre-existing individual is predicted. See stonework:predictedType for the more common case of predicting a class of outcome rather than a specific not-yet-constructed individual, and stonework:predictedLiteral for predictions of a scalar.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#predictsVariable -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#predictsVariable">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Hypothesis"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Variable"/>
        <skos:definition xml:lang="en">The Variable whose eventual binding a Hypothesis is a prediction about.</skos:definition>
        <skos:prefLabel>predictsVariable</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Because stonework:hasInputVariable/stonework:hasOutputVariable are declared on stonework:Behavior, and stonework:Step is itself a Behavior, a Hypothesis may predict a Variable declared at any level of a Step/Plan decomposition — a top-level Plan&apos;s overall outcome or a single Step&apos;s individual result — without a separate property per level.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#procedureFor -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#procedureFor">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#implements"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Procedure"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Technique"/>
        <skos:definition xml:lang="en">Relates a Procedure to the Technique it implements; a specialized form of stonework:implements for procedure-to-technique links.</skos:definition>
        <skos:prefLabel xml:lang="en">procedureFor</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#produces -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#produces">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#CyberActivity"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <skos:definition xml:lang="en">Links an executing CyberActivity to a CyberEntity it constructed or generated in the course of executing.</skos:definition>
        <skos:prefLabel>produces</skos:prefLabel>
        <skos:scopeNote xml:lang="en">General-purpose construction/generation link — e.g. the CyberActivity realizing a Step is what actually constructs the value a Variable ends up stonework:boundTo, or a complex output artifact (a dataset, a report) that value refers to.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#producesReport -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#producesReport">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Investigation"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Process"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Assessment"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Report"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates a Process or Investigation to the intelligence product it generates.</skos:definition>
        <skos:prefLabel xml:lang="en">producesReport</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#protects -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#protects">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#AccessControlList"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Countermeasure"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#DataAsset"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#DigitalArtifact"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates a Countermeasure or ACL to the resource it protects.</skos:definition>
        <skos:prefLabel xml:lang="en">protects</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#provenanceOf -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#provenanceOf">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Provenance"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#IntelligenceProduct"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#QualifiedAssertion"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates a Provenance record to the IntelligenceProduct or QualifiedAssertion whose origin or evidentiary basis it documents.</skos:definition>
        <skos:prefLabel xml:lang="en">provenanceOf</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#references -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#references">
        <skos:definition xml:lang="en">Generic reference from one entity to another. Use a more specific property where one exists.</skos:definition>
        <skos:prefLabel>references</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#refines -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#refines">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#AttackTechnique"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#AttackPattern"/>
        <skos:definition xml:lang="en">Relates an AttackTechnique to a broader or more abstract AttackPattern that it specializes, enabling roll-up from operational techniques to pattern families.</skos:definition>
        <skos:prefLabel xml:lang="en">refines</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#registeredTo -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#registeredTo">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Infrastructure"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <skos:definition xml:lang="en">Relates infrastructure to the Agent recorded as its owner or registrant of record — the entity in whose name the resource is officially registered.</skos:definition>
        <skos:prefLabel>registeredTo</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#registeredWith -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#registeredWith">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Infrastructure"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <skos:definition xml:lang="en">Relates infrastructure to the registrar, registry, or administrative authority through which the registration was processed or is maintained.</skos:definition>
        <skos:prefLabel>registeredWith</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#relatedAttackPattern -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#relatedAttackPattern">
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#AttackPattern"/>
        <skos:definition xml:lang="en">Relates an entity to an AttackPattern representing the same underlying technique in a different framework shape, resolved from a shared technique identifier (e.g. a CAPEC entry and the MITRE ATT&amp;CK technique it maps to, or a CWE weakness and the CAPEC pattern that exploits it).</skos:definition>
        <skos:prefLabel>relatedAttackPattern</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Domain intentionally left unset: subjects include stonework:Weakness (CWE → CAPEC) and stonework:AttackPattern itself (CAPEC → ATT&amp;CK). Materialized by joining a framework&apos;s technique-identifier literal (see stonework:relatedTechniqueIdentifier) against the ATT&amp;CK technique&apos;s external reference. Framework ontologies declare their concrete property (e.g. capec:relatedAttackTechnique, cwe:relatedAttackPattern) as rdfs:subPropertyOf this.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#relatedTechnique -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#relatedTechnique">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#CyberTechnique"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#CyberTechnique"/>
        <skos:definition xml:lang="en">Relates a CyberTechnique to another related CyberTechnique via a cross-framework or cross-abstraction-level association.</skos:definition>
        <skos:prefLabel>relatedTechnique</skos:prefLabel>
        <skos:scopeNote xml:lang="en">For technique-to-technique associations where both ends are already stonework:CyberTechnique individuals. Where the association instead crosses AttackPattern shapes (e.g. CWE weakness → CAPEC pattern, CAPEC pattern → ATT&amp;CK technique), use stonework:relatedAttackPattern, whose domain is not restricted to CyberTechnique.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#relatedTo -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#relatedTo">
        <skos:definition>Shortcut triple: generic relationship. Corresponds to STIX relationship_type &apos;related-to&apos;.</skos:definition>
        <skos:prefLabel>relatedTo</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#remediates -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#remediates">
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Vulnerability"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Weakness"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates an entity that addresses or corrects a Vulnerability or Weakness to the condition it remediates.</skos:definition>
        <skos:prefLabel>remediates</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#reportedBy -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#reportedBy">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Report"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Sighting"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <skos:definition xml:lang="en">Relates a Report or Sighting to the Agent who created it.</skos:definition>
        <skos:prefLabel xml:lang="en">reportedBy</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#reportedIn -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#reportedIn">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Vulnerability"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Publication"/>
        <skos:definition xml:lang="en">A Vulnerability is formally disclosed in this Publication (advisory, CVE NVD entry, security bulletin). Primary arc into the Publication class.</skos:definition>
        <skos:prefLabel xml:lang="en">reportedIn</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#resolvedTo -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#resolvedTo">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#resolvesTo"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Domain"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#IPAddress"/>
        <skos:definition xml:lang="en">A Domain resolves to this IPAddress via DNS. More specific than stonework:resolvesTo (Infrastructure → Infrastructure); use this for explicit domain-to-IP mappings.</skos:definition>
        <skos:prefLabel xml:lang="en">resolvedTo</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#resolvesTo -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#resolvesTo">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Infrastructure"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Infrastructure"/>
        <skos:definition xml:lang="en">Relates one Infrastructure entity to another Infrastructure entity to which it resolves, such as a Domain resolving to an IPAddress.</skos:definition>
        <skos:prefLabel xml:lang="en">resolvesTo</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#respondsToActivity -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#respondsToActivity">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#FinancialTransaction"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#CyberActivity"/>
        <skos:definition xml:lang="en">A cyber activity whose occurrence prompted or provides the context for this financial transaction, without asserting that the transaction financed the activity.</skos:definition>
        <skos:prefLabel xml:lang="en">respondsToActivity</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Use for a victim&apos;s ransom payment linked to the incident it responds to, restitution or remediation payments, and similar contextual relationships. Use stonework:fundsActivity only when the transaction finances the linked activity.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#revokedBy -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#revokedBy">
        <skos:definition>Shortcut triple: source STIX object is revoked and superseded by target. Corresponds to STIX relationship_type &apos;revoked-by&apos;.</skos:definition>
        <skos:prefLabel>revokedBy</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#riskOfScenario -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#riskOfScenario">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Risk"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#ThreatScenario"/>
        <skos:definition xml:lang="en">Relates an assessed Risk to the ThreatScenario whose realization gives rise to that risk.</skos:definition>
        <skos:prefLabel xml:lang="en">riskOfScenario</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#roleContext -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#roleContext">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#RoleAssignment"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#CyberActivity"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#CyberEntity"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">The campaign, operation, organization, or other context in which a RoleAssignment applies.</skos:definition>
        <skos:prefLabel xml:lang="en">roleContext</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#rolePlayer -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#rolePlayer">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#hasRoleAssignment"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#RoleAssignment"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <skos:definition xml:lang="en">The entity that bears the Role in a qualified RoleAssignment.</skos:definition>
        <skos:prefLabel xml:lang="en">rolePlayer</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#runs -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#runs">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Host"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#RuntimeProcess"/>
        <skos:definition xml:lang="en">Relates a Host to the RuntimeProcesses executing on it.</skos:definition>
        <skos:prefLabel xml:lang="en">runs</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#scenarioActor -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#scenarioActor">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#ThreatScenario"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#ThreatActor"/>
        <skos:definition xml:lang="en">Relates a ThreatScenario to the threat actor type or group it models.</skos:definition>
        <skos:prefLabel xml:lang="en">scenarioActor</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#scenarioAsset -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#scenarioAsset">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#ThreatScenario"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#DataAsset"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Infrastructure"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates a ThreatScenario to the targeted assets in the scenario.</skos:definition>
        <skos:prefLabel xml:lang="en">scenarioAsset</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#scenarioTechnique -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#scenarioTechnique">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#ThreatScenario"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#AttackTechnique"/>
        <skos:definition xml:lang="en">Relates a ThreatScenario to the AttackTechniques in the attack path.</skos:definition>
        <skos:prefLabel xml:lang="en">scenarioTechnique</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#sharesCertificate -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#sharesCertificate">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Infrastructure"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Certificate"/>
        <skos:definition xml:lang="en">Relates an Infrastructure entity to a TLS/SSL Certificate it presents or uses; shared certificate values may indicate common ownership or operation.</skos:definition>
        <skos:prefLabel>sharesCertificate</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#sharesRegistrant -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#sharesRegistrant">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Infrastructure"/>
        <skos:definition xml:lang="en">Links Infrastructure entities sharing a common domain registrant record, supporting operator attribution clustering.</skos:definition>
        <skos:prefLabel>sharesRegistrant</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#sightedAt -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#sightedAt">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Sighting"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Infrastructure"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Location"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates a Sighting to the infrastructure or location where the observation was made.</skos:definition>
        <skos:prefLabel xml:lang="en">sightedAt</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#sightedBy -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#sightedBy">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Sighting"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <skos:definition xml:lang="en">Relates a Sighting to the Agent who made the observation.</skos:definition>
        <skos:prefLabel xml:lang="en">sightedBy</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#sightedObject -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#sightedObject">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Sighting"/>
        <skos:definition xml:lang="en">Relates a Sighting to the entity that was observed.</skos:definition>
        <skos:prefLabel xml:lang="en">sightedObject</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#signedWith -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#signedWith">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#File"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Certificate"/>
        <skos:definition xml:lang="en">A File is code-signed with this Certificate. Supports trust chain analysis, publisher attribution of binaries, and detection of certificate abuse or misuse.</skos:definition>
        <skos:prefLabel xml:lang="en">signedWith</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#spawns -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#spawns">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#hasParentProcess"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#RuntimeProcess"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#RuntimeProcess"/>
        <skos:definition xml:lang="en">A RuntimeProcess creates a child process. Inverse of stonework:hasParentProcess; enables top-down process tree traversal for execution chain analysis.</skos:definition>
        <skos:prefLabel xml:lang="en">spawns</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#storedIn -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#storedIn">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#DataAsset"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Infrastructure"/>
        <skos:definition xml:lang="en">Relates a DataAsset to the Infrastructure system that stores it.</skos:definition>
        <skos:prefLabel xml:lang="en">storedIn</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#storedOn -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#storedOn">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#DigitalArtifact"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#File"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Registry"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Host"/>
        <skos:definition xml:lang="en">Relates a DigitalArtifact to the Host on which it is stored.</skos:definition>
        <skos:prefLabel xml:lang="en">storedOn</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#subdomainOf -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#subdomainOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Domain"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Domain"/>
        <skos:definition xml:lang="en">This Domain is a subdomain of the specified parent Domain. Transitive: if A is a subdomain of B and B of C, then A is a subdomain of C.</skos:definition>
        <skos:prefLabel>subdomainOf</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#subsidiary -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#subsidiary">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Organization"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Organization"/>
        <skos:definition xml:lang="en">Relates an Organization to a subsidiary organization it owns or controls.</skos:definition>
        <skos:prefLabel xml:lang="en">subsidiary</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#supersededBy -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#supersededBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Vulnerability"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Vulnerability"/>
        <skos:definition xml:lang="en">Relates a vulnerability to the vulnerability record that supersedes it, e.g. when a CVE is split, merged, or formally replaced by another identifier.</skos:definition>
        <skos:prefLabel xml:lang="en">supersededBy</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Corresponds to cve:replacedBy in CVE JSON 5.x, but as an object property linking to a stonework:Vulnerability individual rather than a string. The source-specific string form is preserved on cve:replacedBy regardless of whether resolution to this property succeeds.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#supersedes -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#supersedes">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#VersionedProduct"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#VersionedProduct"/>
        <skos:definition xml:lang="en">Relates a product version to an older version it replaces. Transitive to support full product lifecycle reasoning.</skos:definition>
        <skos:prefLabel xml:lang="en">supersedes</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#targets -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#targets">
        <skos:definition>Shortcut triple: source targets the target Identity, Vulnerability, or Location. Corresponds to STIX relationship_type &apos;targets&apos;.</skos:definition>
        <skos:prefLabel>targets</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Domain/range intentionally left unset: this property is a direct lift of the STIX 2.1 relationship_type &apos;targets&apos; shortcut. STIX does not schema-constrain which SDO/SCO types may appear as source_ref/target_ref for a given relationship_type — that&apos;s producer convention, not enforceable structure, and a closed domain/range here would misrepresent real STIX 2.1 data and mislead reasoner-based consumers.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#targetsPlatform -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#targetsPlatform">
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#VersionedProduct"/>
        <skos:definition xml:lang="en">A MalwareSample or Tool is engineered to run on or exploit this VersionedProduct (OS, application, firmware version). Supports exposure and blast-radius queries.</skos:definition>
        <skos:prefLabel xml:lang="en">targetsPlatform</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#targetsService -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#targetsService">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#NetworkTraffic"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#NetworkService"/>
        <skos:definition xml:lang="en">The NetworkService this traffic addresses.</skos:definition>
        <skos:prefLabel xml:lang="en">targetsService</skos:prefLabel>
        <skos:scopeNote>⚑ Category: service *type* (HTTP, SSH, RDP, SMB, DNS) is better expressed as stonework:categorizedBy → Category named individual than as subclasses of NetworkService. NetworkService as a class is appropriate only when the instance has its own properties (port, vulnerability linkage).</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#techniqueOf -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#techniqueOf">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Technique"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Tactic"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Technique"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:isDefinedBy rdf:resource="https://cyberterrain.org/ns/stonework#"/>
        <skos:definition xml:lang="en">Relates a Technique to a Tactic it supports or to a broader Technique of which it is a specialization.</skos:definition>
        <skos:prefLabel xml:lang="en">techniqueOf</skos:prefLabel>
        <skos:scopeNote xml:lang="en">This is the inverse of hasTechnique. A Technique may support multiple Tactics, and a sub-technique may identify its broader parent Technique through the same hierarchy.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#toStep -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#toStep">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Transition"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Step"/>
        <skos:definition xml:lang="en">The Step a Transition enters.</skos:definition>
        <skos:prefLabel>toStep</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A Transition whose toStep was already reached earlier in the same Behavior&apos;s Step graph expresses a loop back-edge; a self-loop (toStep equal to fromStep) is the degenerate case.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#transactionCurrency -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#transactionCurrency">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#FinancialTransaction"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Currency"/>
        <skos:definition xml:lang="en">Convenience projection of the currency of a single-denomination transaction&apos;s stonework:MonetaryAmount, for consumers that need one value without traversing stonework:hasMonetaryValue.</skos:definition>
        <skos:prefLabel xml:lang="en">transactionCurrency</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Do not use for a currency exchange with distinct input and output currencies; traverse stonework:originatorMonetaryValue and stonework:beneficiaryMonetaryValue to their stonework:currency values instead.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#transfersFile -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#transfersFile">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#NetworkTraffic"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#File"/>
        <skos:definition xml:lang="en">A File carried as payload in this NetworkTraffic flow. Covers both delivery (malware download) and exfiltration scenarios.</skos:definition>
        <skos:prefLabel xml:lang="en">transfersFile</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#triggeredBy -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#triggeredBy">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#triggersPlaybook"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Playbook"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Event"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Incident"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates a Playbook to the Event or Incident that initiates its execution.</skos:definition>
        <skos:prefLabel xml:lang="en">triggeredBy</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#triggersPlaybook -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#triggersPlaybook">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Event"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Incident"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Playbook"/>
        <skos:definition xml:lang="en">Relates an Event or Incident to a Playbook invoked in response.</skos:definition>
        <skos:prefLabel xml:lang="en">triggersPlaybook</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#urlOf -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#urlOf">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#URI"/>
        <skos:definition xml:lang="en">The entity this URI serves as a locator or persistent identifier for.</skos:definition>
        <skos:prefLabel>urlOf</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#uses -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#uses">
        <skos:definition>Relates a threat actor group, campaign, malware, or tool to an offensive technique, malware, or tool it is known to employ.</skos:definition>
        <skos:prefLabel>uses</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Domain/range intentionally left unset: this property is a direct lift of the STIX 2.1 relationship_type &apos;uses&apos; shortcut (sub-property stones:uses carries the shortcut triples emitted by the STIX 2.1 transform). STIX does not schema-constrain which SDO/SCO types may appear as source_ref/target_ref for a given relationship_type — that&apos;s producer convention, not enforceable structure. In the MITRE ATT&amp;CK bundle alone, observed &apos;uses&apos; sources include Campaign, IntrusionSet, Malware, and Tool, and observed targets include AttackTechnique, Malware, and Tool — a closed domain/range would misrepresent this real data and mislead reasoner-based consumers. Query-time discrimination (e.g. selecting only IntrusionSet users of a technique) should filter on the asserted stones:stixType literal or a specific rdf:type, not assume it from this property alone.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#usesDetectionRule -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#usesDetectionRule">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#DetectionPlan"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Step"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#DetectionRule"/>
        <skos:definition xml:lang="en">Relates a DetectionPlan or Step to a DetectionRule that it evaluates or invokes.</skos:definition>
        <skos:prefLabel xml:lang="en">usesDetectionRule</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Use stonework:usesRule for the deployment-side relationship between a Sensor and a DetectionRule.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#usesInfrastructure -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#usesInfrastructure">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#uses"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Agent"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#CyberActivity"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Malware"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Product"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Infrastructure"/>
        <skos:definition xml:lang="en">Relates malware, a product, cyber activity, or agent to infrastructure it uses.</skos:definition>
        <skos:prefLabel xml:lang="en">usesInfrastructure</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Use for an operational dependency on infrastructure, such as malware using command-and-control infrastructure, a CyberActivityCluster or Campaign using hosting infrastructure, a product using a supporting service, or an Agent using infrastructure in an operation. This relationship asserts use, not ownership, compromise, or attribution.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#usesInstrument -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#usesInstrument">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#FinancialTransaction"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#PaymentInstrument"/>
        <skos:definition xml:lang="en">The payment instrument or rail used to execute this transaction — wire, ACH, SEPA, card, cash, on-chain transfer, and so on.</skos:definition>
        <skos:prefLabel xml:lang="en">usesInstrument</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#usesRule -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#usesRule">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#uses"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Sensor"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#DetectionRule"/>
        <skos:definition>Relates a Sensor to the Detection Rules it applies.</skos:definition>
        <skos:prefLabel>usesRule</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#valuationCurrency -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#valuationCurrency">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#MetricObservation"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Currency"/>
        <skos:definition xml:lang="en">The currency in which a normalized monetary metric value is expressed.</skos:definition>
        <skos:prefLabel xml:lang="en">valuationCurrency</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Required for a stonework:MetricObservation whose stonework:metricType is stonework:metricNormalizedValue. The source amount retains its own stonework:currency; this property identifies the output unit produced by the cited exchange-rate source.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#variantOf -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#variantOf">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#MalwareFamily"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#MalwareSample"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#MalwareFamily"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#MalwareSample"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <skos:definition xml:lang="en">Relates a MalwareFamily or MalwareSample to another family or sample from which it is derived, modified, or evolved, indicating shared code lineage, forked development, or deliberate repackaging.</skos:definition>
        <skos:prefLabel>variantOf</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#vendorOf -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#vendorOf">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Product"/>
        <skos:definition xml:lang="en">Relates an Agent to a product family it develops or maintains.</skos:definition>
        <skos:prefLabel xml:lang="en">vendorOf</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#versionOf -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#versionOf">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#hasVersion"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#VersionedProduct"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Product"/>
        <skos:definition xml:lang="en">Links a specific versioned product instance back to its abstract product family.</skos:definition>
        <skos:prefLabel xml:lang="en">versionOf</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#weaknessOf -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#weaknessOf">
        <owl:inverseOf rdf:resource="https://cyberterrain.org/ns/stonework#hasWeakness"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Weakness"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Vulnerability"/>
        <skos:definition xml:lang="en">Relates a weakness to the vulnerability that exploits or instantiates it.</skos:definition>
        <skos:prefLabel xml:lang="en">weaknessOf</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The range is a vulnerability individual. The weakness individual (domain) is a stonework:Weakness whose IRI is derived from the CWE identifier. The weakness individual may be populated by a separate CWE ingest.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#worksFor -->


    <owl:ObjectProperty rdf:about="https://cyberterrain.org/ns/stonework#worksFor">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Person"/>
        <rdfs:range rdf:resource="https://cyberterrain.org/ns/stonework#Organization"/>
        <skos:definition xml:lang="en">Relates a Person to the Organization they work for.</skos:definition>
        <skos:prefLabel xml:lang="en">worksFor</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/abstract -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/abstract"/>
    


    <!-- http://purl.org/dc/terms/created -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/identifier -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/identifier"/>
    


    <!-- http://purl.org/dc/terms/issued -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#notation -->


    <owl:DatatypeProperty rdf:about="http://www.w3.org/2004/02/skos/core#notation"/>
    


    <!-- https://cyberterrain.org/ns/stonework#abaRoutingNumber -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#abaRoutingNumber">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#FinancialInstitution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The US ABA routing transit number of this institution. National branch or bank codes from other schemes, for example a UK sort code, may be recorded with the same property pending scheme-specific refinement.</skos:definition>
        <skos:prefLabel xml:lang="en">abaRoutingNumber</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#accountName -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#accountName">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#UserAccount"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The username or account identifier on the target system or service.</skos:definition>
        <skos:prefLabel xml:lang="en">accountName</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#accountNumber -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#accountNumber">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#BankAccountNumber"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The domestic account number string.</skos:definition>
        <skos:prefLabel xml:lang="en">accountNumber</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#amount -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#amount">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#MonetaryAmount"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <skos:definition xml:lang="en">The magnitude of a stonework:MonetaryAmount, in the units of its stonework:currency. Negative values represent debit or overdrawn balances; transaction amounts are non-negative by convention, with direction carried by originator and beneficiary roles.</skos:definition>
        <skos:prefLabel xml:lang="en">amount</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#asName -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#asName">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#AutonomousSystem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The registered name or handle of the autonomous system.</skos:definition>
        <skos:prefLabel xml:lang="en">asName</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#asNumber -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#asNumber">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#AutonomousSystem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedInt"/>
        <skos:definition xml:lang="en">The Autonomous System Number (ASN) assigned by IANA.</skos:definition>
        <skos:prefLabel xml:lang="en">asNumber</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#assertionRelationType -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#assertionRelationType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#QualifiedAssertion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The source vocabulary&apos;s wire-level name for the relation expressed by a qualified assertion.</skos:definition>
        <skos:prefLabel xml:lang="en">assertion relation type</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Preserves open relationship vocabularies such as STIX relationship_type strings. A separately materialized object property may provide a query-friendly projection of the same assertion.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#attackId -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#attackId">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#notation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The MITRE ATT&amp;CK identifier of an ATT&amp;CK object, as ATT&amp;CK displays it: Txxxx or Txxxx.yyy (technique, sub-technique), TAxxxx (tactic), Gxxxx (group), Sxxxx (software), Mxxxx (mitigation), Cxxxx (campaign), DETxxxx (detection strategy), ANxxxx (analytic), DCxxxx (data component).</skos:definition>
        <skos:prefLabel xml:lang="en">attackId</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Domain deliberately unset: every kind of ATT&amp;CK object has an ATT&amp;CK ID. The canonical and source forms are the same, so attack:attackId specializes both this property and stonework:externalId. Not unique across object types (ATT&amp;CK&apos;s deprecated mitigations reuse technique T-numbers): look an object up by its ID together with its class. Distinct from stonework:relatedTechniqueIdentifier, which carries an ATT&amp;CK technique ID on another framework&apos;s entity (e.g. a CAPEC pattern) as a join key; attackId is the ATT&amp;CK object&apos;s own identifier.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#bic -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#bic">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#FinancialInstitution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The Business Identifier Code (SWIFT/BIC, ISO 9362) of this institution.</skos:definition>
        <skos:prefLabel xml:lang="en">bic</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#blockchainNetwork -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#blockchainNetwork">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#CryptoAsset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The distributed ledger a crypto asset is native to or issued on (e.g. Bitcoin, Ethereum, Tron, Monero). The same nominal token issued on more than one ledger is modeled as distinct CryptoAsset individuals.</skos:definition>
        <skos:prefLabel xml:lang="en">blockchainNetwork</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#bomFormat -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#bomFormat">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition>The exchange format and version in which a Bill of Materials was originally serialized (e.g. &apos;CycloneDX 1.6&apos;, &apos;SPDX 2.3&apos;).</skos:definition>
        <skos:prefLabel>BOM format</skos:prefLabel>
        <skos:scopeNote>Domain intentionally left unset. Serves as provenance metadata on stonework:SoftwareBillOfMaterials instances, distinguishing the source format from the STONEWORK representation.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#boundToLiteral -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#boundToLiteral">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Variable"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <skos:definition xml:lang="en">Binds a Variable, at execution time or at plan instantiation, to a scalar result value such as a boolean, count, or numeric score.</skos:definition>
        <skos:prefLabel>boundToLiteral</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Tested by stonework:guardLiteralValue and stonework:guardOperator on a Transition. When the guard uses an ordering operator (LessThan, GreaterThanOrEqual, etc.), this value MUST carry a numeric datatype (xsd:decimal, xsd:double, or xsd:integer) — untyped or string literals do not compare numerically under SPARQL.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#byteCount -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#byteCount">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#NetworkTraffic"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <skos:definition xml:lang="en">The total number of bytes transmitted in the traffic flow.</skos:definition>
        <skos:prefLabel xml:lang="en">byteCount</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#capecId -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#capecId">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#notation"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#AttackPattern"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The CAPEC identifier in the format CAPEC-NNN.</skos:definition>
        <skos:prefLabel xml:lang="en">capecId</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The canonical form a person types and searches for. The source-native number (e.g. &apos;66&apos;) is capec:capecId, which specializes stonework:externalId.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#certIssuerDN -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#certIssuerDN">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Certificate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The Distinguished Name of the Certificate Authority that issued the certificate.</skos:definition>
        <skos:prefLabel xml:lang="en">certIssuerDN</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#certSerialNumber -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#certSerialNumber">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Certificate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The unique serial number assigned to the certificate by the issuing CA.</skos:definition>
        <skos:prefLabel xml:lang="en">certSerialNumber</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#certSubjectDN -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#certSubjectDN">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Certificate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The Distinguished Name of the certificate subject.</skos:definition>
        <skos:prefLabel xml:lang="en">certSubjectDN</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#certValidNotAfter -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#certValidNotAfter">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Certificate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <skos:definition xml:lang="en">The end of the certificate&apos;s validity period.</skos:definition>
        <skos:prefLabel xml:lang="en">certValidNotAfter</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#certValidNotBefore -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#certValidNotBefore">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Certificate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <skos:definition xml:lang="en">The start of the certificate&apos;s validity period.</skos:definition>
        <skos:prefLabel xml:lang="en">certValidNotBefore</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#cidrNotation -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#cidrNotation">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#IPBlock"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The CIDR notation representing the IP address block (e.g. 192.168.0.0/16).</skos:definition>
        <skos:prefLabel xml:lang="en">cidrNotation</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#commandLine -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#commandLine">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#RuntimeProcess"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The full command line string used to launch the process.</skos:definition>
        <skos:prefLabel xml:lang="en">commandLine</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#compilationTimestamp -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#compilationTimestamp">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#MalwareSample"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <skos:definition xml:lang="en">The timestamp embedded in the binary indicating when the malware was compiled.</skos:definition>
        <skos:prefLabel xml:lang="en">compilationTimestamp</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#confidence -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#confidence">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <skos:definition xml:lang="en">An integer score from 0 to 100 representing confidence in the accuracy of an assertion or the expected outcome of a Hypothesis.</skos:definition>
        <skos:prefLabel>confidence</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Domain is intentionally unset because the property is shared by Hypotheses and STIX-derived intelligence objects. Matches the STIX 2.1 confidence scale for round-tripping. For source- and time-qualified confidence history, use stonework:MetricObservation with stonework:metricConfidence.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#content -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#content">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Note"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The full text content of the note.</skos:definition>
        <skos:prefLabel xml:lang="en">content</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#controlBaseline -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#controlBaseline">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Control"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The security baseline(s) in which this control is required (e.g. Low, Moderate, High for NIST 800-53).</skos:definition>
        <skos:prefLabel xml:lang="en">controlBaseline</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#controlFamily -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#controlFamily">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Control"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The control family or category grouping (e.g. Access Control, Incident Response).</skos:definition>
        <skos:prefLabel xml:lang="en">controlFamily</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#controlId -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#controlId">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Control"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The framework-specific identifier for the control (e.g. AC-2, CIS 4.1).</skos:definition>
        <skos:prefLabel xml:lang="en">controlId</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#countryCode -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#countryCode">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Country"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The ISO 3166-1 alpha-2 country code (e.g. US, CN, RU).</skos:definition>
        <skos:prefLabel xml:lang="en">countryCode</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#cpeUri -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#cpeUri">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#VersionedProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The CPE 2.3 formatted string identifying this product version.</skos:definition>
        <skos:prefLabel xml:lang="en">cpeUri</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#created -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#created">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/created"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <skos:definition xml:lang="en">The timestamp when this individual was first created or recorded.</skos:definition>
        <skos:prefLabel xml:lang="en">created</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Compatibility alias for dcterms:created. Prefer dcterms:created in newly authored data.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#cveId -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#cveId">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#vulnerabilityId"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Vulnerability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The CVE identifier in the format CVE-YYYY-NNNNN.</skos:definition>
        <skos:prefLabel xml:lang="en">cveId</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Retained as the STONEWORK-level CVE-specific identifier. cve:cveId (declared rdfs:subPropertyOf this property) is the source-native alias always present on data ingested from CVE JSON; query this property for cross-source lookups.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#cvssBaseScore -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#cvssBaseScore">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Vulnerability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <skos:definition xml:lang="en">The headline context-neutral CVSS base score for this vulnerability, on a 0.0–10.0 scale.</skos:definition>
        <skos:prefLabel xml:lang="en">cvssBaseScore</skos:prefLabel>
        <skos:scopeNote xml:lang="en">When multiple CVSS versions are present, this SHOULD reflect the highest available version (CVSS 4.0 preferred over 3.1, 3.1 over 2.0). For full structured metric data across all CVSS versions use stonework:hasCvssMetric.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#cvssMetricBaseScore -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#cvssMetricBaseScore">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#CvssMetric"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <skos:definition xml:lang="en">The base score calculated by a structured CVSS assessment, on a 0.0-10.0 scale.</skos:definition>
        <skos:prefLabel xml:lang="en">cvssMetricBaseScore</skos:prefLabel>
        <skos:scopeNote xml:lang="en">cve:baseScore (on cve:CvssMetric) is declared rdfs:subPropertyOf this property (one-way).</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#cvssMetricBaseSeverity -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#cvssMetricBaseSeverity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#CvssMetric"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The qualitative severity corresponding to a structured CVSS assessment&apos;s base score.</skos:definition>
        <skos:prefLabel xml:lang="en">cvssMetricBaseSeverity</skos:prefLabel>
        <skos:scopeNote xml:lang="en">cve:baseSeverity (on cve:CvssMetric) is declared rdfs:subPropertyOf this property (one-way).</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#cvssMetricVector -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#cvssMetricVector">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#CvssMetric"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The complete vector string used by a structured CVSS assessment.</skos:definition>
        <skos:prefLabel xml:lang="en">cvssMetricVector</skos:prefLabel>
        <skos:scopeNote xml:lang="en">cve:vectorString (on cve:CvssMetric) is declared rdfs:subPropertyOf this property (one-way).</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#cvssMetricVersion -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#cvssMetricVersion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#CvssMetric"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The CVSS specification version used by a structured assessment, such as 3.1 or 4.0.</skos:definition>
        <skos:prefLabel xml:lang="en">cvssMetricVersion</skos:prefLabel>
        <skos:scopeNote xml:lang="en">cve:version carries this same value on cve:CvssMetric as a plain string, but is not declared a subproperty of this property because cve:version is shared with cve:VersionRange, a class this property&apos;s domain does not cover.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#cvssScore -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#cvssScore">
        <rdfs:subPropertyOf rdf:resource="https://cyberterrain.org/ns/stonework#cvssBaseScore"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Vulnerability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <skos:definition xml:lang="en">The CVSS base score (0.0–10.0) for the vulnerability.</skos:definition>
        <skos:prefLabel xml:lang="en">cvssScore</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Retained for compatibility with the original datatype-property vocabulary. Prefer stonework:cvssBaseScore for new data.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#cvssSeverity -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#cvssSeverity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Vulnerability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The qualitative CVSS severity rating corresponding to the headline base score: NONE, LOW, MEDIUM, HIGH, or CRITICAL.</skos:definition>
        <skos:prefLabel xml:lang="en">cvssSeverity</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#cvssVector -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#cvssVector">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Vulnerability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The CVSS vector string encoding the metric values used to compute the headline base score, e.g. &apos;CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:H/I:H/A:H&apos;.</skos:definition>
        <skos:prefLabel xml:lang="en">cvssVector</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#cweAbstractionLevel -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#cweAbstractionLevel">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Weakness"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The CWE abstraction level: Pillar, Class, Base, or Variant.</skos:definition>
        <skos:prefLabel xml:lang="en">cweAbstractionLevel</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#cweId -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#cweId">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#notation"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Weakness"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The CWE identifier in the format CWE-NNN.</skos:definition>
        <skos:prefLabel xml:lang="en">cweId</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The canonical form a person types and searches for. The source-native number (e.g. &apos;79&apos;) is cwe:cweId, which specializes stonework:externalId.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#dateAssigned -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#dateAssigned">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Vulnerability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <skos:definition xml:lang="en">The date and time at which a vulnerability identifier was assigned by the relevant numbering authority.</skos:definition>
        <skos:prefLabel xml:lang="en">dateAssigned</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Corresponds to cveMetadata.dateReserved in CVE JSON 5.x and equivalent assignment timestamps from other vulnerability sources. cve:dateAssigned is declared rdfs:subPropertyOf this property (one-way).</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#datePublic -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#datePublic">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Vulnerability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <skos:definition xml:lang="en">The date and time at which this vulnerability was publicly disclosed.</skos:definition>
        <skos:prefLabel xml:lang="en">datePublic</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Corresponds to cveMetadata.datePublished in CVE JSON 5.x and equivalent disclosure timestamps from other vulnerability sources. cve:datePublic is declared rdfs:subPropertyOf this property (one-way).</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#dateUpdated -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#dateUpdated">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Vulnerability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <skos:definition xml:lang="en">The date and time at which the vulnerability record was last modified in its source database.</skos:definition>
        <skos:prefLabel xml:lang="en">dateUpdated</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Corresponds to cveMetadata.dateUpdated in CVE JSON 5.x and equivalent update timestamps from other vulnerability sources. cve:dateUpdated is declared rdfs:subPropertyOf this property (one-way).</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#description -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#description">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/description"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <skos:definition xml:lang="en">A human-readable description of the described resource.</skos:definition>
        <skos:prefLabel xml:lang="en">description</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Domain is intentionally unset so framework-specific descriptions for vulnerabilities, weaknesses, attack patterns, and threat objects can share this canonical property. Prefer stonework:description in newly authored data.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#displayName -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#displayName">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#EmailAddress"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The display name associated with the email address.</skos:definition>
        <skos:prefLabel xml:lang="en">displayName</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#domainName -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#domainName">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Domain"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The fully qualified domain name string (e.g. malicious-site.com).</skos:definition>
        <skos:prefLabel xml:lang="en">domainName</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#dstPort -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#dstPort">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#NetworkTraffic"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedShort"/>
        <skos:definition xml:lang="en">The destination TCP/UDP port number.</skos:definition>
        <skos:prefLabel xml:lang="en">dstPort</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#emailValue -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#emailValue">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#EmailAddress"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The email address string (local@domain).</skos:definition>
        <skos:prefLabel xml:lang="en">emailValue</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#endedAtTime -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#endedAtTime">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#CyberActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#endedAtTime"/>
        <skos:definition xml:lang="en">The date and time at which a CyberActivity ended.</skos:definition>
        <skos:prefLabel>endedAtTime</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#epssScore -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#epssScore">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Vulnerability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <skos:definition xml:lang="en">The EPSS (Exploit Prediction Scoring System) score (0.0–1.0), estimating the probability of exploitation in the wild within 30 days.</skos:definition>
        <skos:prefLabel xml:lang="en">epssScore</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Convenience projection for a current score. Preserve dated values, source, and EPSS model version with stonework:MetricObservation and stonework:metricEpssScore.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#executablePath -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#executablePath">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#RuntimeProcess"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The filesystem path of the process executable image.</skos:definition>
        <skos:prefLabel xml:lang="en">executablePath</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#expirationDate -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#expirationDate">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Domain"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <skos:definition xml:lang="en">The date the domain registration expires.</skos:definition>
        <skos:prefLabel xml:lang="en">expirationDate</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#externalId -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#externalId">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/identifier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">An identifier from an external system or framework (e.g. STIX ID, MITRE ATT&amp;CK ID, NVD CVE ID).</skos:definition>
        <skos:prefLabel xml:lang="en">externalId</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Compatibility alias for dcterms:identifier when the value originates in an external system. Prefer dcterms:identifier when source context is already explicit.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#fileExtension -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#fileExtension">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#File"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The file extension without the leading dot (e.g. exe, dll, ps1).</skos:definition>
        <skos:prefLabel xml:lang="en">fileExtension</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#fileName -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#fileName">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#File"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The name of the file without path.</skos:definition>
        <skos:prefLabel xml:lang="en">fileName</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#filePath -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#filePath">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#File"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The full filesystem path of the file.</skos:definition>
        <skos:prefLabel xml:lang="en">filePath</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#fileSize -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#fileSize">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#File"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <skos:definition xml:lang="en">The size of the file in bytes.</skos:definition>
        <skos:prefLabel xml:lang="en">fileSize</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#firstSeen -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#firstSeen">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <skos:definition xml:lang="en">The timestamp when the entity was first observed.</skos:definition>
        <skos:prefLabel xml:lang="en">firstSeen</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Use with stonework:lastSeen to delimit an observation window. For the execution interval of a stonework:CyberActivity, use stonework:startedAtTime and stonework:endedAtTime instead.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#fqdn -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#fqdn">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Host"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The fully qualified domain name of the host.</skos:definition>
        <skos:prefLabel xml:lang="en">fqdn</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#groupName -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#groupName">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#UserGroup"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The name of the user group.</skos:definition>
        <skos:prefLabel xml:lang="en">groupName</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#guardLiteralValue -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#guardLiteralValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Transition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <skos:definition xml:lang="en">The literal value that guardVariable&apos;s bound value is compared against.</skos:definition>
        <skos:prefLabel>guardLiteralValue</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Compared using the operator given by stonework:guardOperator; if guardOperator is omitted, comparison defaults to Equals. Must share a compatible, numerically-typed datatype with the guardVariable&apos;s stonework:boundToLiteral value when an ordering operator is used.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hashAlgorithm -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#hashAlgorithm">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Hash"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The cryptographic hash algorithm used (e.g. MD5, SHA-1, SHA-256, SHA-512, SSDEEP).</skos:definition>
        <skos:prefLabel xml:lang="en">hashAlgorithm</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hashValue -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#hashValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Hash"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The hex-encoded digest produced by the hash algorithm.</skos:definition>
        <skos:prefLabel xml:lang="en">hashValue</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#hostname -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#hostname">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Host"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The system hostname or NetBIOS name.</skos:definition>
        <skos:prefLabel xml:lang="en">hostname</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#iban -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#iban">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#IBAN"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The IBAN string, including country prefix and check digits.</skos:definition>
        <skos:prefLabel xml:lang="en">iban</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#ipValue -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#ipValue">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#IPAddress"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The dotted-decimal or colon-hex string representation of the IP address.</skos:definition>
        <skos:prefLabel xml:lang="en">ipValue</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#ipVersion -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#ipVersion">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#IPAddress"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <skos:definition xml:lang="en">The IP protocol version: 4 or 6.</skos:definition>
        <skos:prefLabel xml:lang="en">ipVersion</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#isKnownExploited -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#isKnownExploited">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Vulnerability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <skos:definition xml:lang="en">Indicates whether this vulnerability appears in CISA&apos;s Known Exploited Vulnerabilities (KEV) catalog.</skos:definition>
        <skos:prefLabel xml:lang="en">isKnownExploited</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Convenience projection for a current catalog snapshot. A false value is only meaningful as of a specific time; preserve dated membership evidence with stonework:MetricObservation and stonework:metricKevMembership.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#isPacked -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#isPacked">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#MalwareSample"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <skos:definition xml:lang="en">Indicates whether the sample has been packed or obfuscated.</skos:definition>
        <skos:prefLabel xml:lang="en">isPacked</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#isPrivileged -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#isPrivileged">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#UserAccount"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <skos:definition xml:lang="en">Indicates whether the account has elevated or administrative privileges.</skos:definition>
        <skos:prefLabel xml:lang="en">isPrivileged</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#lastSeen -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#lastSeen">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <skos:definition xml:lang="en">The most recent timestamp when the entity was observed.</skos:definition>
        <skos:prefLabel xml:lang="en">lastSeen</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Use with stonework:firstSeen to delimit an observation window. For the execution interval of a stonework:CyberActivity, use stonework:startedAtTime and stonework:endedAtTime instead.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#latitude -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#latitude">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Location"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <skos:definition xml:lang="en">The geographic latitude in decimal degrees (WGS 84).</skos:definition>
        <skos:prefLabel xml:lang="en">latitude</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#lei -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#lei">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Organization"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The Legal Entity Identifier (ISO 17442) of this organization — a general legal-entity identifier applicable to any organization party to a financial transaction, not only financial institutions.</skos:definition>
        <skos:prefLabel xml:lang="en">lei</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#likelihoodScore -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#likelihoodScore">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Likelihood"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <skos:definition xml:lang="en">A numeric score (0.0–1.0) representing the estimated probability of occurrence.</skos:definition>
        <skos:prefLabel xml:lang="en">likelihoodScore</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Convenience projection for a current value. Use stonework:MetricObservation with stonework:metricLikelihoodScore when source, assessment time, or model version must be preserved.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#locationPrecision -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#locationPrecision">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Location"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <skos:definition xml:lang="en">The radius, in meters, of uncertainty around this Location&apos;s stonework:latitude and stonework:longitude.</skos:definition>
        <skos:prefLabel xml:lang="en">locationPrecision</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Corresponds to the STIX 2.1 Location precision property. Use it to distinguish an exact facility coordinate from a city- or region-level centroid, such as a geolocated IP address or an event geotagged from a news report. Omit it when the precision is unknown.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#logSource -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#logSource">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Log"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The system, component, or application that generated the log (e.g. Windows Security, syslog, Apache).</skos:definition>
        <skos:prefLabel xml:lang="en">logSource</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#longitude -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#longitude">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Location"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <skos:definition xml:lang="en">The geographic longitude in decimal degrees (WGS 84).</skos:definition>
        <skos:prefLabel xml:lang="en">longitude</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#metricValue -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#metricValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#MetricObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <skos:definition xml:lang="en">The typed literal value recorded by a MetricObservation.</skos:definition>
        <skos:prefLabel xml:lang="en">metricValue</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#mimeType -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#mimeType">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#File"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The MIME type of the file (e.g. application/x-executable, text/html).</skos:definition>
        <skos:prefLabel xml:lang="en">mimeType</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#minorUnitDigits -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#minorUnitDigits">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Currency"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <skos:definition xml:lang="en">The number of decimal places in the currency&apos;s minor unit — 0 for JPY, 2 for USD, 3 for BHD — as defined by ISO 4217 for fiat currencies.</skos:definition>
        <skos:prefLabel xml:lang="en">minorUnitDigits</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#modelVersion -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#modelVersion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#MetricObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The version identifier of the scoring, prediction, or assessment model that produced a metric observation.</skos:definition>
        <skos:prefLabel xml:lang="en">modelVersion</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#modified -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#modified">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/modified"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <skos:definition xml:lang="en">The timestamp when this individual was last modified.</skos:definition>
        <skos:prefLabel xml:lang="en">modified</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Compatibility alias for dcterms:modified. Prefer dcterms:modified in newly authored data.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#mutexName -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#mutexName">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Mutex"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The name string of the mutex object.</skos:definition>
        <skos:prefLabel xml:lang="en">mutexName</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#networkProtocol -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#networkProtocol">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#NetworkTraffic"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The network or transport protocol (e.g. TCP, UDP, ICMP, HTTP, DNS).</skos:definition>
        <skos:prefLabel xml:lang="en">networkProtocol</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#objective -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#objective">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Campaign"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Operation"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#ThreatActor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">A description of the strategic goal or objective being pursued.</skos:definition>
        <skos:prefLabel xml:lang="en">objective</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#observedAt -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#observedAt">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#MetricObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <skos:definition xml:lang="en">The date and time at which a metric observation was made or calculated.</skos:definition>
        <skos:prefLabel xml:lang="en">observedAt</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#osName -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#osName">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Host"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The name of the operating system running on the host (e.g. Windows, Linux, macOS).</skos:definition>
        <skos:prefLabel xml:lang="en">osName</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#osVersion -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#osVersion">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Host"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The version string of the operating system.</skos:definition>
        <skos:prefLabel xml:lang="en">osVersion</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#packerName -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#packerName">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#MalwareSample"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The name of the packer or obfuscator used (e.g. UPX, Themida).</skos:definition>
        <skos:prefLabel xml:lang="en">packerName</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#packetCount -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#packetCount">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#NetworkTraffic"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <skos:definition xml:lang="en">The total number of packets observed in the traffic flow.</skos:definition>
        <skos:prefLabel xml:lang="en">packetCount</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#parentPid -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#parentPid">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#RuntimeProcess"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <skos:definition xml:lang="en">The process identifier of the parent process.</skos:definition>
        <skos:prefLabel xml:lang="en">parentPid</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#phoneValue -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#phoneValue">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#PhoneNumber"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The phone number string in E.164 or local format.</skos:definition>
        <skos:prefLabel xml:lang="en">phoneValue</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#pid -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#pid">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#RuntimeProcess"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <skos:definition xml:lang="en">The process identifier assigned by the OS.</skos:definition>
        <skos:prefLabel xml:lang="en">pid</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#playbookFormat -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#playbookFormat">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Playbook"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The machine-readable format of the playbook (e.g. CACAO JSON, BPMN, YAML).</skos:definition>
        <skos:prefLabel xml:lang="en">playbookFormat</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#playbookVersion -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#playbookVersion">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Playbook"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The version string of the playbook.</skos:definition>
        <skos:prefLabel xml:lang="en">playbookVersion</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#port -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#port">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#NetworkService"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedShort"/>
        <skos:definition xml:lang="en">The TCP/UDP port number on which the service listens.</skos:definition>
        <skos:prefLabel xml:lang="en">port</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#postalCode -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#postalCode">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Location"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The postal or ZIP code of the location.</skos:definition>
        <skos:prefLabel xml:lang="en">postalCode</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#predictedLiteral -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#predictedLiteral">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Hypothesis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <skos:definition xml:lang="en">The scalar value a Hypothesis predicts its stonework:predictsVariable will be bound to, once executed.</skos:definition>
        <skos:prefLabel>predictedLiteral</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Mirrors stonework:boundToLiteral on the actual-result side; see stonework:predictedValue for predictions of an individual rather than a scalar.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#productName -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#productName">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Product"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The canonical product name.</skos:definition>
        <skos:prefLabel xml:lang="en">productName</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#publishedDate -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#publishedDate">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/issued"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <skos:definition xml:lang="en">The date the item was first publicly published or disclosed.</skos:definition>
        <skos:prefLabel xml:lang="en">publishedDate</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Compatibility alias for dcterms:issued. Prefer dcterms:issued in newly authored data.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#purl -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#purl">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#VersionedProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <skos:definition xml:lang="en">The Package URL (PURL) identifying this software package version.</skos:definition>
        <skos:prefLabel xml:lang="en">purl</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#rawEntry -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#rawEntry">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Log"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The raw, unprocessed log line or record.</skos:definition>
        <skos:prefLabel xml:lang="en">rawEntry</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#regionCode -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#regionCode">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Region"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The ISO 3166-2 region code (e.g. US-CA, GB-ENG).</skos:definition>
        <skos:prefLabel xml:lang="en">regionCode</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#registrationDate -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#registrationDate">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Domain"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <skos:definition xml:lang="en">The date and time when the domain was first registered.</skos:definition>
        <skos:prefLabel xml:lang="en">registrationDate</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Uses xsd:dateTime so source-native registration timestamps, including dns:registeredOn, can map without losing precision.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#registryKeyPath -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#registryKeyPath">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#RegistryKey"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The full registry key path (e.g. HKEY_LOCAL_MACHINE\SOFTWARE\...).</skos:definition>
        <skos:prefLabel xml:lang="en">registryKeyPath</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#registryValueData -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#registryValueData">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#RegistryValue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <skos:definition xml:lang="en">The typed literal data stored in the registry value.</skos:definition>
        <skos:prefLabel xml:lang="en">registryValueData</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The broad literal range preserves string, numeric, multi-string, and binary-valued source representations. Use stonework:registryValueType to record the Windows registry type explicitly.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#registryValueName -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#registryValueName">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#RegistryValue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The name of the registry value.</skos:definition>
        <skos:prefLabel xml:lang="en">registryValueName</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#registryValueType -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#registryValueType">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#RegistryValue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The type of the registry value (e.g. REG_SZ, REG_DWORD, REG_BINARY).</skos:definition>
        <skos:prefLabel xml:lang="en">registryValueType</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#relatedTechniqueIdentifier -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#relatedTechniqueIdentifier">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">A framework-native technique identifier string (e.g. a MITRE ATT&amp;CK technique ID such as &apos;T1003.001&apos;) carried on an entity from another framework, both for provenance and as the join key used to materialize the corresponding stonework:relatedAttackPattern or stonework:mitigatesAttackPattern edge.</skos:definition>
        <skos:prefLabel>relatedTechniqueIdentifier</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Domain intentionally left unset: populated on entities as different as capec:AttackPattern and cis:Control. Framework-specific subproperties (e.g. capec:attackTechniqueId, cis:mitigatesTechniqueId) carry the concrete literal. Retained after materialization — it records the source string as ingested, distinct from the resolved object-property edge.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#reliability -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#reliability">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#HumanSource"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Provenance"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The assessed reliability of the source (e.g. using the NATO Admiralty Code A–F).</skos:definition>
        <skos:prefLabel xml:lang="en">reliability</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#riskScore -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#riskScore">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <skos:definition xml:lang="en">A numeric risk score expressing combined impact and likelihood.</skos:definition>
        <skos:prefLabel xml:lang="en">riskScore</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Convenience projection for a current score. Use stonework:MetricObservation with stonework:metricRiskScore when methodology, source, model version, or assessment time must be preserved.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#ruleContent -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#ruleContent">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#DetectionRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The full text content of the detection rule.</skos:definition>
        <skos:prefLabel xml:lang="en">ruleContent</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#ruleFormat -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#ruleFormat">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#DetectionRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The format or language of the rule (e.g. YARA, Sigma, Snort, KQL, SPL).</skos:definition>
        <skos:prefLabel xml:lang="en">ruleFormat</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#ruleName -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#ruleName">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#DetectionRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The human-readable name of the detection rule.</skos:definition>
        <skos:prefLabel xml:lang="en">ruleName</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#ruleVersion -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#ruleVersion">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#DetectionRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The version string of the detection rule.</skos:definition>
        <skos:prefLabel xml:lang="en">ruleVersion</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#serialNumber -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#serialNumber">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition>A globally unique identifier for a BOM document, typically expressed as a URN UUID (e.g. urn:uuid:...) per the CycloneDX specification or as a document namespace per SPDX.</skos:definition>
        <skos:prefLabel>serial number</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Domain intentionally left unset. Primary subject is stonework:SoftwareBillOfMaterials. Use dcterms:created for the BOM timestamp.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#serviceBanner -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#serviceBanner">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#NetworkService"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The banner string returned by the service upon connection.</skos:definition>
        <skos:prefLabel xml:lang="en">serviceBanner</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#serviceName -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#serviceName">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#NetworkService"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The name of the network service (e.g. HTTP, SSH, RDP, SMB).</skos:definition>
        <skos:prefLabel xml:lang="en">serviceName</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#serviceProtocol -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#serviceProtocol">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#NetworkService"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The transport protocol used by the service (e.g. TCP, UDP).</skos:definition>
        <skos:prefLabel xml:lang="en">serviceProtocol</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#serviceVersion -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#serviceVersion">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#NetworkService"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The version string of the service software.</skos:definition>
        <skos:prefLabel xml:lang="en">serviceVersion</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#severity -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#severity">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Event"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Incident"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The assessed severity of the incident or event (e.g. critical, high, medium, low, informational).</skos:definition>
        <skos:prefLabel xml:lang="en">severity</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#sightingCount -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#sightingCount">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Sighting"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <skos:definition xml:lang="en">The number of times the sighted object was observed.</skos:definition>
        <skos:prefLabel xml:lang="en">sightingCount</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#srcPort -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#srcPort">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#NetworkTraffic"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedShort"/>
        <skos:definition xml:lang="en">The source TCP/UDP port number.</skos:definition>
        <skos:prefLabel xml:lang="en">srcPort</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#startedAtTime -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#startedAtTime">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#CyberActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#startedAtTime"/>
        <skos:definition xml:lang="en">The date and time at which a CyberActivity began.</skos:definition>
        <skos:prefLabel>startedAtTime</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#stepOrder -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#stepOrder">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Step"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <skos:definition xml:lang="en">An optional ordinal position for a Step within a strictly linear Behavior, where the full precededByStep graph is unnecessary.</skos:definition>
        <skos:prefLabel>stepOrder</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Most CTI procedure write-ups (a numbered list of adversary actions) are linear. stepOrder is a low-overhead alternative to precededByStep for that common case; the two are not mutually exclusive.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#streetAddress -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#streetAddress">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Location"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The street address of the location, such as a building number and street name.</skos:definition>
        <skos:prefLabel xml:lang="en">streetAddress</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Corresponds to the STIX 2.1 Location street_address property. Record the postal code with stonework:postalCode and the enclosing City, Region, or Country with stonework:locatedWithin rather than repeating them in this string.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#summary -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#summary">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/abstract"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#IntelligenceProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">A brief summary of the intelligence product&apos;s key findings.</skos:definition>
        <skos:prefLabel xml:lang="en">summary</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#timestamp -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#timestamp">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <skos:definition xml:lang="en">The date and time at which this observation or event occurred.</skos:definition>
        <skos:prefLabel xml:lang="en">timestamp</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Domain is intentionally unset for point-in-time records. Use stonework:firstSeen and stonework:lastSeen for observation windows, and stonework:startedAtTime and stonework:endedAtTime for CyberActivity execution intervals.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#title -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#title">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/title"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <skos:definition xml:lang="en">A human-readable title for the described resource.</skos:definition>
        <skos:prefLabel xml:lang="en">title</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Domain is intentionally unset so framework-specific titles for controls, products, publications, and intelligence products can share this canonical property. Prefer dcterms:title in newly authored data.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#transactionAmount -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#transactionAmount">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#FinancialTransaction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <skos:definition xml:lang="en">Convenience projection of the magnitude of a single-denomination transaction&apos;s stonework:MonetaryAmount, paired with stonework:transactionCurrency.</skos:definition>
        <skos:prefLabel xml:lang="en">transactionAmount</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Do not use for a currency exchange with distinct input and output amounts; use stonework:originatorMonetaryValue and stonework:beneficiaryMonetaryValue instead.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#transactionReference -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#transactionReference">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#FinancialTransaction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">A reference string carried by this transaction — a wire reference or end-to-end identifier, a payment memo, or an on-chain transaction hash.</skos:definition>
        <skos:prefLabel xml:lang="en">transactionReference</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#updateFrequency -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#updateFrequency">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Feed"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">How often the feed is updated (e.g. hourly, daily, real-time).</skos:definition>
        <skos:prefLabel xml:lang="en">updateFrequency</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#uriValue -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#uriValue">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#URI"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <skos:definition xml:lang="en">The full URI string conforming to RFC 3986.</skos:definition>
        <skos:prefLabel xml:lang="en">uriValue</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#url -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#url">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Feed"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#OnlineReference"/>
                    <rdf:Description rdf:about="https://cyberterrain.org/ns/stonework#Publication"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <skos:definition xml:lang="en">The URL of the online resource.</skos:definition>
        <skos:prefLabel xml:lang="en">url</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#userAgentString -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#userAgentString">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#UserAgent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The raw HTTP User-Agent header string.</skos:definition>
        <skos:prefLabel xml:lang="en">userAgentString</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#validFrom -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#validFrom">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#QualifiedAssertion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <skos:definition xml:lang="en">The start of the interval during which a qualified assertion is considered applicable.</skos:definition>
        <skos:prefLabel xml:lang="en">validFrom</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#validUntil -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#validUntil">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#QualifiedAssertion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <skos:definition xml:lang="en">The end of the interval during which a qualified assertion is considered applicable.</skos:definition>
        <skos:prefLabel xml:lang="en">validUntil</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#variableName -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#variableName">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Variable"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">A short name identifying a Variable within the scope of its declaring Behavior, allowing it to be referenced consistently across Steps and Transitions.</skos:definition>
        <skos:prefLabel>variableName</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#version -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#version">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#VersionedProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The version string for this specific product release.</skos:definition>
        <skos:prefLabel xml:lang="en">version</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#vulnerabilityId -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#vulnerabilityId">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#Vulnerability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The canonical identifier assigned to this vulnerability by its originating numbering authority, e.g. &apos;CVE-2021-44228&apos;, &apos;GHSA-jfh8-c2jp-hdp9&apos;, or &apos;OSV-2021-1&apos;.</skos:definition>
        <skos:prefLabel xml:lang="en">vulnerabilityId</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Identifier-specific core properties such as stonework:cveId are declared as subproperties (and source-native framework aliases such as cve:cveId are declared subproperties of those), enabling cross-source queries on a single predicate. Each vulnerability record SHOULD carry exactly one identifier from its primary numbering authority.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://cyberterrain.org/ns/stonework#walletAddress -->


    <owl:DatatypeProperty rdf:about="https://cyberterrain.org/ns/stonework#walletAddress">
        <rdfs:domain rdf:resource="https://cyberterrain.org/ns/stonework#CryptoAddress"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">The on-chain address string (e.g. a Bitcoin or Ethereum address).</skos:definition>
        <skos:prefLabel xml:lang="en">walletAddress</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Resolve the address&apos;s asset through ^stonework:hasIdentifier/stonework:accountCurrency and then its ledger through stonework:blockchainNetwork on a stonework:CryptoAsset. Do not rely on the address string alone to identify the asset or network.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2000/01/rdf-schema#Class -->


    <owl:Class rdf:about="http://www.w3.org/2000/01/rdf-schema#Class"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#Concept -->


    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#ConceptScheme -->


    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    


    <!-- https://cyberterrain.org/ns/stonework#AIAgent -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#AIAgent">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <skos:definition>An autonomous or semi-autonomous system driven by AI/ML that can act, make decisions, or be attributed responsibility in a cyber or sociotechnical context.</skos:definition>
        <skos:prefLabel>AI Agent</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Covers both offensive uses (AI-assisted or autonomous threat actors) and defensive uses (AI-driven detection, response, or hunting systems). Distinct from Tool — an AIAgent has a degree of autonomous decision-making rather than being a passively invoked artifact.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#AITechnique -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#AITechnique">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Technique"/>
        <skos:definition xml:lang="en">A specific method by which adversaries attack AI/ML systems (e.g., training data poisoning, adversarial examples, model extraction).</skos:definition>
        <skos:prefLabel xml:lang="en">AI Technique</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#AccessControlList -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#AccessControlList">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#DigitalArtifact"/>
        <skos:definition xml:lang="en">A structured list of access control entries (ACEs) that governs which principals (users, groups, or system accounts) are permitted or denied specific operations on a resource.</skos:definition>
        <skos:prefLabel xml:lang="en">Access Control List</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Applies across filesystems, operating system objects (registry keys, processes), network devices (firewall rules), cloud IAM policies, and APIs. In a CTI context, adversaries frequently modify ACLs to establish persistence, escalate privileges, or deny defenders access to compromised resources. Framework-specific extensions (e.g. Windows DACL/SACL structure) are modeled at the framework layer.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Account -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Account">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#DigitalIdentity"/>
        <skos:definition xml:lang="en">A named account held by an Agent with a provider — an authenticated-access identity, a value-holding ledger position, or both aspects together — identified by one or more Identifiers and optionally attributed to a known Agent.</skos:definition>
        <skos:prefLabel xml:lang="en">Account</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Abstract parent of stonework:UserAccount (authenticated access) and stonework:FinancialAccount (value custody and movement). It exists chiefly to give stonework:hasAccount and stonework:accountOf a range spanning both without widening to every DigitalIdentity. A single real-world account often has both natures; model them as two individuals linked by stonework:controls rather than one individual of both types, since one login commonly governs several ledgers.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#AccountType -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#AccountType">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://cyberterrain.org/ns/stonework#accountTypeScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">A classification of a user account by its authentication or deployment context.</skos:definition>
        <skos:prefLabel xml:lang="en">Account Type</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Actuator -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Actuator">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#PhysicalArtifact"/>
        <skos:definition xml:lang="en">A physical device that effects a change in a physical process or plant — for example a valve, motor, relay, or servo — as distinct from a cyber security safeguard mechanism.</skos:definition>
        <skos:prefLabel xml:lang="en">Actuator</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Use for ICS and OT field devices that act on a physical process. Distinct from stonework:SecurityActuator, which is deployed infrastructure that applies a countermeasure. A PLC or motor starter is an Actuator; an EDR agent or firewall is a SecurityActuator. An ICS device that also runs processes and participates in networks may additionally be typed as stonework:Host.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Agent -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Agent">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <skos:definition xml:lang="en">Any entity that can act, perform actions, or be attributed responsibility in a cyber or sociotechnical context.</skos:definition>
        <skos:prefLabel>Agent</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Covers AI, human individuals, groups, organizations, and other actors (e.g. threat actors, vendors, government bodies). Used as the top-level superclass for identity-related objects in alignment with STIX Identity.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Analysis -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Analysis">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#IntelligenceProduct"/>
        <skos:definition xml:lang="en">A systematic examination of a cyber entity, artifact, or event that produces structured findings about its nature, behavior, or properties.</skos:definition>
        <skos:prefLabel xml:lang="en">Analysis</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Sibling to stonework:Assessment under IntelligenceProduct. Where Assessment answers &apos;how bad/likely/risky?&apos;, Analysis answers &apos;what is it and what does it do?&apos; Superclass for domain-specific analyses such as MalwareAnalysis. Aligns with STIX MalwareAnalysis SDO at the subclass level.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#AnalyticTechnique -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#AnalyticTechnique">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Technique"/>
        <skos:definition xml:lang="en">A prescribed analytical method used to process, evaluate, or reason over data to produce intelligence, detections, or assessments.</skos:definition>
        <skos:prefLabel>Analytic Technique</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Covers structured analytic techniques (e.g., analysis of competing hypotheses, kill chain analysis, diamond model analysis) and computational analytic methods (e.g., clustering, anomaly detection). Distinct from DetectionRule — an AnalyticTechnique describes the method; a DetectionRule is a deployable artifact implementing it.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Assessment -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Assessment">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#IntelligenceProduct"/>
        <skos:definition xml:lang="en">A structured knowledge artifact capturing the evaluation, analysis, or estimation of risk, likelihood, impact, or other security-relevant attributes.</skos:definition>
        <skos:prefLabel>Assessment</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Covers risk assessments, vulnerability assessments, and impact analyses. Assessment is an Information artifact — the output of an evaluative process — not the process itself. The process producing an Assessment may be modeled as a stonework:Process or stonework:Investigation.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#AttackPattern -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#AttackPattern">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Behavior"/>
        <skos:definition xml:lang="en">A type of Tactics, Techniques, and Procedures (TTP) that describes ways that adversaries attempt to compromise targets. Often maps to MITRE ATT&amp;CK techniques.</skos:definition>
        <skos:prefLabel xml:lang="en">Attack Pattern</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The abstract concept spanning framework-specific shapes that are not structurally identical: CAPEC&apos;s shape (capec:AttackPattern) is a taxonomy entry with severity/likelihood/prerequisite fields; MITRE ATT&amp;CK&apos;s shape (stonework:AttackTechnique) is an operationalized technique with sub-techniques, procedures, mitigations, and detections. Both are AttackPatterns; stonework:relatedAttackPattern links instances across shapes that describe the same underlying technique.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#AttackTechnique -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#AttackTechnique">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#AttackPattern"/>
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberTechnique"/>
        <skos:definition xml:lang="en">A prescribed offensive method used by an adversary to achieve a specific tactical objective within a target environment.</skos:definition>
        <skos:prefLabel xml:lang="en">Attack Technique</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Aligns with MITRE ATT&amp;CK techniques and D3FEND OffensiveTechnique. The MITRE ATT&amp;CK-shaped realization of stonework:AttackPattern — operationalized for execution, as distinct from CAPEC&apos;s more abstract taxonomy-entry shape (capec:AttackPattern, also a stonework:AttackPattern). Framework-specific subclasses (e.g. attack:Technique) provide the concrete individuals. A specific, concrete realization of this technique is modeled as a stonework:Procedure, linked back via stonework:implementedBy.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#AutonomousSystem -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#AutonomousSystem">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Infrastructure"/>
        <skos:definition>Represents an Autonomous System (AS), a collection of IP routing prefixes under the control of a single administrative entity, identified by its AS number.</skos:definition>
        <skos:prefLabel xml:lang="en">Autonomous System</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#BankAccountNumber -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#BankAccountNumber">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Identifier"/>
        <skos:definition xml:lang="en">A domestic bank account number as issued under a national scheme, without IBAN normalization.</skos:definition>
        <skos:prefLabel xml:lang="en">Bank Account Number</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The value is stonework:accountNumber. The routing context (US ABA routing number, UK sort code) is recorded on the holding stonework:FinancialInstitution via stonework:abaRoutingNumber or an equivalent, not on this identifier.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Behavior -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Behavior">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <skos:definition xml:lang="en">A pattern of actions or methods characteristic of an entity, particularly adversaries.</skos:definition>
        <skos:prefLabel>Behavior</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Groups TTP-related classes: Tactic, Technique (and subclasses), and Procedure. In BFO terms, Behaviors are GenericallyDependentContinuants — specifications or patterns describing how actions are carried out. The execution of a Technique is a CyberActivity; the Technique itself is a Behavior. Aligns with IAO PlanSpecification.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#BomEntry -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#BomEntry">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#ComponentContext"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://cyberterrain.org/ns/stonework#installationOf"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://cyberterrain.org/ns/stonework#VersionedProduct"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">BomEntry is the STONEWORK representation of a CycloneDX component element or SPDX package entry. It links a VersionedProduct into the context of a particular SBOM document via stonework:installationOf, and may carry component-specific metadata (PURL, license, hash, component type) that does not belong on the VersionedProduct itself.</rdfs:comment>
        <skos:definition xml:lang="en">A single component entry within a Software Bill of Materials, asserting that a specific VersionedProduct is included in the artifact or system described by the SBOM.</skos:definition>
        <skos:prefLabel>BOM Entry</skos:prefLabel>
        <skos:scopeNote xml:lang="en">An SBOM import creates one BomEntry per declared component. The BomEntry IRI is scoped to the SBOM (e.g. &lt;sbom-iri/entry/&lt;component-ref&gt;&gt;). Multiple BomEntry instances across different SBOMs may reference the same VersionedProduct via stonework:installationOf.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Campaign -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Campaign">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberActivity"/>
        <skos:definition>A grouping of adversary behaviours and resources with a common objective pursued over a period of time. Campaigns may be attributed to ThreatActors and may form part of a broader CyberActivityCluster.</skos:definition>
        <skos:prefLabel xml:lang="en">Campaign</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A Campaign is organized around an objective and time period, while a CyberActivityCluster is organized by analytic correlation. A Campaign that is one episode within a broader activity cluster is linked to it with stonework:memberOfActivityCluster. The same body of activity may be typed as both classes when both descriptions apply.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Category -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Category">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">A classification or tagging concept used to group or qualify other individuals in a particular context.</skos:definition>
        <skos:prefLabel xml:lang="en">Category</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Categories are reified so they can be referenced, versioned, or scoped. They are not rigid types.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Certificate -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Certificate">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#DigitalArtifact"/>
        <skos:definition xml:lang="en">A structured digital document binding a public key to an identity, issued and signed by a certificate authority. Used for authentication, encryption, and trust establishment in networked systems.</skos:definition>
        <skos:prefLabel xml:lang="en">Certificate</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Primarily represents X.509 certificates. May be used to cluster infrastructure sharing the same certificate or to link observed TLS/SSL artifacts to their issuing authority. Referenced by stonework:sharesCertificate on Infrastructure. Represent certificate fingerprints through stonework:hasHash and a stonework:Hash individual rather than algorithm-specific fingerprint literals.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#City -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#City">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Location"/>
        <skos:definition>A significant urban settlement, municipality, or metropolitan area.</skos:definition>
        <skos:prefLabel>City</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#ComparisonOperator -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#ComparisonOperator">
        <skos:definition xml:lang="en">A controlled vocabulary of operators used to compare a Variable&apos;s bound value against a threshold in a Transition guard.</skos:definition>
        <skos:prefLabel>Comparison Operator</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Individuals are stonework:Equals, stonework:NotEquals, stonework:LessThan, stonework:LessThanOrEqual, stonework:GreaterThan, and stonework:GreaterThanOrEqual. Referenced by stonework:guardOperator; omitting an operator on a guard defaults to Equals semantics.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#ComponentContext -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#ComponentContext">
        <skos:definition xml:lang="en">An abstract class representing a context-specific reference to a VersionedProduct: the same product version appears differently depending on whether it is declared in a bill of materials or observed as a running installation on a specific system.</skos:definition>
        <skos:prefLabel>Component Context</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Subclassed by stonework:BomEntry (declarative — listed in an SBOM document), stonework:ProductInstallation (observational — verified deployment via SWID tag or scan), and framework-specific subclasses such as cve:AffectedProduct (advisory — named in a source vulnerability record, possibly against several VersionedProduct individuals at once). Unifies these evidence bases under a single superclass so that stonework:installationOf can span all of them without domain restrictions forcing incorrect inferences. BomEntry and ProductInstallation are additionally restricted to at most one installationOf value each; ComponentContext itself imposes no such limit, since not every subclass shares that one-to-one shape.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Control -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Control">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Behavior"/>
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Countermeasure"/>
        <rdfs:comment>Instances of stonework:Control may represent individual controls, control enhancements, or sub‑controls. Framework‑specific identifiers (e.g., &quot;AC‑2&quot;, &quot;CIS 4.1&quot;) SHOULD be modeled using explicit properties rather than encoded in the class IRI. Control text SHOULD be referenced via citations rather than reproduced verbatim.</rdfs:comment>
        <skos:definition>A prescribed security or privacy safeguard that specifies an action, capability, or condition intended to reduce risk, enforce policy, or achieve a defined protection objective within an information system or organization.</skos:definition>
        <skos:prefLabel>Control</skos:prefLabel>
        <skos:scopeNote>This class provides a semantic representation of security and privacy controls from frameworks such as NIST SP 800‑53 and the CIS Controls. It supports mapping to external control identifiers and families without embedding copyrighted control text.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#ControlPlan -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#ControlPlan">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Behavior"/>
        <skos:definition xml:lang="en">A concrete, Step-decomposed sequence of actions that implements a Control in a specific operational context.</skos:definition>
        <skos:prefLabel>Control Plan</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Mirrors the Technique/Procedure split on the defensive side: stonework:Control is the abstract prescribed safeguard (a catalog entry, e.g. NIST AC-2 or a CIS control); ControlPlan is its concrete implementation as a Step sequence, linked back via stonework:implements. A ControlPlan is typically invoked from within a Playbook or DetectionPlan by a Step that stonework:implements it.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Countermeasure -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Countermeasure">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <skos:definition xml:lang="en">Any control, mitigation, or safeguard applied to protect against, reduce, or respond to security risks.</skos:definition>
        <skos:prefLabel>Countermeasure</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Includes Controls, Mitigations, CoursesOfAction, and DetectionRules. The two primary branches are preventive/reactive measures (Mitigation, CourseOfAction, Control) and detection logic (DetectionRule, Signature). A Countermeasure describes the safeguard or procedure; the deployed mechanism that can apply it is a stonework:SecurityActuator, and a particular application is a stonework:SecurityActuation.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Country -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Country">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Location"/>
        <skos:definition>A sovereign state or top-level administrative entity recognized internationally.</skos:definition>
        <skos:prefLabel>Country</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#CourseOfAction -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#CourseOfAction">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Mitigation"/>
        <skos:definition xml:lang="en">A specific, contextualized recommended action or set of steps to prevent or respond to a threat, attack, or incident.</skos:definition>
        <skos:prefLabel xml:lang="en">Course of Action</skos:prefLabel>
        <skos:scopeNote xml:lang="en">More prescriptive and situational than a general Mitigation — a CourseOfAction packages guidance for a specific threat context. Corresponds to the STIX 2.1 CourseOfAction SDO. General reusable controls (e.g. ATT&amp;CK mitigations) are modeled as Mitigation; specific incident response actions are CourseOfAction.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#CryptoAddress -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#CryptoAddress">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Identifier"/>
        <skos:definition xml:lang="en">An on-chain address that identifies a destination for value on a distributed ledger.</skos:definition>
        <skos:prefLabel xml:lang="en">Crypto Address</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The address string is stonework:walletAddress. Attach a CryptoAddress to the wallet it identifies, a stonework:FinancialAccount, with stonework:hasIdentifier; the address&apos;s asset and network are then traversable through ^stonework:hasIdentifier/stonework:accountCurrency and stonework:blockchainNetwork. Sibling of stonework:EmailAddress and stonework:MACAddress.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#CryptoAsset -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#CryptoAsset">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Currency"/>
        <skos:altLabel xml:lang="en">virtual asset</skos:altLabel>
        <skos:definition xml:lang="en">A cryptocurrency, stablecoin, or other token that serves as a unit of value on a distributed ledger.</skos:definition>
        <skos:prefLabel xml:lang="en">Crypto Asset</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Instances are the assets themselves (e.g. Bitcoin, Ether, a specific ERC-20 token) — not wallets, addresses, or holdings. A wallet is modeled as a stonework:FinancialAccount and its address as a stonework:CryptoAddress; an amount of a crypto asset is a stonework:MonetaryAmount whose stonework:currency is the CryptoAsset. The same nominal token issued on multiple ledgers is modeled as distinct individuals distinguished by stonework:blockchainNetwork. &apos;Virtual asset&apos; is the FATF term; a service that custodies or exchanges them is a virtual asset service provider (stonework:FinancialInstitution categorized accordingly).</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Currency -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Currency">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <skos:definition xml:lang="en">A unit in which monetary value is denominated — a fiat currency or a crypto asset.</skos:definition>
        <skos:prefLabel xml:lang="en">Currency</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The range of stonework:currency on stonework:MonetaryAmount. Fiat units are supplied as a closed controlled vocabulary in stonework:fiatCurrencyScheme (ISO 4217). Crypto units are stonework:CryptoAsset individuals, created as needed rather than pre-enumerated. Currency itself carries no instances directly.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#CvssMetric -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#CvssMetric">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Assessment"/>
        <skos:definition xml:lang="en">A structured technical-severity assessment of a vulnerability using the Common Vulnerability Scoring System, carrying a version, vector, base score, and qualitative severity.</skos:definition>
        <skos:prefLabel xml:lang="en">CVSS Metric</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Use stonework:hasCvssMetric to attach one or more source-specific assessments to a Vulnerability. Identify the scoring authority with stonework:createdBy and preserve the source record with stonework:hasProvenance. The direct stonework:cvssBaseScore, stonework:cvssSeverity, and stonework:cvssVector properties are query-friendly headline projections. CVSS base metrics are context-neutral; environmental metrics may adjust technical severity for a deployment context, but CVSS does not establish whether the vulnerable product is present or constitute a full enterprise risk assessment. Use stonework:VulnerabilityAssessment for that contextual judgment. A plan that calculates or consumes a CVSS assessment may bind a Variable to this assessment, but the Variable is an execution-time value and does not replace the vulnerability-to-metric relationship.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#CyberActivity -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#CyberActivity">
        <skos:definition xml:lang="en">A specific occurrence or performance of actions by one or more agents over time within a cyber or sociotechnical context.</skos:definition>
        <skos:prefLabel>Cyber Activity</skos:prefLabel>
        <skos:scopeNote xml:lang="en">One of two root classes in STONEWORK alongside CyberEntity. Superclass for Campaigns, CyberActivityClusters, Incidents, Operations, Events, and Processes. Aligns with BFO Occurrent and BFO Process.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#CyberActivityCluster -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#CyberActivityCluster">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberActivity"/>
        <skos:definition xml:lang="en">An analytically identified aggregate of cyber activities grouped because available evidence suggests a common source, mechanism, or operational thread.</skos:definition>
        <skos:prefLabel xml:lang="en">Cyber Activity Cluster</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A CyberActivityCluster is unified by analytic correlation rather than the objective and time period of a Campaign, the unified command or intent of an Operation, the execution sequence of a Process, or the inquiry purpose of an Investigation. It does not require a known objective, responsible Agent, precise boundaries, or a conclusion that the activity is adversarial. It denotes the body of activity believed to be related, not the intelligence artifact recording that judgment; use stonework:Grouping, stonework:Report, or stonework:Assessment for the artifact. Only CyberActivity instances are members through stonework:memberOfActivityCluster and stonework:hasMemberActivity; relate tools, malware, infrastructure, and responsible participants through their specific relationships. The STIX adapter maps its narrower intrusion-set source class to CyberActivityCluster.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#CyberEntity -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#CyberEntity">
        <skos:definition xml:lang="en">Any concept, object, or resource that exists or operates within a cyber or sociotechnical domain.</skos:definition>
        <skos:prefLabel>Cyber Entity</skos:prefLabel>
        <skos:scopeNote xml:lang="en">One of two root classes in STONEWORK. Groups all persistent entities — Agents, Infrastructure, DigitalArtifacts, PhysicalArtifacts, Behaviors, IntelligenceProducts, SecurityConditions, RiskFactors, Countermeasures, and related classes. Aligns with BFO Continuant. The sibling root class CyberActivity covers happenings (Campaigns, Incidents, Operations, etc.).</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#CyberTechnique -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#CyberTechnique">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Technique"/>
        <skos:definition>A technique performed within or against cyberspace, encompassing both offensive and defensive cyber operations.</skos:definition>
        <skos:prefLabel>Cyber Technique</skos:prefLabel>
        <skos:scopeNote>Mirrors D3FEND&apos;s CyberTechnique class. Subclassed by stonework:AttackTechnique (offensive) and stonework:DefendTechnique (defensive), enabling a single property chain to span both ATT&amp;CK and D3FEND individuals.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#DataAsset -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#DataAsset">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <skos:definition xml:lang="en">A defender-owned collection of data or information with organizational value, such as databases, intellectual property, credentials stores, or PII collections.</skos:definition>
        <skos:prefLabel>Data Asset</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Represents data as a targetable resource distinct from the systems that store or process it. Used to model what adversaries seek to access, exfiltrate, or destroy rather than the infrastructure they exploit to reach it.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#DefendTechnique -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#DefendTechnique">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberTechnique"/>
        <skos:definition>A prescribed defensive method used to detect, prevent, or respond to adversary behavior within a target environment.</skos:definition>
        <skos:prefLabel>Defend Technique</skos:prefLabel>
        <skos:scopeNote>Aligns with MITRE D3FEND DefensiveTechnique. Framework-specific subclasses (e.g. d3fend:DefensiveTechnique) extend this class when D3FEND data is loaded.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#DefensiveTactic -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#DefensiveTactic">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Tactic"/>
        <skos:definition>A high-level defensive objective that groups related countermeasure techniques by the protection goal they serve.</skos:definition>
        <skos:prefLabel>Defensive Tactic</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Aligns with MITRE D3FEND defensive tactics (e.g. Harden, Detect, Isolate, Evict, Restore). Individuals are typically drawn from D3FEND or similar defensive frameworks via the framework mapping layer.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#DetectionPlan -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#DetectionPlan">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#InvestigationPlan"/>
        <skos:definition xml:lang="en">A Step-decomposed sequence of actions for determining whether observed activity constitutes a security-relevant violation, as distinct from the offensive or defensive action plans that respond to one.</skos:definition>
        <skos:prefLabel>Detection Plan</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A specialization of stonework:InvestigationPlan narrowly scoped to violation triage: orchestrating DetectionRule/Signature evaluation and analytic logic to identify whether a violation occurred, typically triggering a defensive Playbook or ControlPlan via a guarded Transition once one is confirmed. Where a Playbook is an action plan carried out by an interested party — offensive (an adversary&apos;s operational playbook) or defensive (an incident responder&apos;s playbook) — a DetectionPlan plays a neutral, evaluative role, watching for the kind of changes an InvestigationPlan more broadly investigates.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#DetectionRule -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#DetectionRule">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Countermeasure"/>
        <skos:definition xml:lang="en">A structured, machine-readable rule designed to detect malicious or suspicious activity, techniques, or indicators. It may be signature-based, behavioral, correlation-based, or analytic.</skos:definition>
        <skos:prefLabel>Detection Rule</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Encompasses pattern-matching signatures (YARA, Snort, Suricata), behavioral rules (Sigma), SIEM correlation logic, and analytic detections. Signature is a subclass for content-centric, indicator-matching rules.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#DigitalArtifact -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#DigitalArtifact">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <skos:definition xml:lang="en">Any discrete digital object or content entity that can be observed, transmitted, stored, or acted upon in a cyber environment.</skos:definition>
        <skos:prefLabel>Digital Artifact</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Includes files, hashes, malware samples, network traffic captures, and other content-bearing items. Aligns with D3FEND DigitalArtifact concepts. Sibling of stonework:PhysicalArtifact.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#DigitalIdentity -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#DigitalIdentity">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <skos:definition>A digital representation or persona of an Agent, inferred from one or more identifiers (email, phone, account, etc.). It may or may not be attributed to a known real-world Agent.</skos:definition>
        <skos:prefLabel>Digital Identity</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Useful when you observe identifiers without confirmed attribution. Can aggregate multiple Identifiers and later be linked to a real-worldAgent.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Directory -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Directory">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#DigitalArtifact"/>
        <skos:prefLabel>Directory</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Domain -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Domain">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Infrastructure"/>
        <skos:definition>Represents a network domain name. Can reference the IP addresses it resolves to.</skos:definition>
        <skos:prefLabel xml:lang="en">Domain</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#EmailAddress -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#EmailAddress">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Identifier"/>
        <skos:definition>Represents a single email address, optionally associating it with a display name and a user account.</skos:definition>
        <skos:prefLabel xml:lang="en">Email Address</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#EmailMessage -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#EmailMessage">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#DigitalArtifact"/>
        <skos:definition xml:lang="en">A discrete email communication, including headers, body content, and optional attachments, transmitted over an email protocol.</skos:definition>
        <skos:prefLabel xml:lang="en">Email Message</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Distinct from stonework:EmailAddress, which represents the sender/recipient identifier. An EmailMessage is the content artifact itself. Used to represent phishing lures, spear-phishing emails, or other email-borne threat delivery mechanisms. Corresponds to STIX EmailMessage SCO.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Event -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Event">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberActivity"/>
        <skos:definition xml:lang="en">An atomic, observable occurrence in a system, network, or environment that has potential security relevance but has not yet been assessed or declared as an Incident.</skos:definition>
        <skos:prefLabel xml:lang="en">Event</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Represents the pre-triage state — a raw log entry, alert, or sensor observation. Distinguished from Incident by the absence of human or automated assessment declaring it significant and adverse. Useful for SIEM, log-based, and threat hunting use cases.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#FalsePositiveRate -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#FalsePositiveRate">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://cyberterrain.org/ns/stonework#falsePositiveRateScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">An ordinal classification of the expected false-positive frequency of a detection rule.</skos:definition>
        <skos:prefLabel xml:lang="en">False Positive Rate</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Feed -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Feed">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Provenance"/>
        <skos:definition>A structured data source that provides indicators, intelligence, or enrichment data on a regular or continuous basis.</skos:definition>
        <skos:prefLabel>Feed</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Examples: URLHaus, AlienVault OTX, Abuse.ch, commercial threat feeds, etc.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#File -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#File">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#DigitalArtifact"/>
        <skos:definition xml:lang="en">A discrete unit of data stored on a filesystem, identified by name, path, and cryptographic hash. Includes executable binaries, scripts, documents, archives, and other file types relevant to cyber threat analysis.</skos:definition>
        <skos:prefLabel xml:lang="en">File</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Linked to hash values via stonework:hasHash. A MalwareSample may be associated with its File representation. Framework-specific extensions (PE headers, NTFS streams, archive contents) are modeled at the framework layer.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#FinancialAccount -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#FinancialAccount">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Account"/>
        <skos:definition xml:lang="en">An account that can hold a balance of, or transfer, economic value — fiat currency, cryptocurrency, or monetary-equivalent stored value such as gift-card credit, gaming currency, or loyalty points redeemable for goods.</skos:definition>
        <skos:prefLabel xml:lang="en">Financial Account</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Defined by function, not by the holder: an account at a regulated bank, brokerage, or exchange and a stored-value balance at a non-financial merchant are both FinancialAccounts. Whether it is held at a regulated institution is recorded with the optional stonework:heldAt link, not by the class. Account kind (checking, custodial wallet, prepaid card, exchange account) is asserted with stonework:categorizedBy a stonework:FinancialAccountType. Identifiers such as an IBAN, domestic account number, or crypto address attach with stonework:hasIdentifier. Use stonework:accountCurrency for each currency or crypto asset the account holds or is denominated in; it is intentionally multi-valued. Balance over time is a stonework:MetricObservation. A crypto wallet is a FinancialAccount; its on-chain address is a stonework:CryptoAddress.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#FinancialAccountType -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#FinancialAccountType">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://cyberterrain.org/ns/stonework#financialAccountTypeScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">A classification of a financial account by the kind of value custody or service it represents.</skos:definition>
        <skos:prefLabel xml:lang="en">Financial Account Type</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#FinancialInstitution -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#FinancialInstitution">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Organization"/>
        <skos:definition xml:lang="en">An organization whose business is holding, moving, exchanging, or safeguarding financial assets on behalf of others — a bank, credit union, broker-dealer, payment processor, money services business, or virtual asset service provider.</skos:definition>
        <skos:prefLabel xml:lang="en">Financial Institution</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The natural bearer of institution identifiers (stonework:bic, stonework:abaRoutingNumber) that should not broaden bare stonework:Organization, and the range of stonework:heldAt. Institution kind is asserted with stonework:categorizedBy a stonework:FinancialInstitutionType. The Legal Entity Identifier is a general organization identifier (stonework:lei), not institution-specific.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#FinancialInstitutionType -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#FinancialInstitutionType">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://cyberterrain.org/ns/stonework#financialInstitutionTypeScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">A classification of a financial institution by its regulatory form and the service it provides.</skos:definition>
        <skos:prefLabel xml:lang="en">Financial Institution Type</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#FinancialTransaction -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#FinancialTransaction">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberActivity"/>
        <skos:definition xml:lang="en">A movement of economic value from one financial account to another, occurring over a definite period and optionally attributed to the agents responsible for initiating it.</skos:definition>
        <skos:prefLabel xml:lang="en">Financial Transaction</skos:prefLabel>
        <skos:scopeNote xml:lang="en">An occurrent: it starts and settles at a time (stonework:startedAtTime and stonework:endedAtTime), is attributed with stonework:attributedTo, and can be sighted, investigated, and grouped into a stonework:CyberActivityCluster. Originator and beneficiary are given by stonework:originatorAccount and stonework:beneficiaryAccount; correspondent hops by stonework:intermediaryAccount. The transferred value is a stonework:MonetaryAmount via stonework:hasMonetaryValue. Use stonework:originatorMonetaryValue and stonework:beneficiaryMonetaryValue when the debited input and credited output differ, as in a currency exchange. Flat stonework:transactionAmount and stonework:transactionCurrency are convenience projections only for a single-denomination transfer. A blockchain transaction is a FinancialTransaction whose accounts are crypto wallets. Divergent source records of one economic event are handled through stonework:hasProvenance and stonework:Sighting rather than a distinct record class. Use stonework:hasBehavior to link a transaction, or a cluster of them, to a stonework:IllicitFinanceTechnique it exhibits. Use stonework:fundsActivity only when the transaction finances an activity; use stonework:respondsToActivity when a transaction occurs in response to an activity, such as a victim&apos;s ransom payment.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#GranularMarking -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#GranularMarking">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <skos:definition xml:lang="en">A marking application that assigns a data-handling marking to selected fields or portions of another cyber entity.</skos:definition>
        <skos:prefLabel xml:lang="en">Granular Marking</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Represents the structural application of a marking, including its selectors and referenced marking definition. It is distinct from a stonework:Markings category value, which expresses the handling designation itself.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Group -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Group">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <skos:definition xml:lang="en">Any collection of Persons, Organizations, or other Groups that share a common purpose or identity but do not necessarily have formal legal structure.</skos:definition>
        <skos:prefLabel>Group</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Used for informal collectives, communities, ad-hoc teams, criminal syndicates, or loose alliances. More general than Organization. Can contain other Groups or Organizations.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Grouping -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Grouping">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#IntelligenceProduct"/>
        <skos:definition xml:lang="en">A structured intelligence product that asserts shared context among a set of referenced cyber threat intelligence entities.</skos:definition>
        <skos:prefLabel xml:lang="en">Grouping</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Use when related objects need to be collected without the narrative and publication semantics of a Report. Corresponds to the STIX 2.1 Grouping SDO.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Hash -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Hash">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Identifier"/>
        <skos:definition>A single cryptographic hash entry associating a hashing algorithm with its hex-encoded digest value. Used to represent entries in the STIX hashes dictionary.</skos:definition>
        <skos:prefLabel xml:lang="en">Hash</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Host -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Host">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Infrastructure"/>
        <skos:definition xml:lang="en">A computing system, device, or endpoint (physical, virtual, container, or cloud instance) that can run processes, host files, and participate in networks.</skos:definition>
        <skos:prefLabel xml:lang="en">Host</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#HumanSource -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#HumanSource">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Provenance"/>
        <skos:definition>A person who provides information, intelligence, or a report (as opposed to automated feeds or technical artifacts).</skos:definition>
        <skos:prefLabel>Human Source</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Often used in HUMINT or OSINT contexts. Reliability scoring is commonly applied to human sources.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Hypothesis -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Hypothesis">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#IntelligenceProduct"/>
        <skos:definition xml:lang="en">A structured, falsifiable prediction about the value a Variable will resolve to once the Behavior or Step declaring that Variable executes.</skos:definition>
        <skos:prefLabel>Hypothesis</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Formalizes the anticipated side of the Variable lifecycle described in stonework:Variable&apos;s scopeNote: a Hypothesis names, in advance, the value an output Variable is predicted to be bound to. Linked to the Variable it predicts via stonework:predictsVariable, and to the prediction itself via stonework:predictedType (a class, the common case — mirrors stonework:guardType), stonework:predictedValue (a specific individual), or stonework:predictedLiteral (a scalar) — mirroring stonework:boundTo/stonework:boundToLiteral on the actual-result side. A Transition&apos;s guard properties, which test a Variable&apos;s actual bound value, implicitly test agreement with whichever Hypothesis predicted that Variable — confirming it if they match, refuting it otherwise. May attach at any level of a Step/Plan decomposition, since stonework:Step is itself a stonework:Behavior.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#HypothesisStatus -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#HypothesisStatus">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://cyberterrain.org/ns/stonework#hypothesisStatusScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">A classification of a Hypothesis&apos;s position in the confirm/refute lifecycle.</skos:definition>
        <skos:prefLabel xml:lang="en">Hypothesis Status</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Applied via stonework:hasHypothesisStatus to Hypothesis individuals. Named individuals: pending (not yet tested), confirmed (actual result matched the prediction), refuted (actual result did not match the prediction).</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#IBAN -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#IBAN">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Identifier"/>
        <skos:definition xml:lang="en">An International Bank Account Number (ISO 13616): the cross-jurisdiction normalized identifier for a bank account.</skos:definition>
        <skos:prefLabel xml:lang="en">IBAN</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The value is stonework:iban. A single stonework:FinancialAccount may carry both an IBAN and one or more domestic identifiers (stonework:BankAccountNumber) via stonework:hasIdentifier; the IBAN is the normalized form that reconciles differing national account-number formats.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#IPAddress -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#IPAddress">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Infrastructure"/>
        <skos:definition xml:lang="en">Represents a single IP address (IPv4 or IPv6).</skos:definition>
        <skos:prefLabel xml:lang="en">IP Address</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#IPBlock -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#IPBlock">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Infrastructure"/>
        <skos:definition xml:lang="en">A Classless Inter-Domain Routing (CIDR) block used to represent an IP network range.</skos:definition>
        <skos:prefLabel xml:lang="en">IP Block</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Identifier -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Identifier">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <skos:definition xml:lang="en">A first-class representation of a security-relevant identifier value, such as an email address, cryptographic hash, MAC address, phone number, URI, or user-agent string.</skos:definition>
        <skos:prefLabel>Identifier</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Identifier does not provide the RDF identity of every CyberEntity and does not imply that every CyberEntity has an Identifier. Named RDF resources are identified by their IRIs; identifiers originating in external systems are recorded with dcterms:identifier or stonework:externalId. Use the most specific available subclass, such as EmailAddress, Hash, MACAddress, PhoneNumber, URI, or UserAgent. Instantiate Identifier directly only when the identifier type is unknown or no suitable subclass exists.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#IllicitFinanceTechnique -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#IllicitFinanceTechnique">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Technique"/>
        <skos:definition xml:lang="en">A prescribed method for disguising the origin, ownership, or destination of illicitly obtained funds, or for moving value while evading financial controls.</skos:definition>
        <skos:prefLabel xml:lang="en">Illicit Finance Technique</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Covers money-laundering typologies and the adjacent methods of terrorist financing, sanctions evasion, and financial fraud. A neutral structural slot: STONEWORK defines the class but not its individuals. A starter set of FATF-derived typology individuals is supplied by the optional frameworks/fatf.ttl module; other bodies&apos; typology sets can populate the same class. Link an exhibiting stonework:FinancialTransaction or stonework:CyberActivityCluster with stonework:hasBehavior. Because the class sits under stonework:Technique, a concrete laundering chain can later be modeled as a stonework:Procedure that stonework:implements a typology, with no rework.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Impact -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Impact">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#RiskFactor"/>
        <rdfs:comment>Instances of stonework:Impact SHOULD specify the affected asset or mission, the type of consequence, and the severity level. Impact SHOULD be represented using explicit properties rather than encoded in class IRIs or labels.</rdfs:comment>
        <skos:definition>The magnitude of harm, loss, or adverse effects that would result if a threat were realized and a compromise occurred, expressed in terms of mission, business, operational, or technical consequences.</skos:definition>
        <skos:prefLabel>Impact</skos:prefLabel>
        <skos:scopeNote>Impact represents the severity of consequences associated with a compromise. It may include effects on confidentiality, integrity, availability, safety, mission success, financial loss, or reputational damage. Impact values may be qualitative or quantitative.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#ImpactLevel -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#ImpactLevel">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://cyberterrain.org/ns/stonework#impactLevelScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">An ordinal classification of the magnitude of a security impact.</skos:definition>
        <skos:prefLabel xml:lang="en">Impact Level</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#ImpactType -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#ImpactType">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://cyberterrain.org/ns/stonework#impactTypeScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">A classification of the security dimension or consequence affected by an impact.</skos:definition>
        <skos:prefLabel xml:lang="en">Impact Type</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Incident -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Incident">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberActivity"/>
        <skos:definition xml:lang="en">A significant adverse event or series of related events that has caused, or has the potential to cause, harm to an organization’s operations, assets, or people.</skos:definition>
        <skos:prefLabel>Incident</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Distinguished from stonework:Event (a raw, unassessed occurrence) by the presence of human or automated triage declaring significance and adversity. An Incident may aggregate multiple Events, involve one or more Campaigns, and trigger Investigation and Playbook execution.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#IncidentStatus -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#IncidentStatus">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://cyberterrain.org/ns/stonework#incidentStatusScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">A classification of an incident&apos;s position in the response lifecycle.</skos:definition>
        <skos:prefLabel xml:lang="en">Incident Status</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Indicator -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Indicator">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#IntelligenceProduct"/>
        <skos:definition xml:lang="en">An intelligence assertion that a pattern — atomic, expression-based, or behavioral — when matched in an observed environment, indicates the presence of threat activity attributable to a specific adversary behavior, malware, or campaign.</skos:definition>
        <skos:prefLabel xml:lang="en">Indicator</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The central concept in operational CTI. The term is used by the community in three overlapping senses, all of which stonework:Indicator covers: (1) IOC sense — an atomic observable (IP address, domain, file hash, URL) that has been assessed as malicious or suspicious and tagged for detection; in STONEWORK the underlying observable is the SCO (stonework:IPAddress, stonework:Domain, stonework:Hash), and the Indicator wraps it with the assertion, confidence, and validity window. (2) Pattern sense — a STIX patterning expression over one or more SCOs (e.g., [ipv4-addr:value = ‘198.51.100.0/24’]). (3) Behavioral sense — a multi-step or TTPs-based pattern asserting that an observed sequence of behaviors indicates a technique or campaign. Distinct from stonework:DetectionRule: an Indicator is the intelligence claim (‘look for this’); a DetectionRule is the operational artifact that implements the check (‘here is the Sigma/Snort/YARA rule that looks for it’). Indicators are produced by threat intelligence analysts and consumed by detection pipelines; DetectionRules are deployed in SIEMs, EDRs, and network sensors. Corresponds to STIX 2.1 Indicator SDO. Use stonework:indicates to link an Indicator to the AttackPattern, Malware, Campaign, or ThreatActor it asserts.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Industry -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Industry">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Sector"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://cyberterrain.org/ns/stonework#industryScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">A specific branch of economic activity or commercial sector (typically modeled using NAICS or similar codes).</skos:definition>
        <skos:prefLabel xml:lang="en">Industry</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Examples: Financial Services, Manufacturing, Retail, Pharmaceuticals.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Infrastructure -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Infrastructure">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <skos:definition>Represents systems, software services, or any group of resources used to conduct cyber operations. Infrastructure is used by threat actors and intrusion sets both offensively and defensively.</skos:definition>
        <skos:prefLabel xml:lang="en">Infrastructure</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#InfrastructureType -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#InfrastructureType">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://cyberterrain.org/ns/stonework#infrastructureTypeScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">A classification of infrastructure by its operational role or purpose within a cyber operation.</skos:definition>
        <skos:prefLabel xml:lang="en">Infrastructure Type</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Applied via stonework:categorizedBy to Infrastructure individuals. Covers both adversary-controlled infrastructure (C2, staging, phishing) and defender infrastructure (firewall, workstation). Aligns with the STIX 2.1 infrastructure-type open vocabulary.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#IntelligenceProduct -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#IntelligenceProduct">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <skos:definition xml:lang="en">A structured artifact produced by an intelligence or analytical process, intended to convey findings, assessments, observations, or sourcing context to support decision-making.</skos:definition>
        <skos:prefLabel xml:lang="en">Intelligence Product</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The intelligence product hierarchy covers the outputs of the intelligence lifecycle: Reports, Assessments, Sightings, Notes, and Provenance records. Distinguished from stonework:DigitalArtifact (raw observable technical data) and stonework:Behavior (plan specifications and TTP patterns). Intelligence products are the result of human or automated analytical work applied to raw data — they carry judgment, context, and traceability that raw artifacts do not.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Investigation -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Investigation">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Process"/>
        <skos:definition>A systematic Process of inquiry, evidence collection, analysis, hypothesis testing, and conclusion to understand, attribute, or resolve security incidents, threats, anomalies, or other matters of interest.</skos:definition>
        <skos:prefLabel>Investigation</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Includes digital forensics, threat hunting, root cause analysis, and incident investigations. Links to Sightings, Evidence (via categorizedBy), Sensors, and produces Findings or updated Assessments.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#InvestigationPlan -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#InvestigationPlan">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Behavior"/>
        <rdfs:comment xml:lang="en">An InvestigationPlan is a plan specification; executing one produces an instance of stonework:Investigation.</rdfs:comment>
        <skos:definition xml:lang="en">A Step-decomposed sequence of actions for systematically examining a cyber entity, artifact, or event to determine its nature, extent, or significance.</skos:definition>
        <skos:prefLabel>Investigation Plan</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The general assessment-plan counterpart to stonework:Playbook on the production side: where a Playbook&apos;s execution changes state in the world, an InvestigationPlan&apos;s execution (a stonework:Investigation) produces judgment about something that already exists or happened — typically a stonework:Analysis or stonework:Assessment. stonework:DetectionPlan is a specialized subclass, narrowly scoped to determining whether observed activity constitutes a security-relevant violation; broader analytical work (forensic analysis, malware analysis, vulnerability assessment) is modeled directly as InvestigationPlan.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#KillChainPhase -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#KillChainPhase">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://cyberterrain.org/ns/stonework#killChainPhaseScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">A named phase within a kill chain or attack lifecycle framework used to categorize the stage of an offensive or defensive operation.</skos:definition>
        <skos:prefLabel xml:lang="en">Kill Chain Phase</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Applies to both offensive frameworks (Lockheed Martin Cyber Kill Chain, MITRE ATT&amp;CK) and defensive lifecycle models. Used to tag AttackTechniques, Procedures, or Events with their operational phase.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#LaunderingStage -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#LaunderingStage">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Tactic"/>
        <skos:definition xml:lang="en">One of the classic phases of a money-laundering scheme — placement, layering, or integration — grouping the techniques that serve that phase&apos;s objective.</skos:definition>
        <skos:prefLabel xml:lang="en">Laundering Stage</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The illicit-finance counterpart of stonework:OffensiveTactic: a high-level objective that groups stonework:IllicitFinanceTechnique individuals via stonework:hasTechnique. A neutral structural slot; the three canonical individuals are supplied by frameworks/fatf.ttl.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Likelihood -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Likelihood">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#RiskFactor"/>
        <rdfs:comment>Instances of stonework:Likelihood may incorporate assumptions, uncertainty, adversary behavior, historical frequency, or environmental conditions. Likelihood SHOULD be represented using explicit properties rather than encoded in class IRIs or labels.</rdfs:comment>
        <skos:definition>The estimated probability, plausibility, or frequency with which a threat could be realized and lead to a compromise under specified conditions.</skos:definition>
        <skos:prefLabel>Likelihood</skos:prefLabel>
        <skos:scopeNote>Likelihood reflects the chance that a compromise will occur, considering adversary capability, intent, opportunity, preconditions, and environmental factors. Likelihood values may be qualitative, ordinal, or quantitative.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#LikelihoodLevel -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#LikelihoodLevel">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://cyberterrain.org/ns/stonework#likelihoodLevelScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">An ordinal classification of the assessed likelihood that a security outcome will occur.</skos:definition>
        <skos:prefLabel xml:lang="en">Likelihood Level</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Location -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Location">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <skos:definition>Represents a geographic location. May be as specific as a latitude/longitude coordinate or as broad as a continent. At least one of region, country, or latitude/longitude must be provided.</skos:definition>
        <skos:prefLabel xml:lang="en">Location</skos:prefLabel>
        <skos:scopeNote xml:lang="en">STONEWORK Location is a STIX-style geographic designator, not a BFO Site of occupancy. The BFO adapter maps it to an information content entity that denotes a place.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Log -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Log">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#DigitalArtifact"/>
        <skos:definition xml:lang="en">A structured or semi-structured record of events, actions, or state changes generated by a system, application, or network component over time.</skos:definition>
        <skos:prefLabel xml:lang="en">Log</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Logs are primary data sources for detection, investigation, and threat hunting. Examples include system event logs, authentication logs, DNS query logs, firewall logs, and application logs. Distinct from NetworkTraffic (which captures raw packet data) and from Event (which represents a parsed, security-relevant occurrence derived from log data).</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#MACAddress -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#MACAddress">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Identifier"/>
        <skos:definition xml:lang="en">A media access control address that identifies a network interface at the data-link layer.</skos:definition>
        <skos:prefLabel xml:lang="en">MAC Address</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Covers 48-bit and 64-bit MAC address representations, including values carried by the STIX 2.1 MAC Address SCO.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Malware -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Malware">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <skos:definition xml:lang="en">A software object intended to perform malicious functions within, or on behalf of, a threat actor. Encompasses both abstract family-level concepts and concrete specimen-level artifacts.</skos:definition>
        <skos:prefLabel xml:lang="en">Malware</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Parent class for stonework:MalwareFamily (STIX is_family=true) and stonework:MalwareSample (STIX is_family=false). Corresponds to the STIX 2.1 malware SDO. Use stonework:categorizedBy to assert behavioral type (e.g., stonework:Ransomware). Use stonework:hasArtifact to link a sample to its captured binary.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#MalwareAnalysis -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#MalwareAnalysis">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Analysis"/>
        <skos:definition xml:lang="en">A structured record of findings from static or dynamic analysis performed on a malware specimen or family, including the tool used, analysis configuration, and verdict.</skos:definition>
        <skos:prefLabel xml:lang="en">Malware Analysis</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Captures the output of a single analysis run: antivirus scan, sandbox execution, reverse-engineering session, etc. Key properties include the analysis product and version, the result verdict (malicious/suspicious/benign/unknown), and references to SCOs observed during analysis. Corresponds to STIX 2.1 MalwareAnalysis SDO.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#MalwareFamily -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#MalwareFamily">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Malware"/>
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Product"/>
        <skos:definition xml:lang="en">An abstract malware concept representing a named strain, lineage, or campaign of malicious software sharing common behavioral patterns, code ancestry, or infrastructure. Corresponds to STIX 2.1 malware SDO with is_family=true.</skos:definition>
        <skos:prefLabel xml:lang="en">Malware Family</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Examples: Cobalt Strike, Mimikatz, WannaCry, BlackCat. A MalwareFamily does not have a specific hash or binary but may be linked to MalwareSample instances via the inverse of stonework:memberOfFamily. Use stonework:categorizedBy to assert behavioral type (e.g., stonework:Ransomware, stonework:Backdoor).</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#MalwareSample -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#MalwareSample">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Malware"/>
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#VersionedProduct"/>
        <skos:definition xml:lang="en">A discrete, observable instance of malicious code — a specific binary, script, or executable artifact that can be identified by cryptographic hash, file characteristics, or behavioral signature.</skos:definition>
        <skos:prefLabel xml:lang="en">Malware Sample</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Represents a concrete sample rather than an abstract family concept. A single MalwareFamily may have thousands of associated samples across versions, packers, and dropper variants. Samples are linked to their family via stonework:memberOfFamily and to their file representation via stonework:hasHash or a direct stonework:File association. Properties such as stonework:drops, stonework:downloads, and stonework:communicatesWith describe the behavior of this specific sample, not the family in general.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#MalwareType -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#MalwareType">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://cyberterrain.org/ns/stonework#malwareTypeScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">A behavioral or functional classification of malware, describing what the malware does rather than what it is. Corresponds to the STIX 2.1 malware-type open vocabulary.</skos:definition>
        <skos:prefLabel xml:lang="en">Malware Type</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Instances (e.g., stonework:Ransomware, stonework:Trojan) are assigned via stonework:categorizedBy. A malware object may carry multiple types. The skos:notation value gives the STIX 2.1 wire-format string for aspirational round-trip export.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Markings -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Markings">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://cyberterrain.org/ns/stonework#markingScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">Defines a data handling marking used to restrict or label how data can be shared or handled, such as TLP markings. Referenced by object_marking_refs or granular_markings.</skos:definition>
        <skos:prefLabel xml:lang="en">Markings</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#MetricObservation -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#MetricObservation">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#QualifiedAssertion"/>
        <skos:definition xml:lang="en">A qualified, time-stamped metric value about a cyber entity, carrying its metric type, source provenance, and optional calculation-model version.</skos:definition>
        <skos:prefLabel xml:lang="en">Metric Observation</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Use for values that change over time or differ by source, including EPSS probability, KEV membership, confidence, likelihood, risk scores, and normalized monetary valuations. A stonework:metricNormalizedValue observation records its output currency with stonework:valuationCurrency. Direct datatype properties remain convenience projections for consumers that need a single current value.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#MetricType -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#MetricType">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://cyberterrain.org/ns/stonework#metricTypeScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">A controlled classification identifying the meaning and scale of a qualified metric observation.</skos:definition>
        <skos:prefLabel xml:lang="en">Metric Type</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Mitigation -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Mitigation">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Countermeasure"/>
        <rdfs:seeAlso rdf:resource="https://csrc.nist.gov/glossary/term/mitigation"/>
        <skos:definition xml:lang="en">A deliberate action or control intended to reduce the likelihood, impact, or severity of a risk, threat, vulnerability, or adverse event.</skos:definition>
        <skos:prefLabel>Mitigation</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Mitigations are proactive or reactive measures applied to address weaknesses or threats. Examples include: applying a security patch, enabling MFA, deploying a firewall rule, isolating a compromised host, or training users. A Mitigation may be a reusable control (ATT&amp;CK sense) or a specific situational action. CourseOfAction is a subclass for contextualized, packaged response actions.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#MobileDevice -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#MobileDevice">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Host"/>
        <skos:definition xml:lang="en">A portable computing device with wireless connectivity, typically used for communication, data processing, and accessing networks (e.g., smartphones, tablets, or laptops with cellular capability).</skos:definition>
        <skos:prefLabel>Mobile Device</skos:prefLabel>
        <skos:scopeNote xml:lang="en">In a cyber threat context, Mobile Devices are often treated as both endpoints (Infrastructure) and vectors for attacks (e.g., mobile malware, phishing, lost/stolen device risks). They may host UserAccounts, run Mobile Applications, and connect via cellular, Wi-Fi, or Bluetooth.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#MonetaryAmount -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#MonetaryAmount">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <skos:definition xml:lang="en">A quantity of money: a decimal magnitude paired with the currency that denominates it.</skos:definition>
        <skos:prefLabel xml:lang="en">Monetary Amount</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Reified so magnitude and currency always travel together, mirroring how stonework:Hash pairs algorithm and digest. Attached to a transaction, account, impact, or demand with stonework:hasMonetaryValue or a monetary-value role subproperty. The magnitude is stonework:amount and the unit is stonework:currency. A currency-normalized valuation of the same amount, for example its USD equivalent at a stated time and rate source, is a stonework:MetricObservation on this amount with stonework:valuationCurrency identifying the output currency.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Motivation -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Motivation">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://cyberterrain.org/ns/stonework#motivationScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">The reason or driving force behind an adversary&apos;s decision to conduct an attack or operation.</skos:definition>
        <skos:prefLabel xml:lang="en">Motivation</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Applied via stonework:categorizedBy to ThreatActor, Campaign, or Operation individuals. Named individuals cover the STIX 2.1 attack-motivation open vocabulary. Custom motivations may be added as additional individuals.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Mutex -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Mutex">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#DigitalArtifact"/>
        <skos:definition xml:lang="en">A named mutual exclusion object (mutex or semaphore) used by a process to prevent concurrent access to a shared resource. Commonly used as a malware indicator — malware families often create uniquely named mutexes to avoid re-infecting a host.</skos:definition>
        <skos:prefLabel xml:lang="en">Mutex</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Mutex names serve as host-based indicators of compromise. A specific mutex name found on a system can be attributed to a known malware family. Corresponds to the STIX 2.1 Mutex SCO.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#NetworkService -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#NetworkService">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Infrastructure"/>
        <skos:definition xml:lang="en">A network-accessible service or endpoint provided by infrastructure, such as HTTP, DNS, or SSH servers.</skos:definition>
        <skos:prefLabel>Network Service</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#NetworkTraffic -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#NetworkTraffic">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#DigitalArtifact"/>
        <skos:definition xml:lang="en">A captured or observed network traffic flow between source and destination endpoints, including protocol, ports, payload characteristics, and timing.</skos:definition>
        <skos:prefLabel xml:lang="en">Network Traffic</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Distinct from stonework:Log (which captures parsed event records) and stonework:Event (a security-relevant occurrence). NetworkTraffic is the raw flow artifact. May carry indicators such as user-agent strings, URI patterns, or certificate fingerprints observable in transit.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Note -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Note">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#IntelligenceProduct"/>
        <skos:definition xml:lang="en">A free-text annotation attached to one or more individuals to provide additional context, analyst commentary, caveats, or confidence assessments.</skos:definition>
        <skos:prefLabel>Note</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Notes are analyst-authored rather than machine-generated. They may express uncertainty, sourcing context, or interpretive observations that do not fit structured properties. Corresponds to STIX 2.1 Note SDO.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#OffensiveTactic -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#OffensiveTactic">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Tactic"/>
        <skos:definition>A high-level adversary objective that groups related attack techniques by the goal they serve during an intrusion or operation.</skos:definition>
        <skos:prefLabel>Offensive Tactic</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Aligns with MITRE ATT&amp;CK tactics (e.g. Initial Access, Execution, Lateral Movement) and D3FEND OffensiveTactic. Individuals are typically drawn from ATT&amp;CK or similar offensive frameworks via the STONES or framework mapping layers.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#OnlineReference -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#OnlineReference">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Provenance"/>
        <skos:definition>A reference to an external online resource (URL, article, post, etc.) used for provenance.</skos:definition>
        <skos:prefLabel>Online Reference</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Operation -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Operation">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberActivity"/>
        <skos:definition xml:lang="en">A coordinated set of activities conducted by one or more agents toward a defined objective, typically spanning multiple campaigns, incidents, or phases and characterized by unified command, intent, or resourcing.</skos:definition>
        <skos:prefLabel>Operation</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Operations are broader in scope than Campaigns — a single Operation may encompass multiple Campaigns executed over an extended period. Applies to both offensive operations (e.g. state-sponsored cyber operations) and defensive operations (e.g. incident response operations, threat hunting operations).</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#OperationPlan -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#OperationPlan">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Playbook"/>
        <skos:definition xml:lang="en">A Playbook specifically representing an adversary&apos;s operational plan — the offensive counterpart within the Playbook hierarchy.</skos:definition>
        <skos:prefLabel>Operation Plan</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Named to avoid colliding with the already-established stonework:AttackPattern and stonework:AttackTechnique, and to align with stonework:Operation, whose definition (&apos;a coordinated set of activities... unified command, intent, or resourcing&apos;) describes the executed counterpart of an OperationPlan. Generic stonework:Playbook remains available for the undifferentiated or defensive case.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Opinion -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Opinion">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#IntelligenceProduct"/>
        <skos:definition xml:lang="en">An analyst&apos;s epistemological stance on the correctness or credibility of information asserted in another intelligence object.</skos:definition>
        <skos:prefLabel xml:lang="en">Opinion</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Sibling to stonework:Assessment under IntelligenceProduct. Where Assessment evaluates risk or impact, Opinion evaluates the reliability or accuracy of existing intelligence — e.g., &apos;I disagree with this threat score&apos; or &apos;I believe this indicator attribution is incorrect&apos;. Corresponds to STIX 2.1 Opinion SDO. The opinion value (strongly-agree to strongly-disagree) and explanation are captured via stones: properties.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Organization -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Organization">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#Organization"/>
        <skos:definition xml:lang="en">A formal or semi-formal structured entity such as a company, government agency, non-profit, military unit, or consortium with defined boundaries and usually legal identity.</skos:definition>
        <skos:prefLabel>Organization</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Corresponds to STIX Identity with identity_class = &apos;organization&apos;. Includes corporations, government bodies, NGOs, universities, etc. Distinguished from Group by having more persistent structure, roles, and often legal standing.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#PaymentInstrument -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#PaymentInstrument">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://cyberterrain.org/ns/stonework#paymentInstrumentScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">A classification of the instrument or rail used to move value in a financial transaction.</skos:definition>
        <skos:prefLabel xml:lang="en">Payment Instrument</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Person -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Person">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#Person"/>
        <skos:definition xml:lang="en">A single human individual.</skos:definition>
        <skos:prefLabel>Person</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Represents real named people (e.g. employees, threat actors, researchers). Does not include legal entities or groups. Corresponds to STIX Identity with identity_class = &apos;individual&apos;.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#PhoneNumber -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#PhoneNumber">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Identifier"/>
        <skos:definition xml:lang="en">A telephone number used to contact or identify an Agent. Used for attribution, OSINT pivoting, and identity clustering.</skos:definition>
        <skos:prefLabel xml:lang="en">Phone Number</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#PhysicalArtifact -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#PhysicalArtifact">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <skos:definition xml:lang="en">A discrete material object relevant to cyber operations — a device, appliance, plant component, or other physical artifact that can be observed, located, or acted upon.</skos:definition>
        <skos:prefLabel xml:lang="en">Physical Artifact</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Sibling of stonework:DigitalArtifact. Covers ICS and OT assets such as PLCs, RTUs, safety systems, and HMIs, as well as other tangible devices in a cyber-physical environment. An ICS device that runs processes and participates in networks may also be typed as stonework:Host. Distinct from stonework:Infrastructure, which groups resources used to conduct cyber operations.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Playbook -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Playbook">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Behavior"/>
        <rdfs:comment xml:lang="en">A Playbook is a plan specification; executing one produces instances of stonework:Process. Playbooks are often versioned and tested before use.</rdfs:comment>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#Plan"/>
        <skos:definition xml:lang="en">A documented, structured Behavior that defines a sequenced set of steps, decisions, and actions to be executed in response to a specific type of event, incident, or operational need.</skos:definition>
        <skos:prefLabel>Playbook</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A Playbook may be offensive (an adversary&apos;s operational playbook — see stonework:OperationPlan) or defensive (an incident response, threat hunting, or recovery playbook) — both are action plans carried out by an interested party, as distinct from stonework:DetectionPlan, which plays a neutral, evaluative role. A Playbook decomposes into Steps via stonework:hasStep; its actual execution is recorded as a stonework:Process.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Procedure -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Procedure">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Behavior"/>
        <rdfs:comment>Procedures are instances or patterns of execution that realize a technique. They may include command lines, API calls, malware behaviors, or operator playbook steps. Procedures are distinct from techniques, which describe generalized methods.</rdfs:comment>
        <skos:definition>A concrete, observable sequence of actions, commands, or behaviors that implements a technique in a specific operational context.</skos:definition>
        <skos:prefLabel>Procedure</skos:prefLabel>
        <skos:scopeNote>One realization path for a single Technique — the specific commands, scripts, tools, or configuration that carry it out (e.g. the comsvcs.dll MiniDump way of doing OS Credential Dumping: LSASS Memory). Technique-scoped and typically linear. A Procedure may be only a prose description — the common case when ingesting MITRE ATT&amp;CK procedure examples — or decomposed into stonework:Step individuals via stonework:hasStep for sub-step depth. Links to the Technique it operationalizes via stonework:implements or its specialization stonework:procedureFor. Distinct from stonework:Playbook / stonework:OperationPlan / stonework:ControlPlan, which are objective-scoped plans that orchestrate several Procedures or Techniques with branching, retry, and control flow; a Plan&apos;s Step commonly stonework:implements a Procedure.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Process -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Process">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberActivity"/>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:seeAlso rdf:resource="https://www.opmw.org/model/p-plan/"/>
        <skos:definition>An identifiable activity or sequence of activities performed over time by one or more agents to achieve an operational, security, or business objective. It transforms inputs (artifacts, data, configurations) into outputs and may be governed by plans, controls, or policies.</skos:definition>
        <skos:prefLabel xml:lang="en">Process</skos:prefLabel>
        <skos:scopeNote xml:lang="en">This class operates at the enterprise/operational level and is distinct from low-level runtime Process objects (e.g., STIX SCO Process). It is the execution-side counterpart to Behavior-side plan specifications such as Playbook, ControlPlan, and ThreatScenario — e.g. executing a Playbook produces a Process instance.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Product -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Product">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <owl:disjointWith rdf:resource="https://cyberterrain.org/ns/stonework#VersionedProduct"/>
        <rdfs:comment xml:lang="en">Instances of stonework:Product represent product families or lines (e.g. &apos;Apache Log4j&apos;, &apos;Windows 10&apos;). Specific releases are modeled as stonework:VersionedProduct individuals related via stonework:versionOf. CPE entries with wildcard version components map to stonework:Product; entries with concrete versions map to stonework:VersionedProduct.</rdfs:comment>
        <skos:definition xml:lang="en">An abstract software, hardware, or firmware product line identified by vendor and product name, independent of any specific version or release. Represents the collection of all versioned releases built under that product identity.</skos:definition>
        <skos:prefLabel>Product</skos:prefLabel>
        <skos:scopeNote xml:lang="en">stonework:Product does not carry version, update, edition, or other release-specific attributes. Those belong on stonework:VersionedProduct. The two classes are disjoint.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#ProductInstallation -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#ProductInstallation">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#ComponentContext"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://cyberterrain.org/ns/stonework#installationOf"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://cyberterrain.org/ns/stonework#VersionedProduct"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Represents the most granular product identity level: not what software exists, but where and how it is installed. Multiple ProductInstallation individuals may reference the same VersionedProduct.</rdfs:comment>
        <skos:definition xml:lang="en">A specific installed instance of a VersionedProduct on a particular system or environment, as identified by a SWID tag or equivalent installation record.</skos:definition>
        <skos:prefLabel>Product Installation</skos:prefLabel>
        <skos:scopeNote xml:lang="en">stonework:ProductInstallation is the intended target for SWID tag data. The installing system, path, licensee, and configuration details belong here rather than on stonework:VersionedProduct.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#ProductType -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#ProductType">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://cyberterrain.org/ns/stonework#productTypeScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">A classification of a product by its primary functional category within a system or architecture.</skos:definition>
        <skos:prefLabel xml:lang="en">Product Type</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Applied via stonework:hasProductType to Product individuals. Aligns with CPE component type designations. A product may have more than one type (e.g. an embedded OS is both firmware and operating-system).</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Provenance -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Provenance">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <skos:definition xml:lang="en">Structured source references used to record the origin and trustworthiness of data and relationships.</skos:definition>
        <skos:prefLabel xml:lang="en">Provenance</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Includes Feeds, Publications, and URL References.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Publication -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Publication">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Provenance"/>
        <skos:definition>A structured intelligence artifact such as a blog post, advisory, report, or news article.</skos:definition>
        <skos:prefLabel>Publication</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#QualifiedAssertion -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#QualifiedAssertion">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <skos:definition xml:lang="en">A first-class record of an assertion or relationship that may carry provenance, time, and other context not represented by an unqualified binary property or scalar value.</skos:definition>
        <skos:prefLabel xml:lang="en">Qualified Assertion</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Use assertionSubject, assertionObject, and assertionRelationType for generic directed relationships; subclasses may provide more specific structure. Use direct properties as query-friendly projections when their loss of source, time, or relationship context is acceptable. Provenance is optional in the baseline interoperability profile and required by the strict SHACL overlay.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Region -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Region">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Location"/>
        <skos:definition>A sub-national territorial division such as a state, province, region, or governorate.</skos:definition>
        <skos:prefLabel>Region</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Registry -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Registry">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#DigitalArtifact"/>
        <skos:definition>Describes elements within the Windows configuration Registry system.</skos:definition>
        <skos:prefLabel>Registry</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#RegistryKey -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#RegistryKey">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Registry"/>
        <skos:definition xml:lang="en">A named key in a Windows Registry hierarchy that may contain subordinate keys and registry values.</skos:definition>
        <skos:prefLabel xml:lang="en">Registry Key</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#RegistryValue -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#RegistryValue">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Registry"/>
        <skos:definition xml:lang="en">A named or default value stored beneath a Windows Registry key, including its value type and literal data.</skos:definition>
        <skos:prefLabel xml:lang="en">Registry Value</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Report -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Report">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#IntelligenceProduct"/>
        <skos:definition>A collection of threat intelligence focused on one or more topics, such as a description of a threat actor, malware, or attack technique.</skos:definition>
        <skos:prefLabel>Report</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#ResourceLevel -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#ResourceLevel">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://cyberterrain.org/ns/stonework#resourceLevelScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">A classification of the organizational resources available to a threat actor.</skos:definition>
        <skos:prefLabel xml:lang="en">Resource Level</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Risk -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Risk">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#RiskFactor"/>
        <rdfs:comment>Instances of stonework:Risk may reference the threat being considered, the assets affected, the expected impact of compromise, and the likelihood of occurrence. Risk values may be qualitative or quantitative, and SHOULD be represented using explicit properties rather than encoded in class IRIs or labels.</rdfs:comment>
        <skos:definition>A measure of the potential for loss or adverse effects arising from the realization of a threat, expressed as a function of the impact of compromise and the likelihood that the compromise will occur.</skos:definition>
        <skos:prefLabel>Risk</skos:prefLabel>
        <skos:scopeNote>This class represents the assessed or estimated level of exposure to harm for a specific asset, mission, or organization. Risk is typically derived from the combination of impact and likelihood, and may incorporate assumptions, uncertainty, and contextual factors.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#RiskFactor -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#RiskFactor">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <skos:definition xml:lang="en">A calculated or assessed component used to quantify or characterize security risk, including the potential for harm and the probability of its occurrence.</skos:definition>
        <skos:prefLabel>Risk Factor</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Includes Risk (overall assessed exposure), Impact (magnitude of harm if realized), and Likelihood (probability of occurrence). These are analytical outputs derived from threat and vulnerability data, distinct from the conditions (SecurityCondition) that give rise to them and the countermeasures (Countermeasure) that address them.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#RiskLevel -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#RiskLevel">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://cyberterrain.org/ns/stonework#riskLevelScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">An ordinal classification of the assessed magnitude of a security risk.</skos:definition>
        <skos:prefLabel xml:lang="en">Risk Level</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Role -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Role">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <skos:definition>A function, capacity, or part played by an entity in a specific context, relationship, or operation.</skos:definition>
        <skos:prefLabel>Role</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Roles are typically more stable and relational than Categories. An entity can play multiple Roles. Aligns with patterns in BFO, CCO, and D3FEND (e.g., functional roles of infrastructure or actors).</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#RoleAssignment -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#RoleAssignment">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#QualifiedAssertion"/>
        <skos:definition xml:lang="en">A qualified record assigning a Role to an entity within a particular campaign, operation, organization, or other context.</skos:definition>
        <skos:prefLabel xml:lang="en">Role Assignment</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Create separate assignments when the same entity plays different roles in different contexts or time intervals. The assignment can infer the context-free stonework:playsRole projection through the declared property chain.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#RuntimeProcess -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#RuntimeProcess">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#DigitalArtifact"/>
        <skos:definition xml:lang="en">A running or terminated process instance on a host, identified by PID, executable path, command line, parent process, and associated user account.</skos:definition>
        <skos:prefLabel xml:lang="en">Runtime Process</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Represents low-level OS process objects observed during execution — distinct from stonework:Process (enterprise-level workflows). Mutex objects created by a process are linked as stonework:Mutex individuals. Corresponds to STIX 2.1 Process SCO.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Sector -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Sector">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://cyberterrain.org/ns/stonework#sectorScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">A broad division or category of economic activity, infrastructure, or society used for classification and targeting purposes.</skos:definition>
        <skos:prefLabel xml:lang="en">Sector</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Can represent both commercial industries and critical infrastructure sectors (e.g., from CISA or NIST frameworks).</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#SecurityActuation -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#SecurityActuation">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberActivity"/>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/vocab-ssn/#SOSAActuation"/>
        <skos:definition xml:lang="en">A specific cyber activity in which a deployed security mechanism changes the security state of one or more cyber entities.</skos:definition>
        <skos:prefLabel xml:lang="en">Security Actuation</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Use stonework:madeByActuator for the deployed mechanism, stonework:appliesCountermeasure for the safeguard or procedure being carried out, and stonework:actsOn for each affected entity. Unlike a Countermeasure specification, a SecurityActuation is an occurrence and may carry execution times and produced results. Inspired by SOSA sosa:Actuation without formally importing SOSA. The baseline SHACL profile requires madeByActuator at violation severity — the acting tool&apos;s own identity is always self-asserted and known at creation time — but only warns on a missing actsOn: the tooling that performed an actuation typically knows what it acted on in source-native terms (an IP, a hostname, a process ID) before that reference resolves to a canonical CyberEntity individual, the same resolution lag as stonework:RoleAssignment&apos;s roleContext or stonework:MetricObservation&apos;s metricFor. A SecurityActuation with no actsOn yet is incomplete, not malformed.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#SecurityActuator -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#SecurityActuator">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Infrastructure"/>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/vocab-ssn/#SOSAActuator"/>
        <skos:definition xml:lang="en">A deployed system, service, appliance, or software agent capable of changing the security state of a cyber environment by applying a countermeasure.</skos:definition>
        <skos:prefLabel xml:lang="en">Security Actuator</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A SecurityActuator is the mechanism that applies a safeguard, not the safeguard specification itself. Firewalls, EDR agents, access-control services, and patch-management systems are typical examples. A mechanism such as an IPS or EDR agent may be both a stonework:Sensor and a SecurityActuator. Distinct from stonework:Actuator, which is a physical process or plant actuator. Inspired by SOSA sosa:Actuator without formally importing SOSA.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#SecurityCondition -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#SecurityCondition">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <skos:definition xml:lang="en">A state, circumstance, or disposition relevant to the security posture of a system, asset, or mission — existing independently of any measurement or assessment.</skos:definition>
        <skos:prefLabel>Security Condition</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Includes Threats, Vulnerabilities, and Weaknesses. Risk, Impact, and Likelihood are assessed/calculated concepts and are modeled under stonework:RiskFactor.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#SecurityObservation -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#SecurityObservation">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#IntelligenceProduct"/>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/vocab-ssn/#SOSAObservation"/>
        <skos:definition xml:lang="en">A time-bounded record produced by a security sensor or automated tool capturing one or more cyber observables witnessed in a monitored environment, together with frequency metadata.</skos:definition>
        <skos:prefLabel xml:lang="en">Security Observation</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Machine-produced intelligence: a sensor is not an analyst, but its output feeds the intelligence pipeline in the same way that SIGINT feeds human analysis. Key metadata: the time window the phenomenon was witnessed (first/last observed), how many times it was observed (number_observed), and which cyber observables were captured (hasObservable). Use stonework:madeBySensor to link to the producing stonework:Sensor. Distinct from stonework:Sighting, which records that a known CTI object (indicator, malware, threat actor) was seen; SecurityObservation is the raw sensor-layer record prior to attribution or indicator matching. Corresponds to STIX 2.1 observed-data SDO. Inspired by SOSA sosa:Observation — compatible in concept but does not formally import the SOSA ontology.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Sensor -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Sensor">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Infrastructure"/>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/vocab-ssn/#SOSASensor"/>
        <skos:definition xml:lang="en">A deployed system, appliance, agent, or network tap that collects data about digital artifacts, network activity, or adversary behavior for detection and investigation purposes.</skos:definition>
        <skos:prefLabel>Sensor</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Applies DetectionRules via stonework:usesRule. May be a software agent, physical appliance, virtual instance, or network sensor. Examples: IDS/IPS, SIEM collector, endpoint agent, network tap, honeypot, vulnerability scanner. An AI-driven sensor that crosses into autonomous decision-making may be additionally typed as stonework:AIAgent. Aligns with D3FEND Sensor. Inspired by SOSA sosa:Sensor — compatible in concept but does not formally import the SOSA ontology. Produces stonework:SecurityObservation instances via stonework:madeBySensor.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Sighting -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Sighting">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#IntelligenceProduct"/>
        <skos:definition xml:lang="en">Records that a object such as an indicator, malware, tool, or threat actor was seen. Wraps observation metadata around a reference to the sighted object.</skos:definition>
        <skos:prefLabel>Sighting</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Signature -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Signature">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#DetectionRule"/>
        <skos:definition xml:lang="en">A content-centric detection rule that matches malicious activity by a specific pattern — a byte sequence, string, hash, regular expression, or network packet structure.</skos:definition>
        <skos:prefLabel xml:lang="en">Signature</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Includes YARA rules, Snort/Suricata rules, and AV signatures. Distinguished from broader DetectionRule subclasses (behavioral, correlation, analytic) by its tight binding to a specific known-bad indicator or artifact pattern.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#SoftwareBillOfMaterials -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#SoftwareBillOfMaterials">
        <rdfs:comment xml:lang="en">An SBOM asserts that specific VersionedProduct instances are components of a containing artifact. Component entries are represented as stonework:BomEntry instances linked via stonework:hasBomEntry.</rdfs:comment>
        <skos:definition xml:lang="en">A formal, machine-readable inventory of VersionedProduct components that constitute a software artifact or system, expressed in a standard format such as CycloneDX or SPDX.</skos:definition>
        <skos:prefLabel>Software Bill of Materials</skos:prefLabel>
        <skos:scopeNote xml:lang="en">SoftwareBillOfMaterials is a native STONEWORK class — not a subclass of any STIX domain object, as STIX 2.1 has no SBOM concept. Instances correspond to SBOM documents; format provenance (CycloneDX 1.6, SPDX 2.3, etc.) is expressed via stonework:bomFormat.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#SophisticationLevel -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#SophisticationLevel">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://cyberterrain.org/ns/stonework#sophisticationLevelScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">A classification of a threat actor&apos;s assessed technical sophistication.</skos:definition>
        <skos:prefLabel xml:lang="en">Sophistication Level</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Step -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Step">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Behavior"/>
        <rdfs:seeAlso rdf:resource="http://purl.org/net/p-plan#Step"/>
        <skos:definition xml:lang="en">A single, individually addressable unit of action within a Behavior that models a multi-step process, such as a Procedure, Playbook, ThreatScenario, or Control.</skos:definition>
        <skos:prefLabel>Step</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A Step is itself a Behavior — a plan specification for a sub-action, not its execution — consistent with p-plan:Step subclassing prov:Plan rather than prov:Activity. Because Step is a Behavior, a Step MAY itself decompose into further Steps via stonework:hasStep, supporting nested sub-procedures (e.g. a Kill Chain phase decomposing into candidate technique attempts) without a separate composite class. The activity that executes a Step is a stonework:CyberActivity; it links back to the Step it realizes via stonework:correspondsToStep.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Tactic -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Tactic">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Behavior"/>
        <rdfs:comment>Instances of stonework:Tactic SHOULD correspond to high‑level adversary goals. Techniques are typically modeled as children or members of a tactic.</rdfs:comment>
        <skos:definition>A high‑level objective or strategic goal that groups related techniques by the purpose they serve during an operation.</skos:definition>
        <skos:prefLabel>Tactic</skos:prefLabel>
        <skos:scopeNote>Superclass for OffensiveTactic and DefensiveTactic. Tactics represent the strategic intent behind behavior — gaining initial access, exfiltrating data, or hardening a system. They serve as conceptual categories for techniques.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Technique -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Technique">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Behavior"/>
        <rdfs:comment>Mirrors D3FEND&apos;s Technique class and reflects the PROV-O Plan philosophy: a technique is a plan that describes how an action should be carried out, distinct from the activity that executes it. Subclassed by stonework:CyberTechnique for cyber-specific methods.</rdfs:comment>
        <skos:definition>A reusable, prescribed method for achieving an objective, which may be instantiated as a concrete execution by an actor or system.</skos:definition>
        <skos:prefLabel>Technique</skos:prefLabel>
        <skos:scopeNote>A method specification, not a plan: a Technique describes an approach (&apos;access credential material in LSASS process memory&apos;) without prescribing an ordered, branched sequence of steps. Concrete step structure appears one level down, in a stonework:Procedure that realizes the Technique, or in a stonework:Playbook / stonework:OperationPlan that orchestrates several. An execution links to the Technique it performs directly with stonework:executionOf — no Procedure, Plan, or Step is required for the lightweight case. Technique is intentionally not a subclass of stones:AttackPattern: attack patterns such as CAPEC are abstract taxonomy entries, while Techniques are operationalized methods closer to execution. See stonework:CyberTechnique, stonework:AttackTechnique, stonework:DefendTechnique, and docs/technique-modeling.md.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Threat -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Threat">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#SecurityCondition"/>
        <rdfs:comment>Instances of stonework:Threat may describe adversary capabilities, strategic objectives, targeting patterns, or environmental conditions that increase the likelihood of harmful action. Threats may be linked to threat actors, campaigns, malware, TTPs, weaknesses, or assets, but are conceptually distinct from the actions or events that realize them.</rdfs:comment>
        <skos:definition>A potential or actual source of harm arising from an adversary&apos;s capability, intent, and opportunity to exploit weaknesses or create adverse effects within a system, organization, or mission.</skos:definition>
        <skos:prefLabel>Threat</skos:prefLabel>
        <skos:scopeNote>This class represents the abstract notion of a cyber threat, independent of specific threat actors, campaigns, or events. It provides a semantic foundation for modeling adversary capabilities, intentions, targeting, and conditions that give rise to harmful outcomes.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#ThreatActor -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#ThreatActor">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Agent"/>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <skos:definition>An entity that has the capability and intent to conduct harmful activities within a cyber or sociotechnical context.</skos:definition>
        <skos:prefLabel xml:lang="en">Threat Actor</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Parent class for stonework:ThreatActorIndividual (a single human) and stonework:ThreatActorGroup (a collective or organization). Threat actors are distinct from the threats they pose; they are the entities that carry out actions that realize threats. They may be linked to observed behaviors, techniques, targeting patterns, and strategic objectives.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#ThreatActorGroup -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#ThreatActorGroup">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#ThreatActor"/>
        <skos:definition xml:lang="en">A collective, organization, or coordinated set of individuals operating with common intent to conduct adversarial cyber activities.</skos:definition>
        <skos:prefLabel xml:lang="en">Threat Actor Group</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Covers nation-state units, cybercriminal organizations, hacktivist collectives, and other named adversary groups. Industry names such as APT20 or APT29 are often used for both a tracked body of activity and the presumed group behind it. Model the activity as a separate stonework:CyberActivityCluster and link it to the ThreatActorGroup with stonework:attributedTo when supported. MITRE ATT&amp;CK serializes tracked Groups as STIX intrusion-set objects; that source representation alone does not establish that the activity cluster and responsible group are the same entity. Distinguished from stonework:ThreatActorIndividual, which represents a single human actor.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#ThreatActorIndividual -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#ThreatActorIndividual">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#ThreatActor"/>
        <skos:definition xml:lang="en">A single, identifiable human actor with the capability and intent to conduct adversarial cyber activities.</skos:definition>
        <skos:prefLabel xml:lang="en">Threat Actor Individual</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Covers individual hackers, insiders, contractors, and other identified persons. Relevant for law enforcement and prosecution contexts where attribution to a specific individual — rather than a group — is required. Distinguished from stonework:ThreatActorGroup, which represents a collective or organization.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#ThreatActorRole -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#ThreatActorRole">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Role"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://cyberterrain.org/ns/stonework#threatActorRoleScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">A controlled role type describing the function played by a threat actor within a specific operation, campaign, or criminal organization.</skos:definition>
        <skos:prefLabel xml:lang="en">Threat Actor Role</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A threat actor may play different roles across operations — a nation-state actor may be a sponsor in one campaign and a director in another. Use stonework:RoleAssignment for contextual modeling; stonework:playsRole is the context-free STIX-compatible projection.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#ThreatActorType -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#ThreatActorType">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://cyberterrain.org/ns/stonework#threatActorTypeScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">A classification of a threat actor by their organizational form, affiliation, or primary mode of operation.</skos:definition>
        <skos:prefLabel xml:lang="en">Threat Actor Type</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Applied via stonework:categorizedBy to ThreatActor individuals. A threat actor may have multiple types. Aligns with the STIX 2.1 threat-actor-type open vocabulary.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#ThreatScenario -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#ThreatScenario">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Behavior"/>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#Plan"/>
        <skos:definition xml:lang="en">A plan specification describing how a threat could materialize against specific assets or missions — incorporating adversary intent, capability, opportunity, preconditions, attack path, and expected consequences.</skos:definition>
        <skos:prefLabel xml:lang="en">Threat Scenario</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A ThreatScenario is prescriptive and forward-looking: it specifies a potential sequence of adversary behaviors and environmental conditions rather than recording observed events. Used to guide defensive planning, risk assessment, and Playbook development. Distinct from stonework:Incident (an observed occurrence) and stonework:Threat (an abstract source of harm). Aligns with prov:Plan and P-Plan scenario specifications.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Tool -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Tool">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Product"/>
        <skos:definition xml:lang="en">Legitimate software that can be used offensively by threat actors or defensively by security practitioners. Distinguishable from malware by being designed for benign or dual-use purposes rather than being inherently malicious.</skos:definition>
        <skos:prefLabel xml:lang="en">Tool</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Includes commercial penetration testing tools, remote administration utilities, and living-off-the-land binaries (LOLBins) repurposed by adversaries, as well as defender-operated tools such as scanners, EDR agents, and forensic utilities. Corresponds to STIX 2.1 Tool SDO.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#TransactionType -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#TransactionType">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://cyberterrain.org/ns/stonework#transactionTypeScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">A classification of a financial transaction by the kind of movement it represents.</skos:definition>
        <skos:prefLabel xml:lang="en">Transaction Type</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Transition -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Transition">
        <skos:definition xml:lang="en">A directed edge between two Steps within the same parent Behavior&apos;s Step graph, representing progression from one Step to the next.</skos:definition>
        <skos:prefLabel>Transition</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Unconditioned, a Transition expresses plain sequence — an alternative to stonework:precededByStep for the same purpose, used when a Step has more than one possible successor and the edges themselves need to be individually referenceable. When a Transition&apos;s stonework:toStep targets a Step already reached earlier in the same graph, it expresses a loop back-edge; looping is not a separate construct. Conditional branching is expressed with the guard properties stonework:guardVariable (the Variable tested), stonework:guardType (a class the bound value must be an instance of) or stonework:guardLiteralValue (a scalar it must equal), and stonework:guardOperator (the comparison; omitting it defaults to equality). The Transition fires when its guard holds against the from-Step&apos;s bound Variable.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#URI -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#URI">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Identifier"/>
        <skos:definition xml:lang="en">Represents a Uniform Resource Identifier conforming to RFC 3986.</skos:definition>
        <skos:prefLabel xml:lang="en">URI</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#UserAccount -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#UserAccount">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Account"/>
        <skos:definition xml:lang="en">An authenticated-access identity on a system or service — a local OS account, cloud or directory account, application account, or social media account — through which a principal logs in and acts.</skos:definition>
        <skos:prefLabel xml:lang="en">User Account</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The access/authentication sibling of stonework:FinancialAccount under stonework:Account. Where a login governs a value-holding ledger (online banking, an exchange account, a marketplace wallet), model the ledger as a separate stonework:FinancialAccount and link the two with stonework:controls — one login commonly controls several accounts.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#UserAgent -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#UserAgent">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Identifier"/>
        <skos:definition xml:lang="en">A string identifier transmitted by a client application in HTTP requests declaring the software, version, and platform making the request. Used for fingerprinting clients, identifying malware C2 beaconing patterns, and clustering infrastructure by shared tooling.</skos:definition>
        <skos:prefLabel xml:lang="en">User Agent</skos:prefLabel>
        <skos:scopeNote xml:lang="en">User-agent strings are observable in network traffic, proxy logs, and web server logs. Distinctive or spoofed user-agent values are commonly used as indicators in threat intelligence. Distinct from stonework:UserAccount (an identity credential) — a UserAgent describes software behavior, not a user identity.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#UserGroup -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#UserGroup">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#DigitalIdentity"/>
        <skos:definition xml:lang="en">Represents a user group on a system or service, including local OS groups, cloud groups, and social media groups.</skos:definition>
        <skos:prefLabel>User Group</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Variable -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Variable">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#CyberEntity"/>
        <rdfs:seeAlso rdf:resource="http://purl.org/net/p-plan#Variable"/>
        <skos:definition xml:lang="en">A named placeholder for a value declared by a Behavior or Step, bound to an actual value only once the corresponding execution occurs.</skos:definition>
        <skos:prefLabel>Variable</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Declared via stonework:hasInputVariable or stonework:hasOutputVariable. An input Variable is typically bound before its Step executes from an already-known fact; for example, a plan may bind to an existing stonework:CvssMetric assessment. An output Variable is bound only after its Step executes, such as when an Investigation constructs a stonework:VulnerabilityAssessment. Variables carry execution-time values and do not replace persistent domain relationships. Bound via stonework:boundTo (an individual) or stonework:boundToLiteral (a scalar). The bound value is what stonework:Transition guard properties test, and — in a future deviation-detection layer — what an actual result is compared against what the Step declared as expected.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#VersionedProduct -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#VersionedProduct">
        <rdfs:comment xml:lang="en">Instances of stonework:VersionedProduct may include operating systems, applications, libraries, devices, or embedded components at a specific release. Versioning, vendor attribution, and edition details SHOULD be represented using explicit properties rather than encoded strings.</rdfs:comment>
        <skos:definition xml:lang="en">A specific versioned release or build of a Product, identified by a CPE name or equivalent product identifier. Represents the unit of software actually deployed and potentially affected by vulnerabilities.</skos:definition>
        <skos:prefLabel>Versioned Product</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Each CPE 2.3 entry with a concrete version component maps to a stonework:VersionedProduct individual. Wildcard-version CPEs map to stonework:Product. Related to its abstract product line via stonework:versionOf.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Vulnerability -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Vulnerability">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#SecurityCondition"/>
        <skos:definition xml:lang="en">A flaw or weakness in software, hardware, firmware, or system architecture that can be exploited by a threat actor to compromise confidentiality, integrity, or availability.</skos:definition>
        <skos:prefLabel>Vulnerability</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Represents specific exploitable instances (e.g., CVE-identified vulnerabilities) rather than weakness classes — those are modeled as stonework:Weakness. A Vulnerability is linked to its root Weakness via stonework:hasWeakness, to affected products via stonework:affected, to its fix via stonework:fixedInProduct, and to exploiting malware or actors via stonework:exploits. Aligns with D3FEND Vulnerability and NVD CVE.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#VulnerabilityAssessment -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#VulnerabilityAssessment">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#Assessment"/>
        <skos:definition xml:lang="en">A structured evaluation of a specific vulnerability&apos;s applicability and risk in a particular product or deployment context.</skos:definition>
        <skos:prefLabel xml:lang="en">Vulnerability Assessment</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Captures VEX-style assessments: whether a product is affected, not affected, fixed, or under investigation, together with the justification and any remediation statement. Distinct from stonework:Vulnerability (which describes the flaw itself) and stonework:CvssMetric (which gives context-neutral technical severity): a VulnerabilityAssessment is a judgment about applicability and risk in a specific product, deployment, or enterprise context. It may be constructed by an Investigation executing a Plan whose inputs include the vulnerability, its CVSS assessment, and current enterprise graph state.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stonework#Weakness -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stonework#Weakness">
        <rdfs:subClassOf rdf:resource="https://cyberterrain.org/ns/stonework#SecurityCondition"/>
        <rdfs:comment>Instances of stonework:Weakness may represent base weaknesses, variant weaknesses, or compound weaknesses. CWE identifiers (e.g., &quot;CWE‑79&quot;) SHOULD be modeled using explicit properties rather than encoded in the class IRI. Descriptions and extended details SHOULD be referenced via citations rather than reproduced verbatim.</rdfs:comment>
        <skos:definition>A type of flaw, fault, or design condition in software, hardware, or system architecture that can enable vulnerabilities, reduce security assurance, or increase the likelihood of exploitable behavior.</skos:definition>
        <skos:prefLabel>Weakness</skos:prefLabel>
        <skos:scopeNote>This class provides a semantic representation of weakness types defined in the Common Weakness Enumeration (CWE). It supports hierarchical relationships, abstraction levels, and mappings to related attack patterns, vulnerabilities, and security controls.</skos:scopeNote>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://cyberterrain.org/ns/stonework# -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#">
        <terms:description>A semantic threat ontology and research framework that serves as the ground-truth model for cyber threat intelligence in the CyberTerrain ecosystem. It provides an extensible foundation for modeling cyber threat intelligence concepts, objects, relationships, workflows, and knowledge, and aligns with established CTI framework ontologies — including STONES (STIX 2.1), ATT&amp;CK, CAPEC, CWE, CVE, and CPE — as authoritative reference vocabularies rather than ontologies it imports and extends.</terms:description>
        <terms:title xml:lang="en">STONEWORK — Semantic Threat Ontology and Research Framework</terms:title>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#Adware -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#Adware">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#MalwareType"/>
        <skos:notation>adware</skos:notation>
        <skos:definition xml:lang="en">Software that automatically displays or downloads advertising material, often without user consent.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#malwareTypeScheme"/>
        <skos:prefLabel xml:lang="en">Adware</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#Backdoor -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#Backdoor">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#MalwareType"/>
        <skos:notation>backdoor</skos:notation>
        <skos:definition xml:lang="en">Malware that provides covert, persistent remote access to a compromised system, bypassing normal authentication.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#malwareTypeScheme"/>
        <skos:prefLabel xml:lang="en">Backdoor</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#Bootkit -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#Bootkit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#MalwareType"/>
        <skos:notation>bootkit</skos:notation>
        <skos:definition xml:lang="en">Malware that infects the boot sector or master boot record to load before the operating system, enabling deep persistence and defense evasion.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#malwareTypeScheme"/>
        <skos:prefLabel xml:lang="en">Bootkit</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#Bot -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#Bot">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#MalwareType"/>
        <skos:notation>bot</skos:notation>
        <skos:definition xml:lang="en">Malware that connects an infected host to a command-and-control network, enabling remote tasking as part of a botnet.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#malwareTypeScheme"/>
        <skos:prefLabel xml:lang="en">Bot</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#DDoS -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#DDoS">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#MalwareType"/>
        <skos:notation>ddos</skos:notation>
        <skos:definition xml:lang="en">Malware designed to conduct or participate in distributed denial-of-service attacks against target systems or networks.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#malwareTypeScheme"/>
        <skos:prefLabel xml:lang="en">DDoS Malware</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#Downloader -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#Downloader">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#MalwareType"/>
        <skos:notation>downloader</skos:notation>
        <skos:definition xml:lang="en">Malware whose primary function is to download and execute additional malicious payloads from a remote source.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#malwareTypeScheme"/>
        <skos:prefLabel xml:lang="en">Downloader</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#Dropper -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#Dropper">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#MalwareType"/>
        <skos:notation>dropper</skos:notation>
        <skos:definition xml:lang="en">Malware that carries and installs one or more secondary payloads onto a target system, often unpacking them from within itself.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#malwareTypeScheme"/>
        <skos:prefLabel xml:lang="en">Dropper</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#Equals -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#Equals">
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#ComparisonOperator"/>
        <skos:notation>eq</skos:notation>
        <skos:definition xml:lang="en">The guardVariable&apos;s bound value equals guardLiteralValue.</skos:definition>
        <skos:prefLabel xml:lang="en">Equals</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#ExploitKit -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#ExploitKit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#MalwareType"/>
        <skos:notation>exploit-kit</skos:notation>
        <skos:definition xml:lang="en">A toolkit that automates exploitation of client-side vulnerabilities to deliver malware, typically via drive-by download from compromised or malicious web pages.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#malwareTypeScheme"/>
        <skos:prefLabel xml:lang="en">Exploit Kit</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#GreaterThan -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#GreaterThan">
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#ComparisonOperator"/>
        <skos:notation>gt</skos:notation>
        <skos:definition xml:lang="en">The guardVariable&apos;s bound value is greater than guardLiteralValue.</skos:definition>
        <skos:prefLabel xml:lang="en">Greater Than</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#GreaterThanOrEqual -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#GreaterThanOrEqual">
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#ComparisonOperator"/>
        <skos:notation>ge</skos:notation>
        <skos:definition xml:lang="en">The guardVariable&apos;s bound value is greater than or equal to guardLiteralValue.</skos:definition>
        <skos:prefLabel xml:lang="en">Greater Than Or Equal</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#Keylogger -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#Keylogger">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#MalwareType"/>
        <skos:notation>keylogger</skos:notation>
        <skos:definition xml:lang="en">Malware that records keystrokes on an infected system to capture credentials, sensitive data, or communications.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#malwareTypeScheme"/>
        <skos:prefLabel xml:lang="en">Keylogger</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#LessThan -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#LessThan">
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#ComparisonOperator"/>
        <skos:notation>lt</skos:notation>
        <skos:definition xml:lang="en">The guardVariable&apos;s bound value is less than guardLiteralValue.</skos:definition>
        <skos:prefLabel xml:lang="en">Less Than</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#LessThanOrEqual -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#LessThanOrEqual">
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#ComparisonOperator"/>
        <skos:notation>le</skos:notation>
        <skos:definition xml:lang="en">The guardVariable&apos;s bound value is less than or equal to guardLiteralValue.</skos:definition>
        <skos:prefLabel xml:lang="en">Less Than Or Equal</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#NotEquals -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#NotEquals">
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#ComparisonOperator"/>
        <skos:notation>ne</skos:notation>
        <skos:definition xml:lang="en">The guardVariable&apos;s bound value does not equal guardLiteralValue.</skos:definition>
        <skos:prefLabel xml:lang="en">Not Equals</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#Ransomware -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#Ransomware">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#MalwareType"/>
        <skos:notation>ransomware</skos:notation>
        <skos:definition xml:lang="en">Malware that encrypts or locks victim data or systems and demands payment for restoration of access.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#malwareTypeScheme"/>
        <skos:prefLabel xml:lang="en">Ransomware</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#RemoteAccessTrojan -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#RemoteAccessTrojan">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#MalwareType"/>
        <skos:notation>remote-access-trojan</skos:notation>
        <skos:definition xml:lang="en">Malware providing covert remote control of an infected host, typically including capabilities such as file access, screen capture, keylogging, and command execution.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#malwareTypeScheme"/>
        <skos:prefLabel xml:lang="en">Remote Access Trojan</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#ResourceExploitation -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#ResourceExploitation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#MalwareType"/>
        <skos:notation>resource-exploitation</skos:notation>
        <skos:definition xml:lang="en">Malware that abuses the computational resources of an infected host, such as for cryptocurrency mining or proxying network traffic.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#malwareTypeScheme"/>
        <skos:prefLabel xml:lang="en">Resource Exploitation</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#RogueSecuritySoftware -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#RogueSecuritySoftware">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#MalwareType"/>
        <skos:notation>rogue-security-software</skos:notation>
        <skos:definition xml:lang="en">Malware that masquerades as legitimate security software to deceive users into paying for fake threat removal or granting elevated privileges.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#malwareTypeScheme"/>
        <skos:prefLabel xml:lang="en">Rogue Security Software</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#Rootkit -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#Rootkit">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#MalwareType"/>
        <skos:notation>rootkit</skos:notation>
        <skos:definition xml:lang="en">Malware that conceals itself and other malicious software by subverting operating system or hypervisor mechanisms, typically to maintain privileged persistence.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#malwareTypeScheme"/>
        <skos:prefLabel xml:lang="en">Rootkit</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#ScreenCapture -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#ScreenCapture">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#MalwareType"/>
        <skos:notation>screen-capture</skos:notation>
        <skos:definition xml:lang="en">Malware that periodically or continuously captures screenshots of the victim&apos;s display and exfiltrates them to an attacker.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#malwareTypeScheme"/>
        <skos:prefLabel xml:lang="en">Screen Capture</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#Spyware -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#Spyware">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#MalwareType"/>
        <skos:notation>spyware</skos:notation>
        <skos:definition xml:lang="en">Malware that covertly monitors user activity, collects personal or sensitive information, and transmits it to a remote party.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#malwareTypeScheme"/>
        <skos:prefLabel xml:lang="en">Spyware</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#Trojan -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#Trojan">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#MalwareType"/>
        <skos:notation>trojan</skos:notation>
        <skos:definition xml:lang="en">Malware disguised as or bundled with legitimate software to deceive users into executing it, enabling a range of malicious payloads.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#malwareTypeScheme"/>
        <skos:prefLabel xml:lang="en">Trojan</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#UnknownMalware -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#UnknownMalware">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#MalwareType"/>
        <skos:notation>unknown</skos:notation>
        <skos:definition xml:lang="en">The malware type has not been determined or cannot be classified into a known category.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#malwareTypeScheme"/>
        <skos:prefLabel xml:lang="en">Unknown Malware Type</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#Virus -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#Virus">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#MalwareType"/>
        <skos:notation>virus</skos:notation>
        <skos:definition xml:lang="en">Malware that replicates by inserting copies of itself into other executable files or documents, spreading when those files are executed or opened.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#malwareTypeScheme"/>
        <skos:prefLabel xml:lang="en">Virus</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#Webshell -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#Webshell">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#MalwareType"/>
        <skos:notation>webshell</skos:notation>
        <skos:definition xml:lang="en">Malware deployed on a web server that provides remote command execution via HTTP requests, enabling persistent access through the web application layer.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#malwareTypeScheme"/>
        <skos:prefLabel xml:lang="en">Webshell</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#Wiper -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#Wiper">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#MalwareType"/>
        <skos:notation>wiper</skos:notation>
        <skos:definition xml:lang="en">Malware designed to irreversibly destroy data or render systems inoperable, typically used for sabotage or to obscure attacker activity.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#malwareTypeScheme"/>
        <skos:prefLabel xml:lang="en">Wiper</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#Worm -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#Worm">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#MalwareType"/>
        <skos:notation>worm</skos:notation>
        <skos:definition xml:lang="en">Self-replicating malware that spreads across networks or systems without requiring user interaction or a host file to attach to.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#malwareTypeScheme"/>
        <skos:prefLabel xml:lang="en">Worm</skos:prefLabel>
    </owl:NamedIndividual>
    


