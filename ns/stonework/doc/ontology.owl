    <!-- https://cyberterrain.org/ns/stonework#evidence -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#evidence">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
