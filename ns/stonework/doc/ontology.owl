        <rdfs:isDefinedBy rdf:resource="https://cyberterrain.org/ns/stones#"/>
        <skos:definition>Abstract class for STIX Cyber Observable Objects (SCOs), which represent technical observations such as IP addresses, files, network traffic, and processes.</skos:definition>
        <skos:prefLabel xml:lang="en">STIX Cyber Observable Object</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stones#StixDomainObject -->


    <owl:Class rdf:about="https://cyberterrain.org/ns/stones#StixDomainObject">
