        <terms:title xml:lang="en">STONEWORK Category Scheme</terms:title>
        <skos:definition xml:lang="en">The umbrella concept scheme containing all STONEWORK classification and tagging values modeled as instances of stonework:Category subclasses.</skos:definition>
        <skos:prefLabel xml:lang="en">STONEWORK Category Scheme</skos:prefLabel>
        <skos:scopeNote xml:lang="en">More specific schemes organize individual controlled vocabularies. Category instances remain members of this umbrella scheme through the restriction on stonework:Category.</skos:scopeNote>
    </owl:NamedIndividual>
    


