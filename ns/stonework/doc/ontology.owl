            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy rdf:resource="https://cyberterrain.org/ns/stones#"/>
        <skos:definition>A structured reference to non-STIX information, such as a CVE entry, MITRE ATT&amp;CK technique, or external URL. Used to link STIX content to authoritative external sources.</skos:definition>
        <skos:prefLabel xml:lang="en">External Reference</skos:prefLabel>
    </owl:Class>
    


