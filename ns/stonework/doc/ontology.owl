        <skos:prefLabel xml:lang="en">STONEWORK Incident Status Scheme</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#indicator -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#indicator">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#Category"/>
        <skos:definition xml:lang="en">An assertion that a specific pattern or set of Digital Artifacts is associated with malicious behavior, enabling detection, correlation, and response.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:prefLabel xml:lang="en">Indicator</skos:prefLabel>
        <skos:scopeNote xml:lang="en">In STONEWORK, Indicators can be simple (single IOC like a hash or IP) or complex (full STIX patterns combining multiple artifacts and conditions).</skos:scopeNote>
    </owl:NamedIndividual>
    


