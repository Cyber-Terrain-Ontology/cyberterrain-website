    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#infraTypeAmplification -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#infraTypeAmplification">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#InfrastructureType"/>
        <skos:notation>amplification</skos:notation>
        <skos:definition xml:lang="en">Infrastructure used to amplify attack traffic, such as DNS or NTP amplification servers.</skos:definition>
