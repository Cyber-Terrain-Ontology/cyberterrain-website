    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#paymentInstrumentCash -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#paymentInstrumentCash">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#PaymentInstrument"/>
        <skos:notation>cash</skos:notation>
        <skos:definition xml:lang="en">A physical currency deposit, withdrawal, or hand-to-hand payment.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#paymentInstrumentScheme"/>
        <skos:prefLabel xml:lang="en">Cash</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#paymentInstrumentMoneyOrder -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#paymentInstrumentMoneyOrder">
