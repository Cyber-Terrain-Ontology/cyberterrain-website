        <terms:source rdf:resource="https://www.iso.org/iso-4217-currency-codes.html"/>
        <skos:definition xml:lang="en">The controlled vocabulary of fiat currencies, identified by their ISO 4217 alphabetic codes. Members are stonework:Currency individuals; only currencies in active use by consuming graphs need be materialized.</skos:definition>
        <skos:prefLabel xml:lang="en">STONEWORK Fiat Currency Scheme</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#financialAccountTypeBrokerage -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#financialAccountTypeBrokerage">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#FinancialAccountType"/>
        <skos:notation>brokerage</skos:notation>
        <skos:definition xml:lang="en">An account holding securities or other investment assets on behalf of the accountholder.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#financialAccountTypeScheme"/>
        <skos:prefLabel xml:lang="en">Brokerage Account</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#financialAccountTypeChecking -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#financialAccountTypeChecking">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#FinancialAccountType"/>
        <skos:notation>checking</skos:notation>
        <skos:definition xml:lang="en">A transactional deposit account at a bank or credit union, used for routine payments and withdrawals.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#financialAccountTypeScheme"/>
        <skos:prefLabel xml:lang="en">Checking Account</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#financialAccountTypeCorrespondent -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#financialAccountTypeCorrespondent">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#FinancialAccountType"/>
        <skos:notation>correspondent</skos:notation>
        <skos:definition xml:lang="en">An account one financial institution holds at another to settle cross-border or cross-institution payments on behalf of its customers.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#financialAccountTypeScheme"/>
        <skos:prefLabel xml:lang="en">Correspondent Account</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#financialAccountTypeExchangeHostedWallet -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#financialAccountTypeExchangeHostedWallet">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#FinancialAccountType"/>
        <skos:notation>exchange-hosted-wallet</skos:notation>
        <skos:definition xml:lang="en">A custodial crypto-asset balance held for a customer by an exchange or virtual asset service provider, controlled through the provider rather than by an on-chain key the customer holds.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#financialAccountTypeScheme"/>
        <skos:prefLabel xml:lang="en">Exchange-Hosted Wallet</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#financialAccountTypeMerchantStoredValue -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#financialAccountTypeMerchantStoredValue">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#FinancialAccountType"/>
        <skos:notation>merchant-stored-value</skos:notation>
        <skos:definition xml:lang="en">A stored-value balance held with a non-financial merchant or platform, such as gift-card credit, marketplace store credit, or in-platform currency redeemable for goods.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#financialAccountTypeScheme"/>
        <skos:prefLabel xml:lang="en">Merchant Stored Value</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#financialAccountTypePaymentServiceAccount -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#financialAccountTypePaymentServiceAccount">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#FinancialAccountType"/>
        <skos:notation>payment-service-account</skos:notation>
        <skos:definition xml:lang="en">An account with a payment service provider or e-money institution, such as a digital wallet or peer-to-peer payment balance.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#financialAccountTypeScheme"/>
        <skos:prefLabel xml:lang="en">Payment Service Account</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#financialAccountTypePrepaidCard -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#financialAccountTypePrepaidCard">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#FinancialAccountType"/>
        <skos:notation>prepaid-card</skos:notation>
        <skos:definition xml:lang="en">A stored-value balance accessed through a prepaid or reloadable payment card, which may be issued without full identity verification.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#financialAccountTypeScheme"/>
        <skos:prefLabel xml:lang="en">Prepaid Card</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#financialAccountTypeSavings -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#financialAccountTypeSavings">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#FinancialAccountType"/>
        <skos:notation>savings</skos:notation>
        <skos:definition xml:lang="en">An interest-bearing deposit account with limited transactional use.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#financialAccountTypeScheme"/>
        <skos:prefLabel xml:lang="en">Savings Account</skos:prefLabel>
    </owl:NamedIndividual>
    


