        <skos:definition xml:lang="en">The controlled vocabulary of adversary motivations.</skos:definition>
        <skos:prefLabel xml:lang="en">STONEWORK Motivation Scheme</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#motivationUnpredictable -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#motivationUnpredictable">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#Motivation"/>
        <skos:notation>unpredictable</skos:notation>
        <skos:definition xml:lang="en">A threat actor whose motivation is unknown, unclear, or inconsistent; actions that do not fit a clear pattern of intent.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#motivationScheme"/>
        <skos:prefLabel xml:lang="en">Unpredictable</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#paymentInstrumentAchTransfer -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#paymentInstrumentAchTransfer">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#PaymentInstrument"/>
        <skos:notation>ach-transfer</skos:notation>
        <skos:definition xml:lang="en">A batched account-to-account credit or debit transfer over an automated clearing house.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#paymentInstrumentScheme"/>
        <skos:prefLabel xml:lang="en">ACH Transfer</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#paymentInstrumentCardPayment -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#paymentInstrumentCardPayment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#PaymentInstrument"/>
        <skos:notation>card-payment</skos:notation>
        <skos:definition xml:lang="en">A payment made with a credit, debit, or prepaid payment card.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#paymentInstrumentScheme"/>
