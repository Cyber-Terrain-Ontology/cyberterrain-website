        <skos:notation>possible</skos:notation>
        <skos:definition xml:lang="en">The outcome is assessed as plausible but not more likely than not.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#likelihoodLevelScheme"/>
