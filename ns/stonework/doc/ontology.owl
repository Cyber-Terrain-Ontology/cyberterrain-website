        <rdfs:isDefinedBy rdf:resource="https://cyberterrain.org/ns/stones#"/>
        <skos:definition>A single MIME part within a multipart email message, including its body content, content type, and content disposition.</skos:definition>
        <skos:prefLabel xml:lang="en">Email MIME Part</skos:prefLabel>
    </owl:Class>
    


