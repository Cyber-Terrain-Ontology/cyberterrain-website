        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#IncidentStatus"/>
        <skos:notation>contained</skos:notation>
        <skos:definition xml:lang="en">The incident&apos;s spread or immediate harmful activity has been stopped.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#incidentStatusScheme"/>
        <skos:prefLabel xml:lang="en">Contained</skos:prefLabel>
    </owl:NamedIndividual>
    


