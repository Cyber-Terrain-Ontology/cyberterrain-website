        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#metricTypeScheme"/>
        <skos:prefLabel xml:lang="en">Risk Score</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#metricTypeScheme -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#metricTypeScheme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <terms:title xml:lang="en">STONEWORK Metric Type Scheme</terms:title>
        <terms:isPartOf rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:definition xml:lang="en">The controlled vocabulary identifying the semantics and scale of qualified metric observations.</skos:definition>
        <skos:prefLabel xml:lang="en">STONEWORK Metric Type Scheme</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#motivationAccidental -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#motivationAccidental">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#Motivation"/>
        <skos:notation>accidental</skos:notation>
        <skos:definition xml:lang="en">A threat actor who did not have intent to cause harm; unintentional or inadvertent actions that result in a security incident.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#motivationScheme"/>
        <skos:prefLabel xml:lang="en">Accidental</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#motivationCoercion -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#motivationCoercion">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#Motivation"/>
        <skos:notation>coercion</skos:notation>
        <skos:definition xml:lang="en">A threat actor who is being forced to act against their will; actions taken under duress or threat.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#motivationScheme"/>
        <skos:prefLabel xml:lang="en">Coercion</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#motivationDominance -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#motivationDominance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#Motivation"/>
        <skos:notation>dominance</skos:notation>
        <skos:definition xml:lang="en">A threat actor seeking to assert superiority or control over a target, competitor, or adversary; establishing authority or influence.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#motivationScheme"/>
        <skos:prefLabel xml:lang="en">Dominance</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#motivationIdeology -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#motivationIdeology">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#Motivation"/>
        <skos:notation>ideology</skos:notation>
        <skos:definition xml:lang="en">A threat actor motivated by political, religious, or social beliefs; actions intended to advance or defend a particular worldview.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#motivationScheme"/>
        <skos:prefLabel xml:lang="en">Ideology</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#motivationNotoriety -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#motivationNotoriety">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#Motivation"/>
        <skos:notation>notoriety</skos:notation>
        <skos:definition xml:lang="en">A threat actor seeking fame, recognition, or infamy; actions intended to demonstrate capability or gain public public attention.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#motivationScheme"/>
        <skos:prefLabel xml:lang="en">Notoriety</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#motivationOrganizationalGain -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#motivationOrganizationalGain">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#Motivation"/>
        <skos:notation>organizational-gain</skos:notation>
        <skos:definition xml:lang="en">A threat actor seeking to benefit their organization, nation-state, or group through espionage, competitive intelligence, or strategic advantage.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#motivationScheme"/>
        <skos:prefLabel xml:lang="en">Organizational Gain</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#motivationPersonalGain -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#motivationPersonalGain">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#Motivation"/>
        <skos:notation>personal-gain</skos:notation>
        <skos:definition xml:lang="en">A threat actor motivated by financial reward or material benefit for themselves.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#motivationScheme"/>
        <skos:prefLabel xml:lang="en">Personal Gain</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#motivationPersonalSatisfaction -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#motivationPersonalSatisfaction">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#Motivation"/>
        <skos:notation>personal-satisfaction</skos:notation>
        <skos:definition xml:lang="en">A threat actor driven by curiosity, intellectual challenge, or the intrinsic satisfaction of successfully executing an attack.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#motivationScheme"/>
        <skos:prefLabel xml:lang="en">Personal Satisfaction</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#motivationRevenge -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#motivationRevenge">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#Motivation"/>
        <skos:notation>revenge</skos:notation>
        <skos:definition xml:lang="en">A threat actor seeking retaliation for a perceived wrong; actions motivated by grievance against a specific target.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#motivationScheme"/>
        <skos:prefLabel xml:lang="en">Revenge</skos:prefLabel>
    </owl:NamedIndividual>
    


