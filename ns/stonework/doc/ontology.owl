        <skos:definition>Defines a schema extension to STIX 2.1. Allows producers to add new properties or new object types in a structured, interoperable way.</skos:definition>
        <skos:prefLabel xml:lang="en">Extension Definition Object</skos:prefLabel>
    </owl:Class>
    


    <!-- https://cyberterrain.org/ns/stones#ExternalReference -->


