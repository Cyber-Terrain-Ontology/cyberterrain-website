        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#incidentStatusScheme"/>
        <skos:prefLabel xml:lang="en">In Progress</skos:prefLabel>
    </owl:NamedIndividual>
    


