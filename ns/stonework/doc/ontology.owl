        <terms:title xml:lang="en">STONEWORK Financial Account Type Scheme</terms:title>
        <terms:isPartOf rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:definition xml:lang="en">The controlled vocabulary of financial account kinds.</skos:definition>
        <skos:prefLabel xml:lang="en">STONEWORK Financial Account Type Scheme</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#financialAccountTypeSelfCustodyWallet -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#financialAccountTypeSelfCustodyWallet">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#FinancialAccountType"/>
        <skos:notation>self-custody-wallet</skos:notation>
        <skos:definition xml:lang="en">A crypto-asset wallet whose on-chain keys are held by the accountholder, with no custodian.</skos:definition>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#categoryScheme"/>
        <skos:inScheme rdf:resource="https://cyberterrain.org/ns/stonework#financialAccountTypeScheme"/>
        <skos:prefLabel xml:lang="en">Self-Custody Wallet</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://cyberterrain.org/ns/stonework#financialInstitutionTypeBrokerDealer -->


    <owl:NamedIndividual rdf:about="https://cyberterrain.org/ns/stonework#financialInstitutionTypeBrokerDealer">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://cyberterrain.org/ns/stonework#FinancialInstitutionType"/>
        <skos:notation>broker-dealer</skos:notation>
        <skos:definition xml:lang="en">A firm that trades securities for its own account or on behalf of customers.</skos:definition>
