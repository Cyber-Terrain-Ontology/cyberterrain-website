  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The incident's spread or immediate harmful activity has been stopped."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#incidentStatusScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "contained"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Contained"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#incidentStatusInProgress",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#IncidentStatus"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The incident is under active investigation or response."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#incidentStatusScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "in-progress"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "In Progress"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#incidentStatusOpen",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#IncidentStatus"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The incident has been declared and remains unresolved."
  } ],
