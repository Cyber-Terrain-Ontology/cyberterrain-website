    "@value" : "hacker"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Hacker"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#threatActorTypeInsiderAccidental",
