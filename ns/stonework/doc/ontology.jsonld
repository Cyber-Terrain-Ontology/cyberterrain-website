  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Innovator"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#sophisticationLevelIntermediate",
