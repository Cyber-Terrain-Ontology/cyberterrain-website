    "@value" : "The controlled vocabulary of specific branches of economic activity."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "STONEWORK Industry Scheme"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#infraTypeAmplification",
