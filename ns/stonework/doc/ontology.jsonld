  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A network of compromised systems under adversary control, used to execute distributed attacks or other operations."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
