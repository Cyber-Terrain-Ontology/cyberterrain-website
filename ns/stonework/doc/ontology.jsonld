}, {
  "@id" : "http://www.w3.org/2004/02/skos/core#scopeNote",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Hohimer Intelligence Strategies LLC"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "A semantic threat ontology and research framework that serves as the ground-truth model for cyber threat intelligence in the CyberTerrain ecosystem. It provides an extensible foundation for modeling cyber threat intelligence concepts, objects, relationships, workflows, and knowledge, and aligns with established CTI framework ontologies — including STONES (STIX 2.1), ATT&CK, CAPEC, CWE, CVE, and CPE — as authoritative reference vocabularies rather than ontologies it imports and extends."
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://opensource.org/licenses/MIT"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "STONEWORK — Semantic Threat Ontology and Research Framework"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "STONEWORK"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework/0.19.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "0.19.0"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#AIAgent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Agent"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An autonomous or semi-autonomous system driven by AI/ML that can act, make decisions, or be attributed responsibility in a cyber or sociotechnical context."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "AI Agent"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Covers both offensive uses (AI-assisted or autonomous threat actors) and defensive uses (AI-driven detection, response, or hunting systems). Distinct from Tool — an AIAgent has a degree of autonomous decision-making rather than being a passively invoked artifact."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#AITechnique",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Technique"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A specific method by which adversaries attack AI/ML systems (e.g., training data poisoning, adversarial examples, model extraction)."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "AI Technique"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#AccessControlList",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#DigitalArtifact"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A structured list of access control entries (ACEs) that governs which principals (users, groups, or system accounts) are permitted or denied specific operations on a resource."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Access Control List"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Applies across filesystems, operating system objects (registry keys, processes), network devices (firewall rules), cloud IAM policies, and APIs. In a CTI context, adversaries frequently modify ACLs to establish persistence, escalate privileges, or deny defenders access to compromised resources. Framework-specific extensions (e.g. Windows DACL/SACL structure) are modeled at the framework layer."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Account",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#DigitalIdentity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A named account held by an Agent with a provider — an authenticated-access identity, a value-holding ledger position, or both aspects together — identified by one or more Identifiers and optionally attributed to a known Agent."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Account"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Abstract parent of stonework:UserAccount (authenticated access) and stonework:FinancialAccount (value custody and movement). It exists chiefly to give stonework:hasAccount and stonework:accountOf a range spanning both without widening to every DigitalIdentity. A single real-world account often has both natures; model them as two individuals linked by stonework:controls rather than one individual of both types, since one login commonly governs several ledgers."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#AccountType",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid266"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A classification of a user account by its authentication or deployment context."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Account Type"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Actuator",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#PhysicalArtifact"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A physical device that effects a change in a physical process or plant — for example a valve, motor, relay, or servo — as distinct from a cyber security safeguard mechanism."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Actuator"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Use for ICS and OT field devices that act on a physical process. Distinct from stonework:SecurityActuator, which is deployed infrastructure that applies a countermeasure. A PLC or motor starter is an Actuator; an EDR agent or firewall is a SecurityActuator. An ICS device that also runs processes and participates in networks may additionally be typed as stonework:Host."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Adware",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#MalwareType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Software that automatically displays or downloads advertising material, often without user consent."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#malwareTypeScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "adware"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Adware"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#AffectedStatus",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid267"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A judgment of whether a product or version is affected by a vulnerability."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Affected Status"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Applied with stonework:hasAffectedStatus on a stonework:VulnerabilityAssessment. Covers the CVE record statuses affected, unaffected, and unknown, and the VEX statuses fixed and under investigation."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Agent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Any entity that can act, perform actions, or be attributed responsibility in a cyber or sociotechnical context."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Agent"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Covers AI, human individuals, groups, organizations, and other actors (e.g. threat actors, vendors, government bodies). Used as the top-level superclass for identity-related objects in alignment with STIX Identity."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Analysis",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#IntelligenceProduct"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A systematic examination of a cyber entity, artifact, or event that produces structured findings about its nature, behavior, or properties."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Analysis"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Sibling to stonework:Assessment under IntelligenceProduct. Where Assessment answers 'how bad/likely/risky?', Analysis answers 'what is it and what does it do?' Superclass for domain-specific analyses such as MalwareAnalysis. Aligns with STIX MalwareAnalysis SDO at the subclass level."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#AnalyticTechnique",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Technique"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A prescribed analytical method used to process, evaluate, or reason over data to produce intelligence, detections, or assessments."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Analytic Technique"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Covers structured analytic techniques (e.g., analysis of competing hypotheses, kill chain analysis, diamond model analysis) and computational analytic methods (e.g., clustering, anomaly detection). Distinct from DetectionRule — an AnalyticTechnique describes the method; a DetectionRule is a deployable artifact implementing it."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Assessment",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#IntelligenceProduct"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A structured knowledge artifact capturing the evaluation, analysis, or estimation of risk, likelihood, impact, or other security-relevant attributes."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Assessment"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Covers risk assessments, vulnerability assessments, and impact analyses. Assessment is an Information artifact — the output of an evaluative process — not the process itself. The process producing an Assessment may be modeled as a stonework:Process or stonework:Investigation."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#AttackPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Behavior"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A type of Tactics, Techniques, and Procedures (TTP) that describes ways that adversaries attempt to compromise targets. Often maps to MITRE ATT&CK techniques."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Attack Pattern"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "The abstract concept spanning framework-specific shapes that are not structurally identical: CAPEC's shape (capec:AttackPattern) is a taxonomy entry with severity/likelihood/prerequisite fields; MITRE ATT&CK's shape (stonework:AttackTechnique) is an operationalized technique with sub-techniques, procedures, mitigations, and detections. Both are AttackPatterns; stonework:relatedAttackPattern links instances across shapes that describe the same underlying technique."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#AttackTechnique",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#AttackPattern"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberTechnique"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A prescribed offensive method used by an adversary to achieve a specific tactical objective within a target environment."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Attack Technique"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Aligns with MITRE ATT&CK techniques and D3FEND OffensiveTechnique. The MITRE ATT&CK-shaped realization of stonework:AttackPattern — operationalized for execution, as distinct from CAPEC's more abstract taxonomy-entry shape (capec:AttackPattern, also a stonework:AttackPattern). Framework-specific subclasses (e.g. attack:Technique) provide the concrete individuals. A specific, concrete realization of this technique is modeled as a stonework:Procedure, linked back via stonework:implementedBy."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#AuthenticationFactor",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid268"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A kind of evidence of identity a verifier checks: knowledge, possession or inherence."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Authentication Factor"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Applied via stonework:authenticationFactor to the activity in which the factor was checked. One distinct factor is single-factor authentication; two or more, multifactor; none, an activity that relied on an earlier authentication (a session token)."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#AuthenticationVerdict",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid269"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A verdict of a sender-authentication check on an email."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Authentication Verdict"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Applied via stonework:hasAuthenticationVerdict to EmailAuthenticationResult individuals. The verdicts of an Authentication-Results header (RFC 8601): pass, fail, soft fail, neutral, none, temporary error, permanent error, policy."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#AuthenticatorType",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid270"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A kind of authenticator a user or program presents to prove its identity, after NIST SP 800-63B: passwords, one-time codes and approvals, cryptographic keys, and the tokens and assertions that stand in for a fresh authentication."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Authenticator Type"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Applied via stonework:authenticatedWith to the activity in which it was presented. Which factors an authenticator amounted to is recorded per activity (stonework:authenticationFactor), since a FIDO2 key is one factor or two depending on whether the user was verified that time. stonework:phishingResistant marks the types bound to the site's origin, which a relaying phishing proxy can't use."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#AutonomousSystem",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Infrastructure"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Represents an Autonomous System (AS), a collection of IP routing prefixes under the control of a single administrative entity, identified by its AS number."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Autonomous System"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Backdoor",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#MalwareType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Malware that provides covert, persistent remote access to a compromised system, bypassing normal authentication."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#malwareTypeScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "backdoor"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Backdoor"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#BankAccountNumber",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Identifier"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A domestic bank account number as issued under a national scheme, without IBAN normalization."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Bank Account Number"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "The value is stonework:accountNumber. The routing context (US ABA routing number, UK sort code) is recorded on the holding stonework:FinancialInstitution via stonework:abaRoutingNumber or an equivalent, not on this identifier."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Behavior",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A pattern of actions or methods characteristic of an entity, particularly adversaries."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Behavior"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Groups TTP-related classes (Tactic, Technique and its subclasses), Controls, Mitigations (and so CoursesOfAction), Steps, and stonework:Plan, the step-structured specifications that are executed. Methods such as Techniques, Controls and Mitigations are not Plans; Plans implement them. In BFO terms, Behaviors are GenericallyDependentContinuants — specifications or patterns describing how actions are carried out. The execution of a Technique is a CyberActivity; the Technique itself is a Behavior. Aligns with IAO PlanSpecification."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#BomEntry",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "BomEntry is the STONEWORK representation of a CycloneDX component element or SPDX package entry. It links a VersionedProduct into the context of a particular SBOM document via stonework:installationOf, and may carry component-specific metadata (PURL, license, hash, component type) that does not belong on the VersionedProduct itself."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#ComponentContext"
  }, {
    "@id" : "_:genid271"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A single component entry within a Software Bill of Materials, asserting that a specific VersionedProduct is included in the artifact or system described by the SBOM."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "BOM Entry"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "An SBOM import creates one BomEntry per declared component. The BomEntry IRI is scoped to the SBOM (e.g. <sbom-iri/entry/<component-ref>>). Multiple BomEntry instances across different SBOMs may reference the same VersionedProduct via stonework:installationOf."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Bootkit",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#MalwareType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Malware that infects the boot sector or master boot record to load before the operating system, enabling deep persistence and defense evasion."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#malwareTypeScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "bootkit"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Bootkit"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Bot",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#MalwareType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Malware that connects an infected host to a command-and-control network, enabling remote tasking as part of a botnet."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#malwareTypeScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "bot"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Bot"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#BusinessProcess",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Plan"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A Plan by which an organization carries out a routine part of its business, such as paying a supplier, onboarding an employee or granting access, whose Steps may be performed by people or by systems."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Business Process"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Part of STONEWORK because attacks such as business email compromise succeed or fail inside business processes: whether a Step that implements a stonework:Control (a callback, a second approval) was carried out. The process is the plan; each run of it is a stonework:Process that is stonework:executionOf it, so the name does not make the plan an execution. Process models kept in a notation such as BPMN can be recorded with stonework:planFormat. Distinct from stonework:Playbook, which responds to an event, incident or operational need rather than carrying out the organization's ordinary work."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Campaign",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberActivity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A grouping of adversary behaviours and resources with a common objective pursued over a period of time. Campaigns may be attributed to ThreatActors and may form part of a broader CyberActivityCluster."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Campaign"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "A Campaign is organized around an objective and time period, while a CyberActivityCluster is organized by analytic correlation. A Campaign that is one episode within a broader activity cluster is linked to it with stonework:memberOfActivityCluster. The same body of activity may be typed as both classes when both descriptions apply."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Category",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity"
  }, {
    "@id" : "_:genid272"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A classification or tagging concept used to group or qualify other individuals in a particular context."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Category"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Categories are reified so they can be referenced, versioned, or scoped. They are not rigid types."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Certificate",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#DigitalArtifact"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A structured digital document binding a public key to an identity, issued and signed by a certificate authority. Used for authentication, encryption, and trust establishment in networked systems."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Certificate"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Primarily represents X.509 certificates. May be used to cluster infrastructure sharing the same certificate or to link observed TLS/SSL artifacts to their issuing authority. Referenced by stonework:sharesCertificate on Infrastructure. Represent certificate fingerprints through stonework:hasHash and a stonework:Hash individual rather than algorithm-specific fingerprint literals."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#City",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Location"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A significant urban settlement, municipality, or metropolitan area."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "City"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#ComparisonOperator",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A controlled vocabulary of operators used to compare a Variable's bound value against a threshold in a Transition guard."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Comparison Operator"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Individuals are stonework:Equals, stonework:NotEquals, stonework:LessThan, stonework:LessThanOrEqual, stonework:GreaterThan, and stonework:GreaterThanOrEqual. Referenced by stonework:guardOperator; omitting an operator on a guard defaults to Equals semantics."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#ComponentContext",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An abstract class representing a context-specific reference to a VersionedProduct: the same product version appears differently depending on whether it is declared in a bill of materials or observed as a running installation on a specific system."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Component Context"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Subclassed by stonework:BomEntry (declarative — listed in an SBOM document), stonework:ProductInstallation (observational — verified deployment via SWID tag or scan), and framework-specific subclasses such as cve:AffectedProduct (advisory — named in a source vulnerability record, possibly against several VersionedProduct individuals at once). Unifies these evidence bases under a single superclass so that stonework:installationOf can span all of them without domain restrictions forcing incorrect inferences. BomEntry and ProductInstallation are additionally restricted to at most one installationOf value each; ComponentContext itself imposes no such limit, since not every subclass shares that one-to-one shape."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Control",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Instances of stonework:Control may represent individual controls, control enhancements, or sub‑controls. Framework‑specific identifiers (e.g., \"AC‑2\", \"CIS 4.1\") SHOULD be modeled using explicit properties rather than encoded in the class IRI. Control text SHOULD be referenced via citations rather than reproduced verbatim."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Behavior"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#Countermeasure"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A prescribed security or privacy safeguard that specifies an action, capability, or condition intended to reduce risk, enforce policy, or achieve a defined protection objective within an information system or organization."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Control"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@value" : "This class provides a semantic representation of security and privacy controls from frameworks such as NIST SP 800‑53 and the CIS Controls. It supports mapping to external control identifiers and families without embedding copyrighted control text."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#ControlPlan",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Plan"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A concrete, Step-decomposed sequence of actions that implements a Control or Mitigation in a specific operational context."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Control Plan"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Mirrors the Technique/Procedure split on the defensive side: stonework:Control is the abstract prescribed safeguard (a catalog entry, e.g. NIST AC-2 or a CIS control), and a stonework:Mitigation (e.g. an ATT&CK mitigation) is another; ControlPlan is its concrete implementation as a Step sequence, linked back via stonework:implements. A ControlPlan is typically invoked from within a Playbook or DetectionPlan by a Step that stonework:implements it."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Countermeasure",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Any control, mitigation, or safeguard applied to protect against, reduce, or respond to security risks."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Countermeasure"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Includes Controls, Mitigations, CoursesOfAction, and DetectionRules. The two primary branches are preventive/reactive measures (Mitigation, CourseOfAction, Control), which are also stonework:Behaviors that plans implement, and detection logic (DetectionRule, Signature). A Countermeasure describes the safeguard or procedure; the deployed mechanism that can apply it is a stonework:SecurityActuator, and a particular application is a stonework:SecurityActuation."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Country",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Location"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A sovereign state or top-level administrative entity recognized internationally."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Country"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#CourseOfAction",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Mitigation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A specific, contextualized recommended action or set of steps to prevent or respond to a threat, attack, or incident."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Course of Action"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "More prescriptive and situational than a general Mitigation — a CourseOfAction packages guidance for a specific threat context. Corresponds to the STIX 2.1 CourseOfAction SDO. General reusable controls (e.g. ATT&CK mitigations) are modeled as Mitigation; specific incident response actions are CourseOfAction."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#CryptoAddress",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Identifier"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An on-chain address that identifies a destination for value on a distributed ledger."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Crypto Address"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "The address string is stonework:walletAddress. Attach a CryptoAddress to the wallet it identifies, a stonework:FinancialAccount, with stonework:hasIdentifier; the address's asset and network are then traversable through ^stonework:hasIdentifier/stonework:accountCurrency and stonework:blockchainNetwork. Sibling of stonework:EmailAddress and stonework:MACAddress."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#CryptoAsset",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Currency"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "virtual asset"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A cryptocurrency, stablecoin, or other token that serves as a unit of value on a distributed ledger."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Crypto Asset"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Instances are the assets themselves (e.g. Bitcoin, Ether, a specific ERC-20 token) — not wallets, addresses, or holdings. A wallet is modeled as a stonework:FinancialAccount and its address as a stonework:CryptoAddress; an amount of a crypto asset is a stonework:MonetaryAmount whose stonework:currency is the CryptoAsset. The same nominal token issued on multiple ledgers is modeled as distinct individuals distinguished by stonework:blockchainNetwork. 'Virtual asset' is the FATF term; a service that custodies or exchanges them is a virtual asset service provider (stonework:FinancialInstitution categorized accordingly)."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Currency",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A unit in which monetary value is denominated — a fiat currency or a crypto asset."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Currency"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "The range of stonework:currency on stonework:MonetaryAmount. Fiat units are supplied as a closed controlled vocabulary in stonework:fiatCurrencyScheme (ISO 4217). Crypto units are stonework:CryptoAsset individuals, created as needed rather than pre-enumerated. Currency itself carries no instances directly."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#CvssMetric",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Assessment"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A structured technical-severity assessment of a vulnerability using the Common Vulnerability Scoring System, carrying a version, vector, base score, and qualitative severity."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "CVSS Metric"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Use stonework:hasCvssMetric to attach one or more source-specific assessments to a Vulnerability. Identify the scoring authority with stonework:createdBy and preserve the source record with stonework:hasProvenance. The direct stonework:cvssBaseScore, stonework:cvssSeverity, and stonework:cvssVector properties are query-friendly headline projections. CVSS base metrics are context-neutral; environmental metrics may adjust technical severity for a deployment context, but CVSS does not establish whether the vulnerable product is present or constitute a full enterprise risk assessment. Use stonework:VulnerabilityAssessment for that contextual judgment. A plan that calculates or consumes a CVSS assessment may bind a Variable to this assessment, but the Variable is an execution-time value and does not replace the vulnerability-to-metric relationship."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#CyberActivity",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A specific occurrence or performance of actions by one or more agents over time within a cyber or sociotechnical context."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Cyber Activity"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "One of two root classes in STONEWORK alongside CyberEntity. Superclass for Campaigns, CyberActivityClusters, Incidents, Operations, Events, and Processes. Aligns with BFO Occurrent and BFO Process."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#CyberActivityCluster",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberActivity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An analytically identified aggregate of cyber activities grouped because available evidence suggests a common source, mechanism, or operational thread."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Cyber Activity Cluster"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "A CyberActivityCluster is unified by analytic correlation rather than the objective and time period of a Campaign, the unified command or intent of an Operation, the execution sequence of a Process, or the inquiry purpose of an Investigation. It does not require a known objective, responsible Agent, precise boundaries, or a conclusion that the activity is adversarial. It denotes the body of activity believed to be related, not the intelligence artifact recording that judgment; use stonework:Grouping, stonework:Report, or stonework:Assessment for the artifact. Only CyberActivity instances are members through stonework:memberOfActivityCluster and stonework:hasMemberActivity; relate tools, malware, infrastructure, and responsible participants through their specific relationships. The STIX adapter maps its narrower intrusion-set source class to CyberActivityCluster."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Any concept, object, or resource that exists or operates within a cyber or sociotechnical domain."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Cyber Entity"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "One of two root classes in STONEWORK. Groups all persistent entities — Agents, Infrastructure, DigitalArtifacts, PhysicalArtifacts, Behaviors, IntelligenceProducts, SecurityConditions, RiskFactors, Countermeasures, and related classes. Aligns with BFO Continuant. The sibling root class CyberActivity covers happenings (Campaigns, Incidents, Operations, etc.)."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#CyberTechnique",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Technique"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A technique performed within or against cyberspace, encompassing both offensive and defensive cyber operations."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Cyber Technique"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@value" : "Mirrors D3FEND's CyberTechnique class. Subclassed by stonework:AttackTechnique (offensive) and stonework:DefendTechnique (defensive), enabling a single property chain to span both ATT&CK and D3FEND individuals."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#DDoS",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#MalwareType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Malware designed to conduct or participate in distributed denial-of-service attacks against target systems or networks."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#malwareTypeScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "ddos"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "DDoS Malware"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#DataAsset",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A defender-owned collection of data or information with organizational value, such as databases, intellectual property, credentials stores, or PII collections."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Data Asset"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Represents data as a targetable resource distinct from the systems that store or process it. Used to model what adversaries seek to access, exfiltrate, or destroy rather than the infrastructure they exploit to reach it."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#DefendTechnique",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberTechnique"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A prescribed defensive method used to detect, prevent, or respond to adversary behavior within a target environment."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Defend Technique"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@value" : "Aligns with MITRE D3FEND DefensiveTechnique. Framework-specific subclasses (e.g. d3fend:DefensiveTechnique) extend this class when D3FEND data is loaded."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#DefensiveTactic",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Tactic"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A high-level defensive objective that groups related countermeasure techniques by the protection goal they serve."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Defensive Tactic"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Aligns with MITRE D3FEND defensive tactics (e.g. Harden, Detect, Isolate, Evict, Restore). Individuals are typically drawn from D3FEND or similar defensive frameworks via the framework mapping layer."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#DetectionPlan",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#InvestigationPlan"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A Step-decomposed sequence of actions for determining whether observed activity constitutes a security-relevant violation, as distinct from the offensive or defensive action plans that respond to one."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Detection Plan"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "A specialization of stonework:InvestigationPlan narrowly scoped to violation triage: orchestrating DetectionRule/Signature evaluation and analytic logic to identify whether a violation occurred, typically triggering a defensive Playbook or ControlPlan via a guarded Transition once one is confirmed. Where a Playbook is an action plan carried out by an interested party — offensive (an adversary's operational playbook) or defensive (an incident responder's playbook) — a DetectionPlan plays a neutral, evaluative role, watching for the kind of changes an InvestigationPlan more broadly investigates."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#DetectionRule",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Countermeasure"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A structured, machine-readable rule designed to detect malicious or suspicious activity, techniques, or indicators. It may be signature-based, behavioral, correlation-based, or analytic."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Detection Rule"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Encompasses pattern-matching signatures (YARA, Snort, Suricata), behavioral rules (Sigma), SIEM correlation logic, and analytic detections. Signature is a subclass for content-centric, indicator-matching rules."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Deviation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#QualifiedAssertion"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An established finding that one run of a Plan departed from that Plan: a required Step was not performed, or was performed by the wrong Role, by the same Agent as a Step it must be separated from, out of order, or through an identity used by someone other than its holder."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Deviation"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "The finding of conformance checking, in process mining's terms. The run is stonework:deviationRun, the Steps concerned stonework:deviationStep, the executions concerned (if any) stonework:deviationExecution, the kind stonework:deviationKind, and the evidence stonework:evidencedBy; the Investigation that establishes it stonework:produces it. A query over runs can propose candidates, such as a Step the Plan's guards required that has no execution in the run, or an execution whose performer doesn't hold the Step's stonework:performerRole. But a missing execution doesn't show that the Step wasn't done, only that it wasn't recorded: the Deviation is the analyst's finding, with evidence, that it wasn't. Checks that can't resolve a performer to an Agent, or whose performer may be a misused identity, report the case as undetermined, not as conforming. A Control that failed is reached through the Step (stonework:deviationStep / stonework:implements)."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#DeviationKind",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid273"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A classification of how a run departed from its Plan."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Deviation Kind"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Applied via stonework:deviationKind to Deviation individuals. Named individuals: skipped, wrong role, same agent, out of order, misused identity, wrong target."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#DigitalArtifact",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Any discrete digital object or content entity that can be observed, transmitted, stored, or acted upon in a cyber environment."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Digital Artifact"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Includes files, hashes, malware samples, network traffic captures, and other content-bearing items. Aligns with D3FEND DigitalArtifact concepts. Sibling of stonework:PhysicalArtifact."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#DigitalIdentity",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Agent"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A digital representation or persona of an Agent, inferred from one or more identifiers (email, phone, account, etc.). It may or may not be attributed to a known real-world Agent."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Digital Identity"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Useful when you observe identifiers without confirmed attribution. Can aggregate multiple Identifiers and later be linked to a real-worldAgent."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Directory",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#DigitalArtifact"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Directory"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Domain",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Infrastructure"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Represents a network domain name. Can reference the IP addresses it resolves to."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Domain"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Downloader",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#MalwareType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Malware whose primary function is to download and execute additional malicious payloads from a remote source."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#malwareTypeScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "downloader"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Downloader"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Dropper",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#MalwareType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Malware that carries and installs one or more secondary payloads onto a target system, often unpacking them from within itself."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#malwareTypeScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "dropper"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Dropper"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#EmailAddress",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Identifier"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Represents a single email address, optionally associating it with a display name and a user account."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Email Address"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#EmailAuthenticationMethod",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid274"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A sender-authentication method for email."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Email Authentication Method"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Applied via stonework:hasEmailAuthenticationMethod to EmailAuthenticationResult individuals. Named individuals: SPF, DKIM, DMARC, ARC."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#EmailAuthenticationResult",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Assessment"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The verdict of one sender-authentication check (SPF, DKIM, DMARC or ARC) on an EmailMessage, as a receiving server recorded it in an Authentication-Results header: the method, the verdict, the domain checked, and the server that checked."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Email Authentication Result"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "A pass authenticates the domain, not the sender's honesty: a lookalike domain registered by an actor passes SPF, DKIM and DMARC for itself. Compare stonework:authenticatedDomain with the domain the recipient expected. The method and verdict are categories (stonework:hasEmailAuthenticationMethod, stonework:hasAuthenticationVerdict)."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#EmailMessage",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#DigitalArtifact"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A discrete email communication, including headers, body content, and optional attachments, transmitted over an email protocol."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Email Message"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Distinct from stonework:EmailAddress, which represents the sender/recipient identifier. An EmailMessage is the content artifact itself. Used to represent phishing lures, spear-phishing emails, or other email-borne threat delivery mechanisms. Corresponds to STIX EmailMessage SCO. Its headers: the addresses by role (stonework:hasFromAddress, hasSenderAddress, hasReplyToAddress, hasReturnPathAddress, hasToAddress, hasCcAddress, hasBccAddress), stonework:fromDisplayName, emailSubject, sentAtTime, messageId, the thread (inReplyTo, referencesMessage), and the receiving servers' stonework:hasAuthenticationResult. Each Received header is a hop: a stonework:Event generatedFrom the message, with its time (startedAtTime), the sending server's address (hasSourceAddress) and the receiving server (occursOn)."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Equals",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#ComparisonOperator"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The guardVariable's bound value equals guardLiteralValue."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "eq"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Equals"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Event",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberActivity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An atomic, observable occurrence in a system, network, or environment that has potential security relevance but has not yet been assessed or declared as an Incident."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Event"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Represents the pre-triage state — a raw log entry, alert, or sensor observation. Distinguished from Incident by the absence of human or automated assessment declaring it significant and adverse. Useful for SIEM, log-based, and threat hunting use cases. An Event parsed from a record keeps the link to it (stonework:generatedFrom) and names who performed it (stonework:performedBy). When an analyst places it in a run (stonework:correspondsToStep, stonework:partOfExecution) it stays an Event: it is the execution of that Step without changing type, and its link to the record remains."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#ExecutionOutcome",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid275"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "How an execution of a Step or Plan, or any observed activity, ended: succeeded, failed, timed out or interrupted."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Execution Outcome"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "The value of a Step's stonework:outcomeVariable in a run, and of stonework:hasOutcome on any activity. Named individuals: succeeded, failed, timed out, interrupted. A timeout is kept apart from other failures, as CACAO reports it separately; interrupted (not in CACAO) is an activity that paused for something more, such as a further authentication step, and continues in another record."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#ExploitKit",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#MalwareType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A toolkit that automates exploitation of client-side vulnerabilities to deliver malware, typically via drive-by download from compromised or malicious web pages."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#malwareTypeScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "exploit-kit"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Exploit Kit"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#ExploitMaturity",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid276"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "How mature a known exploit for a vulnerability is."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Exploit Maturity"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Applied with stonework:hasExploitMaturity. poc means a proof of concept exists. weaponized means the exploit is reliable against most targets or is built into an attack tool or malware. A source report that exploitation was observed is stonework:metricReportedExploited. Membership in a known-exploited catalog is stonework:metricKevMembership, with the catalog named by the observation's provenance."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#ExploitationReportKind",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid277"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "What a source's report that a vulnerability was exploited says about who exploited it."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Exploitation Report Kind"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Applied with stonework:hasExploitationReportKind to a stonework:MetricObservation of stonework:metricReportedExploited."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#FalsePositiveRate",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid278"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An ordinal classification of the expected false-positive frequency of a detection rule."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "False Positive Rate"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Feed",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Provenance"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A structured data source that provides indicators, intelligence, or enrichment data on a regular or continuous basis."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Feed"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Examples: URLHaus, AlienVault OTX, Abuse.ch, commercial threat feeds, etc."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#File",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#DigitalArtifact"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A discrete unit of data stored on a filesystem, identified by name, path, and cryptographic hash. Includes executable binaries, scripts, documents, archives, and other file types relevant to cyber threat analysis."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "File"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Linked to hash values via stonework:hasHash. A MalwareSample may be associated with its File representation. Framework-specific extensions (PE headers, NTFS streams, archive contents) are modeled at the framework layer."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#FinancialAccount",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Account"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An account that can hold a balance of, or transfer, economic value — fiat currency, cryptocurrency, or monetary-equivalent stored value such as gift-card credit, gaming currency, or loyalty points redeemable for goods."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Financial Account"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Defined by function, not by the holder: an account at a regulated bank, brokerage, or exchange and a stored-value balance at a non-financial merchant are both FinancialAccounts. Whether it is held at a regulated institution is recorded with the optional stonework:heldAt link, not by the class. Account kind (checking, custodial wallet, prepaid card, exchange account) is asserted with stonework:categorizedBy a stonework:FinancialAccountType. Identifiers such as an IBAN, domestic account number, or crypto address attach with stonework:hasIdentifier. Use stonework:accountCurrency for each currency or crypto asset the account holds or is denominated in; it is intentionally multi-valued. Balance over time is a stonework:MetricObservation. A crypto wallet is a FinancialAccount; its on-chain address is a stonework:CryptoAddress."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#FinancialAccountType",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid279"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A classification of a financial account by the kind of value custody or service it represents."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Financial Account Type"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#FinancialInstitution",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Organization"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An organization whose business is holding, moving, exchanging, or safeguarding financial assets on behalf of others — a bank, credit union, broker-dealer, payment processor, money services business, or virtual asset service provider."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Financial Institution"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "The natural bearer of institution identifiers (stonework:bic, stonework:abaRoutingNumber) that should not broaden bare stonework:Organization, and the range of stonework:heldAt. Institution kind is asserted with stonework:categorizedBy a stonework:FinancialInstitutionType. The Legal Entity Identifier is a general organization identifier (stonework:lei), not institution-specific."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#FinancialInstitutionType",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid280"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A classification of a financial institution by its regulatory form and the service it provides."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Financial Institution Type"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#FinancialTransaction",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberActivity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A movement of economic value from one financial account to another, occurring over a definite period and optionally attributed to the agents responsible for initiating it."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Financial Transaction"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "An occurrent: it starts and settles at a time (stonework:startedAtTime and stonework:endedAtTime), is attributed with stonework:attributedTo, and can be sighted, investigated, and grouped into a stonework:CyberActivityCluster. Originator and beneficiary are given by stonework:originatorAccount and stonework:beneficiaryAccount; correspondent hops by stonework:intermediaryAccount. The transferred value is a stonework:MonetaryAmount via stonework:hasMonetaryValue. Use stonework:originatorMonetaryValue and stonework:beneficiaryMonetaryValue when the debited input and credited output differ, as in a currency exchange. Flat stonework:transactionAmount and stonework:transactionCurrency are convenience projections only for a single-denomination transfer. A blockchain transaction is a FinancialTransaction whose accounts are crypto wallets. Divergent source records of one economic event are handled through stonework:hasProvenance and stonework:Sighting rather than a distinct record class. Use stonework:hasBehavior to link a transaction, or a cluster of them, to a stonework:IllicitFinanceTechnique it exhibits. Use stonework:fundsActivity only when the transaction finances an activity; use stonework:respondsToActivity when a transaction occurs in response to an activity, such as a victim's ransom payment."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#FlowKind",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid281"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A classification of how control flow splits after a Step or joins before one."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Flow Kind"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Applied via stonework:splitKind and stonework:joinKind to Steps. Named individuals: exclusive, parallel."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#GranularMarking",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A marking application that assigns a data-handling marking to selected fields or portions of another cyber entity."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Granular Marking"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Represents the structural application of a marking, including its selectors and referenced marking definition. It is distinct from a stonework:Markings category value, which expresses the handling designation itself."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#GreaterThan",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#ComparisonOperator"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The guardVariable's bound value is greater than guardLiteralValue."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "gt"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Greater Than"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#GreaterThanOrEqual",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#ComparisonOperator"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The guardVariable's bound value is greater than or equal to guardLiteralValue."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "ge"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Greater Than Or Equal"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Group",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Agent"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Any collection of Persons, Organizations, or other Groups that share a common purpose or identity but do not necessarily have formal legal structure."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Group"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Used for informal collectives, communities, ad-hoc teams, criminal syndicates, or loose alliances. More general than Organization. Can contain other Groups or Organizations."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Grouping",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#IntelligenceProduct"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A structured intelligence product that asserts shared context among a set of referenced cyber threat intelligence entities."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Grouping"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Use when related objects need to be collected without the narrative and publication semantics of a Report. Corresponds to the STIX 2.1 Grouping SDO."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Hash",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Identifier"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A single cryptographic hash entry associating a hashing algorithm with its hex-encoded digest value. Used to represent entries in the STIX hashes dictionary."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Hash"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Host",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Infrastructure"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A computing system, device, or endpoint (physical, virtual, container, or cloud instance) that can run processes, host files, and participate in networks."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Host"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#HumanSource",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Provenance"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A person who provides information, intelligence, or a report (as opposed to automated feeds or technical artifacts)."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Human Source"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Often used in HUMINT or OSINT contexts. Reliability scoring is commonly applied to human sources."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Hypothesis",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#IntelligenceProduct"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A structured, falsifiable prediction about the value a Variable will resolve to once the Behavior or Step declaring that Variable executes."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Hypothesis"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Formalizes the anticipated side of the Variable lifecycle described in stonework:Variable's scopeNote: a Hypothesis names, in advance, the value an output Variable is predicted to be bound to. Linked to the Variable it predicts via stonework:predictsVariable, and to the prediction itself via stonework:predictedType (a class, the common case — mirrors stonework:guardType), stonework:predictedValue (a specific individual), or stonework:predictedLiteral (a scalar) — mirroring stonework:boundTo/stonework:boundToLiteral on the actual-result side. A Hypothesis is judged against the stonework:VariableBinding of its Variable in the Investigation that tests it (stonework:testsHypothesis): the binding stonework:boundIn that Investigation or in an execution stonework:partOfExecution it. When a run binds the Variable more than once, as when one search Step is run for each of several mailboxes, the Step's own execution (itself an Investigation) tests the Hypothesis, so that one binding judges it. A Transition's guard properties, which test a Variable's actual bound value, implicitly test agreement with whichever Hypothesis predicted that Variable — confirming it if they match, refuting it otherwise. May attach at any level of a Step/Plan decomposition, since stonework:Step is itself a stonework:Behavior. What a Hypothesis is about is stonework:hypothesisAbout. A compound claim, such as \"actor X is using technique Y\", is a Hypothesis whose stonework:hypothesisPart values are its separately testable claims (the activity, the attribution), so a refuted compound shows which part failed. Lineage keeps the earlier Hypothesis: stonework:splitFrom names the one this was split from, stonework:absorbedInto the one this was merged into, and stonework:obsoletes the one this replaces. The earlier Hypothesis's status becomes superseded unless it was already confirmed or refuted."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#HypothesisStatus",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid282"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A classification of a Hypothesis's position in the confirm/refute lifecycle."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Hypothesis Status"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Applied via stonework:hasHypothesisStatus to Hypothesis individuals. Named individuals: pending (not yet tested), confirmed (actual result matched the prediction), refuted (actual result did not match the prediction)."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#IBAN",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Identifier"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An International Bank Account Number (ISO 13616): the cross-jurisdiction normalized identifier for a bank account."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "IBAN"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "The value is stonework:iban. A single stonework:FinancialAccount may carry both an IBAN and one or more domestic identifiers (stonework:BankAccountNumber) via stonework:hasIdentifier; the IBAN is the normalized form that reconciles differing national account-number formats."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#IPAddress",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Infrastructure"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Represents a single IP address (IPv4 or IPv6)."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "IP Address"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#IPBlock",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Infrastructure"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A Classless Inter-Domain Routing (CIDR) block used to represent an IP network range."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "IP Block"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Identifier",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A first-class representation of a security-relevant identifier value, such as an email address, cryptographic hash, MAC address, phone number, URI, or user-agent string."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Identifier"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Identifier does not provide the RDF identity of every CyberEntity and does not imply that every CyberEntity has an Identifier. Named RDF resources are identified by their IRIs; identifiers originating in external systems are recorded with dcterms:identifier or stonework:externalId. Use the most specific available subclass, such as EmailAddress, Hash, MACAddress, PhoneNumber, URI, or UserAgent. Instantiate Identifier directly only when the identifier type is unknown or no suitable subclass exists."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#IdentityControl",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#QualifiedAssertion"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A qualified record that an Agent controlled a DigitalIdentity, able to act through it, during an interval."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Identity Control"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "The Agent is stonework:controllingAgent, the identity stonework:controlledIdentity, and the interval stonework:validFrom and stonework:validUntil; with no validUntil, control continues or its end is unknown. Evidence is stonework:evidencedBy (the sign-ins, the audit records), and provenance and confidence apply as on any qualified assertion. Three facts about identities differ: stonework:attributedToAgent (and stonework:accountOf) says whose an identity is, with no time; stonework:attributedTo on an activity says who did that one thing; an IdentityControl says who could act through the identity, and when. Control is not exclusive: the holder usually keeps using the account while an actor also controls it, so every execution performed through the identity in the interval and not yet attributed needs review. Typically used for a compromise, but it also fits delegated or shared access. No timeless projection property is declared, since it would lose the interval that is the point. When control is itself in doubt, a stonework:Hypothesis can be stonework:hypothesisAbout the IdentityControl."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#IllicitFinanceTechnique",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Technique"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A prescribed method for disguising the origin, ownership, or destination of illicitly obtained funds, or for moving value while evading financial controls."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Illicit Finance Technique"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Covers money-laundering typologies and the adjacent methods of terrorist financing, sanctions evasion, and financial fraud. A neutral structural slot: STONEWORK defines the class but not its individuals. A starter set of FATF-derived typology individuals is supplied by the optional frameworks/fatf.ttl module; other bodies' typology sets can populate the same class. Link an exhibiting stonework:FinancialTransaction or stonework:CyberActivityCluster with stonework:hasBehavior. Because the class sits under stonework:Technique, a concrete laundering chain can later be modeled as a stonework:Procedure that stonework:implements a typology, with no rework."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Impact",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Instances of stonework:Impact SHOULD specify the affected asset or mission, the type of consequence, and the severity level. Impact SHOULD be represented using explicit properties rather than encoded in class IRIs or labels."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#RiskFactor"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The magnitude of harm, loss, or adverse effects that would result if a threat were realized and a compromise occurred, expressed in terms of mission, business, operational, or technical consequences."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Impact"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@value" : "Impact represents the severity of consequences associated with a compromise. It may include effects on confidentiality, integrity, availability, safety, mission success, financial loss, or reputational damage. Impact values may be qualitative or quantitative."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#ImpactLevel",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid283"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An ordinal classification of the magnitude of a security impact."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Impact Level"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#ImpactType",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid284"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A classification of the security dimension or consequence affected by an impact."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Impact Type"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Incident",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberActivity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A significant adverse event or series of related events that has caused, or has the potential to cause, harm to an organization’s operations, assets, or people."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Incident"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Distinguished from stonework:Event (a raw, unassessed occurrence) by the presence of human or automated triage declaring significance and adversity. An Incident may aggregate multiple Events, involve one or more Campaigns, and trigger Investigation and Playbook execution."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#IncidentStatus",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid285"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A classification of an incident's position in the response lifecycle."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Incident Status"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Indicator",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#IntelligenceProduct"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An intelligence assertion that a pattern — atomic, expression-based, or behavioral — when matched in an observed environment, indicates the presence of threat activity attributable to a specific adversary behavior, malware, or campaign."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Indicator"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "The central concept in operational CTI. The term is used by the community in three overlapping senses, all of which stonework:Indicator covers: (1) IOC sense — an atomic observable (IP address, domain, file hash, URL) that has been assessed as malicious or suspicious and tagged for detection; in STONEWORK the underlying observable is the SCO (stonework:IPAddress, stonework:Domain, stonework:Hash), and the Indicator wraps it with the assertion, confidence, and validity window. (2) Pattern sense — a STIX patterning expression over one or more SCOs (e.g., [ipv4-addr:value = ‘198.51.100.0/24’]). (3) Behavioral sense — a multi-step or TTPs-based pattern asserting that an observed sequence of behaviors indicates a technique or campaign. Distinct from stonework:DetectionRule: an Indicator is the intelligence claim (‘look for this’); a DetectionRule is the operational artifact that implements the check (‘here is the Sigma/Snort/YARA rule that looks for it’). Indicators are produced by threat intelligence analysts and consumed by detection pipelines; DetectionRules are deployed in SIEMs, EDRs, and network sensors. Corresponds to STIX 2.1 Indicator SDO. Use stonework:indicates to link an Indicator to the AttackPattern, Malware, Campaign, or ThreatActor it asserts."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Industry",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Sector"
  }, {
    "@id" : "_:genid286"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A specific branch of economic activity or commercial sector (typically modeled using NAICS or similar codes)."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Industry"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Examples: Financial Services, Manufacturing, Retail, Pharmaceuticals."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Infrastructure",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Represents systems, software services, or any group of resources used to conduct cyber operations. Infrastructure is used by threat actors and intrusion sets both offensively and defensively."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Infrastructure"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#InfrastructureType",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid287"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A classification of infrastructure by its operational role or purpose within a cyber operation."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Infrastructure Type"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Applied via stonework:categorizedBy to Infrastructure individuals. Covers both adversary-controlled infrastructure (C2, staging, phishing) and defender infrastructure (firewall, workstation). Aligns with the STIX 2.1 infrastructure-type open vocabulary."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#IntelligenceProduct",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A structured artifact produced by an intelligence or analytical process, intended to convey findings, assessments, observations, or sourcing context to support decision-making."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Intelligence Product"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "The intelligence product hierarchy covers the outputs of the intelligence lifecycle: Reports, Assessments, Sightings, Notes, and Provenance records. Distinguished from stonework:DigitalArtifact (raw observable technical data) and stonework:Behavior (plan specifications and TTP patterns). Intelligence products are the result of human or automated analytical work applied to raw data — they carry judgment, context, and traceability that raw artifacts do not."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Investigation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Process"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A systematic Process of inquiry, evidence collection, analysis, hypothesis testing, and conclusion to understand, attribute, or resolve security incidents, threats, anomalies, or other matters of interest."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Investigation"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Includes digital forensics, threat hunting, root cause analysis, and incident investigations, and the cases an analyst works. Its subject is stonework:investigates; its sources are stonework:examines (intelligence products) and stonework:collects (digital artifacts as evidence); its hypotheses are stonework:testsHypothesis; its reviews of records are stonework:Reviews that are stonework:partOfExecution it; its output is stonework:producesReport. Who works it is stonework:performedBy and stonework:leadInvestigator; when, stonework:startedAtTime and stonework:endedAtTime. Its lifecycle is stonework:hasInvestigationStatus, how it ended is stonework:hasInvestigationOutcome, and its urgency is stonework:hasPriority (all in categories.ttl). An Investigation merged into another keeps its record, linked by stonework:mergedInto."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#InvestigationOutcome",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid288"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A classification of how a closed investigation ended."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Investigation Outcome"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#InvestigationPlan",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An InvestigationPlan is a plan specification; executing one produces an instance of stonework:Investigation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Plan"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A Step-decomposed sequence of actions for systematically examining a cyber entity, artifact, or event to determine its nature, extent, or significance."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Investigation Plan"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "The general assessment-plan counterpart to stonework:Playbook on the production side: where a Playbook's execution changes state in the world, an InvestigationPlan's execution (a stonework:Investigation) produces judgment about something that already exists or happened — typically a stonework:Analysis or stonework:Assessment. stonework:DetectionPlan is a specialized subclass, narrowly scoped to determining whether observed activity constitutes a security-relevant violation; broader analytical work (forensic analysis, malware analysis, vulnerability assessment) is modeled directly as InvestigationPlan."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#InvestigationStatus",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid289"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A classification of an investigation's position in its lifecycle."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Investigation Status"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Keylogger",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#MalwareType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Malware that records keystrokes on an infected system to capture credentials, sensitive data, or communications."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#malwareTypeScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "keylogger"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Keylogger"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#KillChainPhase",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid290"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A named phase within a kill chain or attack lifecycle framework used to categorize the stage of an offensive or defensive operation."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Kill Chain Phase"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Applies to both offensive frameworks (Lockheed Martin Cyber Kill Chain, MITRE ATT&CK) and defensive lifecycle models. Used to tag AttackTechniques, Procedures, or Events with their operational phase."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#LaunderingStage",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Tactic"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "One of the classic phases of a money-laundering scheme — placement, layering, or integration — grouping the techniques that serve that phase's objective."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Laundering Stage"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "The illicit-finance counterpart of stonework:OffensiveTactic: a high-level objective that groups stonework:IllicitFinanceTechnique individuals via stonework:hasTechnique. A neutral structural slot; the three canonical individuals are supplied by frameworks/fatf.ttl."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#LessThan",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#ComparisonOperator"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The guardVariable's bound value is less than guardLiteralValue."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "lt"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Less Than"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#LessThanOrEqual",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#ComparisonOperator"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The guardVariable's bound value is less than or equal to guardLiteralValue."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "le"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Less Than Or Equal"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Likelihood",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Instances of stonework:Likelihood may incorporate assumptions, uncertainty, adversary behavior, historical frequency, or environmental conditions. Likelihood SHOULD be represented using explicit properties rather than encoded in class IRIs or labels."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#RiskFactor"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The estimated probability, plausibility, or frequency with which a threat could be realized and lead to a compromise under specified conditions."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Likelihood"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@value" : "Likelihood reflects the chance that a compromise will occur, considering adversary capability, intent, opportunity, preconditions, and environmental factors. Likelihood values may be qualitative, ordinal, or quantitative."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#LikelihoodLevel",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid291"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An ordinal classification of the assessed likelihood that a security outcome will occur."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Likelihood Level"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Location",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Represents a geographic location. May be as specific as a latitude/longitude coordinate or as broad as a continent. At least one of region, country, or latitude/longitude must be provided."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Location"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "STONEWORK Location is a STIX-style geographic designator, not a BFO Site of occupancy. The BFO adapter maps it to an information content entity that denotes a place."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Log",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#DigitalArtifact"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A structured or semi-structured record of events, actions, or state changes generated by a system, application, or network component over time."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Log"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Logs are primary data sources for detection, investigation, and threat hunting. Examples include system event logs, authentication logs, DNS query logs, firewall logs, and application logs. Distinct from NetworkTraffic (which captures raw packet data) and from Event (which represents a parsed, security-relevant occurrence derived from log data)."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#MACAddress",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Identifier"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A media access control address that identifies a network interface at the data-link layer."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "MAC Address"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Covers 48-bit and 64-bit MAC address representations, including values carried by the STIX 2.1 MAC Address SCO."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#MailboxRule",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#DigitalArtifact"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A rule a mailbox applies automatically to the email it receives: conditions that select messages, and actions taken on them, such as forwarding, moving or deleting."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Mailbox Rule"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Covers server-side inbox rules (Exchange, Microsoft 365), client rules and webmail filters (Gmail). An actor holding a mailbox's credentials creates one to read mail without signing in again (ATT&CK T1114.003, Email Forwarding Rule) or to keep replies and warnings from the holder (T1564.008, Email Hiding Rules). The activity that creates a rule produces it (stonework:produces); later changes and its removal are activities that act on it (stonework:actsOn). Rules applied by the mail service to a whole organization (transport or mail-flow rules) are not mailbox rules."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Malware",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A software object intended to perform malicious functions within, or on behalf of, a threat actor. Encompasses both abstract family-level concepts and concrete specimen-level artifacts."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Malware"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Parent class for stonework:MalwareFamily (STIX is_family=true) and stonework:MalwareSample (STIX is_family=false). Corresponds to the STIX 2.1 malware SDO. Use stonework:categorizedBy to assert behavioral type (e.g., stonework:Ransomware). Use stonework:hasArtifact to link a sample to its captured binary."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#MalwareAnalysis",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Analysis"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A structured record of findings from static or dynamic analysis performed on a malware specimen or family, including the tool used, analysis configuration, and verdict."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Malware Analysis"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Captures the output of a single analysis run: antivirus scan, sandbox execution, reverse-engineering session, etc. Key properties include the analysis product and version, the result verdict (malicious/suspicious/benign/unknown), and references to SCOs observed during analysis. Corresponds to STIX 2.1 MalwareAnalysis SDO."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#MalwareFamily",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Malware"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#Product"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An abstract malware concept representing a named strain, lineage, or campaign of malicious software sharing common behavioral patterns, code ancestry, or infrastructure. Corresponds to STIX 2.1 malware SDO with is_family=true."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Malware Family"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Examples: Cobalt Strike, Mimikatz, WannaCry, BlackCat. A MalwareFamily does not have a specific hash or binary but may be linked to MalwareSample instances via the inverse of stonework:memberOfFamily. Use stonework:categorizedBy to assert behavioral type (e.g., stonework:Ransomware, stonework:Backdoor)."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#MalwareSample",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Malware"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#VersionedProduct"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A discrete, observable instance of malicious code — a specific binary, script, or executable artifact that can be identified by cryptographic hash, file characteristics, or behavioral signature."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Malware Sample"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Represents a concrete sample rather than an abstract family concept. A single MalwareFamily may have thousands of associated samples across versions, packers, and dropper variants. Samples are linked to their family via stonework:memberOfFamily and to their file representation via stonework:hasHash or a direct stonework:File association. Properties such as stonework:drops, stonework:downloads, and stonework:communicatesWith describe the behavior of this specific sample, not the family in general."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#MalwareType",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid292"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A behavioral or functional classification of malware, describing what the malware does rather than what it is. Corresponds to the STIX 2.1 malware-type open vocabulary."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Malware Type"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Instances (e.g., stonework:Ransomware, stonework:Trojan) are assigned via stonework:categorizedBy. A malware object may carry multiple types. The skos:notation value gives the STIX 2.1 wire-format string for aspirational round-trip export."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Markings",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid293"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Defines a data handling marking used to restrict or label how data can be shared or handled, such as TLP markings. Referenced by object_marking_refs or granular_markings."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Markings"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#MetricObservation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#QualifiedAssertion"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A qualified, time-stamped metric value about a cyber entity, carrying its metric type, source provenance, and optional calculation-model version."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Metric Observation"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Use for values that change over time or differ by source, including EPSS probability and percentile, known-exploited catalog membership, confidence, likelihood, risk scores, and normalized monetary valuations. Which source produced a value is stonework:hasProvenance, not a separate metric type. A stonework:metricNormalizedValue observation records its output currency with stonework:valuationCurrency. Direct datatype properties remain convenience projections for consumers that need a single current value."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#MetricType",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid294"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A controlled classification identifying the meaning and scale of a qualified metric observation."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Metric Type"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Mitigation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "https://csrc.nist.gov/glossary/term/mitigation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Behavior"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#Countermeasure"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A deliberate action or control intended to reduce the likelihood, impact, or severity of a risk, threat, vulnerability, or adverse event."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Mitigation"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Mitigations are proactive or reactive measures applied to address weaknesses or threats. Examples include: applying a security patch, enabling MFA, deploying a firewall rule, isolating a compromised host, or training users. A Mitigation may be a reusable control (ATT&CK sense) or a specific situational action. CourseOfAction is a subclass for contextualized, packaged response actions. Like stonework:Control, a Mitigation is a stonework:Behavior: a specification of how to act, not an occurrence. So a stonework:ControlPlan, or one of its Steps, stonework:implements an ATT&CK mitigation the same way it implements a NIST control, and the technique it mitigates is reached through stonework:mitigatesAttackPattern either way."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#MobileDevice",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Host"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A portable computing device with wireless connectivity, typically used for communication, data processing, and accessing networks (e.g., smartphones, tablets, or laptops with cellular capability)."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Mobile Device"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "In a cyber threat context, Mobile Devices are often treated as both endpoints (Infrastructure) and vectors for attacks (e.g., mobile malware, phishing, lost/stolen device risks). They may host UserAccounts, run Mobile Applications, and connect via cellular, Wi-Fi, or Bluetooth."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#MonetaryAmount",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A quantity of money: a decimal magnitude paired with the currency that denominates it."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Monetary Amount"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Reified so magnitude and currency always travel together, mirroring how stonework:Hash pairs algorithm and digest. Attached to a transaction, account, impact, or demand with stonework:hasMonetaryValue or a monetary-value role subproperty. The magnitude is stonework:amount and the unit is stonework:currency. A currency-normalized valuation of the same amount, for example its USD equivalent at a stated time and rate source, is a stonework:MetricObservation on this amount with stonework:valuationCurrency identifying the output currency."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Motivation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid295"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The reason or driving force behind an adversary's decision to conduct an attack or operation."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Motivation"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Applied via stonework:categorizedBy to ThreatActor, Campaign, or Operation individuals. Named individuals cover the STIX 2.1 attack-motivation open vocabulary. Custom motivations may be added as additional individuals."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Mutex",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#DigitalArtifact"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A named mutual exclusion object (mutex or semaphore) used by a process to prevent concurrent access to a shared resource. Commonly used as a malware indicator — malware families often create uniquely named mutexes to avoid re-infecting a host."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Mutex"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Mutex names serve as host-based indicators of compromise. A specific mutex name found on a system can be attributed to a known malware family. Corresponds to the STIX 2.1 Mutex SCO."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#NetworkService",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Infrastructure"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A network-accessible service or endpoint provided by infrastructure, such as HTTP, DNS, or SSH servers."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Network Service"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#NetworkTraffic",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#DigitalArtifact"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A captured or observed network traffic flow between source and destination endpoints, including protocol, ports, payload characteristics, and timing."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Network Traffic"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Distinct from stonework:Log (which captures parsed event records) and stonework:Event (a security-relevant occurrence). NetworkTraffic is the raw flow artifact. May carry indicators such as user-agent strings, URI patterns, or certificate fingerprints observable in transit."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#NotEquals",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#ComparisonOperator"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The guardVariable's bound value does not equal guardLiteralValue."
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "ne"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Not Equals"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Note",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#IntelligenceProduct"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A free-text annotation attached to one or more individuals to provide additional context, analyst commentary, caveats, or confidence assessments."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Note"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Notes are analyst-authored rather than machine-generated. They may express uncertainty, sourcing context, or interpretive observations that do not fit structured properties. Corresponds to STIX 2.1 Note SDO."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#OffensiveTactic",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Tactic"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A high-level adversary objective that groups related attack techniques by the goal they serve during an intrusion or operation."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Offensive Tactic"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Aligns with MITRE ATT&CK tactics (e.g. Initial Access, Execution, Lateral Movement) and D3FEND OffensiveTactic. Individuals are typically drawn from ATT&CK or similar offensive frameworks via the STONES or framework mapping layers."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#OnlineReference",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Provenance"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A reference to an external online resource (URL, article, post, etc.) used for provenance."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Online Reference"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Operation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberActivity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A coordinated set of activities conducted by one or more agents toward a defined objective, typically spanning multiple campaigns, incidents, or phases and characterized by unified command, intent, or resourcing."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Operation"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Operations are broader in scope than Campaigns — a single Operation may encompass multiple Campaigns executed over an extended period. Applies to both offensive operations (e.g. state-sponsored cyber operations) and defensive operations (e.g. incident response operations, threat hunting operations)."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#OperationPlan",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Playbook"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Attack plan"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A Playbook specifically representing an adversary's operational plan — the offensive counterpart within the Playbook hierarchy."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Operation Plan"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Named to avoid colliding with the already-established stonework:AttackPattern and stonework:AttackTechnique, and to align with stonework:Operation, whose definition ('a coordinated set of activities... unified command, intent, or resourcing') describes the executed counterpart of an OperationPlan. Generic stonework:Playbook remains available for the undifferentiated or defensive case. User interfaces may call it an attack plan (its altLabel), the phrase practitioners use for an adversary's procedures in order, each carrying out a technique under the tactic it serves."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Opinion",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#IntelligenceProduct"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An analyst's epistemological stance on the correctness or credibility of information asserted in another intelligence object."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Opinion"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Sibling to stonework:Assessment under IntelligenceProduct. Where Assessment evaluates risk or impact, Opinion evaluates the reliability or accuracy of existing intelligence — e.g., 'I disagree with this threat score' or 'I believe this indicator attribution is incorrect'. Corresponds to STIX 2.1 Opinion SDO. The opinion value (strongly-agree to strongly-disagree) and explanation are captured via stones: properties."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Organization",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://www.w3.org/ns/prov#Organization"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Agent"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A formal or semi-formal structured entity such as a company, government agency, non-profit, military unit, or consortium with defined boundaries and usually legal identity."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Organization"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Corresponds to STIX Identity with identity_class = 'organization'. Includes corporations, government bodies, NGOs, universities, etc. Distinguished from Group by having more persistent structure, roles, and often legal standing."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#PaymentInstrument",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid296"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A classification of the instrument or rail used to move value in a financial transaction."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Payment Instrument"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Person",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://www.w3.org/ns/prov#Person"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Agent"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A single human individual."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Person"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Represents real named people (e.g. employees, threat actors, researchers). Does not include legal entities or groups. Corresponds to STIX Identity with identity_class = 'individual'."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#PhoneNumber",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Identifier"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A telephone number used to contact or identify an Agent. Used for attribution, OSINT pivoting, and identity clustering."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Phone Number"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#PhysicalArtifact",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A discrete material object relevant to cyber operations — a device, appliance, plant component, or other physical artifact that can be observed, located, or acted upon."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Physical Artifact"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Sibling of stonework:DigitalArtifact. Covers ICS and OT assets such as PLCs, RTUs, safety systems, and HMIs, as well as other tangible devices in a cyber-physical environment. An ICS device that runs processes and participates in networks may also be typed as stonework:Host. Distinct from stonework:Infrastructure, which groups resources used to conduct cyber operations."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Plan",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://purl.org/net/p-plan#Plan"
  }, {
    "@id" : "http://www.w3.org/ns/prov#Plan"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Behavior"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A specification of actions, usually decomposed into Steps, that an agent intends to carry out, and that can be executed any number of times."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Plan"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "The common parent of the executable Behaviors: stonework:Playbook (and stonework:OperationPlan), stonework:ControlPlan, stonework:InvestigationPlan (and stonework:DetectionPlan), stonework:BusinessProcess, stonework:Procedure and stonework:ThreatScenario. They differ in scope and stance (whose plan it is, and whether it is believed or hypothesized), not in kind. A Plan decomposes into Steps via stonework:hasStep and declares Variables via stonework:hasInputVariable and stonework:hasOutputVariable; a Plan given only as prose has no Steps. Each execution, or run, is a stonework:CyberActivity (usually a stonework:Process) that is stonework:executionOf the Plan; the executions of its Steps are stonework:partOfExecution that run, and the values its Variables take in that run are stonework:VariableBinding individuals. Distinct from the methods a Plan implements (stonework:Technique, stonework:Control): a method is not executed step by step, and one method has many Plans that realize it. Aligns with prov:Plan and p-plan:Plan; a stonework:Step is part of a Plan rather than a Plan of its own, as p-plan:Step is distinct from p-plan:Plan."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Playbook",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A Playbook is a plan specification; executing one produces instances of stonework:Process. Playbooks are often versioned and tested before use."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://www.w3.org/ns/prov#Plan"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Plan"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A documented, structured Behavior that defines a sequenced set of steps, decisions, and actions to be executed in response to a specific type of event, incident, or operational need."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Playbook"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "A Playbook may be offensive (an adversary's operational playbook — see stonework:OperationPlan) or defensive (an incident response, threat hunting, or recovery playbook) — both are action plans carried out by an interested party, as distinct from stonework:DetectionPlan, which plays a neutral, evaluative role. A Playbook decomposes into Steps via stonework:hasStep; each execution is recorded as a stonework:Process. An organization's routine work is a stonework:BusinessProcess, a sibling under stonework:Plan."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#PlaybookType",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid297"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A classification of what a Plan is for, from the CACAO playbook types."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Playbook Type"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Applied via stonework:hasPlaybookType. The values are CACAO 2.0's playbook-type-ov. STONEWORK's Plan subclasses correspond: OperationPlan to attack, DetectionPlan to detection, InvestigationPlan to investigation, and ControlPlan to mitigation, prevention or remediation; engagement and notification have no subclass."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#PriorityLevel",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid298"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A classification of how urgently something should be worked, relative to other work."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Priority Level"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Procedure",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Procedures are instances or patterns of execution that realize a technique. They may include command lines, API calls, malware behaviors, or operator playbook steps. Procedures are distinct from techniques, which describe generalized methods."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Plan"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A concrete, observable sequence of actions, commands, or behaviors that implements a technique in a specific operational context."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Procedure"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@value" : "One realization path for a single Technique — the specific commands, scripts, tools, or configuration that carry it out (e.g. the comsvcs.dll MiniDump way of doing OS Credential Dumping: LSASS Memory). Technique-scoped and typically linear. A Procedure may be only a prose description — the common case when ingesting MITRE ATT&CK procedure examples — or decomposed into stonework:Step individuals via stonework:hasStep for sub-step depth. Links to the Technique it operationalizes via stonework:implements or its specialization stonework:procedureFor. A Procedure is a stonework:Plan at the realization layer, so its runs can be recorded like any other Plan's. Distinct from stonework:Playbook / stonework:OperationPlan / stonework:ControlPlan, which are objective-scoped plans that orchestrate several Procedures or Techniques with branching, retry, and control flow; a Plan's Step commonly stonework:implements a Procedure."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Process",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://www.w3.org/ns/prov#Activity"
  }, {
    "@id" : "https://www.opmw.org/model/p-plan/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberActivity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An identifiable activity or sequence of activities performed over time by one or more agents to achieve an operational, security, or business objective. It transforms inputs (artifacts, data, configurations) into outputs and may be governed by plans, controls, or policies."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Process"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "This class operates at the enterprise/operational level and is distinct from low-level runtime Process objects (e.g., STIX SCO Process). It is the execution-side counterpart to stonework:Plan: each run of a Playbook, ControlPlan, BusinessProcess or other Plan is a Process that is stonework:executionOf it, and the executions of its Steps are stonework:partOfExecution that run."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Product",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Instances of stonework:Product represent product families or lines (e.g. 'Apache Log4j', 'Windows 10'). Specific releases are modeled as stonework:VersionedProduct individuals related via stonework:versionOf. CPE entries with wildcard version components map to stonework:Product; entries with concrete versions map to stonework:VersionedProduct."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#VersionedProduct"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An abstract software, hardware, or firmware product line identified by vendor and product name, independent of any specific version or release. Represents the collection of all versioned releases built under that product identity."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Product"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "stonework:Product does not carry version, update, edition, or other release-specific attributes. Those belong on stonework:VersionedProduct. The two classes are disjoint."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#ProductInstallation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Represents the most granular product identity level: not what software exists, but where and how it is installed. Multiple ProductInstallation individuals may reference the same VersionedProduct."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#ComponentContext"
  }, {
    "@id" : "_:genid299"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A specific installed instance of a VersionedProduct on a particular system or environment, as identified by a SWID tag or equivalent installation record."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Product Installation"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "stonework:ProductInstallation is the intended target for SWID tag data. The installing system, path, licensee, and configuration details belong here rather than on stonework:VersionedProduct."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#ProductType",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid300"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A classification of a product by its primary functional category within a system or architecture."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Product Type"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Applied via stonework:hasProductType to Product individuals. Aligns with CPE component type designations. A product may have more than one type (e.g. an embedded OS is both firmware and operating-system)."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Provenance",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Structured source references used to record the origin and trustworthiness of data and relationships."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Provenance"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Includes Feeds, Publications, and URL References."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Publication",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Provenance"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A structured intelligence artifact such as a blog post, advisory, report, or news article."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Publication"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#QualifiedAssertion",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A first-class record of an assertion or relationship that may carry provenance, time, and other context not represented by an unqualified binary property or scalar value."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Qualified Assertion"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Use assertionSubject, assertionObject, and assertionRelationType for generic directed relationships; subclasses may provide more specific structure. Use direct properties as query-friendly projections when their loss of source, time, or relationship context is acceptable. Provenance is optional in the baseline interoperability profile and required by the strict SHACL overlay."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Ransomware",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#MalwareType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Malware that encrypts or locks victim data or systems and demands payment for restoration of access."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#malwareTypeScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "ransomware"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Ransomware"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Region",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Location"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A sub-national territorial division such as a state, province, region, or governorate."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Region"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Registry",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#DigitalArtifact"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Describes elements within the Windows configuration Registry system."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Registry"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#RegistryKey",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Registry"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A named key in a Windows Registry hierarchy that may contain subordinate keys and registry values."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Registry Key"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#RegistryValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Registry"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A named or default value stored beneath a Windows Registry key, including its value type and literal data."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Registry Value"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#RemoteAccessTrojan",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#MalwareType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Malware providing covert remote control of an infected host, typically including capabilities such as file access, screen capture, keylogging, and command execution."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#malwareTypeScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "remote-access-trojan"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Remote Access Trojan"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Report",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#IntelligenceProduct"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A collection of threat intelligence focused on one or more topics, such as a description of a threat actor, malware, or attack technique."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Report"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#ResourceExploitation",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#MalwareType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Malware that abuses the computational resources of an infected host, such as for cryptocurrency mining or proxying network traffic."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#malwareTypeScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "resource-exploitation"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Resource Exploitation"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#ResourceLevel",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid301"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A classification of the organizational resources available to a threat actor."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Resource Level"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Review",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "https://ontology.caseontology.org/case/investigation/InvestigativeAction"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Process"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An analyst's examination of records or artifacts, as part of an investigation, ending in a judgment of whether they are relevant to it."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Review"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "The records reviewed are stonework:hasInput; the investigation is the execution the review is stonework:partOfExecution (directly, or through the execution of one of its Steps; when the investigation follows an InvestigationPlan, the Step a review carries out is stonework:correspondsToStep); the analyst is stonework:performedBy; when, stonework:startedAtTime and stonework:endedAtTime. What it found is stonework:hasReviewFinding (in categories.ttl), which applies to every input: records found relevant and records found not relevant are two Reviews. A later Review of the same record in the same investigation supersedes an earlier one, and both stay as the record of the work. A finding of not relevant says nothing about whether a record is true, benign or malicious: correctness is a stonework:Opinion, and how a whole investigation ended is stonework:hasInvestigationOutcome. Follows the CASE investigative action: who examined what, when, and what resulted."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#ReviewFinding",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid302"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A classification of what a review found about the records it examined, relative to the investigation it is part of."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Review Finding"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Risk",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Instances of stonework:Risk may reference the threat being considered, the assets affected, the expected impact of compromise, and the likelihood of occurrence. Risk values may be qualitative or quantitative, and SHOULD be represented using explicit properties rather than encoded in class IRIs or labels."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#RiskFactor"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A measure of the potential for loss or adverse effects arising from the realization of a threat, expressed as a function of the impact of compromise and the likelihood that the compromise will occur."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Risk"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@value" : "This class represents the assessed or estimated level of exposure to harm for a specific asset, mission, or organization. Risk is typically derived from the combination of impact and likelihood, and may incorporate assumptions, uncertainty, and contextual factors."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#RiskFactor",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A calculated or assessed component used to quantify or characterize security risk, including the potential for harm and the probability of its occurrence."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Risk Factor"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Includes Risk (overall assessed exposure), Impact (magnitude of harm if realized), and Likelihood (probability of occurrence). These are analytical outputs derived from threat and vulnerability data, distinct from the conditions (SecurityCondition) that give rise to them and the countermeasures (Countermeasure) that address them."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#RiskLevel",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid303"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An ordinal classification of the assessed magnitude of a security risk."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Risk Level"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#RogueSecuritySoftware",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#MalwareType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Malware that masquerades as legitimate security software to deceive users into paying for fake threat removal or granting elevated privileges."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#malwareTypeScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "rogue-security-software"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Rogue Security Software"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Role",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A function, capacity, or part played by an entity in a specific context, relationship, or operation."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Role"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Roles are typically more stable and relational than Categories. An entity can play multiple Roles. Aligns with patterns in BFO, CCO, and D3FEND (e.g., functional roles of infrastructure or actors)."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#RoleAssignment",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#QualifiedAssertion"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A qualified record assigning a Role to an entity within a particular campaign, operation, organization, or other context."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Role Assignment"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Create separate assignments when the same entity plays different roles in different contexts or time intervals. The assignment can infer the context-free stonework:playsRole projection through the declared property chain."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Rootkit",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#MalwareType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Malware that conceals itself and other malicious software by subverting operating system or hypervisor mechanisms, typically to maintain privileged persistence."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#malwareTypeScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "rootkit"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Rootkit"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#RuntimeProcess",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#DigitalArtifact"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A running or terminated process instance on a host, identified by PID, executable path, command line, parent process, and associated user account."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Runtime Process"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Represents low-level OS process objects observed during execution — distinct from stonework:Process (enterprise-level workflows). Mutex objects created by a process are linked as stonework:Mutex individuals. Corresponds to STIX 2.1 Process SCO."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#ScreenCapture",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#MalwareType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Malware that periodically or continuously captures screenshots of the victim's display and exfiltrates them to an attacker."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#malwareTypeScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "screen-capture"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Screen Capture"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Sector",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid304"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A broad division or category of economic activity, infrastructure, or society used for classification and targeting purposes."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Sector"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Can represent both commercial industries and critical infrastructure sectors (e.g., from CISA or NIST frameworks)."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#SecurityActuation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "https://www.w3.org/TR/vocab-ssn/#SOSAActuation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberActivity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A specific cyber activity in which a deployed security mechanism changes the security state of one or more cyber entities."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Security Actuation"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Use stonework:madeByActuator for the deployed mechanism, stonework:appliesCountermeasure for the safeguard or procedure being carried out, and stonework:actsOn for each affected entity. Unlike a Countermeasure specification, a SecurityActuation is an occurrence and may carry execution times and produced results. Inspired by SOSA sosa:Actuation without formally importing SOSA. The baseline SHACL profile requires madeByActuator at violation severity — the acting tool's own identity is always self-asserted and known at creation time — but only warns on a missing actsOn: the tooling that performed an actuation typically knows what it acted on in source-native terms (an IP, a hostname, a process ID) before that reference resolves to a canonical CyberEntity individual, the same resolution lag as stonework:RoleAssignment's roleContext or stonework:MetricObservation's metricFor. A SecurityActuation with no actsOn yet is incomplete, not malformed."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#SecurityActuator",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "https://www.w3.org/TR/vocab-ssn/#SOSAActuator"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Infrastructure"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A deployed system, service, appliance, or software agent capable of changing the security state of a cyber environment by applying a countermeasure."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Security Actuator"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "A SecurityActuator is the mechanism that applies a safeguard, not the safeguard specification itself. Firewalls, EDR agents, access-control services, and patch-management systems are typical examples. A mechanism such as an IPS or EDR agent may be both a stonework:Sensor and a SecurityActuator. Distinct from stonework:Actuator, which is a physical process or plant actuator. Inspired by SOSA sosa:Actuator without formally importing SOSA."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#SecurityCondition",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A state, circumstance, or disposition relevant to the security posture of a system, asset, or mission — existing independently of any measurement or assessment."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Security Condition"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Includes Threats, Vulnerabilities, and Weaknesses. Risk, Impact, and Likelihood are assessed/calculated concepts and are modeled under stonework:RiskFactor."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#SecurityObservation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "https://www.w3.org/TR/vocab-ssn/#SOSAObservation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#IntelligenceProduct"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A time-bounded record produced by a security sensor or automated tool capturing one or more cyber observables witnessed in a monitored environment, together with frequency metadata."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Security Observation"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Machine-produced intelligence: a sensor is not an analyst, but its output feeds the intelligence pipeline in the same way that SIGINT feeds human analysis. Key metadata: the time window the phenomenon was witnessed (first/last observed), how many times it was observed (number_observed), and which cyber observables were captured (hasObservable). Use stonework:madeBySensor to link to the producing stonework:Sensor. Distinct from stonework:Sighting, which records that a known CTI object (indicator, malware, threat actor) was seen; SecurityObservation is the raw sensor-layer record prior to attribution or indicator matching. Corresponds to STIX 2.1 observed-data SDO. Inspired by SOSA sosa:Observation — compatible in concept but does not formally import the SOSA ontology."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Sensor",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "https://www.w3.org/TR/vocab-ssn/#SOSASensor"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Infrastructure"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A deployed system, appliance, agent, or network tap that collects data about digital artifacts, network activity, or adversary behavior for detection and investigation purposes."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Sensor"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Applies DetectionRules via stonework:usesRule. May be a software agent, physical appliance, virtual instance, or network sensor. Examples: IDS/IPS, SIEM collector, endpoint agent, network tap, honeypot, vulnerability scanner. An AI-driven sensor that crosses into autonomous decision-making may be additionally typed as stonework:AIAgent. Aligns with D3FEND Sensor. Inspired by SOSA sosa:Sensor — compatible in concept but does not formally import the SOSA ontology. Produces stonework:SecurityObservation instances via stonework:madeBySensor."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Sighting",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#IntelligenceProduct"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Records that a object such as an indicator, malware, tool, or threat actor was seen. Wraps observation metadata around a reference to the sighted object."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Sighting"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Signature",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#DetectionRule"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A content-centric detection rule that matches malicious activity by a specific pattern — a byte sequence, string, hash, regular expression, or network packet structure."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Signature"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Includes YARA rules, Snort/Suricata rules, and AV signatures. Distinguished from broader DetectionRule subclasses (behavioral, correlation, analytic) by its tight binding to a specific known-bad indicator or artifact pattern."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#SoftwareBillOfMaterials",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An SBOM asserts that specific VersionedProduct instances are components of a containing artifact. Component entries are represented as stonework:BomEntry instances linked via stonework:hasBomEntry."
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A formal, machine-readable inventory of VersionedProduct components that constitute a software artifact or system, expressed in a standard format such as CycloneDX or SPDX."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Software Bill of Materials"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "SoftwareBillOfMaterials is a native STONEWORK class — not a subclass of any STIX domain object, as STIX 2.1 has no SBOM concept. Instances correspond to SBOM documents; format provenance (CycloneDX 1.6, SPDX 2.3, etc.) is expressed via stonework:bomFormat."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#SophisticationLevel",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid305"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A classification of a threat actor's assessed technical sophistication."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Sophistication Level"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Spyware",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#MalwareType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Malware that covertly monitors user activity, collects personal or sensitive information, and transmits it to a remote party."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#malwareTypeScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "spyware"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Spyware"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Step",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://purl.org/net/p-plan#Step"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Behavior"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A single, individually addressable unit of action within a Behavior that models a multi-step process, such as a Plan or a Control."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Step"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "A Step is itself a Behavior — a plan specification for a sub-action, not its execution — consistent with p-plan:Step subclassing prov:Plan rather than prov:Activity. Because Step is a Behavior, a Step MAY itself decompose into further Steps via stonework:hasStep, supporting nested sub-procedures (e.g. a Kill Chain phase decomposing into candidate technique attempts) without a separate composite class. The activity that executes a Step is a stonework:CyberActivity; it links back to the Step it realizes via stonework:correspondsToStep."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Tactic",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Instances of stonework:Tactic SHOULD correspond to high‑level adversary goals. Techniques are typically modeled as children or members of a tactic."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Behavior"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A high‑level objective or strategic goal that groups related techniques by the purpose they serve during an operation."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Tactic"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@value" : "Superclass for OffensiveTactic and DefensiveTactic. Tactics represent the strategic intent behind behavior — gaining initial access, exfiltrating data, or hardening a system. They serve as conceptual categories for techniques."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Technique",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Mirrors D3FEND's Technique class and reflects the PROV-O Plan philosophy: a technique is a plan that describes how an action should be carried out, distinct from the activity that executes it. Subclassed by stonework:CyberTechnique for cyber-specific methods."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Behavior"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A reusable, prescribed method for achieving an objective, which may be instantiated as a concrete execution by an actor or system."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Technique"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@value" : "A method specification, not a plan: a Technique describes an approach ('access credential material in LSASS process memory') without prescribing an ordered, branched sequence of steps. Concrete step structure appears one level down, in a stonework:Procedure that realizes the Technique, or in a stonework:Playbook / stonework:OperationPlan that orchestrates several. An execution links to the Technique it performs directly with stonework:executionOf — no Procedure, Plan, or Step is required for the lightweight case. Technique is intentionally not a subclass of stones:AttackPattern: attack patterns such as CAPEC are abstract taxonomy entries, while Techniques are operationalized methods closer to execution. See stonework:CyberTechnique, stonework:AttackTechnique, stonework:DefendTechnique, and docs/technique-modeling.md."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Threat",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Instances of stonework:Threat may describe adversary capabilities, strategic objectives, targeting patterns, or environmental conditions that increase the likelihood of harmful action. Threats may be linked to threat actors, campaigns, malware, TTPs, weaknesses, or assets, but are conceptually distinct from the actions or events that realize them."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#SecurityCondition"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A potential or actual source of harm arising from an adversary's capability, intent, and opportunity to exploit weaknesses or create adverse effects within a system, organization, or mission."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Threat"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@value" : "This class represents the abstract notion of a cyber threat, independent of specific threat actors, campaigns, or events. It provides a semantic foundation for modeling adversary capabilities, intentions, targeting, and conditions that give rise to harmful outcomes."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#ThreatActor",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://www.w3.org/ns/prov#Agent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Agent"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "An entity that has the capability and intent to conduct harmful activities within a cyber or sociotechnical context."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Threat Actor"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Parent class for stonework:ThreatActorIndividual (a single human) and stonework:ThreatActorGroup (a collective or organization). Threat actors are distinct from the threats they pose; they are the entities that carry out actions that realize threats. They may be linked to observed behaviors, techniques, targeting patterns, and strategic objectives."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#ThreatActorGroup",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#ThreatActor"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A collective, organization, or coordinated set of individuals operating with common intent to conduct adversarial cyber activities."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Threat Actor Group"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Covers nation-state units, cybercriminal organizations, hacktivist collectives, and other named adversary groups. Industry names such as APT20 or APT29 are often used for both a tracked body of activity and the presumed group behind it. Model the activity as a separate stonework:CyberActivityCluster and link it to the ThreatActorGroup with stonework:attributedTo when supported. MITRE ATT&CK serializes tracked Groups as STIX intrusion-set objects; that source representation alone does not establish that the activity cluster and responsible group are the same entity. Distinguished from stonework:ThreatActorIndividual, which represents a single human actor."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#ThreatActorIndividual",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#ThreatActor"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A single, identifiable human actor with the capability and intent to conduct adversarial cyber activities."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Threat Actor Individual"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Covers individual hackers, insiders, contractors, and other identified persons. Relevant for law enforcement and prosecution contexts where attribution to a specific individual — rather than a group — is required. Distinguished from stonework:ThreatActorGroup, which represents a collective or organization."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#ThreatActorRole",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#Role"
  }, {
    "@id" : "_:genid306"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A controlled role type describing the function played by a threat actor within a specific operation, campaign, or criminal organization."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Threat Actor Role"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "A threat actor may play different roles across operations — a nation-state actor may be a sponsor in one campaign and a director in another. Use stonework:RoleAssignment for contextual modeling; stonework:playsRole is the context-free STIX-compatible projection."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#ThreatActorType",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid307"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A classification of a threat actor by their organizational form, affiliation, or primary mode of operation."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Threat Actor Type"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Applied via stonework:categorizedBy to ThreatActor individuals. A threat actor may have multiple types. Aligns with the STIX 2.1 threat-actor-type open vocabulary."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#ThreatScenario",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://www.w3.org/ns/prov#Plan"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Plan"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A plan specification describing how a threat could materialize against specific assets or missions — incorporating adversary intent, capability, opportunity, preconditions, attack path, and expected consequences."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Threat Scenario"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "A ThreatScenario is prescriptive and forward-looking: it specifies a potential sequence of adversary behaviors and environmental conditions rather than recording observed events. Used to guide defensive planning, risk assessment, and Playbook development. A ThreatScenario is a stonework:Plan held as a hypothesis: an adversary plan that may or may not exist, where a stonework:OperationPlan is one believed to exist. It can be executed, as in a red-team exercise or tabletop, and an observed Incident can be compared against it. Distinct from stonework:Incident (an observed occurrence) and stonework:Threat (an abstract source of harm). Aligns with prov:Plan and P-Plan scenario specifications."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Tool",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Product"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Legitimate software that can be used offensively by threat actors or defensively by security practitioners. Distinguishable from malware by being designed for benign or dual-use purposes rather than being inherently malicious."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Tool"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Includes commercial penetration testing tools, remote administration utilities, and living-off-the-land binaries (LOLBins) repurposed by adversaries, as well as defender-operated tools such as scanners, EDR agents, and forensic utilities. Corresponds to STIX 2.1 Tool SDO."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#TransactionType",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  }, {
    "@id" : "_:genid308"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A classification of a financial transaction by the kind of movement it represents."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Transaction Type"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Transition",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A directed edge between two Steps within the same parent Behavior's Step graph, representing progression from one Step to the next."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Transition"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Unconditioned, a Transition expresses plain sequence — an alternative to stonework:precededByStep for the same purpose, used when a Step has more than one possible successor and the edges themselves need to be individually referenceable. When a Transition's stonework:toStep targets a Step already reached earlier in the same graph, it expresses a loop back-edge; looping is not a separate construct. Conditional branching is expressed with the guard properties stonework:guardVariable (the Variable tested), stonework:guardType (a class the bound value must be an instance of) or stonework:guardLiteralValue (a scalar it must equal) or stonework:guardValue (an individual it must be), and stonework:guardOperator (the comparison; omitting it defaults to equality). The Transition fires when its guard holds against the value the from-Step's execution bound: the stonework:VariableBinding of the guard Variable that is stonework:boundIn that execution. Whether a Step's several outgoing Transitions are alternatives or concurrent branches is given by that Step's stonework:splitKind, and whether a Step entered by several Transitions waits for all of them by its stonework:joinKind; both default to exclusive (one path). A Step's stonework:defaultTransition is taken only when no other outgoing Transition's guard holds. A Transition never leaves its Plan: between Plans, only data passes, as a message through a shared Variable (see stonework:Variable)."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Trojan",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#MalwareType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Malware disguised as or bundled with legitimate software to deceive users into executing it, enabling a range of malicious payloads."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#malwareTypeScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "trojan"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Trojan"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#URI",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Identifier"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Represents a Uniform Resource Identifier conforming to RFC 3986."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "URI"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#UnknownMalware",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#MalwareType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The malware type has not been determined or cannot be classified into a known category."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#malwareTypeScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "unknown"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Unknown Malware Type"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#UserAccount",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Account"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An authenticated-access identity on a system or service — a local OS account, cloud or directory account, application account, or social media account — through which a principal logs in and acts."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "User Account"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "The access/authentication sibling of stonework:FinancialAccount under stonework:Account. Where a login governs a value-holding ledger (online banking, an exchange account, a marketplace wallet), model the ledger as a separate stonework:FinancialAccount and link the two with stonework:controls — one login commonly controls several accounts."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#UserAgent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Identifier"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A string identifier transmitted by a client application in HTTP requests declaring the software, version, and platform making the request. Used for fingerprinting clients, identifying malware C2 beaconing patterns, and clustering infrastructure by shared tooling."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "User Agent"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "User-agent strings are observable in network traffic, proxy logs, and web server logs. Distinctive or spoofed user-agent values are commonly used as indicators in threat intelligence. Distinct from stonework:UserAccount (an identity credential) — a UserAgent describes software behavior, not a user identity."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#UserGroup",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#DigitalIdentity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Represents a user group on a system or service, including local OS groups, cloud groups, and social media groups."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "User Group"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Variable",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://purl.org/net/p-plan#Variable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A named placeholder for a value declared by a Plan or Step, which takes a value in each execution of it."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Variable"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Declared via stonework:hasInputVariable or stonework:hasOutputVariable. A Variable belongs to the plan, not to a run: the value it takes in one execution is a stonework:VariableBinding (stonework:bindingOf the Variable, stonework:boundIn the execution that bound it), so a plan run many times keeps every run's values. Data flows between Steps through a shared Variable, as in P-Plan: one Step declares it as an output, a later Step as an input, and in a run the later Step's execution records the binding it received with stonework:usedBinding. An input supplied when a run starts, for example an existing stonework:CvssMetric assessment, is bound in the run itself. When the producing Step and the consuming Step belong to different Plans, the data flow is a message between participants (BPMN's message flow): an adversary's OperationPlan whose Step outputs the payment request an organization's BusinessProcess takes as input, for example. Control flow never crosses Plans; only data does. When the sender's plan isn't modelled, stonework:suppliedBy names the Role whose holders supply the value, and the value is bound in the execution that received it. Variables carry execution-time values and do not replace persistent domain relationships. A binding's value is what stonework:Transition guard properties test, and what a stonework:Hypothesis that predicts the Variable is judged against."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#VariableBinding",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://purl.org/net/p-plan#correspondsToVariable"
  }, {
    "@id" : "http://www.w3.org/ns/prov#Entity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The value a Variable took in one execution of the Plan or Step that declares it."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Variable Binding"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Names the Variable with stonework:bindingOf, the execution that bound it with stonework:boundIn (a Step's execution for an output, the run itself for an input supplied when it starts), and the value with stonework:boundTo (an individual) or stonework:boundToLiteral (a scalar). An execution that received the value records it with stonework:usedBinding. A Step executed several times in one run, as in a retry loop, binds its output Variables once per execution. In P-Plan the run's own entity carries p-plan:correspondsToVariable; a binding does the same for literal values, which cannot carry properties, and treats individuals the same way. In PROV terms a binding is an Entity generated by the execution it is boundIn and used by those that record it with usedBinding."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#VersionedProduct",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Instances of stonework:VersionedProduct may include operating systems, applications, libraries, devices, or embedded components at a specific release. Versioning, vendor attribution, and edition details SHOULD be represented using explicit properties rather than encoded strings."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A specific versioned release or build of a Product, identified by a CPE name or equivalent product identifier. Represents the unit of software actually deployed and potentially affected by vulnerabilities."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Versioned Product"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Each CPE 2.3 entry with a concrete version component maps to a stonework:VersionedProduct individual. Wildcard-version CPEs map to stonework:Product. Related to its abstract product line via stonework:versionOf."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Virus",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#MalwareType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Malware that replicates by inserting copies of itself into other executable files or documents, spreading when those files are executed or opened."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#malwareTypeScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "virus"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Virus"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Vulnerability",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#SecurityCondition"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A flaw or weakness in software, hardware, firmware, or system architecture that can be exploited by a threat actor to compromise confidentiality, integrity, or availability."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Vulnerability"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Represents specific exploitable instances (e.g., CVE-identified vulnerabilities) rather than weakness classes — those are modeled as stonework:Weakness. A Vulnerability is linked to its root Weakness via stonework:hasWeakness, to affected products via stonework:affected, to its fix via stonework:fixedInProduct, and to exploiting malware or actors via stonework:exploits. Aligns with D3FEND Vulnerability and NVD CVE."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#VulnerabilityAssessment",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Assessment"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A structured evaluation of a specific vulnerability's applicability and risk in a particular product or deployment context."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Vulnerability Assessment"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Captures VEX-style assessments: whether a product is affected, not affected, fixed, or under investigation, together with the justification and any remediation statement. Distinct from stonework:Vulnerability (which describes the flaw itself) and stonework:CvssMetric (which gives context-neutral technical severity): a VulnerabilityAssessment is a judgment about applicability and risk in a specific product, deployment, or enterprise context. It may be constructed by an Investigation executing a Plan whose inputs include the vulnerability, its CVSS assessment, and current enterprise graph state."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Weakness",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Instances of stonework:Weakness may represent base weaknesses, variant weaknesses, or compound weaknesses. CWE identifiers (e.g., \"CWE‑79\") SHOULD be modeled using explicit properties rather than encoded in the class IRI. Descriptions and extended details SHOULD be referenced via citations rather than reproduced verbatim."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#SecurityCondition"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "A type of flaw, fault, or design condition in software, hardware, or system architecture that can enable vulnerabilities, reduce security assurance, or increase the likelihood of exploitable behavior."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "Weakness"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@value" : "This class provides a semantic representation of weakness types defined in the Common Weakness Enumeration (CWE). It supports hierarchical relationships, abstraction levels, and mappings to related attack patterns, vulnerabilities, and security controls."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Webshell",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#MalwareType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Malware deployed on a web server that provides remote command execution via HTTP requests, enabling persistent access through the web application layer."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#malwareTypeScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "webshell"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Webshell"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Wiper",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#MalwareType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Malware designed to irreversibly destroy data or render systems inoperable, typically used for sabotage or to obscure attacker activity."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#malwareTypeScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "wiper"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Wiper"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#Worm",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#MalwareType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Self-replicating malware that spreads across networks or systems without requiring user interaction or a host file to attach to."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#malwareTypeScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "worm"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Worm"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#abaRoutingNumber",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#FinancialInstitution"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The US ABA routing transit number of this institution. National branch or bank codes from other schemes, for example a UK sort code, may be recorded with the same property pending scheme-specific refinement."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "abaRoutingNumber"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#absorbedInto",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Hypothesis"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Hypothesis"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates a Hypothesis to the Hypothesis it was merged into, once they were concluded to be the same claim."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "absorbedInto"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Keeps the absorbed Hypothesis rather than deleting it, so its identity, tests and status stay traceable. A merge is an analyst's decision; when and by whom are recorded through stonework:hasProvenance or a stonework:QualifiedAssertion. Functional: one survivor. Not transitive: the chain is followed in a query, so withdrawing one link withdraws nothing else. An Investigation uses stonework:mergedInto, not this property. The absorbed Hypothesis's status is superseded unless it was already confirmed or refuted."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#accessesFile",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#RuntimeProcess"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#File"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates a RuntimeProcess to Files it reads, writes, or executes."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "accessesFile"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#accessesRegistry",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid1"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Registry"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates a RuntimeProcess or MalwareSample to Registry keys it reads or modifies."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "accessesRegistry"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#accountCurrency",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#FinancialAccount"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Currency"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A currency or crypto asset that this financial account holds or is denominated in."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "accountCurrency"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Intentionally multi-valued: an account, including a hosted exchange account or multi-asset wallet, may hold or support more than one currency."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#accountName",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#UserAccount"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The username or account identifier on the target system or service."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "accountName"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#accountNumber",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#BankAccountNumber"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The domestic account number string."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "accountNumber"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#accountOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Account"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Agent"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The Agent that holds this Account, or to whom it is beneficially attributed. Inverse of stonework:hasAccount."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "accountOf"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "For a UserAccount this is the account holder; for a FinancialAccount it is the accountholder or beneficial owner, which may differ from whoever operates it (an account-takeover attacker operating a victim's FinancialAccount is modeled with stonework:controls from the attacker-held UserAccount, leaving accountOf pointing at the victim)."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#accountTypeCloud",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AccountType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An account managed by a cloud service or identity provider."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#accountTypeScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "cloud"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Cloud"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#accountTypeDomain",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AccountType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An account managed within an enterprise identity domain."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#accountTypeScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "domain"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Domain"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#accountTypeLocal",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AccountType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An account managed locally by a host or application."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#accountTypeScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "local"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Local"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#accountTypeScheme",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "STONEWORK Account Type Scheme"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The controlled vocabulary of account authentication and deployment contexts."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "STONEWORK Account Type Scheme"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#accountTypeService",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AccountType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A non-human account used by a service, workload, or automated process."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#accountTypeScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "service"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Service"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#actsOn",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberActivity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://www.w3.org/ns/prov#used"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Links a CyberActivity to the CyberEntity it acted upon — the asset, artifact, or resource the activity operated against."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "actsOn"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Mirrors prov:used (an Activity used an Entity). Typical range instances are stonework:Host, stonework:RuntimeProcess, or other stonework:DigitalArtifact/stonework:Infrastructure individuals — e.g. the specific lsass.exe stonework:RuntimeProcess a credential-dumping attempt acted on. Distinct from stonework:targets: targets is a direct, open-domain/range lift of the STIX 2.1 relationship_type 'targets' shortcut, describing higher-level strategic targeting (a Sector, a Location, an Agent) by a Campaign/MalwareSample/ThreatActor. actsOn is purpose-built for the concrete technical asset one execution-trace Activity acted upon — the same distinction develop draws between stonework:mitigates (open, STIX-lifted) and stonework:mitigatesAttackPattern (purpose-built, controlled domain/range)."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#addressOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#IPAddress"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid4"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates an IPAddress to the Host or NetworkService for which it serves as a network address."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "addressOf"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#addresses",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid7"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid10"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates a Playbook or ThreatScenario to an AttackTechnique, MalwareFamily, or ThreatActor it is designed to address."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "addresses"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#addressesAttack",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CourseOfAction"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#AttackPattern"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A CourseOfAction prescribes a defensive response to this AttackPattern."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "addressesAttack"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#adjacentTo",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#SymmetricProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Location"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Location"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates a Location to another Location with which it shares a border or boundary, e.g. two neighboring Countries or Regions."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "adjacentTo"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Symmetric and not transitive. Use stonework:locatedWithin for containment rather than adjacency."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#affected",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Vulnerability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#VersionedProduct"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Relates a vulnerability to a product version known to be affected by it."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "affected"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@value" : "The range is a stonework:VersionedProduct individual whose IRI is derived deterministically from the CPE identifier. The product individual may be populated by a separate CPE ingest; references from CVE data precede that ingest and are resolved when CPE data is loaded."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#affectedStatusAffected",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AffectedStatus"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The product or version is affected by the vulnerability."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#affectedStatusScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "affected"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Affected"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#affectedStatusFixed",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AffectedStatus"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The stated product or version contains a fix for the vulnerability."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#affectedStatusScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "fixed"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Fixed"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#affectedStatusScheme",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://docs.oasis-open.org/csaf/csaf/v2.0/os/csaf-v2.0-os.html"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "STONEWORK Affected Status Scheme"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The controlled vocabulary of vulnerability applicability judgments."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "STONEWORK Affected Status Scheme"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#affectedStatusUnaffected",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AffectedStatus"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The product or version is not affected by the vulnerability."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#affectedStatusScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "unaffected"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Unaffected"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#affectedStatusUnderInvestigation",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AffectedStatus"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Applicability of the vulnerability to the product or version is still being determined."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#affectedStatusScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "under-investigation"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Under Investigation"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#affectedStatusUnknown",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AffectedStatus"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "It is not known whether the product or version is affected."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#affectedStatusScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "unknown"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Unknown"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#affectsAsset",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid14"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid19"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates an Incident, Campaign, Risk, or Impact to the assets it threatens or impacts."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "affectsAsset"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#affiliatedWith",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Agent"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Associates an entity with a related Agent through organizational membership, alliance, sponsorship, or informal association."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "affiliatedWith"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#amount",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#MonetaryAmount"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#decimal"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The magnitude of a stonework:MonetaryAmount, in the units of its stonework:currency. Negative values represent debit or overdrawn balances; transaction amounts are non-negative by convention, with direction carried by originator and beneficiary roles."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "amount"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#analysisOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Analysis"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid22"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates an Analysis to the CyberEntity or CyberActivity that it examines."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "analysisOf"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#appliesControl",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CourseOfAction"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Control"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A CourseOfAction specifies this Control as part of its recommended defensive posture. Primary arc into the Control class."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "appliesControl"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#appliesCountermeasure",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#SecurityActuation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Countermeasure"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates a SecurityActuation to the Countermeasure, rule, control, or mitigation carried out during that activity."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "appliesCountermeasure"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#appliesTo",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid25"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid28"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates a Control or DetectionRule to the systems or assets it applies to."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "appliesTo"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#asName",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#AutonomousSystem"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The registered name or handle of the autonomous system."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "asName"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#asNumber",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#AutonomousSystem"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#unsignedInt"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The Autonomous System Number (ASN) assigned by IANA."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "asNumber"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#assertionObject",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#QualifiedAssertion"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Identifies the resource in the object or target position of a qualified assertion."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "assertion object"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Range is intentionally unset because framework relationships may target either a CyberEntity, a CyberActivity, or another externally defined resource."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#assertionRelationType",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#QualifiedAssertion"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The source vocabulary's wire-level name for the relation expressed by a qualified assertion."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "assertion relation type"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Preserves open relationship vocabularies such as STIX relationship_type strings. A separately materialized object property may provide a query-friendly projection of the same assertion."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#assertionSubject",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#QualifiedAssertion"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Identifies the resource in the subject or source position of a qualified assertion."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "assertion subject"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Range is intentionally unset because framework relationships may originate from either a CyberEntity, a CyberActivity, or another externally defined resource."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#assessesExploitationOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CourseOfAction"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Vulnerability"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates a CourseOfAction to a Vulnerability whose exploitation it determines, such as forensic triage or a compromise assessment."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "assessesExploitationOf"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Distinct from stonework:mitigatesVulnerability, which addresses the vulnerability itself. Patching closes the way in; this course of action asks whether someone already came through it. A source that directs both, such as CISA's catalog entries that require forensic triage, gives two courses of action."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#assessmentOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Assessment"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates an Assessment to the entity being assessed."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "assessmentOf"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Scheme-specific linking properties, such as stonework:cvssMetricFor, are declared rdfs:subPropertyOf this property, so a query over assessmentOf reaches every Assessment subclass regardless of scheme."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#assignedBy",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Vulnerability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Agent"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates a vulnerability to the numbering authority that assigned its primary vulnerability identifier."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "assignedBy"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Resolve source-native names, UUIDs, or email addresses to an Agent individual. Like stonework:vulnerabilityId and stonework:dateAssigned, this property describes the vulnerability record's single primary identifier; represent independently assigned identifiers as distinct vulnerability records. The unresolved source string is preserved separately on cve:assigner regardless of whether resolution succeeds."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#assignedRole",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#RoleAssignment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Role"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The Role assigned by a qualified RoleAssignment."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "assignedRole"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#associatedWith",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Generic association between two entities. Use a more specific property where one exists."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "associatedWith"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#attackId",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#notation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The MITRE ATT&CK identifier of an ATT&CK object, as ATT&CK displays it: Txxxx or Txxxx.yyy (technique, sub-technique), TAxxxx (tactic), Gxxxx (group), Sxxxx (software), Mxxxx (mitigation), Cxxxx (campaign), DETxxxx (detection strategy), ANxxxx (analytic), DCxxxx (data component)."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "attackId"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Domain deliberately unset: every kind of ATT&CK object has an ATT&CK ID. The canonical and source forms are the same, so attack:attackId specializes both this property and stonework:externalId. Not unique across object types (ATT&CK's deprecated mitigations reuse technique T-numbers): look an object up by its ID together with its class. Distinct from stonework:relatedTechniqueIdentifier, which carries an ATT&CK technique ID on another framework's entity (e.g. a CAPEC pattern) as a join key; attackId is the ATT&CK object's own identifier."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#attributedTo",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Links a CyberActivity to the Agent responsible for, or associated with, performing it."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "attributedTo"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Domain/range intentionally left unset: this property is a direct lift of the STIX 2.1 relationship_type 'attributed-to' shortcut. STIX does not schema-constrain which SDO/SCO types may appear as source_ref/target_ref for a given relationship_type — that's producer convention, not enforceable structure, and a closed domain/range here would misrepresent real STIX 2.1 data and mislead reasoner-based consumers. In practice the object is typically a stonework:Agent — most often a stonework:ThreatActor in the adversarial case, matching STIX's own convention for 'attributed-to' — but stonework:CyberActivity is a general occurrence class covering defensive and neutral activities too (Investigations, a ControlPlan's Process), so the performer need not be adversarial. A run's attribution covers its executions (stonework:partOfExecution, at any depth), unless one is attributed otherwise; query it through the run rather than copying it onto each execution, so it can be withdrawn in one place. While who is behind an activity is open, attribute it to a persona, a stonework:DigitalIdentity that isn't an Account, such as \"whoever created the rule\"; when that is established, the persona is stonework:attributedToAgent the Agent, and nothing attributed to the persona needs to change. Two personas that may be one actor are kept apart until a Hypothesis says they are."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#attributedToAgent",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#DigitalIdentity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Agent"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Links a digital identity to the real-world Agent it is believed to belong to."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "attributedToAgent"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Names the identity's holder, not whoever used it on a given occasion. When an identity is used by someone else, such as an actor holding a victim's stolen credentials, the activity keeps the identity as its stonework:performedBy and names the Agent responsible with stonework:attributedTo. That someone else controlled the identity for a period, such as an actor holding a mailbox's credentials from its compromise to its containment, is a stonework:IdentityControl."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticatedBy",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#EmailAuthenticationResult"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Infrastructure"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The server that performed an authentication check and recorded its result (the authserv-id of an Authentication-Results header)."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "authenticatedBy"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticatedDomain",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#EmailAuthenticationResult"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Domain"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The domain an authentication check evaluated: the envelope sender's domain for SPF, the signing domain for DKIM, the From domain for DMARC."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "authenticatedDomain"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticatedWith",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberActivity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticatorType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categorizedBy"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An authenticator presented in an activity, such as a sign-in."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "authenticatedWith"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Several for a multifactor sign-in (a password and a push approval). A sign-in that presented a session token rather than authenticating afresh is authenticatedWith stonework:authenticatorSessionToken, with no stonework:authenticationFactor."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticationFactor",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberActivity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticationFactor"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categorizedBy"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A distinct factor the verifier checked in an activity."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "authenticationFactor"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Counted per activity: one is single-factor, two or more multifactor. Recorded only as far as the evidence shows; a log that reports MFA without naming the methods supports no more than its description."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticationFactorInherence",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticationFactor"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Something the user is: a fingerprint, face or other biometric."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticationFactorScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "inherence"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Inherence"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticationFactorKnowledge",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticationFactor"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Something the user knows: a password, PIN or passphrase."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticationFactorScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "knowledge"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Knowledge"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticationFactorPossession",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticationFactor"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Something the user has: a device, key, token or phone."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticationFactorScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "possession"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Possession"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticationFactorScheme",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "STONEWORK Authentication Factor Scheme"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The controlled vocabulary of authentication factors."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "STONEWORK Authentication Factor Scheme"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticationVerdictFail",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticationVerdict"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The check ran and the message failed it."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticationVerdictScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "fail"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Fail"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticationVerdictNeutral",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticationVerdict"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The domain's policy makes no assertion about this sender."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticationVerdictScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "neutral"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Neutral"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticationVerdictNone",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticationVerdict"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "There was nothing to check: no policy, record or signature."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticationVerdictScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "none"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "None"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticationVerdictPass",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticationVerdict"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The check ran and the message passed it. A pass authenticates the domain checked, which may be a lookalike the actor registered."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticationVerdictScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "pass"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Pass"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticationVerdictPermError",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticationVerdict"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The check could not be completed because the domain's published records are invalid."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticationVerdictScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "permerror"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Permanent error"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticationVerdictPolicy",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticationVerdict"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The message passed the check technically, but a local policy of the receiving server overrode the result."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticationVerdictScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "policy"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Policy"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticationVerdictScheme",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "STONEWORK Authentication Verdict Scheme"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The controlled vocabulary of the verdicts of sender-authentication checks on email."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "STONEWORK Authentication Verdict Scheme"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticationVerdictSoftFail",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticationVerdict"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The domain's policy says the sender is probably not authorized, without asking for rejection (SPF ~all)."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticationVerdictScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "softfail"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Soft fail"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticationVerdictTempError",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticationVerdict"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The check could not be completed because of a transient error, such as a DNS timeout."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticationVerdictScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "temperror"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Temporary error"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticatorApiKey",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticatorType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A long-lived secret a program presents for itself: an API key, a client secret, an application password."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticatorTypeScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "api-key"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "API key or client secret"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticatorClientCertificate",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticatorType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A certificate and private key held in software, presented in a TLS handshake or certificate-based sign-in."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticatorTypeScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "client-certificate"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Client certificate"
  } ],
  "https://cyberterrain.org/ns/stonework#phishingResistant" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticatorEmailCode",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticatorType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A one-time code or link sent to a registered email address."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticatorTypeScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "email-code"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Email code"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticatorFederatedAssertion",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticatorType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A SAML assertion or OpenID Connect token from another identity provider, which authenticated the user itself."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticatorTypeScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "federated"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Federated assertion"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticatorFido2SecurityKey",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticatorType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A roaming hardware key that signs a challenge bound to the site's origin (WebAuthn/FIDO2), with or without user verification by PIN or biometric."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticatorTypeScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "fido2-key"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "FIDO2 security key"
  } ],
  "https://cyberterrain.org/ns/stonework#phishingResistant" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticatorHardwareOtpToken",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticatorType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A one-time code shown by a dedicated hardware token."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticatorTypeScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "hardware-otp"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Hardware OTP token"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticatorPIN",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticatorType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A short memorized number, checked by the verifier (a PIN that only unlocks a device is that device's user verification, not a separate authenticator)."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticatorTypeScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "pin"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "PIN"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticatorPassword",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticatorType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A memorized secret the user types."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticatorTypeScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "password"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Password"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticatorPlatformPasskey",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticatorType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A FIDO2 credential held by the user's device or its keychain, unlocked by the device's PIN or biometric (for example Windows Hello for Business, Touch ID)."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticatorTypeScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "passkey"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Platform passkey"
  } ],
  "https://cyberterrain.org/ns/stonework#phishingResistant" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticatorPushApproval",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticatorType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An approval tapped on a registered device in response to a notification, with or without number matching."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticatorTypeScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "push"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Push approval"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticatorRecoveryCode",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticatorType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A pre-issued one-time code from a printed or saved list (NIST SP 800-63B: look-up secret)."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticatorTypeScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "recovery-code"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Recovery code"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticatorSessionToken",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticatorType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A bearer token from an earlier authentication (a session cookie, an access or refresh token) presented in place of a fresh one. It proves the earlier authentication, not who presents it: a stolen token is replayed without any factor (ATT&CK T1539, T1550.001)."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticatorTypeScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "session-token"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Session token"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticatorSmartCard",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticatorType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A card or token holding a private key and certificate, unlocked by a PIN (for example PIV or CAC)."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticatorTypeScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "smart-card"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Smart card"
  } ],
  "https://cyberterrain.org/ns/stonework#phishingResistant" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticatorSmsCode",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticatorType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A one-time code sent by text message to a registered phone."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticatorTypeScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "sms"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "SMS code"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticatorSshKey",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticatorType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A private key presented in an SSH public-key authentication. A passphrase on the key is checked only on the client, so the server sees possession alone."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticatorTypeScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "ssh-key"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "SSH key"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticatorTotpApp",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticatorType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A time-based one-time code generated by an app on a registered device (NIST SP 800-63B: single-factor OTP software)."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticatorTypeScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "totp"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Authenticator-app code"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticatorTypeScheme",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "STONEWORK Authenticator Type Scheme"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The controlled vocabulary of authenticator types."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "STONEWORK Authenticator Type Scheme"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authenticatorVoiceCall",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#AuthenticatorType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A code or approval given in an automated phone call to a registered number."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#authenticatorTypeScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "voice"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Voice call"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#authoredBy",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Provenance"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Agent"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The Agent who authored or produced this provenance record, source document, or intelligence artifact."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "authoredBy"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#beneficiaryAccount",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#FinancialTransaction"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#FinancialAccount"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The account credited by this transaction — the destination of the transferred value."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "beneficiaryAccount"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#beneficiaryMonetaryValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#FinancialTransaction"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#MonetaryAmount"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#hasMonetaryValue"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The monetary amount credited to the beneficiary account as this transaction's output."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "beneficiaryMonetaryValue"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Use with stonework:originatorMonetaryValue when a transaction changes denomination, as in a currency exchange. Both properties remain queryable through their stonework:hasMonetaryValue superproperty."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#bic",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#FinancialInstitution"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The Business Identifier Code (SWIFT/BIC, ISO 9362) of this institution."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "bic"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#bindingOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#VariableBinding"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Variable"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The Variable whose value in one execution a VariableBinding records."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "bindingOf"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#blockchainNetwork",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CryptoAsset"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The distributed ledger a crypto asset is native to or issued on (e.g. Bitcoin, Ethereum, Tron, Monero). The same nominal token issued on more than one ledger is modeled as distinct CryptoAsset individuals."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "blockchainNetwork"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#bomFormat",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The exchange format and version in which a Bill of Materials was originally serialized (e.g. 'CycloneDX 1.6', 'SPDX 2.3')."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "BOM format"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@value" : "Domain intentionally left unset. Serves as provenance metadata on stonework:SoftwareBillOfMaterials instances, distinguishing the source format from the STONEWORK representation."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#boundIn",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#VariableBinding"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberActivity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://www.w3.org/ns/prov#wasGeneratedBy"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The execution in which a VariableBinding's value was bound: the execution of the Step that outputs the Variable, or the run itself for an input supplied when it starts."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "boundIn"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Mirrors prov:wasGeneratedBy. The run a binding belongs to is the execution it is boundIn, or the one that execution is stonework:partOfExecution, at any depth."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#boundTo",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#VariableBinding"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The individual a Variable resolved to in one execution, e.g. the specific SecurityCondition a successful attempt produced."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "boundTo"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Used when the bound value is an instance of a class rather than a scalar; see stonework:boundToLiteral for scalar bindings. Tested by stonework:guardType on a Transition. Since 0.12.0 the subject is a stonework:VariableBinding, not the Variable, so each execution has its own value."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#boundToLiteral",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#VariableBinding"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2000/01/rdf-schema#Literal"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The scalar value, such as a boolean, count or numeric score, a Variable took in one execution."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "boundToLiteral"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Tested by stonework:guardLiteralValue and stonework:guardOperator on a Transition. When the guard uses an ordering operator (LessThan, GreaterThanOrEqual, etc.), this value MUST carry a numeric datatype (xsd:decimal, xsd:double, or xsd:integer) — untyped or string literals do not compare numerically under SPARQL. Since 0.12.0 the subject is a stonework:VariableBinding, not the Variable."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#byteCount",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#NetworkTraffic"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The total number of bytes transmitted in the traffic flow."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "byteCount"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#capecId",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#AttackPattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#notation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The CAPEC identifier in the format CAPEC-NNN."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "capecId"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "The canonical form a person types and searches for. The source-native number (e.g. '66') is capec:capecId, which specializes stonework:externalId."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#categorizedBy",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Category"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Links any individual to one or more contextual categories."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "categorizedBy"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "This is the primary mechanism for flexible, context-sensitive classification (e.g., Evidence, HighValue, Suspect, etc.). Multiple categories per individual are allowed."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "STONEWORK Category Scheme"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The umbrella concept scheme containing all STONEWORK classification and tagging values modeled as instances of stonework:Category subclasses."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "STONEWORK Category Scheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "More specific schemes organize individual controlled vocabularies. Category instances remain members of this umbrella scheme through the restriction on stonework:Category."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#certIssuerDN",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Certificate"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The Distinguished Name of the Certificate Authority that issued the certificate."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "certIssuerDN"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#certSerialNumber",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Certificate"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The unique serial number assigned to the certificate by the issuing CA."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "certSerialNumber"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#certSubjectDN",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Certificate"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The Distinguished Name of the certificate subject."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "certSubjectDN"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#certValidNotAfter",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Certificate"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#dateTime"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The end of the certificate's validity period."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "certValidNotAfter"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#certValidNotBefore",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Certificate"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#dateTime"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The start of the certificate's validity period."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "certValidNotBefore"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#cidrNotation",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#IPBlock"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The CIDR notation representing the IP address block (e.g. 192.168.0.0/16)."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "cidrNotation"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#circumvents",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid33"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid36"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates an AITechnique or AttackPattern to an AnalyticTechnique or DefendTechnique that it bypasses or evades."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "circumvents"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#clusteredWith",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Indicates two entities have been analytically grouped together based on shared characteristics or behaviour, without implying a stronger semantic relationship."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "clusteredWith"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#collects",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Investigation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#DigitalArtifact"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates an Investigation to the digital artifacts it collects as evidence."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "collects"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#commandLine",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#RuntimeProcess"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The full command line string used to launch the process."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "commandLine"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#communicatesWith",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid39"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid42"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates a MalwareSample or Tool to Infrastructure or a URI with which it exchanges command-and-control or exfiltration traffic. Distinct from stonework:deliveredVia, which covers initial delivery."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "communicatesWith"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#compilationTimestamp",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#MalwareSample"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#dateTime"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The timestamp embedded in the binary indicating when the malware was compiled."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "compilationTimestamp"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#compromisedIn",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Agent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Incident"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The Incident during which this Agent (user, system, or organization) was compromised."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "compromisedIn"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#conductedBy",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid45"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Agent"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates a Campaign or Operation to an Agent that conducts it."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "conductedBy"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#confidence",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#integer"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An integer score from 0 to 100 representing confidence in the accuracy of an assertion or the expected outcome of a Hypothesis."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "confidence"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Domain is intentionally unset because the property is shared by Hypotheses and STIX-derived intelligence objects. Matches the STIX 2.1 confidence scale for round-tripping. For source- and time-qualified confidence history, use stonework:MetricObservation with stonework:metricConfidence."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#consistsOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Generic composition relationship. Use stonework:consistsOfCampaign or a more specific property where possible."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "consistsOf"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#consistsOfCampaign",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Operation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Campaign"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates an Operation to the Campaigns that compose it."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "consistsOfCampaign"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#containedIn",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#File"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Directory"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#containsFile"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A File resides in this Directory. Inverse of stonework:containsFile; enables upward traversal of the file system tree."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "containedIn"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#contains",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#TransitiveProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid48"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid51"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates an AutonomousSystem or IPBlock to an IPAddress or more-specific IPBlock contained within its routed address space."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "contains"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#containsDirectory",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Directory"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Directory"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates a Directory to subdirectories it contains."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "containsDirectory"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#containsFile",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Directory"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#File"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates a Directory to the Files it contains."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "containsFile"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#containsLocation",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#TransitiveProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Location"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Location"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#locatedWithin"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates a Location to a narrower Location that lies within it, e.g. a Country to one of its Regions or Cities."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "containsLocation"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Inverse of stonework:locatedWithin; enables downward traversal of the geographic hierarchy."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#content",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Note"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The full text content of the note."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "content"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#controlBaseline",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Control"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The security baseline(s) in which this control is required (e.g. Low, Moderate, High for NIST 800-53)."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "controlBaseline"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#controlFamily",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Control"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The control family or category grouping a control belongs to, by code or name (e.g. AC or Access Control, IR or Incident Response)."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "controlFamily"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "nist:family, the two-letter NIST SP 800-53 family code, is declared rdfs:subPropertyOf this property."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#controlId",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Control"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The framework-specific identifier for the control (e.g. AC-2, CIS 4.1)."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "controlId"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#controlledIdentity",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#IdentityControl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#DigitalIdentity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The DigitalIdentity, such as a UserAccount, controlled in a stonework:IdentityControl."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "controlledIdentity"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#controllingAgent",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#IdentityControl"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Agent"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The Agent who controlled the identity in a stonework:IdentityControl."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "controllingAgent"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#controls",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#UserAccount"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#FinancialAccount"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A stonework:FinancialAccount that this stonework:UserAccount, a login or credential, can operate."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "controls"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Distinct from stonework:accountOf, which records the holder or beneficial owner. One login often controls several financial accounts; a financial account seen in isolation, such as an IBAN in wire data, may have no associated login. An account-takeover attacker holding a victim's UserAccount controls the victim's FinancialAccount without being its accountOf."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#correspondsToStep",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberActivity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Step"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://purl.org/net/p-plan#correspondsToStep"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Links an executing CyberActivity to the Step it is the concrete performance of."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "correspondsToStep"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Directly mirrors p-plan:correspondsToStep (domain prov:Activity, range p-plan:Step), narrowed to stonework:CyberActivity/stonework:Step. Declared functional, matching p-plan: a single CyberActivity corresponds to at most one Step, but a Step may still be the target of many CyberActivity instances across retries or repeated executions. Fills the gap noted on stonework:Step: the property linking an executing Activity back to the Step it realizes."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#counters",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
