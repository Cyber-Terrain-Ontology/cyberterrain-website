    "@language" : "en",
    "@value" : "An account one financial institution holds at another to settle cross-border or cross-institution payments on behalf of its customers."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
