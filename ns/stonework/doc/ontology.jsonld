    "@value" : "The IP protocol version: 4 or 6."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "ipVersion"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#isKnownExploited",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Vulnerability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Indicates whether this vulnerability appears in a known-exploited-vulnerabilities catalog."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "isKnownExploited"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Convenience projection for one current catalog snapshot. A false value is only meaningful as of a specific time and catalog. Preserve dated membership, and identify the catalog, with stonework:MetricObservation, stonework:metricKevMembership, and stonework:hasProvenance."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#isPacked",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
