  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A threat actor seeking fame, recognition, or infamy; actions intended to demonstrate capability or gain public public attention."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#motivationScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "notoriety"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Notoriety"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#motivationOrganizationalGain",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#Motivation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A threat actor seeking to benefit their organization, nation-state, or group through espionage, competitive intelligence, or strategic advantage."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#motivationScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "organizational-gain"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Organizational Gain"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#motivationPersonalGain",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#Motivation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A threat actor motivated by financial reward or material benefit for themselves."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#motivationScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "personal-gain"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Personal Gain"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#motivationPersonalSatisfaction",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#Motivation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A threat actor driven by curiosity, intellectual challenge, or the intrinsic satisfaction of successfully executing an attack."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#motivationScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "personal-satisfaction"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Personal Satisfaction"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#motivationRevenge",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#Motivation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A threat actor seeking retaliation for a perceived wrong; actions motivated by grievance against a specific target."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#motivationScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "revenge"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Revenge"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#motivationScheme",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://purl.org/dc/terms/isPartOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  } ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://docs.oasis-open.org/cti/stix/v2.1/os/stix-v2.1-os.html"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "STONEWORK Motivation Scheme"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The controlled vocabulary of adversary motivations."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "STONEWORK Motivation Scheme"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#motivationUnpredictable",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#Motivation"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A threat actor whose motivation is unknown, unclear, or inconsistent; actions that do not fit a clear pattern of intent."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#motivationScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "unpredictable"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Unpredictable"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#movesToFolder",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#MailboxRule"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The name of the folder a MailboxRule moves the messages it selects to."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "movesToFolder"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Folders the holder rarely opens, such as RSS Feeds, Conversation History or Archive, keep selected messages out of sight (T1564.008)."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#mutexName",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
