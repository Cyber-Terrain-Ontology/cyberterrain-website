  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A threat actor who is being forced to act against their will; actions taken under duress or threat."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#motivationScheme"
  } ],
