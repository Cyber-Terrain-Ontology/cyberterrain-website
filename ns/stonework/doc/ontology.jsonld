  }, {
    "@id" : "_:genid196"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid191"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Actual individuals, groups, or organisations believed to be operating with malicious intent. Unlike Identity, a ThreatActor carries adversarial connotations."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Threat Actor"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stones#Tool",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://cyberterrain.org/ns/stones#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stones#StixDomainObject"
  }, {
    "@id" : "_:genid201"
  }, {
    "@id" : "_:genid202"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid197"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Legitimate software that can be used by threat actors to perform attacks. Distinguishable from malware by being designed for benign purposes but repurposed maliciously."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Tool"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stones#URLObject",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://cyberterrain.org/ns/stones#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stones#StixCyberobservableObject"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid203"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Represents a Uniform Resource Locator conforming to RFC 3986."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "URL Object"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stones#UserAccountObject",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://cyberterrain.org/ns/stones#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stones#StixCyberobservableObject"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid207"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Represents a user account on a system or service, including local OS accounts, cloud accounts, and social media accounts. Supports a unix-account extension for POSIX attributes."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "User Account Object"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stones#Vulnerability",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
