  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A threat actor seeking to assert superiority or control over a target, competitor, or adversary; establishing authority or influence."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
