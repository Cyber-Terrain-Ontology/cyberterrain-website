    "@id" : "_:genid153"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Represents a running or terminated process on a host. Supports extensions for Windows-specific process and service attributes."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Process Object"
  } ]
}, {
