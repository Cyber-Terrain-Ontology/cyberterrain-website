    "@list" : [ {
      "@id" : "https://cyberterrain.org/ns/stones#stixId"
    } ]
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "The top-level abstract class for all STIX objects, encompassing STIX Core Objects (SDOs, SCOs, SROs), Meta Objects, and Bundles."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "STIX Object"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stones#StixRelationshipObject",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://cyberterrain.org/ns/stones#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stones#StixCoreObject"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Abstract class for STIX Relationship Objects (SROs), which link Core Objects to express directed relationships and sightings between them."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "STIX Relationship Object"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stones#StixSubType",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://cyberterrain.org/ns/stones#"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Abstract class for structured sub-types defined by the STIX 2.1 specification that are embedded as property values within STIX objects. Instances are not STIX objects: they carry no identifier, type, spec_version, created, or modified properties and cannot be referenced by identifier from other objects. Subclasses include ExternalReference, GranularMarking, KillChainPhase, HashEntry, EmailMimePart, AlternateDataStream, WindowsPeSection, WindowsRegistryValue, and X509V3Extensions."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "STIX Sub-Type"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stones#ThreatActor",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://cyberterrain.org/ns/stones#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stones#StixDomainObject"
  }, {
