    "@id" : "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The ordinal controlled vocabulary of assessed threat-actor technical sophistication."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "STONEWORK Sophistication Level Scheme"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#sophisticationLevelStrategic",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#SophisticationLevel"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The actor combines advanced capability with long-term planning and coordinated resourcing."
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categoryScheme"
  }, {
    "@id" : "https://cyberterrain.org/ns/stonework#sophisticationLevelScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#notation" : [ {
    "@value" : "strategic"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Strategic"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#spawns",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#RuntimeProcess"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#RuntimeProcess"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#hasParentProcess"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A RuntimeProcess creates a child process. Inverse of stonework:hasParentProcess; enables top-down process tree traversal for execution chain analysis."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "spawns"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#splitFrom",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Hypothesis"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Hypothesis"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates a Hypothesis to the Hypothesis it was split from."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "splitFrom"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "A Hypothesis that has started to catch two patterns is kept, and each pattern is a new Hypothesis that splitFrom it. Several may name the same parent. Functional: one parent. Not transitive. Not stonework:hypothesisPart: parts are the conjunction of one claim, while a split is two claims that used to be one. The parent is not deleted; its status is superseded unless it was already confirmed or refuted."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#splitKind",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Step"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#FlowKind"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "https://www.omg.org/spec/BPMN/2.0.2/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#categorizedBy"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "How a Step's outgoing Transitions are taken when it finishes: exclusive, exactly one, whose guard holds; parallel, every one whose guard holds, as concurrent branches."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "splitKind"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Omitted means exclusive, the meaning several outgoing Transitions had before splitKind existed. With parallel, an unguarded Transition is always taken, so a parallel split whose Transitions are all unguarded is BPMN's parallel gateway, and one whose Transitions are guarded is its inclusive gateway. The branches may overlap in time; the Step where they meet says by its stonework:joinKind whether it waits for them all. As in YAWL, a split is a property of the Step it follows, not a separate gateway node, so every Step remains a unit of action; a BPMN diverging gateway maps onto the splitKind of the Step before it."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#srcPort",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#NetworkTraffic"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#unsignedShort"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The source TCP/UDP port number."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "srcPort"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#startedAtTime",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberActivity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#dateTime"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://www.w3.org/ns/prov#startedAtTime"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The date and time at which a CyberActivity began."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "startedAtTime"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#startedNotAfter",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberActivity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#dateTime"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/P82b_end_of_the_begin"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The latest time at which a CyberActivity can have begun, when the evidence bounds its start but doesn't give it."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "startedNotAfter"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "See stonework:startedNotBefore. CIDOC CRM's \"end of the begin\" (P82b)."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#startedNotBefore",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberActivity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#dateTime"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/P82a_begin_of_the_begin"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The earliest time at which a CyberActivity can have begun, when the evidence bounds its start but doesn't give it."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "startedNotBefore"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "With stonework:startedNotAfter, a window for a start that isn't known exactly, such as a call a statement places between two logged events, in place of an estimated stonework:startedAtTime: an estimate on a timeline reads as a fact. Either bound can be given alone. When the start is known, use stonework:startedAtTime; bounds given as well must contain it. A comparison with another time is undetermined while the window overlaps it. CIDOC CRM's \"begin of the begin\" (P82a)."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#stepOrder",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Step"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#integer"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An optional ordinal position for a Step within a strictly linear Behavior, where the full precededByStep graph is unnecessary."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "stepOrder"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Most CTI procedure write-ups (a numbered list of adversary actions) are linear. stepOrder is a low-overhead alternative to precededByStep for that common case; the two are not mutually exclusive."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#stepTarget",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Step"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberEntity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "What a Step is meant to act on: a specific entity, or a Variable whose value in the run is the target."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "stepTarget"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "The plan-level counterpart of stonework:actsOn, as stonework:performerRole is of stonework:performedBy; CACAO's targets on an action step. A specific entity (the mail tenant) is the target in every run. A stonework:Variable (itself a CyberEntity) means whatever that Variable is bound to in the run, such as the mailbox being contained. An execution whose actsOn is neither departs from the Plan: a wrong-target stonework:Deviation."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#storedIn",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#DataAsset"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Infrastructure"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates a DataAsset to the Infrastructure system that stores it."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "storedIn"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#storedOn",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid217"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Host"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates a DigitalArtifact to the Host on which it is stored."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "storedOn"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#streetAddress",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Location"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The street address of the location, such as a building number and street name."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "streetAddress"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Corresponds to the STIX 2.1 Location street_address property. Record the postal code with stonework:postalCode and the enclosing City, Region, or Country with stonework:locatedWithin rather than repeating them in this string."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#subdomainOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#TransitiveProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Domain"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Domain"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "This Domain is a subdomain of the specified parent Domain. Transitive: if A is a subdomain of B and B of C, then A is a subdomain of C."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "subdomainOf"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#subsidiary",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Organization"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Organization"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates an Organization to a subsidiary organization it owns or controls."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "subsidiary"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#summary",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#IntelligenceProduct"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://purl.org/dc/terms/abstract"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A brief summary of the intelligence product's key findings."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "summary"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#supersededBy",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#TransitiveProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Vulnerability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Vulnerability"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates a vulnerability to the vulnerability record that supersedes it, e.g. when a CVE is split, merged, or formally replaced by another identifier."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "supersededBy"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Corresponds to cve:replacedBy in CVE JSON 5.x, but as an object property linking to a stonework:Vulnerability individual rather than a string. The source-specific string form is preserved on cve:replacedBy regardless of whether resolution to this property succeeds."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#supersedes",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#TransitiveProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#VersionedProduct"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#VersionedProduct"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates a product version to an older version it replaces. Transitive to support full product lifecycle reasoning."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "supersedes"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#suppliedBy",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Variable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "https://www.omg.org/spec/BPMN/2.0.2/"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates a Variable to the Role whose holders supply its value from outside the Plan, as a message from a participant whose own plan isn't modelled."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "suppliedBy"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "BPMN's message flow from a black-box pool: the supplier who sends an invoice, a customer who places an order. The value is bound in the execution that received it. When the sender's plan is modelled, a Step of that plan declares the Variable with stonework:hasOutputVariable instead, and the receiving execution records stonework:usedBinding of the sender's binding. A Variable may have both: a payment request is supplied by the supplier, and a business email compromise actor's OperationPlan can produce one too, which the receiving Step can't tell apart from the real thing. Steps whose input Variables are supplied from outside the organization are its attack surface for messages."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#targets",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Shortcut triple: source targets the target Identity, Vulnerability, or Location. Corresponds to STIX relationship_type 'targets'."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "targets"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Domain/range intentionally left unset: this property is a direct lift of the STIX 2.1 relationship_type 'targets' shortcut. STIX does not schema-constrain which SDO/SCO types may appear as source_ref/target_ref for a given relationship_type — that's producer convention, not enforceable structure, and a closed domain/range here would misrepresent real STIX 2.1 data and mislead reasoner-based consumers."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#targetsPlatform",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#VersionedProduct"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A MalwareSample or Tool is engineered to run on or exploit this VersionedProduct (OS, application, firmware version). Supports exposure and blast-radius queries."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "targetsPlatform"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#targetsService",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#NetworkTraffic"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#NetworkService"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The NetworkService this traffic addresses."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "targetsService"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@value" : "⚑ Category: service *type* (HTTP, SSH, RDP, SMB, DNS) is better expressed as stonework:categorizedBy → Category named individual than as subclasses of NetworkService. NetworkService as a class is appropriate only when the instance has its own properties (port, vulnerability linkage)."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#techniqueOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Technique"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid221"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#hasTechnique"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates a Technique to a Tactic it supports or to a broader Technique of which it is a specialization."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "techniqueOf"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "This is the inverse of hasTechnique. A Technique may support multiple Tactics, and a sub-technique may identify its broader parent Technique through the same hierarchy."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#testsHypothesis",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Investigation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Hypothesis"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates an Investigation to a Hypothesis it tests."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "testsHypothesis"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "The direct link from an Investigation to its Hypotheses. When the Investigation executes an InvestigationPlan, the Hypothesis also predicts a Variable of a Step in that plan (stonework:predictsVariable); its outcome is stonework:hasHypothesisStatus."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#threatActorRoleAgent",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
