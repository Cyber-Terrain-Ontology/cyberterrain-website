  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The name string of the mutex object."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "mutexName"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#networkProtocol",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#NetworkTraffic"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The network or transport protocol (e.g. TCP, UDP, ICMP, HTTP, DNS)."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "networkProtocol"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#noteAbout",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Note"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates a Note to the entities it annotates."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "noteAbout"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#objective",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid250"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A description of the strategic goal or objective being pursued."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "objective"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#observedAt",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#MetricObservation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#dateTime"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The date and time at which a metric observation was made or calculated."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "observedAt"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#observedIn",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid159"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberActivity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates an observed entity, such as a DigitalArtifact, Infrastructure, Malware, Product, Behavior, Identifier, or SecurityCondition, to the CyberActivity (for example a Campaign, Incident, or Event) in which it was observed or collected."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "observedIn"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "A general-purpose shortcut: the kind of context is conveyed by typing the CyberActivity, so narrower subproperties per activity type are unnecessary. Asserting this property does not imply that the object is a Campaign; type it explicitly when that matters. When an observation needs its own metadata, such as observer, time, location, count, or confidence, model it as a stonework:Sighting instead. Not an inverse of stonework:uses, which records that an actor, campaign, or malware employs a technique or tool rather than that an entity was seen in an activity."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#obsoletes",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Hypothesis"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Hypothesis"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://purl.org/dc/terms/replaces"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates a Hypothesis to an earlier Hypothesis it replaces."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "obsoletes"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "The later Hypothesis obsoletes the earlier one, which is kept. Use it when a refuted or faded Hypothesis is replaced by the one formed from it. One Hypothesis may obsolete more than one earlier Hypothesis. Not transitive: follow the chain in a query, so withdrawing one link withdraws nothing else. After Dublin Core replaces. A split is stonework:splitFrom, and a merge is stonework:absorbedInto. stonework:hypothesisPart is a conjunction of one claim, not a successor. The earlier Hypothesis keeps a confirmed or refuted status; otherwise it becomes superseded."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#occursOn",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Event"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Host"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates an Event to the Host on which it was observed."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "occursOn"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#operatesIn",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid167"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid170"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates an Organization or ThreatActor to the Locations or Sectors they operate in."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "operatesIn"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#opinionOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Opinion"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid173"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates an Opinion to the IntelligenceProduct or QualifiedAssertion whose correctness or credibility it evaluates."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "opinionOf"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "An analyst's confirmation or rejection of a single qualified assertion, such as a proposed stonework:refersTo link found by a heuristic, is an Opinion of that QualifiedAssertion: agreement (stones:opinion) with the explanation and author recorded on the Opinion."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#originatesFrom",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Agent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Location"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates an Agent to the geographic Location from which it originates."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "originatesFrom"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#originatesInAS",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#IPAddress"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#AutonomousSystem"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates an IPAddress to the AutonomousSystem that originates its encompassing IP prefix in BGP."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "originatesInAS"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#originatorAccount",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#FinancialTransaction"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#FinancialAccount"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The account debited by this transaction — the source of the transferred value."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "originatorAccount"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Naming follows the FATF Travel Rule and ISO 20022 originator-beneficiary convention. Direction of value is carried by these roles, not by the sign of stonework:amount."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#originatorMonetaryValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#FinancialTransaction"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#MonetaryAmount"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#hasMonetaryValue"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The monetary amount debited from the originator account as this transaction's input."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "originatorMonetaryValue"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Use with stonework:beneficiaryMonetaryValue when a transaction changes denomination, as in a currency exchange. Both properties remain queryable through their stonework:hasMonetaryValue superproperty."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#osName",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Host"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The name of the operating system running on the host (e.g. Windows, Linux, macOS)."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "osName"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#osVersion",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Host"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The version string of the operating system."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "osVersion"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#outcomeDetail",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberActivity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Why an activity ended as it did, as the source system reports it, such as an error code and its message."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "outcomeDetail"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#outcomeVariable",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Behavior"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Variable"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#hasOutputVariable"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The output Variable that records whether an execution of a Step or Plan succeeded, failed or timed out."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "outcomeVariable"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Its value in a run is a stonework:ExecutionOutcome (succeeded, failed, timed out), bound like any other output. Transitions guarded on it with stonework:guardValue express CACAO's on_success and on_failure. Other output Variables carry what the Step found or made; the outcome Variable says only whether it worked, so a search that ran and found nothing has the outcome succeeded."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#overlapsWith",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Indicates two entities share common attributes, infrastructure, or behaviour, suggesting possible connection without asserting a specific relationship type."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "overlapsWith"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#ownedBy",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid176"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#Agent"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates a DataAsset or Infrastructure to its owning Agent."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "ownedBy"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#packerName",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#MalwareSample"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The name of the packer or obfuscator used (e.g. UPX, Themida)."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "packerName"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#packetCount",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#NetworkTraffic"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The total number of packets observed in the traffic flow."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "packetCount"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#parentPid",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#RuntimeProcess"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "The process identifier of the parent process."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "parentPid"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#partOfExecution",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberActivity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://cyberterrain.org/ns/stonework#CyberActivity"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relates the execution of a Step to the execution of the Plan or Step it is part of."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@value" : "partOfExecution"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Groups a run's step executions, as a P-Plan bundle groups a plan's execution trace, so that queries over a plan run many times (which steps ran, which were skipped, which values were bound) are asked of one run at a time. Links to the immediate parent only; nested Steps form a chain to the run, which is the execution that is stonework:executionOf the Plan. An execution may be both a Step's execution in one plan and a run of another, as when an investigation's containment Step is carried out by running a ControlPlan: it is then stonework:partOfExecution the investigation, stonework:correspondsToStep the Step, and stonework:executionOf the ControlPlan. Not transitive, so that each execution's parent stays unambiguous; use a SPARQL property path (stonework:partOfExecution+) for every ancestor."
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#paymentInstrumentAchTransfer",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
