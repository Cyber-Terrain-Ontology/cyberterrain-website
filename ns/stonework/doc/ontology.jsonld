  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Indicates whether the sample has been packed or obfuscated."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "isPacked"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#isPrivileged",
