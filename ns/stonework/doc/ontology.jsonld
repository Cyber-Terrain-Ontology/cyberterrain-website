    "@value" : "accidental"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Accidental"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#motivationCoercion",
