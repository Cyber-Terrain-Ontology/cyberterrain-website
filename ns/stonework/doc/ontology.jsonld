  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Insider Accidental"
  } ]
}, {
  "@id" : "https://cyberterrain.org/ns/stonework#threatActorTypeInsiderDisgruntled",
